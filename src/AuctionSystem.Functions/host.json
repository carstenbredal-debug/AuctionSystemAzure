{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api"
    },
    "queues": {
      "messageEncoding": "base64",
      "maxDequeueCount": 5,
      "batchSize": 1,
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:05:00"
    }
  }
}
