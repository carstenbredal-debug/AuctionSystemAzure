@page "/"
@rendermode InteractiveServer
@inject AuctionDbContext Db

<PageTitle>Dashboard - Auction System</PageTitle>

<h1>Auction System Dashboard</h1>
<p class="text-muted">Connected to Azure SQL Server</p>

@if (loading)
{
    <p>Loading...</p>
}
else
{
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Auctions</h5>
                    <p class="card-text display-6">@totalAuctions</p>
                    <small>@activeAuctions active</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Lots</h5>
                    <p class="card-text display-6">@totalLots</p>
                    <small>@soldLots sold</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Brokers</h5>
                    <p class="card-text display-6">@totalBrokers</p>
                    <small>@totalBuyers buyers</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Sellers</h5>
                    <p class="card-text display-6">@totalSellers</p>
                    <small>@pendingSettlements pending settlements</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Recent Auctions</strong></div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead><tr><th>Number</th><th>Title</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var a in recentAuctions)
                            {
                                <tr>
                                    <td>@a.AuctionNumber</td>
                                    <td>@a.Title</td>
                                    <td>@a.ScheduledDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-@GetStatusColor(a.Status)">@a.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Bid Activity</strong></div>
                <div class="card-body">
                    <p>Total bids: <strong>@totalBids</strong></p>
                    <p>Pending invoices: <strong>@pendingInvoices</strong></p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private int totalAuctions, activeAuctions, totalLots, soldLots;
    private int totalBrokers, totalBuyers, totalSellers;
    private int totalBids, pendingInvoices, pendingSettlements;
    private List<Auction> recentAuctions = new();

    protected override async Task OnInitializedAsync()
    {
        totalAuctions = await Db.Auctions.CountAsync();
        activeAuctions = await Db.Auctions.CountAsync(a => a.Status == AuctionStatus.InProgress);
        totalLots = await Db.Lots.CountAsync();
        soldLots = await Db.Lots.CountAsync(l => l.Status == LotStatus.Sold);
        totalBrokers = await Db.Brokers.CountAsync();
        totalBuyers = await Db.Buyers.CountAsync();
        totalSellers = await Db.Sellers.CountAsync();
        totalBids = await Db.Bids.CountAsync();
        pendingInvoices = await Db.Invoices.CountAsync(i => i.Status == InvoiceStatus.Issued);
        pendingSettlements = await Db.Settlements.CountAsync(s => s.Status == SettlementStatus.Pending);
        recentAuctions = await Db.Auctions.OrderByDescending(a => a.ScheduledDate).Take(5).ToListAsync();
        loading = false;
    }

    private string GetStatusColor(AuctionStatus status) => status switch
    {
        AuctionStatus.Draft => "secondary",
        AuctionStatus.Scheduled => "info",
        AuctionStatus.InProgress => "success",
        AuctionStatus.Completed => "primary",
        AuctionStatus.Cancelled => "danger",
        _ => "secondary"
    };
}
