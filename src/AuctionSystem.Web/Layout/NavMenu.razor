<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView Roles="Broker">
            <Authorized>
                <a class="navbar-brand" href="">Broker Portal</a>
            </Authorized>
            <NotAuthorized>
                <a class="navbar-brand" href="">Auction System</a>
            </NotAuthorized>
        </AuthorizeView>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized Context="authState">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin">
                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-muted"><small><strong>ADMIN</strong></small></span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/users">
                            <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Users & Roles
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/brokers">
                            <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Brokers
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/sellers">
                            <span class="bi bi-shop-nav-menu" aria-hidden="true"></span> Sellers
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/buyers">
                            <span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> Buyers
                        </NavLink>
                    </div>

                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-muted"><small><strong>AUCTION</strong></small></span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="auctions">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Auctions
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="settlements">
                            <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> Settlements
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Broker">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="broker/customers">
                            <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Customers
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="broker/lots">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Lots
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="broker/auction">
                            <span class="bi bi-hammer-nav-menu" aria-hidden="true"></span> Auction
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="broker/financial">
                            <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> Financial
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Buyer">
                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-muted"><small><strong>BUYER</strong></small></span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="buyer">
                            <span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> Buyer Portal
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Seller">
                    <div class="nav-item px-3 mt-2">
                        <span class="nav-link text-muted"><small><strong>SELLER</strong></small></span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="seller">
                            <span class="bi bi-shop-nav-menu" aria-hidden="true"></span> Seller Portal
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3 mt-3 border-top pt-2">
                    <span class="nav-link text-light">
                        <small>@authState.User.Identity?.Name</small>
                    </span>
                    <a class="nav-link text-warning" href="/.auth/logout?post_logout_redirect_uri=/">
                        Logout
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/login">
                        Login
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
