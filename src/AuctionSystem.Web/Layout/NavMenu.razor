<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView Roles="Broker">
            <Authorized>
                <a class="navbar-brand" href="">
                    <img src="images/kopenhagen-fur-logo-white.png" alt="Kopenhagen Fur" class="brand-logo-img" />
                </a>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Buyer">
            <Authorized>
                <a class="navbar-brand" href="">
                    <img src="images/kopenhagen-fur-logo-white.png" alt="Kopenhagen Fur" class="brand-logo-img" />
                </a>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Farmer,Typist">
            <Authorized>
                <a class="navbar-brand" href="">
                    <img src="images/kopenhagen-fur-logo-white.png" alt="Kopenhagen Fur" class="brand-logo-img" />
                </a>
            </Authorized>
        </AuthorizeView>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

