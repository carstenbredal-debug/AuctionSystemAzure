@inherits LayoutComponentBase

<div class="page">
    <div class="dev-banner dev-banner-right">DEV</div>
    <div class="dev-banner dev-banner-left">DEV</div>
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu">
                        <div class="user-avatar" @onclick="ToggleUserMenu">
                            <span class="avatar-icon">👤</span>
                        </div>
                        @if (_showUserMenu)
                        {
                            <div class="user-dropdown">
                                <span class="dropdown-user-name">@context.User.Identity?.Name</span>
                                <a href="/.auth/logout?post_logout_redirect_uri=/" class="dropdown-item">Logout</a>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _showUserMenu;

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
    }
}
