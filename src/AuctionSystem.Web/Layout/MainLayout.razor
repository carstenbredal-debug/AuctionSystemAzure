@inherits LayoutComponentBase

<div class="page">
    @* DEV banners temporarily removed *@
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu">
                        <div class="user-avatar" @onclick="ToggleUserMenu">
                            <span class="avatar-icon">👤</span>
                        </div>
                        @if (_showUserMenu)
                        {
                            <div class="user-dropdown">
                                <span class="dropdown-user-name">@context.User.Identity?.Name</span>
                                <a href="/.auth/logout?post_logout_redirect_uri=/" class="dropdown-item">Logout</a>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>


@code {
    private bool _showUserMenu;

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
    }
}
