@page "/farmer"
@attribute [Authorize(Roles = "Admin,Farmer")]
@using System.Text.Json
@inject HttpClient Http
@inject AuctionApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Farmer Portal - Auction System</PageTitle>

<h1>Farmer Portal</h1>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (string.IsNullOrEmpty(_farmerName))
{
    <div class="alert alert-warning">No farmer account linked to your login.</div>
}
else
{
    <p class="text-muted">Farmer: <strong>@_farmerName</strong></p>

    <div class="section-container">
        <div class="section-header">Auctions</div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Auction</th>
                        <th>Total Skins</th>
                        <th>Sold Skins</th>
                        <th>Total Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_auctionSummaries.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No auctions found.</td></tr>
                    }
                    @foreach (var a in _auctionSummaries)
                    {
                        <tr style="cursor: pointer;" @onclick="() => GoToAuction(a.Auction)">
                            <td><strong>@a.Auction</strong></td>
                            <td>@a.TotalSkins.ToString("N0")</td>
                            <td>@a.SoldSkins.ToString("N0")</td>
                            <td>@a.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _farmerName;
    private List<FarmerAuctionSummary> _auctionSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (oid != null)
        {
            var user = await Api.GetCurrentUserAsync(oid);
            if (user?.FarmerId != null)
            {
                var farmers = await Api.GetFarmersAsync();
                var farmer = farmers.FirstOrDefault(f => f.Id == user.FarmerId);
                _farmerName = farmer?.Name;
            }
        }

        if (!string.IsNullOrEmpty(_farmerName))
        {
            try
            {
                var url = $"api/skins/farmer-summary?farmerName={Uri.EscapeDataString(_farmerName)}";
                var json = await Http.GetStringAsync(url);
                _auctionSummaries = JsonSerializer.Deserialize<List<FarmerAuctionSummary>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
            catch
            {
                // API not available
            }
        }

        _loading = false;
    }

    private void GoToAuction(string auctionNumber)
    {
        Nav.NavigateTo($"/farmer/auction/{Uri.EscapeDataString(auctionNumber)}");
    }

    private class FarmerAuctionSummary
    {
        public string Auction { get; set; } = "";
        public int TotalSkins { get; set; }
        public int SoldSkins { get; set; }
        public decimal TotalValue { get; set; }
    }
}
