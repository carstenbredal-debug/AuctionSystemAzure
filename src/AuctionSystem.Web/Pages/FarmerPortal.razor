@page "/farmer"
@attribute [Authorize(Roles = "Admin,Farmer")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Farmer Portal - Auction System</PageTitle>

<h1>Farmer Portal</h1>

<div class="mb-3">
    <label class="form-label"><strong>Select Farmer</strong></label>
    <select class="form-select w-auto" @bind="selectedFarmerId" @bind:after="LoadFarmerData">
        <option value="0">Choose...</option>
        @foreach (var s in farmers)
        {
            <option value="@s.Id">@s.Name (@s.FarmerNumber)</option>
        }
    </select>
</div>

@if (selectedFarmerId > 0)
{
    <div class="section-container">
        <div class="section-header">Auctions</div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Auction</th>
                        <th>Date</th>
                        <th>Total Skins</th>
                        <th>Sold Skins</th>
                        <th>Total Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_auctionSummaries.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No auctions found for this farmer.</td></tr>
                    }
                    @foreach (var a in _auctionSummaries)
                    {
                        <tr style="cursor: pointer;" @onclick="() => Nav.NavigateTo($&quot;/farmer/auction/{a.AuctionId}?farmerId={selectedFarmerId}&quot;)">
                            <td><strong>@a.AuctionTitle</strong></td>
                            <td>@a.ScheduledDate.ToString("yyyy-MM-dd")</td>
                            <td>@a.TotalSkins.ToString("N0")</td>
                            <td>@a.SoldSkins.ToString("N0")</td>
                            <td>@a.TotalValue.ToString("N2")</td>
                            <td><span class="badge bg-@GetStatusColor(a.Status)">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<FarmerDto> farmers = new();
    private int selectedFarmerId;
    private List<LotDto> lots = new();
    private List<FarmerAuctionSummary> _auctionSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        farmers = await Api.GetFarmersAsync();
    }

    private async Task LoadFarmerData()
    {
        if (selectedFarmerId <= 0) return;
        lots = await Api.GetLotsByFarmerAsync(selectedFarmerId);

        _auctionSummaries = lots
            .GroupBy(l => l.AuctionId)
            .Select(g =>
            {
                var first = g.First();
                var soldLots = g.Where(l => l.Status == LotStatus.Sold || l.Status == LotStatus.Broker).ToList();
                return new FarmerAuctionSummary
                {
                    AuctionId = g.Key,
                    AuctionTitle = first.Auction?.Title ?? first.Auction?.AuctionNumber ?? $"Auction {g.Key}",
                    ScheduledDate = first.Auction?.ScheduledDate ?? DateTime.MinValue,
                    Status = first.Auction?.Status ?? AuctionStatus.Draft,
                    TotalSkins = g.Sum(l => l.Quantity),
                    SoldSkins = soldLots.Sum(l => l.Quantity),
                    TotalValue = soldLots.Sum(l => (l.HammerPrice ?? 0) * l.Quantity)
                };
            })
            .OrderByDescending(a => a.ScheduledDate)
            .ToList();
    }

    private string GetStatusColor(AuctionStatus status) => status switch
    {
        AuctionStatus.Draft => "secondary",
        AuctionStatus.Active => "success",
        AuctionStatus.Closed => "primary",
        _ => "secondary"
    };

    private class FarmerAuctionSummary
    {
        public int AuctionId { get; set; }
        public string AuctionTitle { get; set; } = "";
        public DateTime ScheduledDate { get; set; }
        public AuctionStatus Status { get; set; }
        public int TotalSkins { get; set; }
        public int SoldSkins { get; set; }
        public decimal TotalValue { get; set; }
    }
}
