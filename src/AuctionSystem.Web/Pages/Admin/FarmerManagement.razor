@page "/admin/farmers"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Farmers - Admin</PageTitle>

<h1>Farmers</h1>
<p class="text-muted">Click on a farmer to view details.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <p class="small text-muted mb-3">To add a new farmer, go to <a href="admin/users">Users & Roles</a> and create a user with the Farmer role.</p>

    <div class="mb-3" style="max-width:320px">
        <input class="form-control" placeholder="Search farmer number…"
               value="@_search" @oninput='e => _search = e.Value?.ToString() ?? ""' />
    </div>

    <div class="section-container">
        <div class="section-header">
            Registered Farmers
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Number</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">@(_items.Count == 0 ? "No farmers registered." : "No farmer number matches the search.")</td></tr>
                    }
                    @foreach (var item in Filtered)
                    {
                        <tr style="cursor: pointer;" @onclick="() => ViewFarmer(item.Id)">
                            <td><strong>@item.FarmerNumber</strong></td>
                            <td>@item.Name</td>
                            <td>@item.ContactEmail</td>
                            <td>@item.ContactPhone</td>
                            <td>@item.City</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<FarmerDto> _items = new();
    private string _search = "";
    private bool _loading = true;

    private List<FarmerDto> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(f => (f.FarmerNumber ?? "").Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        _items = await Api.GetFarmersAsync();
        _loading = false;
    }

    private void ViewFarmer(int id) => Nav.NavigateTo($"admin/farmers/{id}");
}
