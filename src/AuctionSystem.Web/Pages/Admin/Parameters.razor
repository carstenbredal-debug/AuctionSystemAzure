@page "/admin/parameters"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Parameters - Admin</PageTitle>

<h1>Parameters</h1>
<p class="text-muted">Configure system-wide settings such as fees, rates, and other parameters.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>System Parameters</strong>
            <button class="btn btn-sm btn-primary" @onclick="ShowAddForm">Add Parameter</button>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Parameter</th>
                        <th>Value</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Last Updated</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No parameters configured. Click "Add Parameter" to create one.</td></tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><strong>@item.Key</strong></td>
                            <td>
                                @if (item.DataType == "percentage")
                                {
                                    <span>@item.Value%</span>
                                }
                                else if (item.DataType == "currency")
                                {
                                    <span>@item.Value</span>
                                }
                                else
                                {
                                    <span>@item.Value</span>
                                }
                            </td>
                            <td><span class="badge bg-info">@item.DataType</span></td>
                            <td class="text-muted">@item.Description</td>
                            <td>@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(item)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(item)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_showForm)
    {
        <div class="card border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <strong>@(_editing?.Id > 0 ? "Edit Parameter" : "Add Parameter")</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="Cancel"></button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Parameter Key <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editing!.Key" placeholder="e.g. AuctionFee" disabled="@(_editing?.Id > 0)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Value <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editing!.Value" placeholder="e.g. 5.00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Data Type</label>
                        <select class="form-select" @bind="_editing!.DataType">
                            <option value="string">String</option>
                            <option value="percentage">Percentage</option>
                            <option value="currency">Currency</option>
                            <option value="number">Number</option>
                            <option value="boolean">Boolean</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <input class="form-control" @bind="_editing!.Description" placeholder="Describe what this parameter is used for" />
                    </div>
                    <div class="col-12 mt-3">
                        <button class="btn btn-success me-2" @onclick="Save">@(_editing?.Id > 0 ? "Update" : "Create")</button>
                        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<SystemParameterDto> _items = new();
    private SystemParameterDto? _editing;
    private bool _loading = true;
    private bool _showForm;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        _items = await Api.GetParametersAsync();
    }

    private void ShowAddForm()
    {
        _editing = new SystemParameterDto { DataType = "percentage" };
        _showForm = true;
        _message = null;
    }

    private void Cancel() { _editing = null; _showForm = false; }

    private void Edit(SystemParameterDto item)
    {
        _editing = new SystemParameterDto
        {
            Id = item.Id, Key = item.Key, Value = item.Value,
            Description = item.Description, DataType = item.DataType
        };
        _showForm = true;
        _message = null;
    }

    private async Task Save()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.Key) || string.IsNullOrWhiteSpace(_editing.Value))
        { _message = "Parameter Key and Value are required."; _messageIsError = true; return; }

        if (_editing.Id > 0)
            await Api.UpdateParameterAsync(_editing.Id, _editing);
        else
            await Api.CreateParameterAsync(_editing);

        _message = $"Parameter '{_editing.Key}' saved."; _messageIsError = false;
        _showForm = false; _editing = null;
        await LoadData();
    }

    private async Task Delete(SystemParameterDto item)
    {
        await Api.DeleteParameterAsync(item.Id);
        _message = $"Parameter '{item.Key}' deleted."; _messageIsError = false;
        await LoadData();
    }
}
