@page "/admin/buyer-balances"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@implements IDisposable

<PageTitle>Buyer Balances - Admin</PageTitle>

<h3 class="mb-4">Finance — Buyer Balances</h3>

<div class="d-flex align-items-center mb-3">
    <button class="btn btn-primary me-3" @onclick="RefreshNow" disabled="@_loading">
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Refresh Now
    </button>
    <div class="form-check form-switch me-3">
        <input class="form-check-input" type="checkbox" id="autoRefresh" @bind="_autoRefreshEnabled" @bind:after="ToggleAutoRefresh" />
        <label class="form-check-label" for="autoRefresh">Auto-refresh every 5 min</label>
    </div>
    @if (!string.IsNullOrEmpty(_lastChecked))
    {
        <small class="text-muted">Last checked: @_lastChecked</small>
    }
    @if (_nextRefresh.HasValue && _autoRefreshEnabled)
    {
        <small class="text-muted ms-3">Next refresh: @_nextRefresh.Value.ToString("HH:mm:ss")</small>
    }
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_result != null)
{
    @if (_result.Buyers.Count == 0)
    {
        <div class="alert alert-info">No buyer data found in BC.</div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="section-body p-3">
                        <h5 class="card-title text-muted">Total Buyers</h5>
                        <h3>@_result.Buyers.Count</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="section-body p-3">
                        <h5 class="card-title text-muted">Total Unallocated</h5>
                        <h3>€@_result.Buyers.Sum(b => b.UnallocatedPayment).ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="section-body p-3">
                        <h5 class="card-title text-muted">Open Invoices</h5>
                        <h3>@_result.Buyers.Sum(b => b.OpenInvoiceCount)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="section-body p-3">
                        <h5 class="card-title text-muted">Open Payments</h5>
                        <h3>@_result.Buyers.Sum(b => b.OpenPaymentCount)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-container">
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Customer #</th>
                            <th>Customer Name</th>
                            <th>Buyer Name</th>
                            <th class="text-end">Total Invoiced</th>
                            <th class="text-end">Total Credited</th>
                            <th class="text-end">Total Payments</th>
                            <th class="text-end">Open Invoice Remaining</th>
                            <th class="text-end">Unallocated Payment</th>
                            <th class="text-center">Open Invoices</th>
                            <th class="text-center">Open Payments</th>
                            <th class="text-center">Statement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in _result.Buyers)
                        {
                            <tr class="@(b.UnallocatedPayment > 0 ? "credit-row" : "")">
                                <td>@b.CustomerNo</td>
                                <td>@b.CustomerName</td>
                                <td>@(b.BuyerName ?? "—")</td>
                                <td class="text-end">€@b.TotalInvoiced.ToString("N2")</td>
                                <td class="text-end">€@b.TotalCredited.ToString("N2")</td>
                                <td class="text-end">€@b.TotalPayments.ToString("N2")</td>
                                <td class="text-end">€@b.OpenInvoiceRemaining.ToString("N2")</td>
                                <td class="text-end fw-bold @(b.UnallocatedPayment > 0 ? "text-danger" : "")">€@b.UnallocatedPayment.ToString("N2")</td>
                                <td class="text-center">@b.OpenInvoiceCount</td>
                                <td class="text-center">@b.OpenPaymentCount</td>
                                <td class="text-center">
                                    <a href="@($"{Api.BaseUrl}/bc/statement/{b.CustomerNo}")" target="_blank" class="btn btn-sm btn-outline-dark" title="Download Statement">
                                        📄
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary fw-bold">
                        <tr>
                            <td colspan="3">Totals</td>
                            <td class="text-end">€@_result.Buyers.Sum(b => b.TotalInvoiced).ToString("N2")</td>
                            <td class="text-end">€@_result.Buyers.Sum(b => b.TotalCredited).ToString("N2")</td>
                            <td class="text-end">€@_result.Buyers.Sum(b => b.TotalPayments).ToString("N2")</td>
                            <td class="text-end">€@_result.Buyers.Sum(b => b.OpenInvoiceRemaining).ToString("N2")</td>
                            <td class="text-end">€@_result.Buyers.Sum(b => b.UnallocatedPayment).ToString("N2")</td>
                            <td class="text-center">@_result.Buyers.Sum(b => b.OpenInvoiceCount)</td>
                            <td class="text-center">@_result.Buyers.Sum(b => b.OpenPaymentCount)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

@code {
    private BcBuyerBalancesResponseDto? _result;
    private bool _loading;
    private string? _error;
    private string? _lastChecked;
    private bool _autoRefreshEnabled = true;
    private DateTime? _nextRefresh;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        StartAutoRefresh();
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _result = await Api.GetBcBuyerBalancesAsync();
            _lastChecked = _result.LastChecked;
            if (string.IsNullOrEmpty(_lastChecked))
                _lastChecked = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _loading = false;
        _nextRefresh = _autoRefreshEnabled ? DateTime.Now.AddMinutes(5) : null;
        StateHasChanged();
    }

    private async Task RefreshNow()
    {
        await LoadData();
        if (_autoRefreshEnabled)
            RestartTimer();
    }

    private void ToggleAutoRefresh()
    {
        if (_autoRefreshEnabled)
            StartAutoRefresh();
        else
            StopAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _timer?.Dispose();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
            });
        }, null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
        _nextRefresh = DateTime.Now.AddMinutes(5);
    }

    private void StopAutoRefresh()
    {
        _timer?.Dispose();
        _timer = null;
        _nextRefresh = null;
    }

    private void RestartTimer()
    {
        StopAutoRefresh();
        StartAutoRefresh();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
