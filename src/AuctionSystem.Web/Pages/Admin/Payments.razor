@page "/admin/payments"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Payments - Admin</PageTitle>

<h3 class="mb-4">Finance — Payments from BC</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="CheckPayments" disabled="@_loading">
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Check Payments in BC
    </button>
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_result != null)
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Customer Ledger Entries</h5>
                    <h3>@_result.TotalCustomerLedgerEntries</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">GL Payment Entries</h5>
                    <h3>@_result.TotalGlPaymentEntries</h3>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_result.LedgerError))
    {
        <div class="alert alert-warning">
            <strong>Ledger entries error:</strong> @_result.LedgerError
        </div>
    }
    @if (!string.IsNullOrEmpty(_result.GlError))
    {
        <div class="alert alert-warning">
            <strong>GL entries error:</strong> @_result.GlError
        </div>
    }

    @* Customer Ledger Entries *@
    @if (_result.CustomerLedgerEntries.Count > 0)
    {
        <h5 class="mb-3">Customer Ledger Entries — Payments</h5>
        <div class="card mb-4">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Entry #</th>
                            <th>Posting Date</th>
                            <th>Document #</th>
                            <th>Customer</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Remaining</th>
                            <th>Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _result.CustomerLedgerEntries)
                        {
                            <tr class="@(!e.Open ? "table-success" : "")">
                                <td>@e.EntryNo</td>
                                <td>@e.PostingDate</td>
                                <td>@e.DocumentNo</td>
                                <td>@e.CustomerName (@e.CustomerNo)</td>
                                <td>@e.Description</td>
                                <td class="text-end">€@e.Amount.ToString("N2")</td>
                                <td class="text-end">€@e.RemainingAmount.ToString("N2")</td>
                                <td><span class="badge @(e.Open ? "bg-warning text-dark" : "bg-success")">@(e.Open ? "Open" : "Closed")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* GL Payment Entries *@
    @if (_result.GlPaymentEntries.Count > 0)
    {
        <h5 class="mb-3">General Ledger — Payment Entries</h5>
        <div class="card mb-4">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Entry #</th>
                            <th>Posting Date</th>
                            <th>Document #</th>
                            <th>Account #</th>
                            <th>Description</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _result.GlPaymentEntries)
                        {
                            <tr>
                                <td>@e.EntryNumber</td>
                                <td>@e.PostingDate</td>
                                <td>@e.DocumentNumber</td>
                                <td>@e.AccountNumber</td>
                                <td>@e.Description</td>
                                <td class="text-end">€@e.DebitAmount.ToString("N2")</td>
                                <td class="text-end">€@e.CreditAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_result.TotalCustomerLedgerEntries == 0 && _result.TotalGlPaymentEntries == 0)
    {
        <div class="alert alert-info">No payment activity detected in BC.</div>
    }
}

@code {
    private BcPaymentsResponseDto? _result;
    private bool _loading;
    private string? _error;

    private async Task CheckPayments()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _result = await Api.GetBcPaymentsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to check payments: {ex.Message}";
        }

        _loading = false;
    }
}
