@page "/admin/payments"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Payments - Admin</PageTitle>

<h3 class="mb-4">Finance — Payments from BC</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="CheckPayments" disabled="@_loading">
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Check Payments in BC
    </button>
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_result != null)
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Payments Found</h5>
                    <h3>@_result.TotalPaymentsFound</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Ledger Entries</h5>
                    <h3>@_result.TotalLedgerEntries</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Payment Amount</h5>
                    <h3>€@(_result.PaymentEntries.Sum(p => Math.Abs(p.Amount)).ToString("N2"))</h3>
                </div>
            </div>
        </div>
    </div>

    @if (_result.PaymentEntries.Count > 0)
    {
        <h5 class="mb-3">Received Payments</h5>
        <div class="card mb-4">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Entry #</th>
                            <th>Posting Date</th>
                            <th>Customer</th>
                            <th>Document #</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Remaining</th>
                            <th>Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _result.PaymentEntries)
                        {
                            <tr>
                                <td>@p.EntryNumber</td>
                                <td>@p.PostingDate</td>
                                <td>@p.CustomerName (@p.CustomerNumber)</td>
                                <td>@p.DocumentNumber</td>
                                <td>@p.Description</td>
                                <td class="text-end">€@Math.Abs(p.Amount).ToString("N2")</td>
                                <td class="text-end">€@Math.Abs(p.RemainingAmount).ToString("N2")</td>
                                <td>@(p.Open ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_result.CustomerLedgerEntries.Count > 0)
    {
        <h5 class="mb-3">All Customer Ledger Entries</h5>
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Entry #</th>
                            <th>Posting Date</th>
                            <th>Type</th>
                            <th>Customer</th>
                            <th>Document #</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Remaining</th>
                            <th>Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _result.CustomerLedgerEntries)
                        {
                            <tr class="@(e.DocumentType == "Payment" ? "table-success" : "")">
                                <td>@e.EntryNumber</td>
                                <td>@e.PostingDate</td>
                                <td><span class="badge @GetTypeBadge(e.DocumentType)">@e.DocumentType</span></td>
                                <td>@e.CustomerName (@e.CustomerNumber)</td>
                                <td>@e.DocumentNumber</td>
                                <td>@e.Description</td>
                                <td class="text-end">€@e.Amount.ToString("N2")</td>
                                <td class="text-end">€@e.RemainingAmount.ToString("N2")</td>
                                <td>@(e.Open ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_result.TotalPaymentsFound == 0 && _result.TotalLedgerEntries == 0)
    {
        <div class="alert alert-info">No payments found in BC.</div>
    }
}

@code {
    private BcPaymentsResponseDto? _result;
    private bool _loading;
    private string? _error;

    private async Task CheckPayments()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _result = await Api.GetBcPaymentsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to check payments: {ex.Message}";
        }

        _loading = false;
    }

    private string GetTypeBadge(string type) => type switch
    {
        "Payment" => "bg-success",
        "Invoice" => "bg-info",
        "Credit Memo" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
