@page "/admin/skins"
@using System.Text.Json
@inject HttpClient Http
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<h3>Sold Skins</h3>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <!-- Summary -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="summary-card">
                <div class="card-title">Total Sold Skins</div>
                <div class="card-value">@_totalSkins.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="summary-card">
                <div class="card-title">Total Value</div>
                <div class="card-value">€@_totalValue.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Search + Page Size -->
    <div class="row mb-3">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search by farmer, farm, barcode, or box..." 
                   @bind="_searchText" @bind:event="oninput" @onkeydown="HandleSearchKey" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary" @onclick="SearchSkins">Search</button>
            @if (!string.IsNullOrEmpty(_activeSearch))
            {
                <button class="btn btn-outline-secondary ms-1" @onclick="ClearSearch">Clear</button>
            }
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="_pageSize" @bind:after="() => GoToPage(1)">
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>
                <option value="200">200 per page</option>
                <option value="500">500 per page</option>
            </select>
        </div>
    </div>

    @if (!_skins.Any())
    {
        <div class="alert alert-info">No sold skins found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Lot</th>
                        <th>Box</th>
                        <th>Barcode</th>
                        <th>Farmer</th>
                        <th>Sales Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Broker</th>
                        <th>Buyer</th>
                        <th>Price (EUR)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skin in _skins)
                    {
                        <tr>
                            <td>@skin.LotNumber</td>
                            <td>@skin.BoxNumber</td>
                            <td>@skin.Barcode</td>
                            <td>@skin.Farmer</td>
                            <td>@skin.SalesType</td>
                            <td>@skin.Gender</td>
                            <td>@skin.Group</td>
                            <td>@skin.Size</td>
                            <td>@skin.Color</td>
                            <td>@skin.Quality</td>
                            <td>@skin.BrokerName</td>
                            <td>@skin.BuyerName</td>
                            <td>@skin.PriceEur?.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <nav>
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @(((_page - 1) * _pageSize) + 1)–@(Math.Min(_page * _pageSize, _totalSkins)) of @_totalSkins.ToString("N0")
                </small>
                <ul class="pagination mb-0">
                    <li class="page-item @(_page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(1)">First</a>
                    </li>
                    <li class="page-item @(_page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(_page - 1)">Prev</a>
                    </li>
                    @foreach (var pg in GetPageNumbers())
                    {
                        <li class="page-item @(pg == _page ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(pg)">@pg</a>
                        </li>
                    }
                    <li class="page-item @(_page >= _totalPages ? "disabled" : "")">
                        <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(_page + 1)">Next</a>
                    </li>
                    <li class="page-item @(_page >= _totalPages ? "disabled" : "")">
                        <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(_totalPages)">Last</a>
                    </li>
                </ul>
            </div>
        </nav>
    }
}

@code {
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 100;
    private int _totalPages;
    private int _totalSkins;
    private decimal _totalValue;
    private string _searchText = "";
    private string _activeSearch = "";
    private List<SkinItem> _skins = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSkins();
    }

    private async Task LoadSkins()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var url = $"api/skins?page={_page}&pageSize={_pageSize}";
            if (!string.IsNullOrEmpty(_activeSearch))
                url += $"&search={Uri.EscapeDataString(_activeSearch)}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                _totalSkins = doc.RootElement.GetProperty("totalSkins").GetInt32();
                _totalValue = doc.RootElement.TryGetProperty("totalValue", out var tvProp) ? tvProp.GetDecimal() : 0m;
                _page = doc.RootElement.GetProperty("page").GetInt32();
                _totalPages = doc.RootElement.GetProperty("totalPages").GetInt32();

                var skinsArray = doc.RootElement.GetProperty("skins");
                _skins = JsonSerializer.Deserialize<List<SkinItem>>(skinsArray.GetRawText(), new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new();
            }
        }
        catch { }
        _loading = false;
        StateHasChanged();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _page = page;
        await LoadSkins();
    }

    private async Task SearchSkins()
    {
        _activeSearch = _searchText;
        _page = 1;
        await LoadSkins();
    }

    private async Task ClearSearch()
    {
        _searchText = "";
        _activeSearch = "";
        _page = 1;
        await LoadSkins();
    }

    private async Task HandleSearchKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchSkins();
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var start = Math.Max(1, _page - 2);
        var end = Math.Min(_totalPages, _page + 2);
        if (end - start < 4)
        {
            start = Math.Max(1, end - 4);
            end = Math.Min(_totalPages, start + 4);
        }
        return Enumerable.Range(start, end - start + 1);
    }

    private class SkinItem
    {
        public Guid UniqueID { get; set; }
        public int BoxNumber { get; set; }
        public long Barcode { get; set; }
        public string? Farmer { get; set; }
        public string? Farm { get; set; }
        public string? SalesType { get; set; }
        public string? Gender { get; set; }
        public string? Group { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public string? Quality { get; set; }
        public string? Clarity { get; set; }
        public string? BrokerName { get; set; }
        public string? BuyerName { get; set; }
        public decimal? PriceEur { get; set; }
        public int? LotNumber { get; set; }
    }
}
