@page "/admin/catalog"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using AuctionSystem.Web.Models
@using AuctionSystem.Web.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject IConfiguration Config
@inject AuctionApiClient Api

<h3>Generate Catalogue</h3>

<div class="catalogue-page">

    <div class="card mb-4">
        <div class="card-header py-2">
            <strong>Catalog Drafts</strong>
            <span class="text-muted small">— frozen from the imported lots (pre-auction), by Sales Type / Gender / Group</span>
        </div>
        <div class="card-body">
            <div class="mb-2">
                <button class="btn btn-warning btn-sm text-white" @onclick="GenerateCatalogNow" disabled="@IsGeneratingCatalog">
                    @(IsGeneratingCatalog ? "Generating..." : "Generate Lots")
                </button>
                <span class="text-muted small ms-2">Rebuilds the catalogue (cataloglots) from the imported boxes.</span>
            </div>

            <hr class="my-3" />

            <div class="mb-2 fw-bold small text-muted">Create catalog draft</div>
            <div class="row g-2 align-items-end" style="max-width:780px">
                <div class="col">
                    <label class="form-label mb-0">Sales Type</label>
                    <select @bind="DraftSalesType" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var val in SalesTypes) { <option value="@val">@val</option> }
                    </select>
                </div>
                <div class="col">
                    <label class="form-label mb-0">Gender</label>
                    <select @bind="DraftGender" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var val in Genders) { <option value="@val">@val</option> }
                    </select>
                </div>
                <div class="col">
                    <label class="form-label mb-0">Group</label>
                    <select @bind="DraftGroup" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var val in Groups) { <option value="@val">@val</option> }
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-success btn-sm" @onclick="CreateDraft" disabled="@IsCreatingDraft">
                        @(IsCreatingDraft ? "Saving..." : "Save as Draft")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(DraftMessage))
            {
                <div class="alert @(DraftIsError ? "alert-danger" : "alert-success") mt-2 mb-0 py-1">@DraftMessage</div>
            }

            @if (Drafts.Any())
            {
                <table class="table table-sm table-hover mt-3" style="max-width:840px">
                    <thead class="table-dark">
                        <tr><th>Name</th><th class="text-end">Lots</th><th class="text-end">Show</th><th class="text-end">Skins</th><th>Status</th><th>Created</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Drafts)
                        {
                            <tr>
                                <td>@d.Name</td>
                                <td class="text-end">@d.LotCount.ToString("N0")</td>
                                <td class="text-end">@d.ShowLotCount.ToString("N0")</td>
                                <td class="text-end">@d.SkinCount.ToString("N0")</td>
                                <td>
                                    @{
                                        var badge = d.Status switch { "Active" => "bg-success", "InAuction" => "bg-secondary", _ => "bg-warning text-dark" };
                                        var label = d.Status == "InAuction" ? "In Auction" : d.Status;
                                    }
                                    <span class="badge @badge">@label</span>
                                </td>
                                <td>@d.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    @if (d.Status == "Draft")
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => ActivateDraft(d.Id)" disabled="@(activatingId != null)">
                                            @(activatingId == d.Id ? "Activating..." : "Activate")
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => ViewDraft(d)">View</button>
                                    <button class="btn btn-sm btn-outline-dark ms-1" @onclick="() => DownloadDraftPdf(d.Id)">PDF</button>
                                    @if (d.Status != "InAuction")
                                    {
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteDraft(d.Id)">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (CatalogLots.Any())
    {
        <div class="results-section mt-3">
            <h6 class="mb-2">
                @viewingDraftName
                @if (viewingDraftStatus == "InAuction") { <span class="badge bg-secondary ms-1">In Auction — locked</span> }
                else if (viewingDraftStatus == "Active") { <span class="badge bg-success ms-1">Active</span> }
                else { <span class="badge bg-warning text-dark ms-1">Draft</span> }
            </h6>
            @if (!string.IsNullOrEmpty(DraftMessage))
            {
                <div class="alert @(DraftIsError ? "alert-danger" : "alert-success") py-1">@DraftMessage</div>
            }
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th><th>String</th><th style="width:280px">Description</th><th class="text-end">Skins</th>
                        <th>Estimate</th><th>Red Limit</th><th>Remarks</th><th style="width:130px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in CatalogLots.OrderBy(l => l.CatalogSortOrder))
                    {
                        <tr class="@(lot.IsShow ? "table-warning" : "")">
                            <td>@lot.LotNumber</td>
                            <td>@lot.StringNumber</td>
                            @if (editingLotId == lot.Id)
                            {
                                <td><input class="form-control form-control-sm" @bind="editDescription" placeholder="@BuildDescription(lot)" /></td>
                                <td class="text-end">@lot.TotalSkins.ToString("N0")</td>
                                <td><input class="form-control form-control-sm" @bind="editEstimate" /></td>
                                <td><input class="form-control form-control-sm" @bind="editRedLimit" /></td>
                                <td><input class="form-control form-control-sm" @bind="editRemarks" /></td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveLot(lot)">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelEditLot">✕</button>
                                </td>
                            }
                            else
                            {
                                <td><div style="max-width:280px; white-space:normal; word-break:break-word;">@(string.IsNullOrWhiteSpace(lot.Description) ? BuildDescription(lot) : lot.Description)</div></td>
                                <td class="text-end">@lot.TotalSkins.ToString("N0")</td>
                                <td>@lot.Estimate</td>
                                <td>@lot.RedLimit</td>
                                <td>@lot.Remarks</td>
                                <td>
                                    @if (viewingDraftStatus != "InAuction")
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditLot(lot)">Edit</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool IsLoading;

    private List<CatalogLotRow> CatalogLots = new();

    private List<string> SalesTypes = new();
    private List<string> Genders = new();
    private List<string> Groups = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFilters();   // Sales Type / Gender / Group from cataloglots
        await LoadDrafts();
    }

    private bool IsCreatingDraft;
    private bool IsGeneratingCatalog;
    private string DraftSalesType = "";
    private string DraftGender = "";
    private string DraftGroup = "";
    private string DraftMessage = "";
    private bool DraftIsError;
    private List<CatalogDraftRow> Drafts = new();

    private async Task LoadDrafts()
    {
        try { Drafts = await Http.GetFromJsonAsync<List<CatalogDraftRow>>("api/catalog/drafts") ?? new(); }
        catch { Drafts = new(); }
    }

    private async Task GenerateCatalogNow()
    {
        IsGeneratingCatalog = true; DraftMessage = ""; DraftIsError = false;
        try
        {
            var resp = await Http.PostAsync("api/lots/generate-admin", null);
            var content = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode) { DraftMessage = string.IsNullOrWhiteSpace(content) ? "Lots generated." : content; await LoadFilters(); }
            else { DraftMessage = $"Generation failed: {(int)resp.StatusCode}"; DraftIsError = true; }
        }
        catch (Exception ex) { DraftMessage = $"Generation failed: {ex.Message}"; DraftIsError = true; }
        finally { IsGeneratingCatalog = false; }
    }

    private async Task CreateDraft()
    {
        IsCreatingDraft = true; DraftMessage = ""; DraftIsError = false;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/catalog/drafts",
                new { salesType = DraftSalesType, gender = DraftGender, group = DraftGroup });
            if (resp.IsSuccessStatusCode) { DraftMessage = "Catalog draft saved."; await LoadDrafts(); }
            else { DraftMessage = $"Failed to save draft: {(int)resp.StatusCode}"; DraftIsError = true; }
        }
        catch (Exception ex) { DraftMessage = $"Failed to save draft: {ex.Message}"; DraftIsError = true; }
        finally { IsCreatingDraft = false; }
    }

    private async Task DeleteDraft(int id)
    {
        try { await Http.DeleteAsync($"api/catalog/drafts/{id}"); await LoadDrafts(); } catch { }
    }

    private int? activatingId;

    private async Task ActivateDraft(int id)
    {
        if (activatingId != null) return;   // ignore re-clicks: a concurrent freeze races the table drops
        activatingId = id;
        DraftMessage = ""; DraftIsError = false;
        try
        {
            var resp = await Http.PostAsync($"api/catalog/drafts/{id}/activate", null);
            if (resp.IsSuccessStatusCode) { await LoadDrafts(); }
            else { DraftMessage = $"Activate failed: {await resp.Content.ReadAsStringAsync()}"; DraftIsError = true; }
        }
        catch (Exception ex) { DraftMessage = $"Activate failed: {ex.Message}"; DraftIsError = true; }
        finally { activatingId = null; }
    }

    private int viewingDraftId;
    private string viewingDraftName = "";
    private string viewingDraftStatus = "Draft";
    private int? editingLotId;
    private string editDescription = "", editEstimate = "", editRedLimit = "", editRemarks = "";

    private async Task ViewDraft(CatalogDraftRow d)
    {
        IsLoading = true; CatalogLots = new(); editingLotId = null; DraftMessage = ""; DraftIsError = false;
        viewingDraftId = d.Id; viewingDraftName = d.Name; viewingDraftStatus = d.Status;
        try { CatalogLots = await Http.GetFromJsonAsync<List<CatalogLotRow>>($"api/catalog/drafts/{d.Id}/lots") ?? new(); }
        catch { CatalogLots = new(); }
        finally { IsLoading = false; }
    }

    private void StartEditLot(CatalogLotRow lot)
    {
        editingLotId = lot.Id;
        editDescription = lot.Description; editEstimate = lot.Estimate;
        editRedLimit = lot.RedLimit; editRemarks = lot.Remarks;
    }

    private void CancelEditLot() => editingLotId = null;

    private async Task SaveLot(CatalogLotRow lot)
    {
        DraftMessage = ""; DraftIsError = false;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/catalog/drafts/{viewingDraftId}/lots/{lot.Id}",
                new { description = editDescription, estimate = editEstimate, redLimit = editRedLimit, remarks = editRemarks });
            if (resp.IsSuccessStatusCode)
            {
                lot.Description = editDescription; lot.Estimate = editEstimate;
                lot.RedLimit = editRedLimit; lot.Remarks = editRemarks;
                editingLotId = null;
            }
            else { DraftMessage = $"Save failed: {await resp.Content.ReadAsStringAsync()}"; DraftIsError = true; }
        }
        catch (Exception ex) { DraftMessage = $"Save failed: {ex.Message}"; DraftIsError = true; }
    }

    private async Task DownloadDraftPdf(int id)
    {
        try { await JS.InvokeVoidAsync("open", $"api/catalog/pdf?draftId={id}", "_blank"); } catch { }
    }

    private class CatalogDraftRow
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? SalesType { get; set; }
        public string? Gender { get; set; }
        public string? Group { get; set; }
        public int LotCount { get; set; }
        public int ShowLotCount { get; set; }
        public int SkinCount { get; set; }
        public string Status { get; set; } = "Draft";
        public DateTime CreatedAt { get; set; }
    }

    private async Task LoadFilters()
    {
        try
        {
            var filters = await Http.GetFromJsonAsync<FilterOptions>("api/catalog/filters");
            if (filters != null)
            {
                SalesTypes = filters.Types ?? new();
                Genders = filters.Genders ?? new();
                Groups = filters.Groups ?? new();
            }
        }
        catch { }
    }

    private Dictionary<string, List<CatalogLotRow>> GetSections()
    {
        return CatalogLots
            .GroupBy(l => $"{l.SalesType} - {l.Gender} - {l.Group}")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private string BuildDescription(CatalogLotRow lot)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(lot.HairLength)) parts.Add(lot.HairLength);
        if (!string.IsNullOrWhiteSpace(lot.Size)) parts.Add(lot.Size);
        if (!string.IsNullOrWhiteSpace(lot.Quality)) parts.Add(lot.Quality);
        if (!string.IsNullOrWhiteSpace(lot.Color)) parts.Add(lot.Color);
        if (!string.IsNullOrWhiteSpace(lot.Clarity)) parts.Add(lot.Clarity);
        if (!string.IsNullOrWhiteSpace(lot.Damages) && !lot.Damages.Equals("None", StringComparison.OrdinalIgnoreCase))
            parts.Add(lot.Damages);
        return string.Join(" / ", parts);
    }

    public class FilterOptions
    {
        public List<string>? Types { get; set; }
        public List<string>? Genders { get; set; }
        public List<string>? Groups { get; set; }
        public List<string>? HairLengths { get; set; }
        public List<string>? Sizes { get; set; }
        public List<string>? Qualities { get; set; }
        public List<string>? Colors { get; set; }
        public List<string>? Clarities { get; set; }
        public List<string>? Damages { get; set; }
    }

    public class CatalogLotRow
    {
        public int Id { get; set; }
        public string Description { get; set; } = "";
        public string Estimate { get; set; } = "";
        public string RedLimit { get; set; } = "";
        public string Remarks { get; set; } = "";
        public int LotNumber { get; set; }
        public int StringNumber { get; set; }
        public int CatalogSortOrder { get; set; }
        public string SalesType { get; set; } = "";
        public string Gender { get; set; } = "";
        public string Group { get; set; } = "";
        public string HairLength { get; set; } = "";
        public string Size { get; set; } = "";
        public string Quality { get; set; } = "";
        public string Color { get; set; } = "";
        public string Clarity { get; set; } = "";
        public string Damages { get; set; } = "";
        public int TotalSkins { get; set; }
        public int LotsInString { get; set; }
        public int LotSequenceInString { get; set; }
        public int StringTotalSkins { get; set; }
        public bool IsShow { get; set; }
    }
}
