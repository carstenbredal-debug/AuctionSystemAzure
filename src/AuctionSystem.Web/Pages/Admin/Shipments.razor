@page "/admin/shipments"
@using AuctionSystem.Web.Models
@using AuctionSystem.Web.Services
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject IJSRuntime JS

<h4 class="mb-4">Shipments</h4>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="row mb-3">
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="ShowCreateModal">+ Create Shipment</button>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="() => LoadShipments()">Refresh</button>
    </div>
    <div class="col-auto">
        <select class="form-select" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Packing">Production (boxes)</option>
            <option value="ShowLot Packing">Production (showlots)</option>
            <option value="Ready">Ready</option>
            <option value="Ready for courier">Ready for courier</option>
            <option value="Scanned">Scanned</option>
            <option value="Shipped">Shipped</option>
            <option value="Delivered">Delivered</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Shipment #</th>
                        <th>Shipper</th>
                        <th>Buyer</th>
                        <th>Tracking #</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th>Lots</th>
                        <th>Boxes</th>
                        <th>Pallets</th>
                        <th>Created</th>
                        <th>Shipped</th>
                        <th>Delivered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _shipments)
                    {
                        <tr>
                            <td><strong>@s.ShipmentNumber</strong></td>
                            <td>@s.ShipperName (@s.ShipperCode)</td>
                            <td>@s.BuyerNumber - @s.BuyerName</td>
                            <td>@s.TrackingNumber</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(s.Status)"
                                      style="@(s.Status == "Ready for courier" ? "background-color:#fd7e14;" : "")">@GetDisplayStatus(s.Status)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.OutLocation))
                                {
                                    <span class="badge bg-dark">@s.OutLocation</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleLots(s.Id)">
                                    @s.LotCount lot(s)
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleBoxes(s.Id)">
                                    @s.BoxCount box(es)
                                </button>
                            </td>
                            <td>@(s.Pallets is > 0 ? s.Pallets.ToString() : "—")</td>
                            <td>@s.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>@(s.ShippedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@(s.DeliveredAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenPackingListPdf(s)" disabled="@(_generatingPdf && _generatingPdfId == s.Id)">
                                    @if (_generatingPdf && _generatingPdfId == s.Id)
                                    {
                                        <span>Generating...</span>
                                    }
                                    else
                                    {
                                        <span>Packing List</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => OpenShippingInvoicePdf(s)" disabled="@(_generatingInvoice && _generatingInvoiceId == s.Id)">
                                    @if (_generatingInvoice && _generatingInvoiceId == s.Id)
                                    {
                                        <span>Generating...</span>
                                    }
                                    else
                                    {
                                        <span>Shipping Invoice</span>
                                    }
                                </button>
                                <label class="btn btn-sm btn-outline-dark me-1 mb-0" title="Upload a certificate document (replaces any existing one)">
                                    @(_uploadingCertId == s.Id ? "Uploading..." : "Upload Cert")
                                    <InputFile OnChange="e => UploadCert(s, e)" style="display:none" disabled="@(_uploadingCertId != 0)" />
                                </label>
                                @if (!string.IsNullOrEmpty(s.CertUrl))
                                {
                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => ViewCert(s)">View Cert</button>
                                }
                                @if (s.Status == "Pending" || s.Status == "ShowLot Packing" || s.Status == "Packing" || s.Status == "Packed" || s.Status == "Ready")
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEdit(s)">Edit</button>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenAwb(s)" title="Set the AWB / tracking number">AWB</button>
                                    @if (s.Status == "Ready")
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => MarkShipped(s)">Ship</button>
                                    }
                                    @if (s.Status != "Packed" && !s.PackingStarted)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteShipment(s.Id)">Delete</button>
                                    }
                                }
                                else if (s.Status == "Ready for courier")
                                {
                                    <span class="text-muted small">Loading — becomes Scanned when all boxes are on the truck</span>
                                }
                                else if (s.Status == "Scanned")
                                {
                                    <span class="text-muted small">Loaded — press Ship on the lane to release it</span>
                                }
                            </td>
                        </tr>
                        @if (_expandedBoxesShipmentId == s.Id)
                        {
                            <tr>
                                <td colspan="13" class="bg-light">
                                    <div class="ps-4">
                                        <strong>Boxes in this shipment:</strong>
                                        @if (_loadingShipmentBoxes)
                                        {
                                            <em class="ms-2">Loading...</em>
                                        }
                                        else if (_shipmentBoxLines.Count == 0)
                                        {
                                            <span class="ms-2 text-muted">No boxes found.</span>
                                        }
                                        else
                                        {
                                            <table class="table table-sm mt-2 mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Box #</th>
                                                        <th>Lot #</th>
                                                        <th>Type</th>
                                                        <th class="text-end">Skins</th>
                                                        <th class="text-end">Gross (kg)</th>
                                                        <th class="text-end">Net (kg)</th>
                                                        <th>Location</th>
                                                        <th>Skins PDF</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var line in _shipmentBoxLines)
                                                    {
                                                        <tr>
                                                            <td><strong>@line.BoxNumber</strong></td>
                                                            <td>@line.LotNumber</td>
                                                            <td>@line.BoxType</td>
                                                            <td class="text-end">@line.Skins</td>
                                                            <td class="text-end">@line.GrossWeightKg.ToString("N2")</td>
                                                            <td class="text-end">@line.NetWeightKg.ToString("N2")</td>
                                                            <td>@line.Location</td>
                                                            <td>
                                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBoxSkinsPdf(s, line.BoxNumber)"
                                                                        title="Skins in this box with country of origin">
                                                                    Skins PDF
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (_expandedShipmentId == s.Id)
                        {
                            <tr>
                                <td colspan="13" class="bg-light">
                                    <div class="ps-4">
                                        <strong>Lots in this shipment:</strong>
                                        @if (!string.IsNullOrEmpty(s.ShippingAddressSummary))
                                        {
                                            <span class="ms-3 text-muted">Ship to: @s.ShippingAddressSummary</span>
                                        }
                                        @if (!string.IsNullOrEmpty(s.Notes))
                                        {
                                            <span class="ms-3 text-muted">Notes: @s.Notes</span>
                                        }
                                        <table class="table table-sm mt-2 mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Lot #</th>
                                                    <th>Invoice #</th>
                                                    <th>PDF</th>
                                                    <th>Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var lot in s.Lots)
                                                {
                                                    <tr>
                                                        <td><strong>@lot.LotNumber</strong></td>
                                                        <td>@lot.InvoiceNumber</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(lot.PdfUrl))
                                                            {
                                                                <a href="@lot.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">View PDF</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">—</span>
                                                            }
                                                        </td>
                                                        <td>@lot.Notes</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (!_shipments.Any())
                    {
                        <tr><td colspan="13" class="text-center text-muted">No shipments found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Ship confirmation — the documents are emailed automatically on accept *@
@if (_showShippedModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ship @_selectedShipment?.ShipmentNumber?</h5>
                    <button type="button" class="btn-close" @onclick="() => _showShippedModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>Mark shipment <strong>@_selectedShipment?.ShipmentNumber</strong> (@_selectedShipment?.BuyerName) as <strong>Ready for courier</strong>?</p>
                    <p class="text-muted">The packing list (@(_selectedShipment?.ShipmentNumber)-PL) and shipping invoice (@(_selectedShipment?.ShipmentNumber)-SI) will be emailed to the address set in Parameters (ShippingDocsEmail).</p>
                    <p class="mb-0 text-muted">When the scanner confirms every box is on the truck the shipment becomes Scanned; pressing Ship on the lane then releases it and frees the lane.</p>
                    @if (string.IsNullOrWhiteSpace(_selectedShipment?.TrackingNumber))
                    {
                        <div class="alert alert-warning mt-2 mb-0 py-1">No AWB number set — use the AWB button first if one is needed.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showShippedModal = false">Cancel</button>
                    <button class="btn btn-success" @onclick="ConfirmShipped" disabled="@_saving">
                        @(_saving ? "Shipping..." : "Ship & Email Documents")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* AWB modal — set the tracking number *@
@if (_showAwbModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">AWB — @_selectedShipment?.ShipmentNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => _showAwbModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-bold">AWB / Tracking Number</label>
                    <input class="form-control" @bind="_trackingNumber" placeholder="Enter AWB number" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showAwbModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAwb" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Edit modal — shipper / address / notes *@
@if (_showEditModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit — @_selectedShipment?.ShipmentNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => _showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Shipper</label>
                        <select class="form-select" @bind="_editShipperId">
                            <option value="0">— Keep current —</option>
                            @foreach (var sh in _shippers)
                            {
                                <option value="@sh.Id">@sh.Code - @sh.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Shipping Address</label>
                        <select class="form-select" @bind="_editAddressId">
                            <option value="0">— Keep current —</option>
                            @foreach (var a in _allAddresses)
                            {
                                <option value="@a.Id">@a.Name — @a.AddressLine1, @a.City @a.Country</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Notes</label>
                        <input class="form-control" @bind="_editNotes" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showEditModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Create Shipment Modal *@
@if (_showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Shipment</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (_loadingCreate)
                    {
                        <p><em>Loading invoices ready for shipment...</em></p>
                    }
                    else if (_confirmInvoices.Count == 0)
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Shipper</label>
                                <select class="form-select" @bind="_createShipperId">
                                    <option value="0">— Select Shipper —</option>
                                    @foreach (var sh in _shippers)
                                    {
                                        <option value="@sh.Id">@sh.Code - @sh.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Shipping Address</label>
                                <select class="form-select" @bind="_createAddressId">
                                    <option value="0">— None —</option>
                                    @foreach (var a in _allAddresses)
                                    {
                                        <option value="@a.Id">@a.Name — @a.AddressLine1, @a.City @a.Country @(a.IsDefault ? "(Default)" : "")</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Tracking Number</label>
                                <input class="form-control" @bind="_createTrackingNumber" placeholder="Optional — can add later" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Notes</label>
                                <input class="form-control" @bind="_createNotes" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Invoices Ready for Shipment</label>
                            @if (!GetInvoiceGroups().Any())
                            {
                                <div class="text-muted">No invoices released for shipping.</div>
                            }
                            else
                            {
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Invoice #</th>
                                            <th>Buyer</th>
                                            <th class="text-end">Lots</th>
                                            <th class="text-end">Skins</th>
                                            <th class="text-end">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* One shipment = one buyer: once an invoice is ticked, other buyers' invoices are hidden. *@
                                        @foreach (var inv in GetInvoiceGroups().Where(g => SelectedBuyerId == 0 || g.BuyerId == SelectedBuyerId))
                                        {
                                            <tr class="@(_selectedInvoiceNumbers.Contains(inv.InvoiceNumber) ? "table-primary" : "")">
                                                <td>
                                                    <input type="checkbox" checked="@_selectedInvoiceNumbers.Contains(inv.InvoiceNumber)"
                                                           @onchange="() => ToggleInvoiceSelection(inv)" />
                                                </td>
                                                <td><strong>@inv.InvoiceNumber</strong></td>
                                                <td>@inv.BuyerNumber - @inv.BuyerName</td>
                                                <td class="text-end">@inv.Lots.Count</td>
                                                <td class="text-end">@inv.Lots.Sum(l => l.Skins).ToString("N0")</td>
                                                <td class="text-end">€@inv.Lots.Sum(l => l.HammerPrice).ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="text-muted small">
                                    @if (_selectedInvoiceNumbers.Count > 0)
                                    {
                                        <strong>Selected: @_selectedInvoiceNumbers.Count invoice(s) — @SelectedBoxCount box(es), @SelectedSkinCount.ToString("N0") skins.</strong>
                                    }
                                    else
                                    {
                                        <span>No invoices selected — one shipment, one buyer.</span>
                                    }
                                    @(SelectedBuyerId != 0 ? " Other buyers' invoices are hidden — deselect all to see them again." : "")
                                    @(_createShipperId == 0 ? " Select a shipper first." : "")
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Confirm step: the boxes that ship on the chosen invoices *@
                        <p class="mb-2">
                            Invoice(s) <strong>@string.Join(", ", _confirmInvoices.Select(i => i.InvoiceNumber))</strong>
                            (@_confirmInvoices.First().BuyerName)
                            via <strong>@(_shippers.FirstOrDefault(s => s.Id == _createShipperId)?.Name)</strong>
                            — confirm the boxes below ship on @(_confirmInvoices.Count == 1 ? "this invoice" : "these invoices").
                        </p>
                        @if (_loadingBoxes)
                        {
                            <p><em>Loading boxes...</em></p>
                        }
                        else if (_confirmBoxes.Count == 0)
                        {
                            <div class="alert alert-warning">No boxes found for the selected invoice(s).</div>
                        }
                        else
                        {
                            <table class="table table-sm table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Box #</th>
                                        <th>Lot #</th>
                                        <th>Type</th>
                                        <th class="text-end">Skins</th>
                                        <th class="text-end">Gross (kg)</th>
                                        <th class="text-end">Net (kg)</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var box in _confirmBoxes.OrderBy(b => b.InvoiceNumber).ThenBy(b => b.LotNumber).ThenBy(b => b.BoxNumber))
                                    {
                                        <tr>
                                            <td>@box.InvoiceNumber</td>
                                            <td>@box.BoxNumber</td>
                                            <td>@box.LotNumber @(box.IsShow ? "★" : "")</td>
                                            <td>@box.BoxType</td>
                                            <td class="text-end">@box.Skins</td>
                                            <td class="text-end">@(box.GrossWeight?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(box.NetWeight?.ToString("N2") ?? "—")</td>
                                            <td>@(box.BoxLocation ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td colspan="4">Total: @_confirmBoxes.Count box(es)</td>
                                        <td class="text-end">@_confirmBoxes.Sum(b => b.Skins).ToString("N0")</td>
                                        <td class="text-end">@_confirmBoxes.Sum(b => b.GrossWeight ?? 0).ToString("N2")</td>
                                        <td class="text-end">@_confirmBoxes.Sum(b => b.NetWeight ?? 0).ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div class="text-muted small">★ = showlot box — location is the catalogue rack number.</div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (_confirmInvoices.Count == 0)
                    {
                        <button class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="ContinueToConfirm"
                                disabled="@(_loadingCreate || _createShipperId == 0 || _selectedInvoiceNumbers.Count == 0)">
                            Continue (@_selectedInvoiceNumbers.Count invoice(s), @SelectedBoxCount box(es), @SelectedSkinCount.ToString("N0") skins)
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary" @onclick="BackToInvoices" disabled="@_saving">Back</button>
                        <button class="btn btn-success" @onclick="CreateShipment" disabled="@(_saving || _loadingBoxes || _confirmBoxes.Count == 0)">
                            @(_saving ? "Creating..." : "Confirm — Create Shipment")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ShipmentListDto> _shipments = new();
    private List<ShipperListDto> _shippers = new();
    private List<ReleasedLotDto> _releasedLots = new();
    private bool _loading = true;
    private string? _error;
    private string? _success;
    private int? _expandedShipmentId;

    // Ship modal
    private bool _showShippedModal;
    private ShipmentListDto? _selectedShipment;
    private string _trackingNumber = "";
    private bool _saving;

    // Create modal — invoice-driven: choose shipper + address, tick one or more invoices (same
    // buyer), confirm their boxes.
    private bool _showCreateModal;
    private bool _loadingCreate;
    private int _createShipperId;
    private int _createAddressId;
    private string _createTrackingNumber = "";
    private string _createNotes = "";
    private List<ShippingAddressListDto> _allAddresses = new();
    private HashSet<string> _selectedInvoiceNumbers = new();
    private List<InvoiceGroup> _confirmInvoices = new();
    private List<ShippingBoxDto> _confirmBoxes = new();
    private bool _loadingBoxes;

    private int SelectedBuyerId =>
        GetInvoiceGroups().FirstOrDefault(g => _selectedInvoiceNumbers.Contains(g.InvoiceNumber))?.BuyerId ?? 0;

    private List<ShippingBoxDto> _modalBoxes = new();
    private int SelectedBoxCount => _modalBoxes.Count(b => _selectedInvoiceNumbers.Contains(b.InvoiceNumber));
    private int SelectedSkinCount => _modalBoxes.Where(b => _selectedInvoiceNumbers.Contains(b.InvoiceNumber)).Sum(b => b.Skins);

    private class InvoiceGroup
    {
        public string InvoiceNumber { get; init; } = "";
        public int BuyerId { get; init; }
        public string BuyerNumber { get; init; } = "";
        public string BuyerName { get; init; } = "";
        public List<ReleasedLotDto> Lots { get; init; } = new();
    }

    // PDF generation
    private bool _generatingPdf;
    private int _generatingPdfId;
    private bool _generatingInvoice;
    private int _generatingInvoiceId;

    protected override async Task OnInitializedAsync()
    {
        await LoadShipments();
    }

    private async Task LoadShipments(string? statusFilter = null)
    {
        _loading = true;
        _error = null;
        try
        {
            _shipments = await Api.GetShipmentsAsync(statusFilter);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async void OnStatusFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        await LoadShipments(string.IsNullOrEmpty(val) ? null : val);
        StateHasChanged();
    }

    private void ToggleLots(int shipmentId)
    {
        _expandedShipmentId = _expandedShipmentId == shipmentId ? null : shipmentId;
        if (_expandedShipmentId != null) _expandedBoxesShipmentId = null;
    }

    private void MarkShipped(ShipmentListDto s)
    {
        _selectedShipment = s;
        _showShippedModal = true;
    }

    private async Task ConfirmShipped()
    {
        if (_selectedShipment == null) return;
        _saving = true;
        _error = null;
        _success = null;
        var (ok, err, emailedTo, emailWarning) = await Api.UpdateShipmentStatusWithEmailAsync(_selectedShipment.Id, new { status = "Ready for courier" });
        if (!ok) { _error = err; _saving = false; return; }
        _success = $"Shipment {_selectedShipment.ShipmentNumber} is Ready for courier — it ships automatically when the scanner confirms all boxes are loaded." +
                   (emailedTo != null ? $" Documents emailed to {emailedTo}." : "");
        if (emailWarning != null) _error = emailWarning;
        _showShippedModal = false;
        _saving = false;
        await LoadShipments();
    }

