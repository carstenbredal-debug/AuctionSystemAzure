    private async Task ShowCreateModal()
    {
        _showCreateModal = true;
        _loadingCreate = true;
        _createShipperId = 0;
        _createAddressId = 0;
        _createTrackingNumber = "";
        _createNotes = "";
        _selectedInvoiceNumbers.Clear();
        _confirmInvoices.Clear();
        _confirmBoxes.Clear();
        _allAddresses.Clear();
        _error = null;

        try
        {
            _shippers = await Api.GetShippersAsync();
            _releasedLots = await Api.GetReleasedLotsForShipmentAsync();
            // Per-box detail for the whole released pool: powers the selected-totals line and the
            // box-confirm step without a second fetch.
            _modalBoxes = await Api.GetShippingBoxesAsync();
            _allAddresses = await Api.GetShippingAddressesAsync();
            var defaultAddr = _allAddresses.FirstOrDefault(a => a.IsDefault);
            _createAddressId = defaultAddr?.Id ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loadingCreate = false;
    }

    private List<InvoiceGroup> GetInvoiceGroups()
    {
        return _releasedLots
            .GroupBy(l => l.InvoiceNumber)
            .Select(g => new InvoiceGroup
            {
                InvoiceNumber = g.Key,
                BuyerId = g.First().BuyerId,
                BuyerNumber = g.First().BuyerNumber,
                BuyerName = g.First().BuyerName,
                Lots = g.ToList()
            })
            .OrderBy(g => g.InvoiceNumber)
            .ToList();
    }

    private void ToggleInvoiceSelection(InvoiceGroup inv)
    {
        if (!_selectedInvoiceNumbers.Remove(inv.InvoiceNumber))
            _selectedInvoiceNumbers.Add(inv.InvoiceNumber);
    }

    private async Task ContinueToConfirm()
    {
        _confirmInvoices = GetInvoiceGroups()
            .Where(g => _selectedInvoiceNumbers.Contains(g.InvoiceNumber))
            .ToList();
        if (_confirmInvoices.Count == 0) return;

        _confirmBoxes.Clear();
        _loadingBoxes = true;
        _error = null;
        StateHasChanged();

        try
        {
            // The released-boxes list (loaded at modal open) carries per-box detail — type, weights,
            // location, showlot rack; scope it to the chosen invoices for confirmation.
            _confirmBoxes = _modalBoxes.Where(b => _selectedInvoiceNumbers.Contains(b.InvoiceNumber)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _confirmInvoices.Clear();
        }
        _loadingBoxes = false;
    }

    private void BackToInvoices()
    {
        _confirmInvoices.Clear();
        _confirmBoxes.Clear();
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _selectedInvoiceNumbers.Clear();
        _confirmInvoices.Clear();
        _confirmBoxes.Clear();
        _error = null;
    }

    private async Task CreateShipment()
    {
        if (_confirmInvoices.Count == 0) return;
        _saving = true;
        _error = null;
        _success = null;

        var payload = new
        {
            shipperId = _createShipperId,
            buyerId = _confirmInvoices.First().BuyerId,
            shippingAddressId = _createAddressId > 0 ? (int?)_createAddressId : null,
            trackingNumber = _createTrackingNumber,
            notes = _createNotes,
            lotNumbers = _confirmInvoices.SelectMany(i => i.Lots.Select(l => l.LotNumber)).Distinct().ToList(),
            boxNumbers = _confirmBoxes.Select(b => b.BoxNumber).Distinct().ToList()
        };

        try
        {
            var (ok, err, num, outLocation) = await Api.CreateShipmentAsync(payload);
            if (!ok) { _error = err; _saving = false; return; }
            _success = $"Shipment {num} created for invoice(s) {string.Join(", ", _confirmInvoices.Select(i => i.InvoiceNumber))}: " +
                       $"{_confirmBoxes.Count} box(es), {_confirmBoxes.Sum(b => b.Skins):N0} skins." +
                       (outLocation != null
                           ? $" Lane: {outLocation} — put all boxes there."
                           : " NO lane free — all 20 are occupied!");
            _showCreateModal = false;
            _selectedInvoiceNumbers.Clear();
            _confirmInvoices.Clear();
            await LoadShipments();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }

    private int? _expandedBoxesShipmentId;
    private bool _loadingShipmentBoxes;
    private List<PackingLineDto> _shipmentBoxLines = new();

    private async Task ToggleBoxes(int shipmentId)
    {
        if (_expandedBoxesShipmentId == shipmentId)
        {
            _expandedBoxesShipmentId = null;
            return;
        }
        _expandedBoxesShipmentId = shipmentId;
        _expandedShipmentId = null;
        _loadingShipmentBoxes = true;
        _shipmentBoxLines = new();
        StateHasChanged();

        try
        {
            var packingList = await Api.GetShipmentPackingListAsync(shipmentId);
            _shipmentBoxLines = packingList?.PackingLines ?? new();
        }
        catch { _shipmentBoxLines = new(); }
        _loadingShipmentBoxes = false;
    }

    private async Task OpenBoxSkinsPdf(ShipmentListDto shipment, int boxNumber)
    {
        // GET endpoint streams the PDF inline — the browser tab does the rest.
        await JS.InvokeVoidAsync("open", $"api/shipments/{shipment.Id}/box-skins-pdf?box={boxNumber}", "_blank");
    }

    // Always regenerates — the document must reflect the current packed state, never a cached PDF.
    private async Task OpenPackingListPdf(ShipmentListDto shipment)
    {
        _generatingPdf = true;
        _generatingPdfId = shipment.Id;
        _error = null;
        StateHasChanged();

        try
        {
            var url = await Api.GeneratePackingListPdfAsync(shipment.Id);
            if (url != null)
            {
                await LoadShipments();
                var updated = _shipments.FirstOrDefault(s => s.Id == shipment.Id);
                var blobUrl = updated?.PackingListPdfUrl;
                if (!string.IsNullOrEmpty(blobUrl))
                    await JS.InvokeVoidAsync("open", blobUrl, "_blank");
                else
                    await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                _error = "Failed to generate packing list PDF.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _generatingPdf = false;
        _generatingPdfId = 0;
    }

    // Always regenerates — same rule as the packing list.
    private async Task OpenShippingInvoicePdf(ShipmentListDto shipment)
    {
        _generatingInvoice = true;
        _generatingInvoiceId = shipment.Id;
        _error = null;
        StateHasChanged();

        try
        {
            var url = await Api.GenerateShippingInvoicePdfAsync(shipment.Id);
