    // Edit modal
    private bool _showEditModal;
    private int _editShipperId;
    private int _editAddressId;
    private string _editNotes = "";

    private async Task OpenEdit(ShipmentListDto s)
    {
        _selectedShipment = s;
        _editShipperId = 0;
        _editAddressId = 0;
        _editNotes = s.Notes ?? "";
        if (_shippers.Count == 0)
            try { _shippers = await Api.GetShippersAsync(); } catch { }
        if (_allAddresses.Count == 0)
            try { _allAddresses = await Api.GetShippingAddressesAsync(); } catch { }
        _showEditModal = true;
    }

    private async Task SaveEdit()
    {
        if (_selectedShipment == null) return;
        _saving = true;
        _error = null;
        var (ok, err) = await Api.UpdateShipmentAsync(_selectedShipment.Id, new
        {
            shipperId = _editShipperId > 0 ? (int?)_editShipperId : null,
            shippingAddressId = _editAddressId > 0 ? (int?)_editAddressId : null,
            notes = _editNotes
        });
        if (!ok) { _error = err; _saving = false; return; }
        _success = $"Shipment {_selectedShipment.ShipmentNumber} updated.";
        _showEditModal = false;
        _saving = false;
        await LoadShipments();
