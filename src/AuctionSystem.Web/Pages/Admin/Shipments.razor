                if (!string.IsNullOrEmpty(blobUrl))
                    await JS.InvokeVoidAsync("open", blobUrl, "_blank");
                else
                    await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                _error = "Failed to generate shipping invoice PDF.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _generatingInvoice = false;
        _generatingInvoiceId = 0;
    }

    // Certificate upload/view
    private int _uploadingCertId;

    private async Task UploadCert(ShipmentListDto shipment, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > 20 * 1024 * 1024) { _error = "Certificate file too large (max 20 MB)."; return; }

        _uploadingCertId = shipment.Id;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var (ok, err, _) = await Api.UploadShipmentCertAsync(shipment.Id, file.Name, file.ContentType, Convert.ToBase64String(ms.ToArray()));
            if (!ok) { _error = err; }
            else
            {
                _success = $"Certificate '{file.Name}' uploaded for {shipment.ShipmentNumber}.";
                await LoadShipments();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _uploadingCertId = 0;
    }

    private async Task ViewCert(ShipmentListDto shipment)
    {
        if (!string.IsNullOrEmpty(shipment.CertUrl))
            await JS.InvokeVoidAsync("open", shipment.CertUrl, "_blank");
    }

    // Both packing statuses are shown as "Production" — the split is an internal detail.
    private static string GetDisplayStatus(string status) =>
        status is "Packing" or "ShowLot Packing" ? "Production" : status;

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Packing" => "bg-light text-dark border",
        "ShowLot Packing" => "bg-light text-dark border",
        "Ready" => "bg-success",
        "Ready for courier" => "text-white",   // orange background via inline style
        "Scanned" => "bg-primary",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };
