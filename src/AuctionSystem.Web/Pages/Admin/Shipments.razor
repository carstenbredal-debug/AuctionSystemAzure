@page "/admin/shipments"
@using AuctionSystem.Web.Models
@using AuctionSystem.Web.Services
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject IJSRuntime JS

<h4 class="mb-4">Shipments</h4>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<div class="row mb-3">
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="ShowCreateModal">+ Create Shipment</button>
    </div>
    <div class="col-auto">
        <select class="form-select" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="ShowLot Packing">ShowLot Packing</option>
            <option value="Shipped">Shipped</option>
            <option value="Delivered">Delivered</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Shipment #</th>
                        <th>Shipper</th>
                        <th>Buyer</th>
                        <th>Tracking #</th>
                        <th>Status</th>
                        <th>Lots</th>
                        <th>Created</th>
                        <th>Shipped</th>
                        <th>Delivered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _shipments)
                    {
                        <tr>
                            <td><strong>@s.ShipmentNumber</strong></td>
                            <td>@s.ShipperName (@s.ShipperCode)</td>
                            <td>@s.BuyerNumber - @s.BuyerName</td>
                            <td>@s.TrackingNumber</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(s.Status)">@s.Status</span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleLots(s.Id)">
                                    @s.LotCount lot(s)
                                </button>
                            </td>
                            <td>@s.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>@(s.ShippedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@(s.DeliveredAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenPackingListPdf(s)" disabled="@(_generatingPdf && _generatingPdfId == s.Id)">
                                    @if (_generatingPdf && _generatingPdfId == s.Id)
                                    {
                                        <span>Generating...</span>
                                    }
                                    else
                                    {
                                        <span>Packing List</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => OpenShippingInvoicePdf(s)" disabled="@(_generatingInvoice && _generatingInvoiceId == s.Id)">
                                    @if (_generatingInvoice && _generatingInvoiceId == s.Id)
                                    {
                                        <span>Generating...</span>
                                    }
                                    else
                                    {
                                        <span>Shipping Invoice</span>
                                    }
                                </button>
                                @if (!string.IsNullOrEmpty(s.PackingListPdfUrl) || !string.IsNullOrEmpty(s.ShippingInvoicePdfUrl))
                                {
                                    <div class="btn-group me-1">
                                        @if (!string.IsNullOrEmpty(s.PackingListPdfUrl))
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => RegeneratePackingListPdf(s)" disabled="@_generatingPdf" title="Regenerate Packing List">
                                                @(_generatingPdfId == s.Id ? "..." : "↻ PL")
                                            </button>
                                        }
                                        @if (!string.IsNullOrEmpty(s.ShippingInvoicePdfUrl))
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => RegenerateShippingInvoicePdf(s)" disabled="@_generatingInvoice" title="Regenerate Shipping Invoice">
                                                @(_generatingInvoiceId == s.Id ? "..." : "↻ SI")
                                            </button>
                                        }
                                    </div>
                                }
                                @if (s.Status == "Pending" || s.Status == "ShowLot Packing" || s.Status == "Packing" || s.Status == "Packed")
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => MarkShipped(s)">Ship</button>
                                    @if (s.Status != "Packed")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteShipment(s.Id)">Delete</button>
                                    }
                                }
                                else if (s.Status == "Shipped")
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => MarkDelivered(s)">Delivered</button>
                                }
                            </td>
                        </tr>
                        @if (_expandedShipmentId == s.Id)
                        {
                            <tr>
                                <td colspan="10" class="bg-light">
                                    <div class="ps-4">
                                        <strong>Lots in this shipment:</strong>
                                        @if (!string.IsNullOrEmpty(s.ShippingAddressSummary))
                                        {
                                            <span class="ms-3 text-muted">Ship to: @s.ShippingAddressSummary</span>
                                        }
                                        @if (!string.IsNullOrEmpty(s.Notes))
                                        {
                                            <span class="ms-3 text-muted">Notes: @s.Notes</span>
                                        }
                                        <table class="table table-sm mt-2 mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Lot #</th>
                                                    <th>Invoice #</th>
                                                    <th>PDF</th>
                                                    <th>Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var lot in s.Lots)
                                                {
                                                    <tr>
                                                        <td><strong>@lot.LotNumber</strong></td>
                                                        <td>@lot.InvoiceNumber</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(lot.PdfUrl))
                                                            {
                                                                <a href="@lot.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">View PDF</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">—</span>
                                                            }
                                                        </td>
                                                        <td>@lot.Notes</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (!_shipments.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted">No shipments found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Mark Shipped Modal *@
@if (_showShippedModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mark as Shipped — @_selectedShipment?.ShipmentNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => _showShippedModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tracking Number</label>
                        <input class="form-control" @bind="_trackingNumber" placeholder="Enter tracking number" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showShippedModal = false">Cancel</button>
                    <button class="btn btn-success" @onclick="ConfirmShipped" disabled="@_saving">
                        @(_saving ? "Updating..." : "Mark Shipped")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Create Shipment Modal *@
@if (_showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Shipment</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (_loadingCreate)
                    {
                        <p><em>Loading invoices ready for shipment...</em></p>
                    }
                    else if (_confirmInvoice == null)
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Shipper</label>
                                <select class="form-select" @bind="_createShipperId">
                                    <option value="0">— Select Shipper —</option>
                                    @foreach (var sh in _shippers)
                                    {
                                        <option value="@sh.Id">@sh.Code - @sh.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Shipping Address</label>
                                <select class="form-select" @bind="_createAddressId">
                                    <option value="0">— None —</option>
                                    @foreach (var a in _allAddresses)
                                    {
                                        <option value="@a.Id">@a.Name — @a.AddressLine1, @a.City @a.Country @(a.IsDefault ? "(Default)" : "")</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Tracking Number</label>
                                <input class="form-control" @bind="_createTrackingNumber" placeholder="Optional — can add later" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Notes</label>
                                <input class="form-control" @bind="_createNotes" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Invoices Ready for Shipment</label>
                            @if (!GetInvoiceGroups().Any())
                            {
                                <div class="text-muted">No invoices released for shipping.</div>
                            }
                            else
                            {
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Buyer</th>
                                            <th class="text-end">Lots</th>
                                            <th class="text-end">Skins</th>
                                            <th class="text-end">Value</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var inv in GetInvoiceGroups())
                                        {
                                            <tr>
                                                <td><strong>@inv.InvoiceNumber</strong></td>
                                                <td>@inv.BuyerNumber - @inv.BuyerName</td>
                                                <td class="text-end">@inv.Lots.Count</td>
                                                <td class="text-end">@inv.Lots.Sum(l => l.Skins).ToString("N0")</td>
                                                <td class="text-end">€@inv.Lots.Sum(l => l.HammerPrice).ToString("N2")</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SelectInvoice(inv)" disabled="@(_createShipperId == 0)">Select</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (_createShipperId == 0)
                                {
                                    <div class="text-muted small">Select a shipper first.</div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        @* Confirm step: the boxes that ship on the chosen invoice *@
                        <p class="mb-2">
                            Invoice <strong>@_confirmInvoice.InvoiceNumber</strong> (@_confirmInvoice.BuyerName)
                            via <strong>@(_shippers.FirstOrDefault(s => s.Id == _createShipperId)?.Name)</strong>
                            — confirm the boxes below ship on this invoice.
                        </p>
                        @if (_loadingBoxes)
                        {
                            <p><em>Loading boxes...</em></p>
                        }
                        else if (_confirmBoxes.Count == 0)
                        {
                            <div class="alert alert-warning">No boxes found for this invoice.</div>
                        }
                        else
                        {
                            <table class="table table-sm table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Box #</th>
                                        <th>Lot #</th>
                                        <th>Type</th>
                                        <th class="text-end">Skins</th>
                                        <th class="text-end">Gross (kg)</th>
                                        <th class="text-end">Net (kg)</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var box in _confirmBoxes.OrderBy(b => b.LotNumber).ThenBy(b => b.BoxNumber))
                                    {
                                        <tr>
                                            <td>@box.BoxNumber</td>
                                            <td>@box.LotNumber</td>
                                            <td>@box.BoxType</td>
                                            <td class="text-end">@box.Skins</td>
                                            <td class="text-end">@(box.GrossWeight?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(box.NetWeight?.ToString("N2") ?? "—")</td>
                                            <td>@(box.BoxLocation ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="fw-bold">
                                    <tr>
                                        <td colspan="3">Total: @_confirmBoxes.Count box(es)</td>
                                        <td class="text-end">@_confirmBoxes.Sum(b => b.Skins).ToString("N0")</td>
                                        <td class="text-end">@_confirmBoxes.Sum(b => b.GrossWeight ?? 0).ToString("N2")</td>
                                        <td class="text-end">@_confirmBoxes.Sum(b => b.NetWeight ?? 0).ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (_confirmInvoice == null)
                    {
                        <button class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-secondary" @onclick="BackToInvoices" disabled="@_saving">Back</button>
                        <button class="btn btn-success" @onclick="CreateShipment" disabled="@(_saving || _loadingBoxes || _confirmBoxes.Count == 0)">
                            @(_saving ? "Creating..." : "Confirm — Create Shipment")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ShipmentListDto> _shipments = new();
    private List<ShipperListDto> _shippers = new();
    private List<ReleasedLotDto> _releasedLots = new();
    private bool _loading = true;
    private string? _error;
    private string? _success;
    private int? _expandedShipmentId;

    // Ship modal
    private bool _showShippedModal;
    private ShipmentListDto? _selectedShipment;
    private string _trackingNumber = "";
    private bool _saving;

    // Create modal — invoice-driven: choose shipper + address, pick an invoice, confirm its boxes.
    private bool _showCreateModal;
    private bool _loadingCreate;
    private int _createShipperId;
    private int _createAddressId;
    private string _createTrackingNumber = "";
    private string _createNotes = "";
    private List<ShippingAddressListDto> _allAddresses = new();
    private InvoiceGroup? _confirmInvoice;
    private List<ShippingBoxDto> _confirmBoxes = new();
    private bool _loadingBoxes;

    private class InvoiceGroup
    {
        public string InvoiceNumber { get; init; } = "";
        public int BuyerId { get; init; }
        public string BuyerNumber { get; init; } = "";
        public string BuyerName { get; init; } = "";
        public List<ReleasedLotDto> Lots { get; init; } = new();
    }

    // PDF generation
    private bool _generatingPdf;
    private int _generatingPdfId;
    private bool _generatingInvoice;
    private int _generatingInvoiceId;

    protected override async Task OnInitializedAsync()
    {
        await LoadShipments();
    }

    private async Task LoadShipments(string? statusFilter = null)
    {
        _loading = true;
        _error = null;
        try
        {
            _shipments = await Api.GetShipmentsAsync(statusFilter);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async void OnStatusFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        await LoadShipments(string.IsNullOrEmpty(val) ? null : val);
        StateHasChanged();
    }

    private void ToggleLots(int shipmentId)
    {
        _expandedShipmentId = _expandedShipmentId == shipmentId ? null : shipmentId;
    }

    private void MarkShipped(ShipmentListDto s)
    {
        _selectedShipment = s;
        _trackingNumber = s.TrackingNumber;
        _showShippedModal = true;
    }

    private async Task ConfirmShipped()
    {
        if (_selectedShipment == null) return;
        _saving = true;
        _error = null;
        _success = null;
        var (ok, err) = await Api.UpdateShipmentStatusAsync(_selectedShipment.Id, new { status = "Shipped", trackingNumber = _trackingNumber });
        if (!ok) { _error = err; _saving = false; return; }
        _success = $"Shipment {_selectedShipment.ShipmentNumber} marked as Shipped.";
        _showShippedModal = false;
        _saving = false;
        await LoadShipments();
    }

    private async Task MarkDelivered(ShipmentListDto s)
    {
        _error = null;
        _success = null;
        var (ok, err) = await Api.UpdateShipmentStatusAsync(s.Id, new { status = "Delivered" });
        if (!ok) { _error = err; return; }
        _success = $"Shipment {s.ShipmentNumber} marked as Delivered.";
        await LoadShipments();
    }

    private async Task DeleteShipment(int id)
    {
        _error = null;
        _success = null;
        var (ok, err) = await Api.DeleteShipmentAsync(id);
        if (!ok) { _error = err; return; }
        _success = "Shipment deleted.";
        await LoadShipments();
    }

    private async Task ShowCreateModal()
    {
        _showCreateModal = true;
        _loadingCreate = true;
        _createShipperId = 0;
        _createAddressId = 0;
        _createTrackingNumber = "";
        _createNotes = "";
        _confirmInvoice = null;
        _confirmBoxes.Clear();
        _allAddresses.Clear();
        _error = null;

        try
        {
            _shippers = await Api.GetShippersAsync();
            _releasedLots = await Api.GetReleasedLotsForShipmentAsync();
            _allAddresses = await Api.GetShippingAddressesAsync();
            var defaultAddr = _allAddresses.FirstOrDefault(a => a.IsDefault);
            _createAddressId = defaultAddr?.Id ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loadingCreate = false;
    }

    private List<InvoiceGroup> GetInvoiceGroups()
    {
        return _releasedLots
            .GroupBy(l => l.InvoiceNumber)
            .Select(g => new InvoiceGroup
            {
                InvoiceNumber = g.Key,
                BuyerId = g.First().BuyerId,
                BuyerNumber = g.First().BuyerNumber,
                BuyerName = g.First().BuyerName,
                Lots = g.ToList()
            })
            .OrderBy(g => g.InvoiceNumber)
            .ToList();
    }

    private async Task SelectInvoice(InvoiceGroup inv)
    {
        _confirmInvoice = inv;
        _confirmBoxes.Clear();
        _loadingBoxes = true;
        _error = null;
        StateHasChanged();

        try
        {
            // The released-boxes list carries per-box detail (type, weights, location); scope it to
            // this invoice for the confirmation view.
            var allBoxes = await Api.GetShippingBoxesAsync();
            _confirmBoxes = allBoxes.Where(b => b.InvoiceNumber == inv.InvoiceNumber).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _confirmInvoice = null;
        }
        _loadingBoxes = false;
    }

    private void BackToInvoices()
    {
        _confirmInvoice = null;
        _confirmBoxes.Clear();
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _confirmInvoice = null;
        _confirmBoxes.Clear();
        _error = null;
    }

    private async Task CreateShipment()
    {
        if (_confirmInvoice == null) return;
        _saving = true;
        _error = null;
        _success = null;

        var payload = new
        {
            shipperId = _createShipperId,
            buyerId = _confirmInvoice.BuyerId,
            shippingAddressId = _createAddressId > 0 ? (int?)_createAddressId : null,
            trackingNumber = _createTrackingNumber,
            notes = _createNotes,
            lotNumbers = _confirmInvoice.Lots.Select(l => l.LotNumber).Distinct().ToList(),
            boxNumbers = _confirmBoxes.Select(b => b.BoxNumber).Distinct().ToList()
        };

        try
        {
            var (ok, err, num) = await Api.CreateShipmentAsync(payload);
            if (!ok) { _error = err; _saving = false; return; }
            _success = $"Shipment {num} created for invoice {_confirmInvoice.InvoiceNumber}: " +
                       $"{_confirmBoxes.Count} box(es), {_confirmBoxes.Sum(b => b.Skins):N0} skins.";
            _showCreateModal = false;
            _confirmInvoice = null;
            await LoadShipments();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }

    private async Task OpenPackingListPdf(ShipmentListDto shipment)
    {
        if (!string.IsNullOrEmpty(shipment.PackingListPdfUrl))
        {
            await JS.InvokeVoidAsync("open", shipment.PackingListPdfUrl, "_blank");
            return;
        }

        _generatingPdf = true;
        _generatingPdfId = shipment.Id;
        _error = null;
        StateHasChanged();

        try
        {
            var url = await Api.GeneratePackingListPdfAsync(shipment.Id);
            if (url != null)
            {
                await LoadShipments();
                var updated = _shipments.FirstOrDefault(s => s.Id == shipment.Id);
                var blobUrl = updated?.PackingListPdfUrl;
                if (!string.IsNullOrEmpty(blobUrl))
                    await JS.InvokeVoidAsync("open", blobUrl, "_blank");
                else
                    await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                _error = "Failed to generate packing list PDF.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _generatingPdf = false;
        _generatingPdfId = 0;
    }

    private async Task RegeneratePackingListPdf(ShipmentListDto shipment)
    {
        _generatingPdf = true;
        _generatingPdfId = shipment.Id;
        _error = null;
        StateHasChanged();

        try
        {
            var url = await Api.GeneratePackingListPdfAsync(shipment.Id);
            if (url != null)
            {
                await LoadShipments();
                var updated = _shipments.FirstOrDefault(s => s.Id == shipment.Id);
                var blobUrl = updated?.PackingListPdfUrl;
                if (!string.IsNullOrEmpty(blobUrl))
                    await JS.InvokeVoidAsync("open", blobUrl, "_blank");
                else
                    await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                _error = "Failed to regenerate packing list PDF.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _generatingPdf = false;
        _generatingPdfId = 0;
    }

    private async Task OpenShippingInvoicePdf(ShipmentListDto shipment)
    {
        if (!string.IsNullOrEmpty(shipment.ShippingInvoicePdfUrl))
        {
            await JS.InvokeVoidAsync("open", shipment.ShippingInvoicePdfUrl, "_blank");
            return;
        }

        _generatingInvoice = true;
        _generatingInvoiceId = shipment.Id;
        _error = null;
        StateHasChanged();

        try
        {
            var url = await Api.GenerateShippingInvoicePdfAsync(shipment.Id);
            if (url != null)
            {
                await LoadShipments();
                var updated = _shipments.FirstOrDefault(s => s.Id == shipment.Id);
                var blobUrl = updated?.ShippingInvoicePdfUrl;
                if (!string.IsNullOrEmpty(blobUrl))
                    await JS.InvokeVoidAsync("open", blobUrl, "_blank");
                else
                    await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                _error = "Failed to generate shipping invoice PDF.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _generatingInvoice = false;
        _generatingInvoiceId = 0;
    }

    private async Task RegenerateShippingInvoicePdf(ShipmentListDto shipment)
    {
        _generatingInvoice = true;
        _generatingInvoiceId = shipment.Id;
        _error = null;
        StateHasChanged();

        try
        {
            var url = await Api.GenerateShippingInvoicePdfAsync(shipment.Id);
            if (url != null)
            {
                await LoadShipments();
                var updated = _shipments.FirstOrDefault(s => s.Id == shipment.Id);
                var blobUrl = updated?.ShippingInvoicePdfUrl;
                if (!string.IsNullOrEmpty(blobUrl))
                    await JS.InvokeVoidAsync("open", blobUrl, "_blank");
                else
                    await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                _error = "Failed to regenerate shipping invoice PDF.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _generatingInvoice = false;
        _generatingInvoiceId = 0;
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "ShowLot Packing" => "bg-light text-dark border",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };
}
