@page "/admin/buyers"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Buyers - Admin</PageTitle>

<h1>Buyers</h1>
<p class="text-muted">Click on a buyer to view details and broker relationships.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <p class="small text-muted mb-3">To add a new buyer, go to <a href="admin/users">Users & Roles</a> and create a user with the Buyer role.</p>

    <div class="card">
        <div class="card-header">
            <strong>Registered Buyers</strong> <span class="badge bg-secondary">@_items.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Number</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No buyers registered.</td></tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr style="cursor: pointer;" @onclick="() => ViewBuyer(item.Id)">
                            <td><strong>@item.BuyerNumber</strong></td>
                            <td>@item.Name</td>
                            <td>@item.ContactEmail</td>
                            <td>@item.ContactPhone</td>
                            <td>@item.Address</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<BuyerDto> _items = new();
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        _items = await Api.GetAllBuyersAsync();
        _loading = false;
    }

    private void ViewBuyer(int id) => Nav.NavigateTo($"admin/buyers/{id}");
}
