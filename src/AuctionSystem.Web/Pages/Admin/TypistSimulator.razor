@page "/admin/typist-simulator"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@using System.Text.Json

<SectionGate Section="Diagnostics" Title="Typist Simulator">
<h3>Typist Simulator</h3>
<p class="text-muted">
    Types an auction's unsold lots as two typists and drives the real matching — matched lots become
    auction results (and the lots are recorded); a configurable share is sent to the disagreement queue.
    Admin test tool. Needs two <strong>Typist</strong> users and at least one active broker.
</p>

@if (_auctions == null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="row g-3" style="max-width:760px">
        <div class="col-md-6">
            <label class="form-label">Auction</label>
            <select class="form-select" @bind="_auctionId" @bind:after="OnAuctionChanged">
                <option value="0">— select —</option>
                @foreach (var a in _auctions)
                {
                    <option value="@a.Id">@a.AuctionNumber — @a.Title (@a.Status)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Disagreement %</label>
            <input type="number" min="0" max="100" class="form-control" @bind="_disagreementPercent" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max lots <span class="text-muted">(blank = all)</span></label>
            <input type="number" min="1" class="form-control" @bind="_maxLots" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Seconds between entries</label>
            <input type="number" min="0" max="30" class="form-control" @bind="_delaySeconds" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Min price (€)</label>
            <input type="number" min="0" step="0.01" class="form-control" @bind="_minPrice" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max price (€)</label>
            <input type="number" min="0" step="0.01" class="form-control" @bind="_maxPrice" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Disagreement type</label>
            <select class="form-select" @bind="_disagreementType">
                <option value="mixed">Mixed (price or broker)</option>
                <option value="price">Price only</option>
                <option value="broker">Broker only</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">Winning broker numbers <span class="text-muted">(comma-separated, e.g. 888, 168 — empty = random across all active)</span></label>
            <input class="form-control" @bind="_brokerNumbersInput" placeholder="e.g. 888, 168, 018" />
            <div class="form-text">Type the broker numbers that should win lots — typed lots are spread across only those. Leave empty to win randomly across all active brokers.</div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" @onclick="Run" disabled="@(_running || _auctionId <= 0)">
            @if (_running && !_resolving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Simulate
        </button>
        <button class="btn btn-outline-secondary" @onclick="ResolveDisagreements" disabled="@(_running || _auctionId <= 0)">
            @if (_resolving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Clear disagreements
        </button>
        @if (_simStatus != null && !(_simStatus.StartsWith("Done") || _simStatus.StartsWith("Failed") || _simStatus.StartsWith("Stopped")))
        {
            <button class="btn btn-outline-danger" @onclick="StopTyping" disabled="@_stopping">
                @if (_stopping)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Stop typing
            </button>
        }
    </div>

    @if (_message != null)
    {
        <div class="alert @(_error ? "alert-danger" : "alert-success") mt-3" style="max-width:760px">@_message</div>
    }

    @if (_simStatus != null)
    {
        <div class="alert alert-info mt-2 d-flex align-items-center" style="max-width:760px">
            @if (!(_simStatus.StartsWith("Done") || _simStatus.StartsWith("Failed")))
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            <span><strong>Simulation:</strong> @_simStatus</span>
        </div>
    }

    <hr class="my-4" style="max-width:760px" />

    <h5>Sell lots</h5>
    <p class="text-muted" style="max-width:760px">
        Sells this auction's recorded-but-unsold lots through the real sell path (commission → invoice →
        background BC push), to buyers <strong>linked to each lot's broker</strong>. Lots whose broker has
        no eligible linked buyer are skipped. Lets you carry a simulated auction through to invoicing / BC.
    </p>

    <div class="row g-3" style="max-width:760px">
        <div class="col-md-4">
            <label class="form-label">Lots to sell <span class="text-muted">(blank = all)</span></label>
            <input type="number" min="1" class="form-control" @bind="_sellCount" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Commission %</label>
            <input type="number" min="0" step="0.01" class="form-control" @bind="_sellCommission" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Re-invoice % <span class="text-muted">(of sold lots)</span></label>
            <input type="number" min="0" max="100" class="form-control" @bind="_sellReinvoicePct" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Max lots / invoice <span class="text-muted">(random 1..n)</span></label>
            <input type="number" min="1" max="100" class="form-control" @bind="_sellMaxLotsPerInvoice" />
        </div>
        <div class="col-12">
            <label class="form-label">Buyer numbers <span class="text-muted">(comma-separated; empty = random linked buyer per lot)</span></label>
            <input class="form-control" @bind="_sellBuyerNumbersInput" placeholder="e.g. 5112, 8446" />
            <div class="form-text">Restrict sales to these buyers (they must be linked to the lots' brokers). Empty picks a random linked buyer per lot. Re-invoice % takes back that share of the sold lots (credit note) and sells them again.</div>
        </div>
    </div>

    <button class="btn btn-success mt-3" @onclick="SellLots" disabled="@(_running || _auctionId <= 0)">
        @if (_selling)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Sell lots
    </button>

    @if (_sellMessage != null)
    {
        <div class="alert @(_sellError ? "alert-danger" : "alert-success") mt-3" style="max-width:760px">@_sellMessage</div>
    }

    <hr class="my-4" style="max-width:760px" />

    <h5>Broker Simulator <span class="text-muted">(concurrency test)</span></h5>
    <p class="text-muted" style="max-width:760px">
        Runs N brokers <strong>at the same time</strong>, each selling and re-invoicing its own lots through
        the real path — stressing simultaneous broker activity (atomic claims, invoicing, the BC drainer,
        the credit-note path). Runs concurrently with the typist (real-life scenario). Each pass, every broker
        buys a small batch and occasionally issues a credit note. <strong>This runs server-side</strong> — once
        started it keeps going (paced by the interval) until everything sellable is sold or you press Stop, even
        if you leave this page.
    </p>
    <div class="row g-3" style="max-width:760px">
        <div class="col-md-3">
            <label class="form-label">Brokers (concurrent)</label>
            <input type="number" min="1" max="50" class="form-control" @bind="_brokerSimCount" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Pace (seconds/pass)</label>
            <input type="number" min="1" max="120" class="form-control" @bind="_brokerSimDuration" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Commission %</label>
            <input type="number" min="0" step="0.01" class="form-control" @bind="_brokerSimCommission" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Re-invoice %</label>
            <input type="number" min="0" max="100" class="form-control" @bind="_brokerSimReinvoicePct" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Max lots/inv</label>
            <input type="number" min="1" max="100" class="form-control" @bind="_brokerSimMaxLots" />
        </div>
    </div>
    <button class="btn btn-warning mt-3" @onclick="StartBrokerSim" disabled="@(_brokerSimActive || _auctionId <= 0)">
        @if (_brokerSimActive)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        Start broker robots
    </button>
    @if (_brokerSimActive)
    {
        <button class="btn btn-outline-danger mt-3 ms-2" @onclick="StopBrokerSim">Stop robots</button>
    }

    @if (_brokerSimStatus != null)
    {
        <div class="alert @(_brokerSimError ? "alert-danger" : "alert-info") mt-3" style="max-width:760px">@_brokerSimStatus</div>
    }
}

</SectionGate>

@code {
    private List<AuctionDto>? _auctions;
    private List<BrokerDto>? _brokers;
    private int _auctionId;
    private int _disagreementPercent;
    private int? _maxLots;
    private decimal _minPrice = 50;
    private decimal _maxPrice = 500;
    private string _disagreementType = "mixed";
    private string _brokerNumbersInput = "";
    private int _delaySeconds = 1;
    private string? _simStatus;
    private bool _running;
    private bool _stopping;
    private bool _polling;
    private bool _resolving;
    private string? _message;
    private bool _error;

    private List<BuyerDto>? _buyers;
    private int? _sellCount;
    private decimal _sellCommission = 1.5m;
    private int _sellReinvoicePct;
    private int _sellMaxLotsPerInvoice = 10;
    private string _sellBuyerNumbersInput = "";
    private bool _selling;
    private string? _sellMessage;
    private bool _sellError;

    // Broker concurrency simulator (server-side paced run, like the typist — survives page-close)
    private int _brokerSimCount = 15;
    private int _brokerSimDuration = 15;     // pace: seconds between passes
    private decimal _brokerSimCommission = 1.5m;
    private int _brokerSimReinvoicePct = 10;
    private int _brokerSimMaxLots = 10;
    private string? _brokerSimStatus;        // mirror of auction.BrokerSimStatus (polled)
    private bool _brokerSimError;
    private bool _brokerSimPolling;
    // Active = the server worker is queued or running passes (drives the Start/Stop buttons).
    private bool _brokerSimActive => _brokerSimStatus != null && (_brokerSimStatus.StartsWith("Queued") || _brokerSimStatus.StartsWith("Pass"));

    protected override async Task OnInitializedAsync()
    {
        // Load resiliently — a transient backend blip (e.g. 502 while the API is restarting after a
        // deploy) must not white-screen the whole page. Render with what we have + a retry hint.
        try
        {
            _auctions = await Api.GetAuctionsAsync();
            _brokers = await Api.GetBrokersAsync();
            _buyers = await Api.GetAllBuyersAsync();
        }
        catch (Exception ex)
        {
            _auctions ??= new();
            _brokers ??= new();
            _buyers ??= new();
            _message = $"Couldn't load page data — the backend may be restarting (deploy). Refresh in a moment. ({ex.Message})";
            _error = true;
        }
    }

    // Resolve the typed broker numbers to broker ids. Returns false (with an error message) if any
    // typed number doesn't match a known broker, so a typo can't silently change who wins.
    private bool TryResolveBrokerNumbers(out List<int>? brokerIds, out string? error)
    {
        brokerIds = null;
        error = null;
        if (string.IsNullOrWhiteSpace(_brokerNumbersInput))
            return true; // empty = random across all active

        var tokens = _brokerNumbersInput
            .Split(new[] { ',', ';', ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => t.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var matched = new List<int>();
        var unmatched = new List<string>();
        foreach (var tok in tokens)
        {
            var b = _brokers?.FirstOrDefault(x => string.Equals(x.BrokerNumber?.Trim(), tok, StringComparison.OrdinalIgnoreCase));
            if (b != null) matched.Add(b.Id);
            else unmatched.Add(tok);
        }

        if (unmatched.Count > 0)
        {
            error = $"Unknown broker number(s): {string.Join(", ", unmatched)}. Check the numbers and try again.";
            return false;
        }

        brokerIds = matched.Count > 0 ? matched : null;
        return true;
    }

    private async Task Run()
    {
        if (_auctionId <= 0) return;
        if (!TryResolveBrokerNumbers(out var brokerIds, out var resolveError))
        {
            _message = resolveError;
            _error = true;
            return;
        }
        _running = true;
        _message = null;
        _simStatus = null;
        try
        {
            var resp = await Api.SimulateTypistEntriesAsync(_auctionId, _disagreementPercent, _maxLots, _minPrice, _maxPrice, _disagreementType, brokerIds, _delaySeconds);
            var json = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
            {
                var root = JsonDocument.Parse(json).RootElement;
                if (root.TryGetProperty("error", out var errEl) && errEl.ValueKind == JsonValueKind.String)
                {
                    _message = errEl.GetString();
                    _error = true;
                }
                else
                {
                    var note = root.TryGetProperty("message", out var m) && m.ValueKind == JsonValueKind.String ? m.GetString() : null;
                    _message = note ?? "Started.";
                    _error = false;
                    var started = root.TryGetProperty("started", out var s) && s.ValueKind == JsonValueKind.True;
                    if (started) _ = PollSimStatusAsync(_auctionId);
                }
            }
            else
            {
                _message = $"Failed: {(int)resp.StatusCode} {resp.ReasonPhrase}. {json}";
                _error = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _error = true;
        }
        finally
        {
            _running = false;
        }
    }

    private async Task StopTyping()
    {
        if (_auctionId <= 0) return;
        _stopping = true;
        try
        {
            var resp = await Api.StopTypistSimAsync(_auctionId);
            _error = !resp.IsSuccessStatusCode;
            _message = resp.IsSuccessStatusCode
                ? "Stop requested — the typist simulator will halt within a lot or two."
                : $"Failed to stop: {(int)resp.StatusCode} {resp.ReasonPhrase}";
        }
        catch (Exception ex) { _message = $"Error: {ex.Message}"; _error = true; }
        finally { _stopping = false; }
    }

    // The run is paced in the background; poll the auction's status until it's Done/Failed. Guarded so
    // re-selecting the auction (e.g. after navigating back) can't spin up a second concurrent poller.
    private async Task PollSimStatusAsync(int auctionId)
    {
        if (_polling) return;
        _polling = true;
        try
        {
            _simStatus ??= "Starting…";
            await InvokeAsync(StateHasChanged);
            for (var i = 0; i < 5000; i++)
            {
                await Task.Delay(3000);
                try
                {
                    var a = await Api.GetAuctionAsync(auctionId);
                    _simStatus = a?.TypistSimStatus ?? _simStatus;
                }
                catch { /* transient; keep polling */ }
                await InvokeAsync(StateHasChanged);
                if (_simStatus != null && (_simStatus.StartsWith("Done") || _simStatus.StartsWith("Failed"))) break;
            }
        }
        finally { _polling = false; }
    }

    // When the auction selection changes (including returning to the page and re-selecting), pick up an
    // in-progress simulation so its live progress shows again instead of the page looking idle.
    private async Task OnAuctionChanged()
    {
        _simStatus = null;
        _brokerSimStatus = null;
        _brokerSimError = false;
        if (_auctionId <= 0) return;
        try
        {
            var a = await Api.GetAuctionAsync(_auctionId);
            var st = a?.TypistSimStatus;
            if (!string.IsNullOrEmpty(st))
            {
                _simStatus = st;                       // show the current/terminal status immediately
                if (!st.StartsWith("Done") && !st.StartsWith("Failed"))
                    _ = PollSimStatusAsync(_auctionId); // still running -> resume live polling
            }

            // Pick up an in-progress (or finished) broker robot run too, so its live progress shows again.
            var bst = a?.BrokerSimStatus;
            if (!string.IsNullOrEmpty(bst))
            {
                _brokerSimStatus = bst;
                _brokerSimError = bst.StartsWith("Failed");
                if (bst.StartsWith("Queued") || bst.StartsWith("Pass"))
                    _ = PollBrokerSimStatusAsync(_auctionId);
            }
        }
        catch { /* transient; ignore */ }
    }

    private async Task ResolveDisagreements()
    {
        if (_auctionId <= 0) return;
        _running = true;
        _resolving = true;
        _message = null;
        try
        {
            var resp = await Api.ResolveTypistDisagreementsAsync(_auctionId);
            var json = await resp.Content.ReadAsStringAsync();
            if (resp.IsSuccessStatusCode)
            {
                var root = JsonDocument.Parse(json).RootElement;
                if (root.TryGetProperty("error", out var errEl) && errEl.ValueKind == JsonValueKind.String)
                {
                    _message = errEl.GetString();
                    _error = true;
                }
                else
                {
                    int Get(string p) => root.TryGetProperty(p, out var e) && e.ValueKind == JsonValueKind.Number ? e.GetInt32() : 0;
                    var note = root.TryGetProperty("message", out var m) && m.ValueKind == JsonValueKind.String ? m.GetString() : null;
                    _message = note ?? $"Cleared {Get("resolved")} disagreement(s) ({Get("errors")} error(s)).";
                    _error = false;
                }
            }
            else
            {
                _message = $"Failed: {(int)resp.StatusCode} {resp.ReasonPhrase}. {json}";
                _error = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _error = true;
        }
        finally
        {
            _running = false;
            _resolving = false;
        }
    }

    // Resolve typed buyer numbers to ids; reject unknowns so a typo can't silently change who buys.
    private bool TryResolveBuyerNumbers(out List<int>? buyerIds, out string? error)
    {
        buyerIds = null;
        error = null;
        if (string.IsNullOrWhiteSpace(_sellBuyerNumbersInput))
            return true; // empty = random linked buyer per lot

        var tokens = _sellBuyerNumbersInput
            .Split(new[] { ',', ';', ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim()).Where(t => t.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        var matched = new List<int>();
        var unmatched = new List<string>();
        foreach (var tok in tokens)
        {
            var b = _buyers?.FirstOrDefault(x => string.Equals(x.BuyerNumber?.Trim(), tok, StringComparison.OrdinalIgnoreCase));
            if (b != null) matched.Add(b.Id);
            else unmatched.Add(tok);
        }
        if (unmatched.Count > 0)
        {
            error = $"Unknown buyer number(s): {string.Join(", ", unmatched)}. Check the numbers and try again.";
            return false;
        }
        buyerIds = matched.Count > 0 ? matched : null;
        return true;
    }

    private async Task SellLots()
    {
        if (_auctionId <= 0) return;
        if (!TryResolveBuyerNumbers(out var buyerIds, out var resolveError))
        {
            _sellMessage = resolveError;
            _sellError = true;
            return;
        }
        _running = true;
        _selling = true;
        _sellMessage = null;
        _sellError = false;

        // The server caps each call (so it can't time out); loop here until the target is met or no
        // sellable lots remain, accumulating the totals into a live progress line.
        var target = (_sellCount is int c && c > 0) ? c : int.MaxValue;
        int totalSold = 0, totalInv = 0, totalReinv = 0, totalCN = 0, totalSkip = 0;
        try
        {
            const int batch = 200;
            while (totalSold < target)
            {
                var thisCall = Math.Min(batch, target - totalSold);
                var resp = await Api.SimulateSellLotsAsync(_auctionId, thisCall, _sellCommission, _sellCommission, buyerIds, _sellReinvoicePct, _sellMaxLotsPerInvoice);
                var json = await resp.Content.ReadAsStringAsync();
                if (!resp.IsSuccessStatusCode)
                {
                    _sellMessage = $"Failed after {totalSold} sold: {(int)resp.StatusCode} {resp.ReasonPhrase}. {json}";
                    _sellError = true;
                    break;
                }
                var root = JsonDocument.Parse(json).RootElement;
                if (root.TryGetProperty("error", out var errEl) && errEl.ValueKind == JsonValueKind.String)
                {
                    _sellMessage = errEl.GetString();
                    _sellError = true;
                    break;
                }
                int Get(string p) => root.TryGetProperty(p, out var e) && e.ValueKind == JsonValueKind.Number ? e.GetInt32() : 0;
                var sold = Get("sold");
                totalSold += sold; totalInv += Get("invoices"); totalReinv += Get("reinvoiced"); totalCN += Get("creditNotes"); totalSkip += Get("skipped");
                var remaining = Get("remaining");
                _sellMessage = $"Selling… {totalSold} sold, {totalInv} invoice(s), {totalReinv} re-invoiced ({totalCN} credit note(s)){(totalSkip > 0 ? $", {totalSkip} skipped" : "")} — {remaining} left.";
                await InvokeAsync(StateHasChanged);
                if (sold == 0 || remaining == 0) break; // nothing more sellable (e.g. no linked buyers)
            }
            if (!_sellError)
                _sellMessage = $"Done — {totalSold} sold, {totalInv} invoice(s), {totalReinv} re-invoiced ({totalCN} credit note(s)), {totalSkip} skipped. BC posting runs in the background.";
        }
        catch (Exception ex)
        {
            _sellMessage = $"Error after {totalSold} sold: {ex.Message}";
            _sellError = true;
        }
        finally
        {
            _running = false;
            _selling = false;
        }
    }

    // Start the server-side paced broker run. It keeps running (and surviving page-close) until everything
    // sellable is sold or Stop is pressed; we just kick it off and poll BrokerSimStatus for progress.
    private async Task StartBrokerSim()
    {
        if (_auctionId <= 0) return;
        _brokerSimError = false;
        try
        {
            var resp = await Api.StartBrokerSimAsync(_auctionId, _brokerSimCount, _brokerSimCommission, _brokerSimReinvoicePct, _brokerSimMaxLots, _brokerSimDuration);
            var json = await resp.Content.ReadAsStringAsync();
            var root = JsonDocument.Parse(json).RootElement;
            if (!resp.IsSuccessStatusCode)
            {
                _brokerSimStatus = root.TryGetProperty("error", out var e) && e.ValueKind == JsonValueKind.String
                    ? e.GetString() : $"Failed: {(int)resp.StatusCode} {resp.ReasonPhrase}. {json}";
                _brokerSimError = true;
                return;
            }
            _brokerSimStatus = "Queued…";
            _ = PollBrokerSimStatusAsync(_auctionId);
        }
        catch (Exception ex) { _brokerSimStatus = $"Error: {ex.Message}"; _brokerSimError = true; }
    }

    // Ask the server to stop; the worker halts after its current pass and writes a "Stopped: …" status.
    private async Task StopBrokerSim()
    {
        if (_auctionId <= 0) return;
        try
        {
            await Api.StopBrokerSimAsync(_auctionId);
            _brokerSimStatus = "Stopping… (halts after the current pass)";
        }
        catch (Exception ex) { _brokerSimStatus = $"Error: {ex.Message}"; _brokerSimError = true; }
    }

    private async Task PollBrokerSimStatusAsync(int auctionId)
    {
        if (_brokerSimPolling) return;
        _brokerSimPolling = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            for (var i = 0; i < 5000; i++)
            {
                await Task.Delay(3000);
                try
                {
                    var a = await Api.GetAuctionAsync(auctionId);
                    _brokerSimStatus = a?.BrokerSimStatus ?? _brokerSimStatus;
                    _brokerSimError = _brokerSimStatus != null && _brokerSimStatus.StartsWith("Failed");
                }
                catch { /* transient; keep polling */ }
                await InvokeAsync(StateHasChanged);
                if (_brokerSimStatus != null && (_brokerSimStatus.StartsWith("Done") || _brokerSimStatus.StartsWith("Stopped") || _brokerSimStatus.StartsWith("Failed"))) break;
            }
        }
        finally { _brokerSimPolling = false; }
    }
}
