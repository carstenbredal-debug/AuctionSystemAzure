@page "/admin/invoices"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Invoices - Admin</PageTitle>

<h1>Invoices</h1>
<p class="text-muted">All invoices and credit notes across all brokers and buyers.</p>

@if (!string.IsNullOrEmpty(_bcError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_bcError
        <button type="button" class="btn-close" @onclick="() => _bcError = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(_bcSuccess))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @_bcSuccess
        <button type="button" class="btn-close" @onclick="() => _bcSuccess = null"></button>
    </div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="summary-card">
                <div class="card-title">Total</div>
                <div class="card-value">@GetFilteredInvoices().Count</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="summary-card">
                <div class="card-title">Invoices</div>
                <div class="card-value">@GetFilteredInvoices().Count(i => !i.IsCreditNote)</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="summary-card">
                <div class="card-title">Credit Notes</div>
                <div class="card-value">@GetFilteredInvoices().Count(i => i.IsCreditNote)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Total Amount</div>
                <div class="card-value">€@GetFilteredInvoices().Where(i => !i.IsCreditNote).Sum(i => i.TotalAmount).ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Credit Total</div>
                <div class="card-value">€@GetFilteredInvoices().Where(i => i.IsCreditNote).Sum(i => i.TotalAmount).ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label">Broker</label>
            <select class="form-select" @bind="_selectedBroker">
                <option value="">All Brokers</option>
                @foreach (var broker in _brokerNames)
                {
                    <option value="@broker">@broker</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Buyer</label>
            <select class="form-select" @bind="_selectedBuyer">
                <option value="">All Buyers</option>
                @foreach (var buyer in _buyerNames)
                {
                    <option value="@buyer">@buyer</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select" @bind="_selectedStatus">
                <option value="">All Statuses</option>
                @foreach (var status in _statusOptions)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link @(_tab == "all" ? "active" : "")" href="#" @onclick='() => _tab = "all"' @onclick:preventDefault>All (@GetFilteredInvoices().Count)</a></li>
        <li class="nav-item"><a class="nav-link @(_tab == "invoices" ? "active" : "")" href="#" @onclick='() => _tab = "invoices"' @onclick:preventDefault>Invoices (@GetFilteredInvoices().Count(i => !i.IsCreditNote))</a></li>
        <li class="nav-item"><a class="nav-link @(_tab == "credits" ? "active" : "")" href="#" @onclick='() => _tab = "credits"' @onclick:preventDefault>Credit Notes (@GetFilteredInvoices().Count(i => i.IsCreditNote))</a></li>
    </ul>

    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>Number</th>
                        <th>Broker</th>
                        <th>Customer No.</th>
                        <th>Buyer</th>
                        <th>Lots</th>
                        <th>Subtotal</th>
                        <th>Auction Fee</th>
                        <th>Commission</th>
                        <th>Total</th>
                        <th>Remaining</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                        <th>PDF</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (GetFilteredInvoices().Count == 0)
                    {
                        <tr><td colspan="16" class="text-center text-muted py-4">No invoices found.</td></tr>
                    }
                    @foreach (var inv in GetFilteredInvoices())
                    {
                        <tr class="@(inv.IsCreditNote ? "credit-row" : "")">
                            <td>
                                @if (inv.IsCreditNote)
                                {
                                    <span class="badge bg-warning text-dark">Credit Note</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Invoice</span>
                                }
                            </td>
                            <td>
                                <a href="#" @onclick="() => OpenPaymentHistory(inv.Id)" @onclick:preventDefault style="text-decoration: underline; cursor: pointer;">
                                    <strong>@inv.InvoiceNumber</strong>
                                </a>
                                @if (!string.IsNullOrEmpty(inv.OriginalInvoiceNumber))
                                {
                                    <br /><small class="text-muted">Ref: @inv.OriginalInvoiceNumber</small>
                                }
                            </td>
                            <td>@(inv.BrokerName ?? "—")</td>
                            <td>@(inv.BuyerNumber ?? "—")</td>
                            <td>@(inv.BuyerName ?? "—")</td>
                            <td>@inv.LinesCount</td>
                            <td>€@inv.SubTotal.ToString("N2")</td>
                            <td>€@inv.AuctionFee.ToString("N2")</td>
                            <td>€@inv.Commission.ToString("N2")</td>
                            <td><strong>€@inv.TotalAmount.ToString("N2")</strong></td>
                            <td>
                                @if (inv.RemainingBalance.HasValue)
                                {
                                    <span class="@(inv.RemainingBalance.Value > 0 ? "text-danger" : "text-success")">€@inv.RemainingBalance.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@inv.InvoiceDate.ToString("d")</td>
                            <td>
                                @{
                                    var creditStatus = GetCreditStatus(inv);
                                }
                                <span class="badge bg-@GetStatusColor(creditStatus)">@creditStatus</span>
                            </td>
                            <td>
                                @{
                                    var isFullyPaid = inv.Status == "Paid" || (inv.RemainingBalance.HasValue && inv.RemainingBalance.Value == 0);
                                }
                                @if (!inv.IsCreditNote && !isFullyPaid && creditStatus != "Fully Credited")
                                {
                                    var invId = inv.Id;
                                    @if (inv.Status == "Downpayment")
                                    {
                                        <span class="text-info me-1">Partially Paid</span>
                                    }
                                    @if (inv.Status == "ReleasedToShip")
                                    {
                                        <span class="badge bg-primary me-1">Released to Ship</span>
                                    }
                                    @if (_updatingId == invId)
                                    {
                                        <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>
                                        <span class="text-muted">Processing...</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-info me-1" @onclick="() => OpenDownpaymentPopup(invId)" disabled="@_updatingId.HasValue">Partial Payment</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => OpenFullyPaidPopup(invId)" disabled="@_updatingId.HasValue">Full Payment</button>
                                    }
                                }
                                else if (isFullyPaid)
                                {
                                    <span class="text-success">Paid</span>
                                    @if (inv.ShippingStatus == "Released" || inv.Status == "ReleasedToShip")
                                    {
                                        <span class="badge bg-primary ms-1">Released to Ship</span>
                                    }
                                    @if (inv.ShippingStatus == "InShipment")
                                    {
                                        <span class="badge bg-info ms-1">In Shipment</span>
                                    }
                                    @if (inv.ShippingStatus == "Shipped")
                                    {
                                        <span class="badge bg-success ms-1">Shipped</span>
                                    }
                                    @if (inv.ShippingStatus == "Delivered")
                                    {
                                        <span class="badge bg-success ms-1">Delivered</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(inv.PdfUrl))
                                {
                                    <a href="@inv.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">PDF</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (inv.Lots.Any())
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleLots(inv.Id)">
                                        @(_expandedInvoiceId == inv.Id ? "Hide Lots" : "Show Lots")
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (_expandedInvoiceId == inv.Id && inv.Lots.Any())
                        {
                            <tr>
                                <td colspan="15" class="p-0">
                                    <table class="table table-sm mb-0 ms-4" style="width: auto;">
                                        <thead>
                                            <tr>
                                                <th>Lot #</th>
                                                <th>Description</th>
                                                <th>Skins</th>
                                                <th>Price/Skin</th>
                                                <th>Subtotal</th>
                                                @if (!inv.IsCreditNote)
                                                {
                                                    <th>Credit Status</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var lot in inv.Lots)
                                            {
                                                <tr class="@(!inv.IsCreditNote && lot.IsCredited ? "table-danger" : (!inv.IsCreditNote && !lot.IsCredited ? "table-success" : ""))">
                                                    <td>@lot.LotNumber</td>
                                                    <td>@lot.Description</td>
                                                    <td>@lot.Skins</td>
                                                    <td>€@lot.PricePerSkin.ToString("N2")</td>
                                                    <td>€@lot.SubTotal.ToString("N2")</td>
                                                    @if (!inv.IsCreditNote)
                                                    {
                                                        <td>
                                                            @if (lot.IsCredited)
                                                            {
                                                                <span class="badge bg-danger">Credited</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success">Invoiced</span>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_showDownpaymentPopup)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Process Partial Payment</h5>
                    <button type="button" class="btn-close" @onclick="CloseDownpaymentPopup"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Amount Type</label>
                        <select class="form-select" @bind="_dpAmountType">
                            <option value="percentage">Percentage (%)</option>
                            <option value="absolute">Absolute Amount (€)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@(_dpAmountType == "percentage" ? "Percentage" : "Amount")</label>
                        <input type="number" class="form-control" @bind="_dpAmount" step="0.01" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDownpaymentPopup">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmDownpayment" disabled="@(_dpAmount <= 0)">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showShippingConfirm)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Release Lots for Shipping?</h5>
                    <button type="button" class="btn-close" @onclick="() => _showShippingConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Do you want to release all uncredited lots on this invoice for shipping?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => SubmitDownpayment(false)">No</button>
                    <button class="btn btn-success" @onclick="() => SubmitDownpayment(true)">Yes — Release for Shipping</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showFullyPaidShippingConfirm)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Release Lots for Shipping?</h5>
                    <button type="button" class="btn-close" @onclick="() => _showFullyPaidShippingConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>Do you want to release all uncredited lots on this invoice for shipping?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => SubmitFullyPaid(false)">No</button>
                    <button class="btn btn-success" @onclick="() => SubmitFullyPaid(true)">Yes — Release for Shipping</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showPaymentHistory && _paymentHistory != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Payment History — @_paymentHistory.InvoiceNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => _showPaymentHistory = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_paymentHistory.Message))
                    {
                        <div class="alert alert-warning">@_paymentHistory.Message</div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <small class="text-muted">BC Invoice No.</small><br />
                                <strong>@_paymentHistory.BcInvoiceNumber</strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Customer</small><br />
                                <strong>@_paymentHistory.CustomerNo</strong> — @_paymentHistory.CustomerName
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">BC Status</small><br />
                                @if (_paymentHistory.BcOpen == false)
                                {
                                    <span class="badge bg-success">Closed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Open</span>
                                }
                            </div>
                        </div>

                        <table class="table table-sm mb-3">
                            <tr>
                                <td class="text-muted">Invoice Amount:</td>
                                <td class="text-end"><strong>€@((_paymentHistory.BcOriginalAmount ?? 0).ToString("N2"))</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Amount Applied:</td>
                                <td class="text-end"><strong class="text-success">€@_paymentHistory.BcAmountApplied.ToString("N2")</strong></td>
                            </tr>
                            <tr class="@(_paymentHistory.BcRemainingAmount > 0 ? "table-danger" : "table-success")">
                                <td><strong>Remaining Balance:</strong></td>
                                <td class="text-end"><strong>€@((_paymentHistory.BcRemainingAmount ?? 0).ToString("N2"))</strong></td>
                            </tr>
                        </table>

                        @if (_paymentHistory.Entries.Count == 0)
                        {
                            <div class="alert alert-info">No payments have been applied to this invoice yet.</div>
                        }
                        else
                        {
                            <h6>Application Details</h6>
                            <table class="table table-sm table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Type</th>
                                        <th>Document No.</th>
                                        <th>Date</th>
                                        <th>Applied to Invoice</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _paymentHistory.Entries)
                                    {
                                        <tr class="@(entry.Type == "Credit Memo" ? "credit-row" : "")">
                                            <td>
                                                <span class="badge @(entry.Type.Contains("Payment") ? "bg-success" : "bg-warning text-dark")">@entry.Type</span>
                                            </td>
                                            <td>@entry.DocumentNo</td>
                                            <td>@entry.PostingDate</td>
                                            <td><strong>€@entry.AmountApplied.ToString("N2")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showPaymentHistory = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showInsufficientBalancePopup)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Insufficient BC Balance</h5>
                    <button type="button" class="btn-close" @onclick="CancelInsufficientBalance"></button>
                </div>
                <div class="modal-body">
                    <p>The available payment balance in BC is <strong>less than the required amount</strong>.</p>
                    <table class="table table-sm mb-3">
                        <tr><td>Required amount:</td><td class="text-end"><strong>@_bcInvoiceAmount.ToString("N2") €</strong></td></tr>
                        <tr><td>Available in BC:</td><td class="text-end"><strong>@_bcAvailableAmount.ToString("N2") €</strong></td></tr>
                        <tr class="credit-row"><td>Shortfall:</td><td class="text-end"><strong>@((_bcInvoiceAmount - _bcAvailableAmount).ToString("N2")) €</strong></td></tr>
                    </table>
                    <p>Do you want to apply the available <strong>@_bcAvailableAmount.ToString("N2") €</strong> to this invoice?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelInsufficientBalance">No — Cancel</button>
                    <button class="btn btn-warning" @onclick="ConfirmApplyAvailable">Yes — Apply @_bcAvailableAmount.ToString("N2") €</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string StatusDownpayment = "Downpayment";
    private const string StatusPaid = "Paid";

    private List<InvoiceSummaryDto> _invoices = new();
    private bool _loading = true;
    private string _tab = "all";
    private string _selectedBroker = "";
    private string _selectedBuyer = "";
    private string _selectedStatus = "";
    private List<string> _brokerNames = new();
    private List<string> _buyerNames = new();
    private List<string> _statusOptions = new() { "Issued", "Partially Paid", "Paid", "Released to Ship", "Partially Credited", "Fully Credited", "Alloted" };
    private int? _updatingId;
    private int? _expandedInvoiceId;

    // Partial Payment popup state
    private bool _showDownpaymentPopup;
    private bool _showShippingConfirm;
    private int _dpInvoiceId;
    private decimal _dpAmount;
    private string _dpAmountType = "percentage";

    // Fully Paid popup state
    private bool _showFullyPaidShippingConfirm;
    private int _fpInvoiceId;

    // Balance check state
    private bool _showInsufficientBalancePopup;
    private decimal _bcAvailableAmount;
    private decimal _bcInvoiceAmount;
    private string _balanceContext = ""; // "fullypaid" or "downpayment"

    // Payment history popup
    private bool _showPaymentHistory;
    private PaymentHistoryDto? _paymentHistory;
    private bool _loadingHistory;

    // BC feedback
    private string? _bcError;
    private string? _bcSuccess;

    private List<InvoiceSummaryDto> GetFilteredInvoices()
    {
        var result = _invoices.AsEnumerable();

        if (!string.IsNullOrEmpty(_selectedBroker))
            result = result.Where(i => i.BrokerName == _selectedBroker);

        if (!string.IsNullOrEmpty(_selectedBuyer))
            result = result.Where(i => i.BuyerName == _selectedBuyer);

        if (!string.IsNullOrEmpty(_selectedStatus))
            result = result.Where(i => GetCreditStatus(i) == _selectedStatus);

        if (_tab == "invoices")
            result = result.Where(i => !i.IsCreditNote);
        else if (_tab == "credits")
            result = result.Where(i => i.IsCreditNote);

        return result.ToList();
    }

    private async Task OpenPaymentHistory(int invoiceId)
    {
        _loadingHistory = true;
        _showPaymentHistory = true;
        _paymentHistory = null;
        StateHasChanged();

        _paymentHistory = await Api.GetInvoicePaymentHistoryAsync(invoiceId);
        _loadingHistory = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _invoices = await Api.GetAllInvoiceSummariesAsync();
        _brokerNames = _invoices.Where(i => !string.IsNullOrEmpty(i.BrokerName)).Select(i => i.BrokerName!).Distinct().OrderBy(n => n).ToList();
        _buyerNames = _invoices.Where(i => !string.IsNullOrEmpty(i.BuyerName)).Select(i => i.BuyerName!).Distinct().OrderBy(n => n).ToList();
        _loading = false;
    }

    private void ClearFilters()
    {
        _selectedBroker = "";
        _selectedBuyer = "";
        _selectedStatus = "";
    }

    private async Task SetStatus(int invoiceId, string status)
    {
        _updatingId = invoiceId;
        var resp = await Api.UpdateInvoiceStatusAsync(invoiceId, status);
        if (resp.IsSuccessStatusCode)
        {
            var inv = _invoices.FirstOrDefault(i => i.Id == invoiceId);
            if (inv != null) inv.Status = status;
        }
        _updatingId = null;
    }

    private void OpenDownpaymentPopup(int invoiceId)
    {
        _dpInvoiceId = invoiceId;
        _dpAmount = 0;
        _dpAmountType = "percentage";
        _showDownpaymentPopup = true;
    }

    private void CloseDownpaymentPopup()
    {
        _showDownpaymentPopup = false;
    }

    private async Task ConfirmDownpayment()
    {
        _showDownpaymentPopup = false;
        _bcError = null;
        _bcSuccess = null;
        _updatingId = _dpInvoiceId;
        StateHasChanged();

        var balance = await Api.CheckBcPaymentBalanceAsync(_dpInvoiceId);
        _updatingId = null;

        var dpInv = _invoices.FirstOrDefault(i => i.Id == _dpInvoiceId);
        var alreadyShipped = dpInv?.Status == "ReleasedToShip";

        if (balance == null || !balance.Available)
        {
            await ProceedWithDownpayment(alreadyShipped);
            return;
        }

        var isPercentage = _dpAmountType == "percentage";
        var actualAmount = isPercentage && dpInv != null ? dpInv.TotalAmount * _dpAmount / 100 : _dpAmount;

        if (balance.AvailableAmount >= actualAmount)
        {
            await ProceedWithDownpayment(alreadyShipped);
        }
        else
        {
            _bcAvailableAmount = balance.AvailableAmount;
            _bcInvoiceAmount = actualAmount;
            _balanceContext = "downpayment";
            _showInsufficientBalancePopup = true;
        }
    }

    private async Task ProceedWithDownpayment(bool alreadyShipped)
    {
        if (alreadyShipped)
            await SubmitDownpayment(true);
        else
            _showShippingConfirm = true;
    }

    private async Task SubmitDownpayment(bool releaseForShipping)
    {
        _showShippingConfirm = false;
        _updatingId = _dpInvoiceId;
        _bcError = null;
        _bcSuccess = null;
        StateHasChanged();
        var resp = await Api.ProcessDownpaymentAsync(_dpInvoiceId, _dpAmount, _dpAmountType == "percentage", releaseForShipping);
        if (resp.IsSuccessStatusCode)
        {
            var inv = _invoices.FirstOrDefault(i => i.Id == _dpInvoiceId);
            if (inv != null)
            {
                inv.Status = releaseForShipping ? "ReleasedToShip" : "Downpayment";
                if (releaseForShipping) inv.ShippingStatus = "Released";
            }
            ParseBcResponse(resp, "Partial payment recorded");
            await CheckAndMarkPaidIfZeroBalance(_dpInvoiceId);
        }
        else
        {
            _bcError = $"Failed to process partial payment (HTTP {(int)resp.StatusCode}).";
        }
        _updatingId = null;
    }

    private async Task OpenFullyPaidPopup(int invoiceId)
    {
        _fpInvoiceId = invoiceId;
        _bcError = null;
        _bcSuccess = null;
        _updatingId = invoiceId;
        StateHasChanged();

        var balance = await Api.CheckBcPaymentBalanceAsync(invoiceId);
        _updatingId = null;

        var fpInv = _invoices.FirstOrDefault(i => i.Id == invoiceId);
        var fpAlreadyShipped = fpInv?.Status == "ReleasedToShip";

        if (balance == null || !balance.Available || balance.Sufficient)
        {
            await ProceedWithFullyPaid(fpAlreadyShipped);
        }
        else
        {
            _bcAvailableAmount = balance.AvailableAmount;
            _bcInvoiceAmount = balance.InvoiceAmount;
            _balanceContext = "fullypaid";
            _showInsufficientBalancePopup = true;
        }
    }

    private async Task ProceedWithFullyPaid(bool alreadyShipped)
    {
        if (alreadyShipped)
            await SubmitFullyPaid(true);
        else
            _showFullyPaidShippingConfirm = true;
    }

    private async Task ConfirmApplyAvailable()
    {
        _showInsufficientBalancePopup = false;
        // Skip shipping question if already released to ship
        if (_balanceContext == "fullypaid")
        {
            var fpInv = _invoices.FirstOrDefault(i => i.Id == _fpInvoiceId);
            if (fpInv?.Status == "ReleasedToShip")
                await SubmitFullyPaid(true);
            else
                _showFullyPaidShippingConfirm = true;
        }
        else
        {
            var dpInv = _invoices.FirstOrDefault(i => i.Id == _dpInvoiceId);
            if (dpInv?.Status == "ReleasedToShip")
                await SubmitDownpayment(true);
            else
                _showShippingConfirm = true;
        }
    }

    private void CancelInsufficientBalance()
    {
        _showInsufficientBalancePopup = false;
    }

    private async Task SubmitFullyPaid(bool releaseForShipping)
    {
        _showFullyPaidShippingConfirm = false;
        _updatingId = _fpInvoiceId;
        _bcError = null;
        _bcSuccess = null;
        StateHasChanged();

        var resp = await Api.UpdateInvoiceStatusAsync(_fpInvoiceId, StatusPaid, releaseForShipping);
        if (resp.IsSuccessStatusCode)
        {
            // Read actual status from backend (may be Downpayment if BC had insufficient balance)
            var inv = _invoices.FirstOrDefault(i => i.Id == _fpInvoiceId);
            try
            {
                var json = await resp.Content.ReadFromJsonAsync<BcStatusResponse>();
                var actualStatus = json?.Status ?? (releaseForShipping ? "ReleasedToShip" : StatusPaid);
                if (inv != null)
                {
                    inv.Status = actualStatus;
                    if (releaseForShipping) inv.ShippingStatus = "Released";
                }
                if (!string.IsNullOrEmpty(json?.BcPaymentError))
                    _bcError = $"Invoice marked as {actualStatus} locally, but BC payment application failed: {json.BcPaymentError}";
                else if (!string.IsNullOrEmpty(json?.BcPaymentSuccess))
                    _bcSuccess = $"Payment applied. BC: {json.BcPaymentSuccess}";
                else
                    _bcSuccess = $"Invoice marked as {actualStatus}.";
            }
            catch
            {
                if (inv != null)
                {
                    inv.Status = releaseForShipping ? "ReleasedToShip" : StatusPaid;
                    if (releaseForShipping) inv.ShippingStatus = "Released";
                }
                _bcSuccess = "Invoice status updated.";
            }
        }
        else
        {
            _bcError = $"Failed to update invoice status (HTTP {(int)resp.StatusCode}).";
        }
        _updatingId = null;
    }

    private async Task CheckAndMarkPaidIfZeroBalance(int invoiceId)
    {
        try
        {
            var remaining = await Api.CheckBcInvoiceRemainingAsync(invoiceId);
            if (remaining?.FullyPaidInBc == true)
            {
                var inv = _invoices.FirstOrDefault(i => i.Id == invoiceId);
                if (inv != null)
                {
                    inv.Status = "Paid";
                    _bcSuccess = "Invoice fully paid in BC — status updated to Paid.";
                }
            }
        }
        catch { /* non-critical — don't block the user */ }
    }

    private class BcStatusResponse
    {
        public string? Status { get; set; }
        public string? BcPaymentError { get; set; }
        public string? BcPaymentSuccess { get; set; }
    }

    private void ToggleLots(int invoiceId)
    {
        _expandedInvoiceId = _expandedInvoiceId == invoiceId ? null : invoiceId;
    }

    private string GetCreditStatus(InvoiceSummaryDto inv)
    {
        if (inv.IsCreditNote) return FormatStatus(inv.Status);
        if (inv.CreditedLots == 0) return FormatStatus(inv.Status);
        if (inv.UncreditedLotNumbers.Count == 0) return "Fully Credited";
        return "Partially Credited";
    }

    private string FormatStatus(string status) => status switch
    {
        "ReleasedToShip" => "Released to Ship",
        "Downpayment" => "Partially Paid",
        "PartiallyCredited" => "Partially Credited",
        "FullyCredited" => "Fully Credited",
        _ => status
    };

    private string GetStatusColor(string status) => status switch
    {
        "Paid" => "success",
        "Fully Credited" => "success",
        "Partially Credited" => "warning",
        "Issued" => "info",
        "Partially Paid" => "info",
        "Alloted" => "success",
        "Released to Ship" => "primary",
        "Overdue" => "danger",
        _ => "secondary"
    };

    private async void ParseBcResponse(HttpResponseMessage resp, string successPrefix)
    {
        try
        {
            var json = await resp.Content.ReadFromJsonAsync<BcStatusResponse>();
            if (!string.IsNullOrEmpty(json?.BcPaymentError))
                _bcError = $"{successPrefix} locally, but BC payment application failed: {json.BcPaymentError}";
            else if (!string.IsNullOrEmpty(json?.BcPaymentSuccess))
                _bcSuccess = $"{successPrefix}. BC: {json.BcPaymentSuccess}";
            else
                _bcSuccess = $"{successPrefix}.";
        }
        catch { _bcSuccess = $"{successPrefix}."; }
    }
}
