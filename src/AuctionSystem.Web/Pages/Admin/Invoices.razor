@page "/admin/invoices"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Invoices - Admin</PageTitle>

<h1>Invoices</h1>
<p class="text-muted">All invoices and credit notes across all brokers and buyers.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total</h5>
                    <h2>@FilteredInvoices.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Invoices</h5>
                    <h2>@FilteredInvoices.Count(i => !i.IsCreditNote)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Credit Notes</h5>
                    <h2 class="text-warning">@FilteredInvoices.Count(i => i.IsCreditNote)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Amount</h5>
                    <h2>€@FilteredInvoices.Where(i => !i.IsCreditNote).Sum(i => i.TotalAmount).ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Credit Total</h5>
                    <h2 class="text-warning">€@FilteredInvoices.Where(i => i.IsCreditNote).Sum(i => i.TotalAmount).ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label">Broker</label>
            <select class="form-select" @bind="_selectedBroker">
                <option value="">All Brokers</option>
                @foreach (var broker in _brokerNames)
                {
                    <option value="@broker">@broker</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Buyer</label>
            <select class="form-select" @bind="_selectedBuyer">
                <option value="">All Buyers</option>
                @foreach (var buyer in _buyerNames)
                {
                    <option value="@buyer">@buyer</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link @(_tab == "all" ? "active" : "")" href="#" @onclick='() => _tab = "all"' @onclick:preventDefault>All (@FilteredInvoices.Count)</a></li>
        <li class="nav-item"><a class="nav-link @(_tab == "invoices" ? "active" : "")" href="#" @onclick='() => _tab = "invoices"' @onclick:preventDefault>Invoices (@FilteredInvoices.Count(i => !i.IsCreditNote))</a></li>
        <li class="nav-item"><a class="nav-link @(_tab == "credits" ? "active" : "")" href="#" @onclick='() => _tab = "credits"' @onclick:preventDefault>Credit Notes (@FilteredInvoices.Count(i => i.IsCreditNote))</a></li>
    </ul>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>Number</th>
                        <th>Broker</th>
                        <th>Buyer</th>
                        <th>Lots</th>
                        <th>Subtotal</th>
                        <th>Auction Fee</th>
                        <th>Commission</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredInvoices.Count == 0)
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">No invoices found.</td></tr>
                    }
                    @foreach (var inv in FilteredInvoices)
                    {
                        <tr class="@(inv.IsCreditNote ? "table-warning" : "")">
                            <td>
                                @if (inv.IsCreditNote)
                                {
                                    <span class="badge bg-warning text-dark">Credit Note</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Invoice</span>
                                }
                            </td>
                            <td>
                                <strong>@inv.InvoiceNumber</strong>
                                @if (!string.IsNullOrEmpty(inv.OriginalInvoiceNumber))
                                {
                                    <br /><small class="text-muted">Ref: @inv.OriginalInvoiceNumber</small>
                                }
                            </td>
                            <td>@(inv.BrokerName ?? "—")</td>
                            <td>@(inv.BuyerName ?? "—")</td>
                            <td>@inv.LinesCount</td>
                            <td>€@inv.SubTotal.ToString("N2")</td>
                            <td>€@inv.AuctionFee.ToString("N2")</td>
                            <td>€@inv.Commission.ToString("N2")</td>
                            <td><strong>€@inv.TotalAmount.ToString("N2")</strong></td>
                            <td>@inv.InvoiceDate.ToString("d")</td>
                            <td><span class="badge bg-@GetStatusColor(inv.Status)">@inv.Status</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(inv.PdfUrl))
                                {
                                    <a href="@inv.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">PDF</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<InvoiceSummaryDto> _invoices = new();
    private bool _loading = true;
    private string _tab = "all";
    private string _selectedBroker = "";
    private string _selectedBuyer = "";
    private List<string> _brokerNames = new();
    private List<string> _buyerNames = new();

    private List<InvoiceSummaryDto> FilteredInvoices
    {
        get
        {
            var result = _invoices.AsEnumerable();

            if (!string.IsNullOrEmpty(_selectedBroker))
                result = result.Where(i => i.BrokerName == _selectedBroker);

            if (!string.IsNullOrEmpty(_selectedBuyer))
                result = result.Where(i => i.BuyerName == _selectedBuyer);

            if (_tab == "invoices")
                result = result.Where(i => !i.IsCreditNote);
            else if (_tab == "credits")
                result = result.Where(i => i.IsCreditNote);

            return result.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _invoices = await Api.GetAllInvoiceSummariesAsync();
        _brokerNames = _invoices.Where(i => !string.IsNullOrEmpty(i.BrokerName)).Select(i => i.BrokerName!).Distinct().OrderBy(n => n).ToList();
        _buyerNames = _invoices.Where(i => !string.IsNullOrEmpty(i.BuyerName)).Select(i => i.BuyerName!).Distinct().OrderBy(n => n).ToList();
        _loading = false;
    }

    private void ClearFilters()
    {
        _selectedBroker = "";
        _selectedBuyer = "";
    }

    private string GetStatusColor(string status) => status switch
    {
        "Paid" => "success",
        "Issued" => "info",
        "Overdue" => "danger",
        _ => "secondary"
    };
}
