@page "/admin/auction-simulation"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Auction Simulation</PageTitle>

<h1>Auction Simulation</h1>
<p class="text-muted">Simulate external auction results — input lot number, broker, and price to assign lots.</p>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header">
                <strong>Submit Sale Result</strong>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success alert-dismissible">
                        @_successMessage
                        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible">
                        @_errorMessage
                        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label"><strong>Lot Number</strong></label>
                    <input type="number" class="form-control" @bind="_lotNumber" placeholder="Enter lot number" />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Broker</strong></label>
                    <select class="form-select" @bind="_selectedBrokerId">
                        <option value="0">— Select Broker —</option>
                        @foreach (var broker in _brokers)
                        {
                            <option value="@broker.Id">@broker.BrokerNumber — @broker.CompanyName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Price (EUR)</strong></label>
                    <div class="input-group">
                        <span class="input-group-text">€</span>
                        <input type="number" step="0.01" class="form-control" @bind="_priceEur" placeholder="0.00" />
                    </div>
                </div>

                <button class="btn btn-primary w-100" @onclick="SubmitResult" disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Submit Sale Result
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Results</strong>
                <span class="badge bg-secondary">@_results.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th>
                            <th>Broker</th>
                            <th>Price (EUR)</th>
                            <th>Type</th>
                            <th>Gender</th>
                            <th>Color</th>
                            <th>Skins</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_results.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No results yet. Submit a sale result to get started.</td></tr>
                        }
                        @foreach (var r in _results)
                        {
                            <tr>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@r.BrokerNumber — @r.BrokerName</td>
                                <td>€@r.PriceEur.ToString("N2")</td>
                                <td>@(r.SalesType ?? "—")</td>
                                <td>@(r.Gender ?? "—")</td>
                                <td>@(r.Color ?? "—")</td>
                                <td>@r.TotalSkins</td>
                                <td>
                                    @if (r.Processed)
                                    {
                                        <span class="badge bg-success">Processed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                                <td><small>@r.ReceivedAt.ToString("HH:mm:ss")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<BrokerDto> _brokers = new();
    private List<AuctionResultDto> _results = new();
    private int _lotNumber;
    private int _selectedBrokerId;
    private decimal _priceEur;
    private bool _submitting;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _brokers = await Api.GetBrokersAsync();
        _results = await Api.GetAuctionResultsAsync();
    }

    private async Task SubmitResult()
    {
        _successMessage = null;
        _errorMessage = null;

        if (_lotNumber <= 0)
        {
            _errorMessage = "Please enter a valid lot number.";
            return;
        }
        if (_selectedBrokerId <= 0)
        {
            _errorMessage = "Please select a broker.";
            return;
        }
        if (_priceEur <= 0)
        {
            _errorMessage = "Please enter a valid price.";
            return;
        }

        _submitting = true;
        try
        {
            var resp = await Api.SubmitAuctionResultAsync(_lotNumber, _selectedBrokerId, _priceEur);
            if (resp.IsSuccessStatusCode)
            {
                _successMessage = $"Lot {_lotNumber} sold to broker for €{_priceEur:N2} — processed and assigned.";
                _lotNumber = 0;
                _priceEur = 0;
                _results = await Api.GetAuctionResultsAsync();
            }
            else
            {
                var content = await resp.Content.ReadAsStringAsync();
                _errorMessage = $"Failed to submit: {content}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
