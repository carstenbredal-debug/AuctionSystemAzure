@page "/admin/brokers"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Brokers - Admin</PageTitle>

<h1>Brokers</h1>
<p class="text-muted">Click on a broker to view details.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <p class="small text-muted mb-3">To add a new broker, go to <a href="admin/users">Users & Roles</a> and create a user with the Broker role.</p>

    <div class="card">
        <div class="card-header">
            <strong>Registered Brokers</strong> <span class="badge bg-secondary">@_items.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Number</th>
                        <th>Company Name</th>
                        <th>Contact</th>
                        <th>City</th>
                        <th>Email</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No brokers registered.</td></tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr style="cursor: pointer;" @onclick="() => ViewBroker(item.Id)">
                            <td><strong>@item.BrokerNumber</strong></td>
                            <td>@item.CompanyName</td>
                            <td>@item.ContactPerson</td>
                            <td>@item.City</td>
                            <td>@item.ContactEmail</td>
                            <td>
                                @if (item.IsActive)
                                { <span class="badge bg-success">Active</span> }
                                else
                                { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<BrokerDto> _items = new();
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        _items = await Api.GetBrokersAsync();
        _loading = false;
    }

    private void ViewBroker(int id) => Nav.NavigateTo($"admin/brokers/{id}");
}
