@page "/admin/brokers"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Brokers - Admin</PageTitle>

<h1>Brokers</h1>
<p class="text-muted">Manage broker companies and their contact information.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="ShowAddForm">Add Broker</button>
    </div>

    @if (_showForm)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <strong>@(_editing?.Id > 0 ? "Edit Broker" : "Add New Broker")</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Broker Number <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editing!.BrokerNumber" placeholder="B001" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Company Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editing!.CompanyName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Contact Person</label>
                        <input class="form-control" @bind="_editing!.ContactPerson" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input class="form-control" type="email" @bind="_editing!.ContactEmail" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone</label>
                        <input class="form-control" @bind="_editing!.ContactPhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Address</label>
                        <input class="form-control" @bind="_editing!.Address" />
                    </div>
                    <div class="col-12 mt-3">
                        <button class="btn btn-success me-2" @onclick="Save">@(_editing?.Id > 0 ? "Update" : "Create")</button>
                        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <strong>Registered Brokers</strong> <span class="badge bg-secondary">@_items.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Number</th>
                        <th>Company Name</th>
                        <th>Contact Person</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No brokers registered.</td></tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><strong>@item.BrokerNumber</strong></td>
                            <td>@item.CompanyName</td>
                            <td>@item.ContactPerson</td>
                            <td>@item.ContactEmail</td>
                            <td>@item.ContactPhone</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(item)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(item)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<BrokerDto> _items = new();
    private BrokerDto? _editing;
    private bool _loading = true;
    private bool _showForm;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        _items = await Api.GetBrokersAsync();
        _loading = false;
    }

    private void ShowAddForm() { _editing = new BrokerDto(); _showForm = true; _message = null; }
    private void Cancel() { _editing = null; _showForm = false; }

    private void Edit(BrokerDto item)
    {
        _editing = new BrokerDto
        {
            Id = item.Id, BrokerNumber = item.BrokerNumber, CompanyName = item.CompanyName,
            ContactPerson = item.ContactPerson, ContactEmail = item.ContactEmail,
            ContactPhone = item.ContactPhone, Address = item.Address
        };
        _showForm = true; _message = null;
    }

    private async Task Save()
    {
        if (_editing == null) return;
        if (string.IsNullOrWhiteSpace(_editing.BrokerNumber) || string.IsNullOrWhiteSpace(_editing.CompanyName))
        { _message = "Broker Number and Company Name are required."; _messageIsError = true; return; }

        if (_editing.Id > 0)
            await Api.UpdateBrokerAsync(_editing.Id, _editing);
        else
            await Api.CreateBrokerAsync(_editing);

        _message = $"Broker '{_editing.CompanyName}' saved."; _messageIsError = false;
        _showForm = false; _editing = null;
        _items = await Api.GetBrokersAsync();
    }

    private async Task Delete(BrokerDto item)
    {
        await Api.DeleteBrokerAsync(item.Id);
        _message = $"Broker '{item.CompanyName}' deleted."; _messageIsError = false;
        _items = await Api.GetBrokersAsync();
    }
}
