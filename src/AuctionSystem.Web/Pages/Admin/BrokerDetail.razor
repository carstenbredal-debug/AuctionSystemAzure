@page "/admin/brokers/{BrokerId:int}"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Broker Details - Admin</PageTitle>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_broker == null)
{
    <div class="alert alert-warning">Broker not found.</div>
    <a href="admin/brokers" class="btn btn-secondary">Back to Brokers</a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">@_broker.BrokerNumber — @_broker.CompanyName</h4>
        </div>
        <a href="admin/brokers" class="btn btn-outline-secondary btn-sm">Back to Brokers</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "info" ? "active" : "")" @onclick='() => _activeTab = "info"'>Information</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "customers" ? "active" : "")" @onclick='() => _activeTab = "customers"'>
                Customers <span class="badge bg-secondary ms-1">@_linkedBuyers.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "purchased" ? "active" : "")" @onclick='() => _activeTab = "purchased"'>
                Purchased Lots <span class="badge bg-secondary ms-1">@_allResults.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "sold" ? "active" : "")" @onclick='() => _activeTab = "sold"'>
                Sold Lots <span class="badge bg-secondary ms-1">@_soldLots.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "unsold" ? "active" : "")" @onclick='() => _activeTab = "unsold"'>
                Unsold Lots <span class="badge bg-secondary ms-1">@_unsoldLots.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "takeback" ? "active" : "")" @onclick='() => _activeTab = "takeback"'>
                Takeback <span class="badge bg-@(_takebackRequests.Count(t => t.Status == CustomerRequestStatus.Pending) > 0 ? "warning" : "secondary") ms-1">@_takebackRequests.Count</span>
            </button>
        </li>
    </ul>

    @if (_activeTab == "info")
    {
        <!-- General Section -->
        <div class="section-container mb-3">
            <div class="section-header">General</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editDto!.BrokerNumber" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editDto!.CompanyName" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Credit Limit</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editDto!.CreditLimit" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Blocked</label>
                        <select class="form-select" @bind="_editDto!.Blocked">
                            <option value="">— (None)</option>
                            <option value="Ship">Ship</option>
                            <option value="Invoice">Invoice</option>
                            <option value="All">All</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address & Contact Section -->
        <div class="section-container mb-3">
            <div class="section-header">Address & Contact</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input class="form-control" @bind="_editDto!.AddressLine1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address 2</label>
                        <input class="form-control" @bind="_editDto!.AddressLine2" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Country/Region Code</label>
                        <select class="form-select" @bind="_editDto!.Country">
                            <option value="">Select Country...</option>
                            @foreach (var c in _bcCountries)
                            {
                                <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Post Code</label>
                        <input class="form-control" @bind="_editDto!.PostalCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">City</label>
                        <input class="form-control" @bind="_editDto!.City" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Contact Name</label>
                        <input class="form-control" @bind="_editDto!.ContactPerson" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone No.</label>
                        <input class="form-control" @bind="_editDto!.ContactPhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mobile Phone No.</label>
                        <input class="form-control" @bind="_editDto!.MobilePhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">E-Mail</label>
                        <input class="form-control" type="email" @bind="_editDto!.ContactEmail" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Home Page</label>
                        <input class="form-control" @bind="_editDto!.HomePage" placeholder="https://" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoicing Section -->
        <div class="section-container mb-3">
            <div class="section-header">Invoicing</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">VAT Registration No.</label>
                        <input class="form-control" @bind="_editDto!.VatRegistrationNo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Registration No.</label>
                        <input class="form-control" @bind="_editDto!.RegistrationNo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Currency Code</label>
                        <select class="form-select" @bind="_editDto!.Currency">
                            <option value="">Select Currency...</option>
                            @foreach (var c in _bcCurrencies)
                            {
                                <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Gen. Bus. Posting Group</label>
                        <select class="form-select" @bind="_editDto!.GenBusPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcGenBusPostingGroups)
                            {
                                <option value="@g.Code">@g.Description (@g.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">VAT Bus. Posting Group</label>
                        <select class="form-select" @bind="_editDto!.VatBusPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcVatBusPostingGroups)
                            {
                                <option value="@g.Code">@g.Description (@g.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Vendor Posting Group</label>
                        <select class="form-select" @bind="_editDto!.CustomerPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcVendorPostingGroups)
                            {
                                <option value="@g.Code">@g.Code</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Section -->
        <div class="section-container mb-3">
            <div class="section-header">Payments</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Payment Terms Code</label>
                        <select class="form-select" @bind="_editDto!.PaymentTerm">
                            <option value="">Select...</option>
                            @foreach (var t in _bcPaymentTerms)
                            {
                                <option value="@t.Code">@t.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Payment Method Code</label>
                        <input class="form-control" @bind="_editDto!.PaymentMethod" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="_editDto!.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-2">
            <button class="btn btn-success me-2" @onclick="SaveEdit">Save</button>
        </div>
    }

    @if (_activeTab == "customers")
    {
        <div class="section-container">
            <div class="section-header">
            Customers
        </div>
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Number</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_linkedBuyers.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No customers linked to this broker.</td></tr>
                        }
                        @foreach (var buyer in _linkedBuyers)
                        {
                            <tr style="cursor: pointer;" @onclick="() => ViewBuyer(buyer.Id)">
                                <td><strong>@buyer.BuyerNumber</strong></td>
                                <td>@buyer.Name</td>
                                <td>@buyer.ContactEmail</td>
                                <td>@buyer.ContactPhone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "purchased")
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card text-center"><div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Purchase</h5>
                    <h2>€@_allResults.Sum(r => r.TotalSkins * r.PriceEur).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="section-body p-3">
                    <h5 class="card-title text-muted">Sold</h5>
                    <h2>€@_soldLots.Sum(r => r.TotalSkins * r.PriceEur).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="section-body p-3">
                    <h5 class="card-title text-muted">Unsold</h5>
                    <h2>€@_unsoldLots.Sum(r => r.TotalSkins * r.PriceEur).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Auction Fees</h5>
                    <h2>€@_allResults.Sum(r => CalcAuctionFee(r.TotalSkins, r.PriceEur)).ToString("N2")</h2>
                </div></div>
            </div>
        </div>
        <div class="section-container">
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th><th>Type</th><th>Gender</th><th>Color</th><th>Quality</th><th>Skins</th><th>Price (EUR)</th><th>Hammer Price</th><th>Auction Fee</th><th>Commission</th><th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_allResults.Count == 0)
                        { <tr><td colspan="11" class="text-center text-muted py-4">No lots.</td></tr> }
                        @foreach (var r in _allResults)
                        {
                            <tr>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@(r.SalesType ?? "—")</td><td>@(r.Gender ?? "—")</td><td>@(r.Color ?? "—")</td><td>@(r.Quality ?? "—")</td>
                                <td>@r.TotalSkins</td><td>€@r.PriceEur.ToString("N2")</td><td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td><td>€@CalcAuctionFee(r.TotalSkins, r.PriceEur).ToString("N2")</td><td>€@((r.CommissionAmount ?? 0).ToString("N2"))</td>
                                <td><span class="badge bg-@(r.SoldToBuyerId != null ? "success" : "secondary")">@(r.SoldToBuyerId != null ? "Sold" : "Unsold")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "sold")
    {
        @if (!string.IsNullOrEmpty(_takebackMessage))
        {
            <div class="alert @(_takebackMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
                @_takebackMessage
                <button type="button" class="btn-close" @onclick="() => _takebackMessage = null"></button>
            </div>
        }
        @if (_soldLots.Count > 0)
        {
            <div class="section-container mb-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <strong>Takeback selected lots:</strong>
                    <button class="btn btn-warning" @onclick="RequestTakeback" disabled="@(_requestingTakeback || _selectedSoldIds.Count == 0)">
                        @if (_requestingTakeback) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Takeback (@_selectedSoldIds.Count)
                    </button>
                </div>
            </div>
        }
        <div class="section-container">
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:40px;"><input type="checkbox" @onchange="ToggleAllSold" checked="@_allSoldSelected" /></th>
                            <th>Lot #</th><th>Type</th><th>Gender</th><th>Color</th><th>Quality</th><th>Skins</th><th>Price (EUR)</th><th>Hammer Price</th><th>Auction Fee</th><th>Commission</th><th>Sold To</th><th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_soldLots.Count == 0)
                        { <tr><td colspan="13" class="text-center text-muted py-4">No sold lots.</td></tr> }
                        @foreach (var r in _soldLots)
                        {
                            <tr>
                                <td><input type="checkbox" checked="@_selectedSoldIds.Contains(r.Id)" @onchange="() => ToggleSoldSelection(r.Id)" /></td>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@(r.SalesType ?? "—")</td><td>@(r.Gender ?? "—")</td><td>@(r.Color ?? "—")</td><td>@(r.Quality ?? "—")</td>
                                <td>@r.TotalSkins</td><td>€@r.PriceEur.ToString("N2")</td><td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td><td>€@CalcAuctionFee(r.TotalSkins, r.PriceEur).ToString("N2")</td><td>€@((r.CommissionAmount ?? 0).ToString("N2"))</td>
                                <td>@(r.SoldToBuyerNumber ?? "") — @(r.SoldToBuyerName ?? "")</td>
                                <td>@(r.SoldAt?.ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "unsold")
    {
        @if (!string.IsNullOrEmpty(_unsoldMessage))
        {
            <div class="alert @(_unsoldMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
                @_unsoldMessage
                <button type="button" class="btn-close" @onclick="() => _unsoldMessage = null"></button>
            </div>
        }
        @if (_selectedUnsoldIds.Count > 0)
        {
            <div class="mb-3 d-flex gap-2">
                <button class="btn btn-warning" @onclick="MoveToInternalBroker" disabled="@_reassigning">
                    @if (_reassigning) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Move to Internal Broker (999)
                </button>
                <button class="btn btn-outline-secondary" @onclick="ReturnToAuction" disabled="@_reassigning">
                    @if (_reassigning) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Return to Auction
                </button>
                <span class="align-self-center text-muted">@_selectedUnsoldIds.Count lot(s) selected</span>
            </div>
        }
        <div class="section-container">
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:40px;"><input type="checkbox" checked="@_allUnsoldSelected" @onchange="ToggleAllUnsold" /></th>
                            <th>Lot #</th><th>Type</th><th>Gender</th><th>Color</th><th>Quality</th><th>Skins</th><th>Price (EUR)</th><th>Hammer Price</th><th>Auction Fee</th><th>Commission</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_unsoldLots.Count == 0)
                        { <tr><td colspan="11" class="text-center text-muted py-4">No unsold lots.</td></tr> }
                        @foreach (var r in _unsoldLots)
                        {
                            <tr>
                                <td><input type="checkbox" checked="@_selectedUnsoldIds.Contains(r.Id)" @onchange="() => ToggleUnsoldSelection(r.Id)" /></td>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@(r.SalesType ?? "—")</td><td>@(r.Gender ?? "—")</td><td>@(r.Color ?? "—")</td><td>@(r.Quality ?? "—")</td>
                                <td>@r.TotalSkins</td><td>€@r.PriceEur.ToString("N2")</td><td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td><td>€@CalcAuctionFee(r.TotalSkins, r.PriceEur).ToString("N2")</td><td>€@((r.CommissionAmount ?? 0).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "takeback")
    {
        @if (!string.IsNullOrEmpty(_brokerTakebackMessage))
        {
            <div class="alert @(_brokerTakebackMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
                @_brokerTakebackMessage
                <button type="button" class="btn-close" @onclick="() => _brokerTakebackMessage = null"></button>
            </div>
        }
        <div class="section-container">
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th><th>Type</th><th>Gender</th><th>Color</th><th>Skins</th><th>Price (EUR)</th><th>Hammer Price</th><th>Sold To</th><th>Initiated By</th><th>Requested</th><th>Status</th><th style="width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_takebackRequests.Count == 0)
                        { <tr><td colspan="12" class="text-center text-muted py-4">No takeback requests.</td></tr> }
                        @foreach (var t in _takebackRequests)
                        {
                            <tr>
                                <td><strong>@t.LotNumber</strong></td>
                                <td>@(t.SalesType ?? "—")</td><td>@(t.Gender ?? "—")</td><td>@(t.Color ?? "—")</td>
                                <td>@t.TotalSkins</td><td>€@t.PriceEur.ToString("N2")</td><td>€@((t.TotalSkins * t.PriceEur).ToString("N2"))</td>
                                <td>@(t.BuyerNumber ?? "") — @(t.BuyerName ?? "")</td>
                                <td><span class="badge bg-info">@t.InitiatedBy</span></td>
                                <td>@t.RequestedAt.ToString("g")</td>
                                <td><span class="badge bg-@(t.Status == CustomerRequestStatus.Pending ? "warning" : t.Status == CustomerRequestStatus.Approved ? "success" : "danger")">@t.Status</span></td>
                                <td>
                                    @if (t.Status == CustomerRequestStatus.Pending)
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => RespondTakeback(t.Id, true)">Approve</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RespondTakeback(t.Id, false)">Decline</button>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@(t.RespondedAt?.ToString("g") ?? "")</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int BrokerId { get; set; }

    private BrokerDto? _broker;
    private List<BrokerCustomerRequestDto> _customerRequests = new();
    private List<BuyerDto> _linkedBuyers = new();
    private List<AuctionResultDto> _allResults = new();
    private List<AuctionResultDto> _soldLots => _allResults.Where(r => r.SoldToBuyerId != null).ToList();
    private List<AuctionResultDto> _unsoldLots => _allResults.Where(r => r.SoldToBuyerId == null).ToList();
    private List<TakebackRequestDto> _takebackRequests = new();
    private decimal _auctionFeePercent;
    private decimal _handlingFeePerSkin;
    private HashSet<int> _selectedSoldIds = new();
    private bool _allSoldSelected => _soldLots.Count > 0 && _soldLots.All(r => _selectedSoldIds.Contains(r.Id));
    private bool _requestingTakeback;
    private string? _takebackMessage;
    private bool _takebackMessageIsError;
    private string? _brokerTakebackMessage;
    private bool _brokerTakebackMessageIsError;
    private HashSet<int> _selectedUnsoldIds = new();
    private bool _allUnsoldSelected => _unsoldLots.Count > 0 && _unsoldLots.All(r => _selectedUnsoldIds.Contains(r.Id));
    private bool _reassigning;
    private string? _unsoldMessage;
    private bool _unsoldMessageIsError;
    private bool _loading = true;
    private BrokerDto? _editDto;
    private string? _message;
    private bool _messageIsError;
    private string _activeTab = "info";
    private List<BcCountryRegionDto> _bcCountries = new();
    private List<BcCurrencyDto> _bcCurrencies = new();
    private List<BcPostingGroupDto> _bcGenBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcVatBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcVendorPostingGroups = new();
    private List<BcPaymentTermDto> _bcPaymentTerms = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        var allBrokers = await Api.GetBrokersAsync();
        _broker = allBrokers.FirstOrDefault(b => b.Id == BrokerId);
        if (_broker != null)
        {
            _customerRequests = await Api.GetCustomerRequestsByBrokerAsync(BrokerId);
            _linkedBuyers = await Api.GetBuyersByBrokerAsync(BrokerId);
            _allResults = await Api.GetAuctionResultsByBrokerAsync(BrokerId);
            _takebackRequests = await Api.GetTakebackRequestsByBrokerAsync(BrokerId);
            await LoadFeeParameters();
            InitEditDto();
        }
        _bcCountries = await Api.GetBcCountriesAsync();
        _bcCurrencies = await Api.GetBcCurrenciesAsync();
        _bcGenBusPostingGroups = await Api.GetBcGenBusPostingGroupsAsync();
        _bcVatBusPostingGroups = await Api.GetBcVatBusPostingGroupsAsync();
        _bcVendorPostingGroups = await Api.GetBcVendorPostingGroupsAsync();
        _bcPaymentTerms = await Api.GetBcPaymentTermsAsync();
    }

    private async Task LoadFeeParameters()
    {
        var parameters = await Api.GetParametersAsync();
        var auctionFee = parameters.FirstOrDefault(p => p.Key == "AuctionFee");
        var handlingFee = parameters.FirstOrDefault(p => p.Key == "HandlingFee");
        if (auctionFee != null) decimal.TryParse(auctionFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _auctionFeePercent);
        if (handlingFee != null) decimal.TryParse(handlingFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _handlingFeePerSkin);
    }

    private decimal CalcAuctionFee(int skins, decimal priceEur)
    {
        var hammerPrice = skins * priceEur;
        var handlingFee = skins * _handlingFeePerSkin;
        return (hammerPrice + handlingFee) * _auctionFeePercent / 100m;
    }

    private void ToggleSoldSelection(int id)
    {
        if (!_selectedSoldIds.Remove(id)) _selectedSoldIds.Add(id);
    }

    private void ToggleAllSold(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedSoldIds = _soldLots.Select(r => r.Id).ToHashSet();
        else
            _selectedSoldIds.Clear();
    }

    private async Task RequestTakeback()
    {
        _takebackMessage = null;
        if (_selectedSoldIds.Count == 0) return;
        _requestingTakeback = true;
        try
        {
            var resp = await Api.RequestTakebackAsync(_selectedSoldIds.ToList());
            if (resp.IsSuccessStatusCode)
            {
                _takebackMessage = $"{_selectedSoldIds.Count} lot(s) taken back. Lots moved to unsold.";
                _takebackMessageIsError = false;
                _selectedSoldIds.Clear();
                await LoadData();
            }
            else
            {
                try
                {
                    var errorJson = await resp.Content.ReadFromJsonAsync<TakebackErrorResponse>();
                    if (errorJson?.Error == "Lot Sold")
                    {
                        _takebackMessage = $"Lot Sold — {errorJson.Message}";
                    }
                    else
                    {
                        _takebackMessage = "Failed to request takeback. Please try again.";
                    }
                }
                catch
                {
                    _takebackMessage = "Failed to request takeback. Please try again.";
                }
                _takebackMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _takebackMessage = $"Error: {ex.Message}";
            _takebackMessageIsError = true;
        }
        finally { _requestingTakeback = false; }
    }

    private class TakebackErrorResponse
    {
        public string? Error { get; set; }
        public string? Message { get; set; }
    }

    private async Task RespondTakeback(int requestId, bool approve)
