@page "/admin/showlot"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<h4 class="mb-4">Showlot — Boxes to Pack</h4>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_shipments.Count == 0)
{
    <div class="alert alert-info">No shipments with ShowLot Packing status.</div>
}
else
{
    @foreach (var shipment in _shipments)
    {
        <div class="section-container mb-4">
            <div class="section-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@shipment.ShipmentNumber</strong>
                    <span class="text-muted ms-3">@shipment.BuyerName (@shipment.BuyerNumber)</span>
                    <span class="text-muted ms-3">Shipper: @shipment.ShipperName</span>
                    <span class="badge bg-info text-dark ms-3">@shipment.ShowLotBoxCount showlot boxes</span>
                </div>
                <small class="text-muted">@shipment.CreatedAt.ToString("yyyy-MM-dd")</small>
            </div>
            <div class="section-body">
                @if (shipment.ShowLotBoxes.Count == 0)
                {
                    <p class="text-muted mb-0">No showlot boxes found.</p>
                }
                else
                {
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Box #</th>
                                <th>Lot #</th>
                                <th>Skins</th>
                                <th>Weight (kg)</th>
                                <th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var box in shipment.ShowLotBoxes)
                            {
                                <tr>
                                    <td>@box.BoxNumber</td>
                                    <td>@box.LotNumber</td>
                                    <td>@box.Skins</td>
                                    <td>@(box.Weight.HasValue ? box.Weight.Value.ToString("N2") : "—")</td>
                                    <td>@(string.IsNullOrEmpty(box.Location) ? "—" : box.Location)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>Total</td>
                                <td>@shipment.ShowLotBoxes.Select(b => b.LotNumber).Distinct().Count() lots</td>
                                <td>@shipment.ShowLotBoxes.Sum(b => b.Skins)</td>
                                <td>@shipment.ShowLotBoxes.Where(b => b.Weight.HasValue).Sum(b => b.Weight!.Value).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        </div>
    }
}

@code {
    private List<ShowLotShipmentDto> _shipments = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _shipments = await Api.GetShowLotShipmentsAsync();
        _loading = false;
    }
}
