@page "/admin/showlot"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<h4 class="mb-4">Showlot — Packing Orders</h4>

<div class="row mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label fw-bold">Filter by Status</label>
        <select class="form-select" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Ready to Pack">Ready to Pack</option>
            <option value="In Production">In Production</option>
            <option value="Packed">Packed</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_orders.Count == 0)
{
    <div class="alert alert-info">No packing orders found.</div>
}
else
{
    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Packing Order #</th>
                        <th>Shipment #</th>
                        <th>Buyer</th>
                        <th>Status</th>
                        <th>Showlots</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in _orders)
                    {
                        <tr>
                            <td>
                                <a href="javascript:void(0)" @onclick="() => ToggleExpand(po.Id)">
                                    <strong>@po.PackingOrderNumber</strong>
                                </a>
                            </td>
                            <td>@po.ShipmentNumber</td>
                            <td>@po.BuyerName (@po.BuyerNumber)</td>
                            <td><span class="badge @GetStatusBadgeClass(po.Status)">@po.Status</span></td>
                            <td>@po.ShowLotCount</td>
                            <td>@po.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (IsLocked(po))
                                {
                                    <span class="text-muted small">Ready for courier — scanner only</span>
                                }
                                else if (po.Status == "Ready to Pack")
                                {
                                    <button class="btn btn-sm btn-primary" @onclick='() => UpdateStatus(po, "In Production")'
                                            title="Makes this order visible to the scanner — completes automatically when all showlots are packed">
                                        Start Packing
                                    </button>
                                }
                                else if (po.Status == "In Production")
                                {
                                    <span class="text-muted small">Packing via scanner — completes when all showlots are packed to @(po.OutLocation ?? "the OUT location")</span>
                                }
                            </td>
                        </tr>
                        @if (_expandedId == po.Id)
                        {
                            <tr>
                                <td colspan="7" class="p-0">
                                    <div class="bg-light p-3">
                                        @{
                                            var unpackedLines = po.Lines.Where(l => l.PackedBoxId == null).ToList();
                                            var packedLines = po.Lines.Where(l => l.PackedBoxId != null).ToList();
                                        }
                                        <h6 class="mb-2">Showlot Boxes to Pack (@unpackedLines.Count unpacked)</h6>
                                        @if (unpackedLines.Count > 0)
                                        {
                                            <table class="table table-sm table-bordered mb-2">
                                                <thead>
                                                    <tr>
                                                        <th>Box #</th>
                                                        <th>Lot #</th>
                                                        <th>Skins</th>
                                                        <th>Box Type</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var line in unpackedLines)
                                                    {
                                                        <tr>
                                                            <td>@line.BoxNumber</td>
                                                            <td>@line.LotNumber</td>
                                                            <td>@line.Skins</td>
                                                            <td>@line.BoxType</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="fw-bold">
                                                        <td>Total</td>
                                                        <td>@unpackedLines.Select(l => l.LotNumber).Distinct().Count() lots</td>
                                                        <td>@unpackedLines.Sum(l => l.Skins)</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                        @if (packedLines.Count > 0)
                                        {
                                            <h6 class="mt-3 mb-2 text-success">Packed Boxes (@packedLines.Count showlots packed)</h6>
                                            @if (_packedBoxes.ContainsKey(po.Id) && _packedBoxes[po.Id].Count > 0)
                                            {
                                                @foreach (var box in _packedBoxes[po.Id])
                                                {
                                                    <div class="card mb-2">
                                                        <div class="card-body p-2">
                                                            <strong>@box.BoxType</strong> — @box.Weight kg — @box.ShowLotCount showlots, @box.TotalSkins skins
                                                            <span class="badge @(box.Status == "Approved" ? "bg-success" : "bg-warning text-dark") ms-2">@box.Status</span>
                                                            @if (box.Status == "Packed" && !IsLocked(po))
                                                            {
                                                                <button class="btn btn-sm btn-success ms-2" @onclick="() => ApproveBox(box)">Approve</button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<PackingOrderDto> _orders = new();
    private bool _loading = true;
    private int? _expandedId;
    private string _statusFilter = "";
    private const string _statusInProduction = "In Production";
    private const string _statusPacked = "Packed";

    private string? _packError;
    private Dictionary<int, List<PackedBoxDto>> _packedBoxes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _loading = true;
        _orders = await Api.GetPackingOrdersAsync(status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter, type: "ShowLot");
        // Load packed boxes for expanded orders
        foreach (var po in _orders.Where(o => o.Lines.Any(l => l.PackedBoxId != null)))
        {
            try { _packedBoxes[po.Id] = await Api.GetPackedBoxesAsync(po.Id); }
            catch { _packedBoxes[po.Id] = new(); }
        }
        _loading = false;
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "";
        await LoadOrders();
    }

    private async Task ToggleExpand(int id)
    {
        if (_expandedId == id) { _expandedId = null; return; }
        _expandedId = id;
        if (!_packedBoxes.ContainsKey(id))
        {
            try { _packedBoxes[id] = await Api.GetPackedBoxesAsync(id); }
            catch { _packedBoxes[id] = new(); }
        }
    }

    // From Ready for courier on, the shipment is scanner-only — no edits here.
    private static bool IsLocked(PackingOrderDto po) =>
        po.ShipmentStatus is "Ready for courier" or "Shipped" or "Delivered" or "Cancelled";

    private async Task UpdateStatus(PackingOrderDto po, string newStatus)
    {
        var success = await Api.UpdatePackingOrderStatusAsync(po.Id, newStatus);
        if (success)
        {
            po.Status = newStatus;
            StateHasChanged();
        }
    }

    private async Task ApproveBox(PackedBoxDto box)
    {
        if (!await Api.ApprovePackedBoxAsync(box.Id))
        { _packError = $"Approve failed: {Api.LastError}"; return; }
        // Refresh packed boxes for this order
        var po = _orders.FirstOrDefault(o => _packedBoxes.ContainsKey(o.Id) && _packedBoxes[o.Id].Any(b => b.Id == box.Id));
        if (po != null)
        {
            _packedBoxes[po.Id] = await Api.GetPackedBoxesAsync(po.Id);
        }
        await LoadOrders();
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Ready to Pack" => "bg-warning text-dark",
        "In Production" => "text-danger",
        "Packed" => "bg-success",
        _ => "bg-secondary"
    };
}
