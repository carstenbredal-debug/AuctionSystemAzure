@page "/admin/sales-order-setup"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Sales Order Setup - Admin</PageTitle>

<h1>Sales Order Setup</h1>
<p class="text-muted">Configure lot grouping, sizing rules, and sort orders for sales order generation.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "grouporder" ? "active" : "")" @onclick='() => _activeTab = "grouporder"'>Lot Group Order</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "sizerules" ? "active" : "")" @onclick='() => _activeTab = "sizerules"'>Lot Size Rules</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "sortorder" ? "active" : "")" @onclick='() => _activeTab = "sortorder"'>Lot Sort Order</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "catalognumber" ? "active" : "")" @onclick='() => _activeTab = "catalognumber"'>Catalog Number Rules</button>
        </li>
    </ul>

    @if (_activeTab == "grouporder")
    {
        @* ── Lot Group Order ── *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Lot Group Order</strong>
                <button class="btn btn-sm btn-primary" @onclick="ShowAddGroupOrder">Add Group</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Order</th>
                            <th>Column Name</th>
                            <th style="width:150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_groupOrders.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">No groups configured.</td></tr>
                        }
                        @foreach (var item in _groupOrders)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.GroupOrder</span></td>
                                <td><strong>@item.ColumnName</strong></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditGroupOrder(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGroupOrder(item)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


    }
    else if (_activeTab == "sizerules")
    {
        @* ── Lot Size Rules ── *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Lot Size Rules</strong>
                <button class="btn btn-sm btn-primary" @onclick="ShowAddSizeRule">Add Rule</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Gender</th>
                            <th>Size</th>
                            <th>Max Boxes</th>
                            <th>Max Skins/Box</th>
                            <th>Showlot Skins</th>
                            <th>Max Lot (excl)</th>
                            <th>Max Lot (incl)</th>
                            <th>Priority</th>
                            <th>Active</th>
                            <th style="width:150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_sizeRules.Count == 0)
                        {
                            <tr><td colspan="10" class="text-center text-muted py-4">No size rules configured.</td></tr>
                        }
                        @foreach (var item in _sizeRules)
                        {
                            <tr>
                                <td>@(item.Gender ?? "—")</td>
                                <td>@(item.Size ?? "—")</td>
                                <td>@item.MaxBoxes</td>
                                <td>@item.MaxSkinsPerBox</td>
                                <td>@item.ShowlotSkins</td>
                                <td>@item.MaxLotSizeExclShowlot</td>
                                <td>@item.MaxLotSizeInclShowlot</td>
                                <td>@item.Priority</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditSizeRule(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSizeRule(item)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


    }
    else if (_activeTab == "sortorder")
    {
        @* ── Lot Sort Order (sub-tabs per group) ── *@
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-sm btn-primary" @onclick="ShowAddSortOrder">Add Sort Value</button>
        </div>

        @if (_sortGroups.Count == 0)
        {
            <div class="text-center text-muted py-4">No sort orders configured.</div>
        }
        else
        {
            <ul class="nav nav-pills mb-3">
                @foreach (var group in _sortGroups)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeSortGroup == group ? "active" : "")" @onclick="() => _activeSortGroup = group">@group</button>
                    </li>
                }
            </ul>

            @if (_activeSortGroup != null)
            {
                var groupItems = _sortOrders.Where(s => s.ColumnName == _activeSortGroup).OrderBy(s => s.SortOrder).ToList();
                <div class="card mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <strong>@_activeSortGroup</strong>
                        <span class="badge bg-dark">@groupItems.Count values</span>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Value</th>
                                    <th style="width:150px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (groupItems.Count == 0)
                                {
                                    <tr><td colspan="3" class="text-center text-muted py-4">No values in this group.</td></tr>
                                }
                                @foreach (var item in groupItems)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@item.SortOrder</span></td>
                                        <td>@item.Value</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditSortOrder(item)">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSortOrder(item)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
    else if (_activeTab == "catalognumber")
    {
        @* ── Catalog Number Rules ── *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Catalog Number Rules</strong>
                <button class="btn btn-sm btn-primary" @onclick="ShowAddCatalogRule">Add Rule</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Sales Type</th>
                            <th>Gender</th>
                            <th>Group</th>
                            <th>Start Number</th>
                            <th>Active</th>
                            <th style="width:150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_catalogRules.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No catalog number rules configured.</td></tr>
                        }
                        @foreach (var item in _catalogRules)
                        {
                            <tr>
                                <td>@(item.SalesType ?? "—")</td>
                                <td>@(item.Gender ?? "—")</td>
                                <td>@(item.Group ?? "—")</td>
                                <td>@item.StartNumber</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditCatalogRule(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCatalogRule(item)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


    }
}

@* ── Modal Popups ── *@

@if (_showGroupForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(_editingGroupOrder != null ? "Edit Group" : "Add Group")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showGroupForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Column Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_newGroupName" @bind:event="oninput" placeholder="e.g. Gender" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Order</label>
                        <input type="number" class="form-control" @bind="_newGroupOrder" @bind:event="oninput" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showGroupForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveGroupOrder">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showSizeForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(_editingSizeRule?.RuleID > 0 ? "Edit Rule" : "Add Rule")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showSizeForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <input class="form-control" @bind="_editingSizeRule!.Gender" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Size</label>
                            <input class="form-control" @bind="_editingSizeRule!.Size" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max Boxes</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxBoxes" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max Skins/Box</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxSkinsPerBox" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Showlot Skins</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.ShowlotSkins" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max Lot Size (excl showlot)</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxLotSizeExclShowlot" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max Lot Size (incl showlot)</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxLotSizeInclShowlot" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Priority</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.Priority" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_editingSizeRule!.IsActive" id="sizeRuleActive" />
                                <label class="form-check-label" for="sizeRuleActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showSizeForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveSizeRule">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showSortForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(_editingSortOrder != null ? "Edit Sort Value" : "Add Sort Value")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showSortForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Group (Column Name) <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_newSortColumnName" @bind:event="oninput" placeholder="e.g. Gender" list="sortGroupSuggestions" />
                        <datalist id="sortGroupSuggestions">
                            @foreach (var g in _sortGroups)
                            {
                                <option value="@g" />
                            }
                        </datalist>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Value <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_newSortValue" @bind:event="oninput" placeholder="e.g. Male" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sort Order</label>
                        <input type="number" class="form-control" @bind="_newSortOrder" @bind:event="oninput" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showSortForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveSortOrder">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showCatalogForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(_editingCatalogRule?.CatalogNumberRuleID > 0 ? "Edit Rule" : "Add Rule")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showCatalogForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Sales Type</label>
                            <input class="form-control" @bind="_editingCatalogRule!.SalesType" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <input class="form-control" @bind="_editingCatalogRule!.Gender" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Group</label>
                            <input class="form-control" @bind="_editingCatalogRule!.Group" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Start Number</label>
                            <input type="number" class="form-control" @bind="_editingCatalogRule!.StartNumber" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_editingCatalogRule!.IsActive" id="catalogRuleActive" />
                                <label class="form-check-label" for="catalogRuleActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showCatalogForm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveCatalogRule">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private string _activeTab = "grouporder";

    // Lot Group Order
    private List<LotGroupOrderDto> _groupOrders = new();
    private bool _showGroupForm;
    private string _newGroupName = "";
    private int _newGroupOrder;
    private LotGroupOrderDto? _editingGroupOrder;

    // Lot Size Rules
    private List<LotSizeRuleDto> _sizeRules = new();
    private bool _showSizeForm;
    private LotSizeRuleDto? _editingSizeRule;

    // Lot Sort Order
    private List<LotSortOrderDto> _sortOrders = new();
    private List<string> _sortGroups = new();
    private string? _activeSortGroup;
    private bool _showSortForm;
    private string _newSortColumnName = "";
    private string _newSortValue = "";
    private int _newSortOrder;
    private LotSortOrderDto? _editingSortOrder;

    // Catalog Number Rules
    private List<CatalogNumberRuleDto> _catalogRules = new();
    private bool _showCatalogForm;
    private CatalogNumberRuleDto? _editingCatalogRule;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        _loading = false;
    }

    private async Task LoadAll()
    {
        _groupOrders = await Api.GetLotGroupOrdersAsync();
        _sizeRules = await Api.GetLotSizeRulesAsync();
        _sortOrders = await Api.GetLotSortOrdersAsync();
        _sortGroups = _sortOrders.Select(s => s.ColumnName).Distinct().OrderBy(s => s).ToList();
        if (_activeSortGroup == null || !_sortGroups.Contains(_activeSortGroup))
            _activeSortGroup = _sortGroups.FirstOrDefault();
        _catalogRules = await Api.GetCatalogNumberRulesAsync();
    }

    // ── Lot Group Order ──

    private void ShowAddGroupOrder()
    {
        _editingGroupOrder = null;
        _newGroupName = "";
        _newGroupOrder = _groupOrders.Count > 0 ? _groupOrders.Max(g => g.GroupOrder) + 1 : 1;
        _showGroupForm = true;
    }

    private void EditGroupOrder(LotGroupOrderDto item)
    {
        _editingGroupOrder = item;
        _newGroupName = item.ColumnName;
        _newGroupOrder = item.GroupOrder;
        _showGroupForm = true;
    }

    private async Task SaveGroupOrder()
    {
        _message = ""; _messageIsError = false;
        if (string.IsNullOrWhiteSpace(_newGroupName)) return;

        if (_editingGroupOrder != null)
        {
            var dto = new LotGroupOrderDto { ColumnName = _newGroupName.Trim(), GroupOrder = _newGroupOrder };
            var (data, error) = await Api.UpdateLotGroupOrderAsync(dto, _editingGroupOrder.ColumnName);
            _message = data != null ? "Group updated." : $"Failed to update group: {error}";
            _messageIsError = data == null;
        }
        else
        {
            var (data, error) = await Api.CreateLotGroupOrderAsync(new LotGroupOrderDto { ColumnName = _newGroupName.Trim(), GroupOrder = _newGroupOrder });
            if (data != null)
            {
                _message = $"Group '{_newGroupName}' added.";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to add group: {error}";
                _messageIsError = true;
            }
        }

        _showGroupForm = false;
        _editingGroupOrder = null;
        _groupOrders = await Api.GetLotGroupOrdersAsync();
    }

    private async Task DeleteGroupOrder(LotGroupOrderDto item)
    {
        var (success, error) = await Api.DeleteLotGroupOrderAsync(item);
        _message = success ? $"Group '{item.ColumnName}' deleted." : $"Failed to delete group: {error}";
        _messageIsError = !success;
        _groupOrders = await Api.GetLotGroupOrdersAsync();
    }

    // ── Lot Size Rules ──

    private void ShowAddSizeRule()
    {
        _editingSizeRule = new LotSizeRuleDto { IsActive = true };
        _showSizeForm = true;
    }

    private void EditSizeRule(LotSizeRuleDto item)
    {
        _editingSizeRule = new LotSizeRuleDto
        {
            RuleID = item.RuleID,
            Gender = item.Gender,
            Size = item.Size,
            MaxBoxes = item.MaxBoxes,
            MaxSkinsPerBox = item.MaxSkinsPerBox,
            ShowlotSkins = item.ShowlotSkins,
            MaxLotSizeExclShowlot = item.MaxLotSizeExclShowlot,
            MaxLotSizeInclShowlot = item.MaxLotSizeInclShowlot,
            Priority = item.Priority,
            IsActive = item.IsActive
        };
        _showSizeForm = true;
    }

    private async Task SaveSizeRule()
    {
        _message = ""; _messageIsError = false;
        if (_editingSizeRule == null) return;

        if (_editingSizeRule.RuleID > 0)
        {
            var (data, error) = await Api.UpdateLotSizeRuleAsync(_editingSizeRule);
            _message = data != null ? "Rule updated." : $"Failed to update rule: {error}";
            _messageIsError = data == null;
        }
        else
        {
            var (data, error) = await Api.CreateLotSizeRuleAsync(_editingSizeRule);
            _message = data != null ? "Rule added." : $"Failed to add rule: {error}";
            _messageIsError = data == null;
        }

        _showSizeForm = false;
        _sizeRules = await Api.GetLotSizeRulesAsync();
    }

    private async Task DeleteSizeRule(LotSizeRuleDto item)
    {
        var (success, error) = await Api.DeleteLotSizeRuleAsync(item);
        _message = success ? "Rule deleted." : $"Failed to delete rule: {error}";
        _messageIsError = !success;
        _sizeRules = await Api.GetLotSizeRulesAsync();
    }

    // ── Lot Sort Order ──

    private void ShowAddSortOrder()
    {
        _editingSortOrder = null;
        _newSortColumnName = "";
        _newSortValue = "";
        _newSortOrder = 0;
        _showSortForm = true;
    }

    private void EditSortOrder(LotSortOrderDto item)
    {
        _editingSortOrder = item;
        _newSortColumnName = item.ColumnName;
        _newSortValue = item.Value;
        _newSortOrder = item.SortOrder;
        _showSortForm = true;
    }

    private async Task SaveSortOrder()
    {
        _message = ""; _messageIsError = false;
        if (string.IsNullOrWhiteSpace(_newSortColumnName) || string.IsNullOrWhiteSpace(_newSortValue)) return;

        if (_editingSortOrder != null)
        {
            var dto = new LotSortOrderDto
            {
                ColumnName = _newSortColumnName.Trim(),
                Value = _newSortValue.Trim(),
                SortOrder = _newSortOrder
            };
            var (data, error) = await Api.UpdateLotSortOrderAsync(dto, _editingSortOrder.ColumnName, _editingSortOrder.Value);
            _message = data != null ? "Sort order updated." : $"Failed to update sort order: {error}";
            _messageIsError = data == null;
        }
        else
        {
            var groupItems = _sortOrders.Where(s => s.ColumnName == _newSortColumnName.Trim()).ToList();
            if (_newSortOrder == 0)
                _newSortOrder = groupItems.Count > 0 ? groupItems.Max(s => s.SortOrder) + 1 : 1;

            var (data, error) = await Api.CreateLotSortOrderAsync(new LotSortOrderDto
            {
                ColumnName = _newSortColumnName.Trim(),
                Value = _newSortValue.Trim(),
                SortOrder = _newSortOrder
            });

            if (data != null)
            {
                _message = $"Value '{_newSortValue}' added to '{_newSortColumnName}'.";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to add: {error}";
                _messageIsError = true;
            }
        }

        _showSortForm = false;
        _editingSortOrder = null;
        _sortOrders = await Api.GetLotSortOrdersAsync();
        _sortGroups = _sortOrders.Select(s => s.ColumnName).Distinct().OrderBy(s => s).ToList();
        if (_activeSortGroup == null || !_sortGroups.Contains(_activeSortGroup))
            _activeSortGroup = _sortGroups.FirstOrDefault();
    }

    private async Task DeleteSortOrder(LotSortOrderDto item)
    {
        var (success, error) = await Api.DeleteLotSortOrderAsync(item);
        _message = success ? $"Value '{item.Value}' removed from '{item.ColumnName}'." : $"Failed to delete: {error}";
        _messageIsError = !success;
        _sortOrders = await Api.GetLotSortOrdersAsync();
        _sortGroups = _sortOrders.Select(s => s.ColumnName).Distinct().OrderBy(s => s).ToList();
        if (_activeSortGroup == null || !_sortGroups.Contains(_activeSortGroup))
            _activeSortGroup = _sortGroups.FirstOrDefault();
    }

    // ── Catalog Number Rules ──

    private void ShowAddCatalogRule()
    {
        _editingCatalogRule = new CatalogNumberRuleDto { IsActive = true };
        _showCatalogForm = true;
    }

    private void EditCatalogRule(CatalogNumberRuleDto item)
    {
        _editingCatalogRule = new CatalogNumberRuleDto
        {
            CatalogNumberRuleID = item.CatalogNumberRuleID,
            SalesType = item.SalesType,
            Gender = item.Gender,
            Group = item.Group,
            StartNumber = item.StartNumber,
            IsActive = item.IsActive
        };
        _showCatalogForm = true;
    }

    private async Task SaveCatalogRule()
    {
        _message = ""; _messageIsError = false;
        if (_editingCatalogRule == null) return;

        if (_editingCatalogRule.CatalogNumberRuleID > 0)
        {
            var (data, error) = await Api.UpdateCatalogNumberRuleAsync(_editingCatalogRule);
            _message = data != null ? "Rule updated." : $"Failed to update rule: {error}";
            _messageIsError = data == null;
        }
        else
        {
            var (data, error) = await Api.CreateCatalogNumberRuleAsync(_editingCatalogRule);
            _message = data != null ? "Rule added." : $"Failed to add rule: {error}";
            _messageIsError = data == null;
        }

        _showCatalogForm = false;
        _catalogRules = await Api.GetCatalogNumberRulesAsync();
    }

    private async Task DeleteCatalogRule(CatalogNumberRuleDto item)
    {
        var (success, error) = await Api.DeleteCatalogNumberRuleAsync(item);
        _message = success ? "Rule deleted." : $"Failed to delete rule: {error}";
        _messageIsError = !success;
        _catalogRules = await Api.GetCatalogNumberRulesAsync();
    }
}
