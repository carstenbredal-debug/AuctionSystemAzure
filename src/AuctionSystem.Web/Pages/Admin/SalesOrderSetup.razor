@page "/admin/sales-order-setup"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Sales Order Setup - Admin</PageTitle>

<h1>Sales Order Setup</h1>
<p class="text-muted">Configure lot grouping, sizing rules, and sort orders for sales order generation.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "grouporder" ? "active" : "")" @onclick='() => _activeTab = "grouporder"'>Lot Group Order</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "sizerules" ? "active" : "")" @onclick='() => _activeTab = "sizerules"'>Lot Size Rules</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "sortorder" ? "active" : "")" @onclick='() => _activeTab = "sortorder"'>Lot Sort Order</button>
        </li>
    </ul>

    @if (_activeTab == "grouporder")
    {
        @* ── Lot Group Order ── *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Lot Group Order</strong>
                <button class="btn btn-sm btn-primary" @onclick="ShowAddGroupOrder">Add Group</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:50px;"></th>
                            <th>Order</th>
                            <th>Column Name</th>
                            <th style="width:150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_groupOrders.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No groups configured.</td></tr>
                        }
                        @foreach (var item in _groupOrders)
                        {
                            <tr draggable="true"
                                @ondragstart="() => DragStartGroup(item)"
                                @ondragover:preventDefault
                                @ondrop="() => DropGroup(item)"
                                class="@(_dragGroupItem == item ? "table-active" : "")"
                                style="cursor: grab;">
                                <td class="text-center text-muted">☰</td>
                                <td><span class="badge bg-secondary">@item.GroupOrder</span></td>
                                <td><strong>@item.ColumnName</strong></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGroupOrder(item)" @onclick:stopPropagation="true">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_showGroupForm)
        {
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <strong>Add Group</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showGroupForm = false"></button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Column Name <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_newGroupName" placeholder="e.g. Gender" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Order</label>
                            <input type="number" class="form-control" @bind="_newGroupOrder" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="SaveGroupOrder">Save</button>
                        <button class="btn btn-secondary ms-2" @onclick="() => _showGroupForm = false">Cancel</button>
                    </div>
                </div>
            </div>
        }
    }
    else if (_activeTab == "sizerules")
    {
        @* ── Lot Size Rules ── *@
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Lot Size Rules</strong>
                <button class="btn btn-sm btn-primary" @onclick="ShowAddSizeRule">Add Rule</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Gender</th>
                            <th>Size</th>
                            <th>Max Boxes</th>
                            <th>Max Skins/Box</th>
                            <th>Showlot Skins</th>
                            <th>Max Lot (excl)</th>
                            <th>Max Lot (incl)</th>
                            <th>Priority</th>
                            <th>Active</th>
                            <th style="width:150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_sizeRules.Count == 0)
                        {
                            <tr><td colspan="10" class="text-center text-muted py-4">No size rules configured.</td></tr>
                        }
                        @foreach (var item in _sizeRules)
                        {
                            <tr>
                                <td>@(item.Gender ?? "—")</td>
                                <td>@(item.Size ?? "—")</td>
                                <td>@item.MaxBoxes</td>
                                <td>@item.MaxSkinsPerBox</td>
                                <td>@item.ShowlotSkins</td>
                                <td>@item.MaxLotSizeExclShowlot</td>
                                <td>@item.MaxLotSizeInclShowlot</td>
                                <td>@item.Priority</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditSizeRule(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSizeRule(item)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_showSizeForm)
        {
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <strong>@(_editingSizeRule?.RuleID > 0 ? "Edit Rule" : "Add Rule")</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showSizeForm = false"></button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Gender</label>
                            <input class="form-control" @bind="_editingSizeRule!.Gender" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Size</label>
                            <input class="form-control" @bind="_editingSizeRule!.Size" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Max Boxes</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxBoxes" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Max Skins/Box</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxSkinsPerBox" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Showlot Skins</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.ShowlotSkins" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Max Lot Size (excl showlot)</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxLotSizeExclShowlot" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Max Lot Size (incl showlot)</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.MaxLotSizeInclShowlot" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Priority</label>
                            <input type="number" class="form-control" @bind="_editingSizeRule!.Priority" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_editingSizeRule!.IsActive" id="sizeRuleActive" />
                                <label class="form-check-label" for="sizeRuleActive">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="SaveSizeRule">Save</button>
                        <button class="btn btn-secondary ms-2" @onclick="() => _showSizeForm = false">Cancel</button>
                    </div>
                </div>
            </div>
        }
    }
    else if (_activeTab == "sortorder")
    {
        @* ── Lot Sort Order (grouped by ColumnName) ── *@
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-sm btn-primary" @onclick="ShowAddSortOrder">Add Sort Value</button>
        </div>

        @if (_showSortForm)
        {
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <strong>Add Sort Value</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showSortForm = false"></button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Group (Column Name) <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_newSortColumnName" placeholder="e.g. Gender" list="sortGroupSuggestions" />
                            <datalist id="sortGroupSuggestions">
                                @foreach (var g in _sortGroups)
                                {
                                    <option value="@g" />
                                }
                            </datalist>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Value <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_newSortValue" placeholder="e.g. Male" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sort Order</label>
                            <input type="number" class="form-control" @bind="_newSortOrder" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="SaveSortOrder">Save</button>
                        <button class="btn btn-secondary ms-2" @onclick="() => _showSortForm = false">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_sortGroups.Count == 0)
        {
            <div class="text-center text-muted py-4">No sort orders configured.</div>
        }

        @foreach (var group in _sortGroups)
        {
            var groupItems = _sortOrders.Where(s => s.ColumnName == group).OrderBy(s => s.SortOrder).ToList();
            <div class="card mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>@group</strong>
                    <span class="badge bg-dark">@groupItems.Count values</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px;"></th>
                                <th>Order</th>
                                <th>Value</th>
                                <th style="width:100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in groupItems)
                            {
                                <tr draggable="true"
                                    @ondragstart="() => DragStartSort(item)"
                                    @ondragover:preventDefault
                                    @ondrop="() => DropSort(item)"
                                    class="@(_dragSortItem == item ? "table-active" : "")"
                                    style="cursor: grab;">
                                    <td class="text-center text-muted">☰</td>
                                    <td><span class="badge bg-secondary">@item.SortOrder</span></td>
                                    <td>@item.Value</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSortOrder(item)" @onclick:stopPropagation="true">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

@code {
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private string _activeTab = "grouporder";

    // Lot Group Order
    private List<LotGroupOrderDto> _groupOrders = new();
    private bool _showGroupForm;
    private string _newGroupName = "";
    private int _newGroupOrder;
    private LotGroupOrderDto? _dragGroupItem;

    // Lot Size Rules
    private List<LotSizeRuleDto> _sizeRules = new();
    private bool _showSizeForm;
    private LotSizeRuleDto? _editingSizeRule;

    // Lot Sort Order
    private List<LotSortOrderDto> _sortOrders = new();
    private List<string> _sortGroups = new();
    private bool _showSortForm;
    private string _newSortColumnName = "";
    private string _newSortValue = "";
    private int _newSortOrder;
    private LotSortOrderDto? _dragSortItem;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        _loading = false;
    }

    private async Task LoadAll()
    {
        _groupOrders = await Api.GetLotGroupOrdersAsync();
        _sizeRules = await Api.GetLotSizeRulesAsync();
        _sortOrders = await Api.GetLotSortOrdersAsync();
        _sortGroups = _sortOrders.Select(s => s.ColumnName).Distinct().OrderBy(s => s).ToList();
    }

    // ── Lot Group Order ──

    private void ShowAddGroupOrder()
    {
        _newGroupName = "";
        _newGroupOrder = _groupOrders.Count > 0 ? _groupOrders.Max(g => g.GroupOrder) + 1 : 1;
        _showGroupForm = true;
    }

    private async Task SaveGroupOrder()
    {
        if (string.IsNullOrWhiteSpace(_newGroupName)) return;
        var result = await Api.CreateLotGroupOrderAsync(new LotGroupOrderDto { ColumnName = _newGroupName.Trim(), GroupOrder = _newGroupOrder });
        if (result != null)
        {
            _message = $"Group '{_newGroupName}' added.";
            _messageIsError = false;
            _showGroupForm = false;
            _groupOrders = await Api.GetLotGroupOrdersAsync();
        }
        else
        {
            _message = "Failed to add group (may already exist).";
            _messageIsError = true;
        }
    }

    private async Task DeleteGroupOrder(LotGroupOrderDto item)
    {
        await Api.DeleteLotGroupOrderAsync(item.ColumnName);
        _message = $"Group '{item.ColumnName}' deleted.";
        _messageIsError = false;
        _groupOrders = await Api.GetLotGroupOrdersAsync();
    }

    private void DragStartGroup(LotGroupOrderDto item) => _dragGroupItem = item;

    private async Task DropGroup(LotGroupOrderDto target)
    {
        if (_dragGroupItem == null || _dragGroupItem == target) return;

        var list = _groupOrders.ToList();
        list.Remove(_dragGroupItem);
        var idx = list.IndexOf(target);
        list.Insert(idx, _dragGroupItem);

        for (int i = 0; i < list.Count; i++)
            list[i].GroupOrder = i + 1;

        _dragGroupItem = null;
        _groupOrders = list;
        StateHasChanged();

        await Api.ReorderLotGroupOrdersAsync(list);
    }

    // ── Lot Size Rules ──

    private void ShowAddSizeRule()
    {
        _editingSizeRule = new LotSizeRuleDto { IsActive = true };
        _showSizeForm = true;
    }

    private void EditSizeRule(LotSizeRuleDto item)
    {
        _editingSizeRule = new LotSizeRuleDto
        {
            RuleID = item.RuleID,
            Gender = item.Gender,
            Size = item.Size,
            MaxBoxes = item.MaxBoxes,
            MaxSkinsPerBox = item.MaxSkinsPerBox,
            ShowlotSkins = item.ShowlotSkins,
            MaxLotSizeExclShowlot = item.MaxLotSizeExclShowlot,
            MaxLotSizeInclShowlot = item.MaxLotSizeInclShowlot,
            Priority = item.Priority,
            IsActive = item.IsActive
        };
        _showSizeForm = true;
    }

    private async Task SaveSizeRule()
    {
        if (_editingSizeRule == null) return;

        if (_editingSizeRule.RuleID > 0)
        {
            var result = await Api.UpdateLotSizeRuleAsync(_editingSizeRule.RuleID, _editingSizeRule);
            _message = result != null ? "Rule updated." : "Failed to update rule.";
            _messageIsError = result == null;
        }
        else
        {
            var result = await Api.CreateLotSizeRuleAsync(_editingSizeRule);
            _message = result != null ? "Rule added." : "Failed to add rule.";
            _messageIsError = result == null;
        }

        _showSizeForm = false;
        _sizeRules = await Api.GetLotSizeRulesAsync();
    }

    private async Task DeleteSizeRule(LotSizeRuleDto item)
    {
        await Api.DeleteLotSizeRuleAsync(item.RuleID);
        _message = "Rule deleted.";
        _messageIsError = false;
        _sizeRules = await Api.GetLotSizeRulesAsync();
    }

    // ── Lot Sort Order ──

    private void ShowAddSortOrder()
    {
        _newSortColumnName = "";
        _newSortValue = "";
        _newSortOrder = 0;
        _showSortForm = true;
    }

    private async Task SaveSortOrder()
    {
        if (string.IsNullOrWhiteSpace(_newSortColumnName) || string.IsNullOrWhiteSpace(_newSortValue)) return;

        var groupItems = _sortOrders.Where(s => s.ColumnName == _newSortColumnName.Trim()).ToList();
        if (_newSortOrder == 0)
            _newSortOrder = groupItems.Count > 0 ? groupItems.Max(s => s.SortOrder) + 1 : 1;

        var result = await Api.CreateLotSortOrderAsync(new LotSortOrderDto
        {
            ColumnName = _newSortColumnName.Trim(),
            Value = _newSortValue.Trim(),
            SortOrder = _newSortOrder
        });

        if (result != null)
        {
            _message = $"Value '{_newSortValue}' added to '{_newSortColumnName}'.";
            _messageIsError = false;
            _showSortForm = false;
            _sortOrders = await Api.GetLotSortOrdersAsync();
            _sortGroups = _sortOrders.Select(s => s.ColumnName).Distinct().OrderBy(s => s).ToList();
        }
        else
        {
            _message = "Failed to add (value may already exist in that group).";
            _messageIsError = true;
        }
    }

    private async Task DeleteSortOrder(LotSortOrderDto item)
    {
        await Api.DeleteLotSortOrderAsync(item.ColumnName, item.Value);
        _message = $"Value '{item.Value}' removed from '{item.ColumnName}'.";
        _messageIsError = false;
        _sortOrders = await Api.GetLotSortOrdersAsync();
        _sortGroups = _sortOrders.Select(s => s.ColumnName).Distinct().OrderBy(s => s).ToList();
    }

    private void DragStartSort(LotSortOrderDto item) => _dragSortItem = item;

    private async Task DropSort(LotSortOrderDto target)
    {
        if (_dragSortItem == null || _dragSortItem == target) return;
        if (_dragSortItem.ColumnName != target.ColumnName) return;

        var group = _dragSortItem.ColumnName;
        var list = _sortOrders.Where(s => s.ColumnName == group).OrderBy(s => s.SortOrder).ToList();
        list.Remove(_dragSortItem);
        var idx = list.IndexOf(target);
        list.Insert(idx, _dragSortItem);

        for (int i = 0; i < list.Count; i++)
            list[i].SortOrder = i + 1;

        _dragSortItem = null;

        var allOther = _sortOrders.Where(s => s.ColumnName != group).ToList();
        _sortOrders = allOther.Concat(list).ToList();
        StateHasChanged();

        await Api.ReorderLotSortOrdersAsync(list);
    }
}
