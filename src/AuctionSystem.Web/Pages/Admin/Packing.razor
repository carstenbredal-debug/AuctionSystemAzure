@page "/admin/packing"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<h4 class="mb-4">Packing Orders</h4>

<div class="row mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label fw-bold">Filter by Status</label>
        <select class="form-select" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Ready to Pack">Ready to Pack</option>
            <option value="In Production">In Production</option>
            <option value="Packed">Packed</option>
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_orders.Count == 0)
{
    <div class="alert alert-info">No packing orders found.</div>
}
else
{
    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Packing Order #</th>
                        <th>Shipment #</th>
                        <th>Buyer</th>
                        <th>Status</th>
                        <th>Boxes</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in _orders)
                    {
                        <tr>
                            <td>
                                <a href="javascript:void(0)" @onclick="() => ToggleExpand(po.Id)">
                                    <strong>@po.PackingOrderNumber</strong>
                                </a>
                            </td>
                            <td>@po.ShipmentNumber</td>
                            <td>@po.BuyerName (@po.BuyerNumber)</td>
                            <td><span class="badge @GetStatusBadgeClass(po.Status)">@po.Status</span></td>
                            <td>@po.BoxCount</td>
                            <td>@po.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (IsLocked(po))
                                {
                                    <span class="text-muted small">Ready for courier — scanner only</span>
                                }
                                else if (po.Status == "Ready to Pack")
                                {
                                    <button class="btn btn-sm btn-primary" @onclick='() => UpdateStatus(po, "In Production")'
                                            title="Makes this order visible to the scanner — completes automatically when all boxes reach the lane">
                                        Start Packing
                                    </button>
                                }
                                else if (po.Status == "In Production")
                                {
                                    <span class="text-muted small">Scanning — completes when all boxes are at @(po.OutLocation ?? "the lane")</span>
                                }
                            </td>
                        </tr>
                        @if (_expandedId == po.Id)
                        {
                            <tr>
                                <td colspan="7" class="p-0">
                                    <div class="bg-light p-3">
                                        <h6 class="mb-2">Boxes in Packing Order (@po.Lines.Count boxes)</h6>
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Box #</th>
                                                    <th>Lot #</th>
                                                    <th>Skins</th>
                                                    <th>Box Type</th>
                                                    <th>Location</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in po.Lines.OrderBy(l => l.BoxNumber))
                                                {
                                                    <tr>
                                                        <td>@line.BoxNumber</td>
                                                        <td>@line.LotNumber</td>
                                                        <td>@line.Skins</td>
                                                        <td>
                                                            @if (IsLocked(po))
                                                            {
                                                                @line.BoxType
                                                            }
                                                            else
                                                            {
                                                                <select class="form-select form-select-sm" style="width:110px"
                                                                        value="@line.BoxType"
                                                                        @onchange="e => ChangeBoxType(line, e)">
                                                                    @if (!_boxTypes.Any(bt => bt.BoxType == line.BoxType))
                                                                    {
                                                                        <option value="@line.BoxType">@line.BoxType</option>
                                                                    }
                                                                    @foreach (var bt in _boxTypes)
                                                                    {
                                                                        <option value="@bt.BoxType">@bt.BoxType</option>
                                                                    }
                                                                </select>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (line.MovedToOutAt != null)
                                                            {
                                                                <span class="badge bg-dark" title="Moved @line.MovedToOutAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@(po.OutLocation ?? "OUT")</span>
                                                            }
                                                            else
                                                            {
                                                                @(string.IsNullOrEmpty(line.Location) ? "—" : line.Location)
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <div class="mt-2 text-muted">
                                            <small>Total: @po.Lines.Count boxes, @po.Lines.Sum(l => l.Skins) skins</small>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<PackingOrderDto> _orders = new();
    private List<BoxTypeDimensionDto> _boxTypes = new();
    private bool _loading = true;
    private int? _expandedId;
    private string? _statusFilter;

    protected override async Task OnInitializedAsync()
    {
        try { _boxTypes = await Api.GetBoxTypeDimensionsAsync(); } catch { }
        await LoadOrders();
    }

    // From Ready for courier on, the shipment is scanner-only — no edits here.
    private static bool IsLocked(PackingOrderDto po) =>
        po.ShipmentStatus is "Ready for courier" or "Shipped" or "Delivered" or "Cancelled";

    // Changing the type here corrects it everywhere: every packing-order line with the box and the
    // auction snapshot the shipping documents read from.
    private async Task ChangeBoxType(PackingOrderLineDto line, ChangeEventArgs e)
    {
        var newType = e.Value?.ToString();
        if (string.IsNullOrEmpty(newType) || newType == line.BoxType) return;
        var (ok, err) = await Api.UpdateBoxTypeAsync(line.Id, newType);
        if (ok)
        {
            line.BoxType = newType;
        }
        else
        {
            // Reload to reset the dropdown to the stored value.
            await LoadOrders();
        }
        StateHasChanged();
    }

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            _orders = await Api.GetPackingOrdersAsync(status: _statusFilter, type: "Packing");
        }
        catch { _orders = new(); }
        _loading = false;
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString();
        if (string.IsNullOrEmpty(_statusFilter)) _statusFilter = null;
        await LoadOrders();
    }

    private void ToggleExpand(int id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private async Task UpdateStatus(PackingOrderDto po, string newStatus)
    {
        var success = await Api.UpdatePackingOrderStatusAsync(po.Id, newStatus);
        if (success)
        {
            po.Status = newStatus;
            StateHasChanged();
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Ready to Pack" => "bg-warning text-dark",
        "In Production" => "text-danger",
        "Packed" => "bg-success",
        _ => "bg-secondary"
    };
}
