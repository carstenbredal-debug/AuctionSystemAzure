@page "/admin/data-integrity"
@using System.Text.Json
@inject HttpClient Http
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<SectionGate Section="Diagnostics" Title="Data Integrity">
<h3>Data Integrity</h3>
<p class="text-muted">Check that sold skin counts and hammer prices match across lots, boxes, and skins.</p>

<div class="mb-4">
    <button class="btn btn-primary" @onclick="RunCheck" disabled="@_checking">
        @if (_checking)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
            <span>Checking...</span>
        }
        else
        {
            <span>Run Skins Price Check</span>
        }
    </button>
</div>

@if (_hasResult)
{
    <div class="alert @(_totalMismatches == 0 ? "alert-success" : "alert-warning")">
        @_message
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Lots Checked</div>
                <div class="card-value">@_totalChecked</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Mismatches</h5>
                    <h2 class="@(_totalMismatches > 0 ? "text-danger" : "text-success")">@_totalMismatches</h2>
                </div>
            </div>
        </div>
    </div>

    @if (_mismatches.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Lot</th>
                        <th>Broker</th>
                        <th>Buyer</th>
                        <th>Price/Skin</th>
                        <th>Expected Skins</th>
                        <th>Actual Skins</th>
                        <th>Expected Hammer</th>
                        <th>Actual Hammer</th>
                        <th>Difference</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _mismatches)
                    {
                        <tr class="credit-row">
                            <td>@m.LotNumber</td>
                            <td>@m.Broker</td>
                            <td>@m.Buyer</td>
                            <td>€@m.PricePerSkin.ToString("N2")</td>
                            <td>@m.ExpectedSkins</td>
                            <td>@m.ActualSkins</td>
                            <td>€@m.ExpectedHammerPrice.ToString("N2")</td>
                            <td>€@m.ActualHammerPrice.ToString("N2")</td>
                            <td class="text-danger fw-bold">€@m.Difference.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<hr class="my-4" />

<div class="card border-danger">
    <div class="card-header bg-danger text-white"><strong>⚠ Danger Zone — System Reset</strong></div>
    <div class="card-body">
        <p class="mb-2">
            Deletes <strong>all auctions and transaction data</strong> (lots, results, invoices, credit notes,
            settlements, shipments, packing, typist entries, sales history) and drops the per-auction snapshot
            tables. <strong>Keeps</strong> brokers, buyers, farmers, shippers, addresses, broker-buyer links,
            users and system parameters. <strong>This cannot be undone — back up the database first.</strong>
        </p>

        @if (!_showResetConfirm && !_resetDone)
        {
            <button class="btn btn-outline-danger" @onclick="() => _showResetConfirm = true" disabled="@_resetting">
                Reset Transaction Data…
            </button>
        }

        @if (_showResetConfirm && !_resetDone)
        {
            <div class="border border-danger rounded p-3 mt-2">
                <p class="mb-2">Type <code>RESET</code> to confirm:</p>
                <input class="form-control mb-2" style="max-width:220px" @bind="_resetConfirmText" @bind:event="oninput" placeholder="RESET" />
                <button class="btn btn-danger me-2" @onclick="DoReset" disabled="@(_resetting || _resetConfirmText != "RESET")">
                    @if (_resetting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Yes, reset now
                </button>
                <button class="btn btn-secondary" @onclick="CancelReset" disabled="@_resetting">Cancel</button>
            </div>
        }

        @if (_resetMessage != null)
        {
            <div class="alert @(_resetError ? "alert-danger" : "alert-success") mt-3 mb-0">
                <div>@_resetMessage</div>
                @if (_resetRemaining != null)
                {
                    <ul class="mb-0 mt-2 small">
                        @foreach (var kv in _resetRemaining)
                        {
                            <li>@kv.Key: <strong>@kv.Value</strong></li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</div>

</SectionGate>

@code {
    private bool _showResetConfirm;
    private bool _resetting;
    private bool _resetDone;
    private string _resetConfirmText = string.Empty;
    private string? _resetMessage;
    private bool _resetError;
    private Dictionary<string, JsonElement>? _resetRemaining;

    private void CancelReset()
    {
        _showResetConfirm = false;
        _resetConfirmText = string.Empty;
    }

    private async Task DoReset()
    {
        if (_resetConfirmText != "RESET") return;
        _resetting = true;
        _resetMessage = null;
        StateHasChanged();
        try
        {
            // keepEntities=true: wipe transactions/auctions, keep brokers/buyers/farmers/shippers/
            // addresses/broker-buyer links/users/parameters. Admin-only endpoint.
            var response = await Http.PostAsync("api/system/reset-all?keepEntities=true", null);
            var json = await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode)
            {
                var doc = JsonDocument.Parse(json);
                _resetMessage = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : "Reset complete.";
                if (doc.RootElement.TryGetProperty("remaining", out var rem))
                    _resetRemaining = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(rem.GetRawText());
                _resetError = false;
                _resetDone = true;
                _showResetConfirm = false;
            }
            else
            {
                _resetMessage = $"Reset failed: {(int)response.StatusCode} {response.ReasonPhrase}. {json}";
                _resetError = true;
            }
        }
        catch (Exception ex)
        {
            _resetMessage = $"Reset failed: {ex.Message}";
            _resetError = true;
        }
        finally
        {
            _resetting = false;
            _resetConfirmText = string.Empty;
            StateHasChanged();
        }
    }

    private bool _checking;
    private bool _hasResult;
    private string _message = "";
    private int _totalChecked;
    private int _totalMismatches;
    private List<MismatchItem> _mismatches = new();

    private async Task RunCheck()
    {
        _checking = true;
        _hasResult = false;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync("api/diag/skins-price-check");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);

                _message = doc.RootElement.GetProperty("message").GetString() ?? "";
                _totalChecked = doc.RootElement.GetProperty("totalChecked").GetInt32();
                _totalMismatches = doc.RootElement.GetProperty("totalMismatches").GetInt32();

                var arr = doc.RootElement.GetProperty("mismatches");
                _mismatches = JsonSerializer.Deserialize<List<MismatchItem>>(arr.GetRawText(), new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new();

                _hasResult = true;
            }
        }
        catch { }

        _checking = false;
        StateHasChanged();
    }

    private class MismatchItem
    {
        public int LotNumber { get; set; }
        public string Broker { get; set; } = "";
        public string Buyer { get; set; } = "";
        public decimal PricePerSkin { get; set; }
        public int ExpectedSkins { get; set; }
        public int ActualSkins { get; set; }
        public decimal ExpectedHammerPrice { get; set; }
        public decimal ActualHammerPrice { get; set; }
        public decimal Difference { get; set; }
    }
}
