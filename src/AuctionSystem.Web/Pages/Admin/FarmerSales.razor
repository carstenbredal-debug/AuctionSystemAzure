@page "/admin/farmer-sales"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Farmers - Finance</PageTitle>

<h1>Farmers</h1>
<p class="text-muted">Skins sold and total value per farmer, for the selected auction.</p>

<div class="row mb-3" style="max-width:520px">
    <div class="col">
        <label class="form-label">Auction</label>
        <select class="form-select" @bind="_auctionId" @bind:after="Load">
            <option value="0">— select an auction —</option>
            @foreach (var a in _auctions ?? new())
            {
                <option value="@a.Id">@a.AuctionNumber — @a.Title</option>
            }
        </select>
    </div>
</div>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_rows != null)
{
    <div class="mb-3" style="max-width:320px">
        <input class="form-control" placeholder="Search farmer number…"
               value="@_search" @oninput='e => _search = e.Value?.ToString() ?? ""' />
    </div>

    <table class="table table-sm table-hover" style="max-width:920px">
        <thead class="table-dark">
            <tr><th>Number</th><th>Farmer</th><th class="text-end">Skins in auction</th><th class="text-end">Skins sold</th><th class="text-end">Total value (€)</th></tr>
        </thead>
        <tbody>
            @if (FilteredRows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-3">@(_rows.Count == 0 ? "No skins for this auction." : "No farmer number matches the search.")</td></tr>
            }
            @foreach (var r in FilteredRows)
            {
                <tr>
                    <td><strong>@NumberFor(r)</strong></td>
                    <td><a href="@(r.FarmerGuid.HasValue ? $"/farmer/auction/{_auctionId}?farmerGuid={r.FarmerGuid}" : $"/farmer/auction/{_auctionId}?farmer={Uri.EscapeDataString(r.Farmer)}")">@r.Farmer</a></td>
                    <td class="text-end">@r.SkinsInAuction.ToString("N0")</td>
                    <td class="text-end">@r.SkinsSold.ToString("N0")</td>
                    <td class="text-end">@r.TotalValue.ToString("N2")</td>
                </tr>
            }
        </tbody>
        @if (FilteredRows.Count > 0)
        {
            <tfoot>
                <tr class="fw-bold">
                    <td></td>
                    <td>Total — @FilteredRows.Count farmer(s)</td>
                    <td class="text-end">@FilteredRows.Sum(x => x.SkinsInAuction).ToString("N0")</td>
                    <td class="text-end">@FilteredRows.Sum(x => x.SkinsSold).ToString("N0")</td>
                    <td class="text-end">@FilteredRows.Sum(x => x.TotalValue).ToString("N2")</td>
                </tr>
            </tfoot>
        }
    </table>
}

@code {
    private List<AuctionDto>? _auctions;
    private int _auctionId;
    private List<FarmerSalesRow>? _rows;
    private bool _loading;
    private string _search = "";
    private Dictionary<Guid, string> _numberByGuid = new();

    private string NumberFor(FarmerSalesRow r) =>
        r.FarmerGuid.HasValue && _numberByGuid.TryGetValue(r.FarmerGuid.Value, out var n) ? n : "";

    private List<FarmerSalesRow> FilteredRows => string.IsNullOrWhiteSpace(_search) || _rows == null
        ? _rows ?? new()
        : _rows.Where(r => NumberFor(r).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _auctions = await Api.GetAuctionsAsync();
        try
        {
            _numberByGuid = (await Api.GetFarmersAsync())
                .Where(f => f.FarmerGUID != null)
                .GroupBy(f => f.FarmerGUID!.Value)
                .ToDictionary(g => g.Key, g => g.First().FarmerNumber);
        }
        catch { }
    }

    private async Task Load()
    {
        if (_auctionId <= 0) { _rows = null; return; }
        _loading = true;
        try { _rows = await Api.GetFarmerSalesByAuctionAsync(_auctionId); }
        catch { _rows = new(); }
        finally { _loading = false; }
    }
}
