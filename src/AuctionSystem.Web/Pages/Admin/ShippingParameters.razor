@page "/admin/shipping-parameters"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Shipping Parameter - Admin</PageTitle>

<h1>Shipping Parameter</h1>
<p class="text-muted">Configure box type dimensions for shipping calculations.</p>

@if (_loading)
{
    <p><em>Loading box types...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="section-container mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Box Type Dimensions</strong>
            <button class="btn btn-sm btn-primary" @onclick="SaveAll" disabled="@_saving">
                @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Save All
            </button>
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Box Type</th>
                        <th style="width:130px">Height (m)</th>
                        <th style="width:130px">Width (m)</th>
                        <th style="width:130px">Length (m)</th>
                        <th style="width:130px">Volume (m³)</th>
                        <th style="width:130px">Kilos (kg)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No box types found.</td></tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><strong>@item.BoxType</strong></td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       @bind="item.HeightM" @bind:event="oninput" />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       @bind="item.WidthM" @bind:event="oninput" />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       @bind="item.LengthM" @bind:event="oninput" />
                            </td>
                            <td>
                                <span class="fw-bold @(Volume(item) > 0 ? "text-success" : "text-muted")">
                                    @Volume(item).ToString("N4")
                                </span>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       @bind="item.WeightKg" @bind:event="oninput" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<BoxTypeDimensionDto> _items = new();
    private bool _loading = true;
    private bool _saving;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Api.GetBoxTypeDimensionsAsync();
        }
        catch (Exception ex)
        {
            _message = $"Failed to load box types: {ex.Message}";
            _messageIsError = true;
        }
        _loading = false;
    }

    private decimal Volume(BoxTypeDimensionDto item) =>
        item.HeightM * item.WidthM * item.LengthM;

    private async Task SaveAll()
    {
        _saving = true;
        _message = null;
        try
        {
            var (ok, err) = await Api.SaveAllBoxTypeDimensionsAsync(_items);
            if (ok)
            {
                _message = "All box type dimensions saved successfully.";
                _messageIsError = false;
            }
            else
            {
                _message = $"Failed to save: {err}";
                _messageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _messageIsError = true;
        }
        _saving = false;
    }
}
