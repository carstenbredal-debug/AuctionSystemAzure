@page "/admin/customer-links"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Link Customer to Broker - Admin</PageTitle>

<h1>Link Customer to Broker</h1>
<p class="text-muted">Directly connect buyers to brokers or manage existing relationships.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="card mb-4 border-info">
        <div class="card-header bg-info text-white">
            <strong>Create Link</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small">Directly connect a buyer to a broker (bypasses the invitation/approval flow).</p>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Buyer</label>
                    <select class="form-select" @bind="_linkBuyerId">
                        <option value="0">— Select Buyer —</option>
                        @foreach (var b in _buyers)
                        {
                            <option value="@b.Id">@b.Name (@b.BuyerNumber)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Broker</label>
                    <select class="form-select" @bind="_linkBrokerId">
                        <option value="0">— Select Broker —</option>
                        @foreach (var b in _brokers)
                        {
                            <option value="@b.Id">@b.CompanyName (@b.BrokerNumber)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-info text-white" @onclick="AdminLink" disabled="@(_linkBuyerId == 0 || _linkBrokerId == 0)">
                        Link Customer to Broker
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Broker-Customer Relationships</strong> <span class="badge bg-secondary">@_links.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Buyer</th>
                        <th>Broker</th>
                        <th>Status</th>
                        <th>Requested</th>
                        <th>Responded</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_links.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No broker-customer relationships.</td></tr>
                    }
                    @foreach (var link in _links)
                    {
                        <tr>
                            <td><strong>@(link.Buyer?.Name ?? $"Buyer {link.BuyerId}")</strong></td>
                            <td>@(link.Broker?.CompanyName ?? $"Broker {link.BrokerId}")</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(link.Status)">@GetStatusText(link.Status)</span>
                            </td>
                            <td>@link.RequestedAt.ToString("g")</td>
                            <td>@(link.RespondedAt?.ToString("g") ?? "—")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLink(link)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<BuyerDto> _buyers = new();
    private List<BrokerDto> _brokers = new();
    private List<BrokerCustomerRequestDto> _links = new();
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private int _linkBuyerId;
    private int _linkBrokerId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        _buyers = await Api.GetAllBuyersAsync();
        _brokers = await Api.GetBrokersAsync();
        _links = await Api.GetAllCustomerRequestsAsync();
    }

    private async Task AdminLink()
    {
        if (_linkBuyerId == 0 || _linkBrokerId == 0) return;

        var result = await Api.AdminCreateCustomerLinkAsync(_linkBrokerId, _linkBuyerId);
        if (result != null)
        {
            var buyerName = _buyers.FirstOrDefault(b => b.Id == _linkBuyerId)?.Name ?? "Buyer";
            var brokerName = _brokers.FirstOrDefault(b => b.Id == _linkBrokerId)?.CompanyName ?? "Broker";
            _message = $"'{buyerName}' linked to '{brokerName}' successfully.";
            _messageIsError = false;
            _linkBuyerId = 0;
            _linkBrokerId = 0;
        }
        else
        {
            _message = "Failed to create link. The relationship may already exist.";
            _messageIsError = true;
        }
        await LoadData();
    }

    private async Task RemoveLink(BrokerCustomerRequestDto link)
    {
        await Api.DeleteCustomerRequestAsync(link.Id);
        _message = "Relationship removed."; _messageIsError = false;
        await LoadData();
    }

    private string GetStatusColor(CustomerRequestStatus status) => status switch
    {
        CustomerRequestStatus.Approved => "success",
        CustomerRequestStatus.Pending => "warning",
        CustomerRequestStatus.Declined => "danger",
        _ => "secondary"
    };

    private string GetStatusText(CustomerRequestStatus status) => status switch
    {
        CustomerRequestStatus.Approved => "Approved",
        CustomerRequestStatus.Pending => "Awaiting Approval",
        CustomerRequestStatus.Declined => "Declined",
        _ => "Unknown"
    };
}
