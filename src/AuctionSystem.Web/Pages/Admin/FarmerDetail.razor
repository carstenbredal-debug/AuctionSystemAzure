@page "/admin/farmers/{FarmerId:int}"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Farmer Details - Admin</PageTitle>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_farmer == null)
{
    <div class="alert alert-warning">Farmer not found.</div>
    <a href="admin/farmers" class="btn btn-secondary">Back to Farmers</a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>@_farmer.Name</h1>
            <p class="text-muted mb-0">Farmer #@_farmer.FarmerNumber</p>
        </div>
        <a href="admin/farmers" class="btn btn-outline-secondary">Back to Farmers</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "info" ? "active" : "")" @onclick='() => _activeTab = "info"'>Information</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "lots" ? "active" : "")" @onclick='() => _activeTab = "lots"'>
                Lots <span class="badge bg-secondary ms-1">@_lots.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "settlements" ? "active" : "")" @onclick='() => _activeTab = "settlements"'>
                Settlements
            </button>
        </li>
    </ul>

    @if (_activeTab == "info")
    {
        <!-- General Section -->
        <div class="section-container mb-3">
            <div class="section-header">General</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editDto!.FarmerNumber" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editDto!.Name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Credit Limit</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editDto!.CreditLimit" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Blocked</label>
                        <select class="form-select" @bind="_editDto!.Blocked">
                            <option value="">— (None)</option>
                            <option value="Ship">Ship</option>
                            <option value="Invoice">Invoice</option>
                            <option value="All">All</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address & Contact Section -->
        <div class="section-container mb-3">
            <div class="section-header">Address & Contact</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input class="form-control" @bind="_editDto!.AddressLine1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address 2</label>
                        <input class="form-control" @bind="_editDto!.AddressLine2" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Country/Region Code</label>
                        <select class="form-select" @bind="_editDto!.Country">
                            <option value="">Select Country...</option>
                            @foreach (var c in _bcCountries)
                            {
                                <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Post Code</label>
                        <input class="form-control" @bind="_editDto!.PostalCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">City</label>
                        <input class="form-control" @bind="_editDto!.City" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Contact Name</label>
                        <input class="form-control" @bind="_editDto!.ContactName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone No.</label>
                        <input class="form-control" @bind="_editDto!.ContactPhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mobile Phone No.</label>
                        <input class="form-control" @bind="_editDto!.MobilePhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">E-Mail</label>
                        <input class="form-control" type="email" @bind="_editDto!.ContactEmail" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Home Page</label>
                        <input class="form-control" @bind="_editDto!.HomePage" placeholder="https://" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoicing Section -->
        <div class="section-container mb-3">
            <div class="section-header">Invoicing</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">VAT Registration No.</label>
                        <input class="form-control" @bind="_editDto!.VatRegistrationNo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Registration No.</label>
                        <input class="form-control" @bind="_editDto!.RegistrationNo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Currency Code</label>
                        <select class="form-select" @bind="_editDto!.Currency">
                            <option value="">Select Currency...</option>
                            @foreach (var c in _bcCurrencies)
                            {
                                <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Gen. Bus. Posting Group</label>
                        <select class="form-select" @bind="_editDto!.GenBusPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcGenBusPostingGroups)
                            {
                                <option value="@g.Code">@g.Description (@g.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">VAT Bus. Posting Group</label>
                        <select class="form-select" @bind="_editDto!.VatBusPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcVatBusPostingGroups)
                            {
                                <option value="@g.Code">@g.Description (@g.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Vendor Posting Group</label>
                        <select class="form-select" @bind="_editDto!.VendorPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcVendorPostingGroups)
                            {
                                <option value="@g.Code">@g.Code</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Section -->
        <div class="section-container mb-3">
            <div class="section-header">Payments</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Payment Terms Code</label>
                        <select class="form-select" @bind="_editDto!.PaymentTerm">
                            <option value="">Select...</option>
                            @foreach (var t in _bcPaymentTerms)
                            {
                                <option value="@t.Code">@t.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Payment Method Code</label>
                        <input class="form-control" @bind="_editDto!.PaymentMethod" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="_editDto!.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Banking Section -->
        <div class="section-container mb-3">
            <div class="section-header">Banking</div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Bank Name</label>
                        <input class="form-control" @bind="_editDto!.BankName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bank Address</label>
                        <input class="form-control" @bind="_editDto!.BankAddress" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bank Country</label>
                        <input class="form-control" @bind="_editDto!.BankCountry" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">IBAN Number</label>
                        <input class="form-control" @bind="_editDto!.BankIbanNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">SWIFT Code</label>
                        <input class="form-control" @bind="_editDto!.SwiftCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Assignee</label>
                        <input class="form-control" @bind="_editDto!.Assignee" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="_editDto!.AssignmentOfReceivable" />
                            <label class="form-check-label">Assignment of Receivable</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-2">
            <button class="btn btn-success me-2" @onclick="SaveEdit">Save</button>
        </div>
    }

    @if (_activeTab == "lots")
    {
        <div class="section-container">
            <div class="section-header">
            Lots
        </div>
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot Number</th>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Starting Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_lots.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No lots consigned.</td></tr>
                        }
                        @foreach (var lot in _lots)
                        {
                            <tr>
                                <td><strong>@lot.LotNumber</strong></td>
                                <td>@lot.Description</td>
                                <td>@lot.Quantity</td>
                                <td>@lot.StartingPrice.ToString("C")</td>
                                <td>
                                    <span class="badge bg-secondary">@lot.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "settlements")
    {
        <div class="section-container">
            <div class="section-header">
            Settlements
        </div>
            <div class="card-body text-center text-muted py-4">
                <p>Settlement information will be available here.</p>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int FarmerId { get; set; }

    private FarmerDto? _farmer;
    private List<LotDto> _lots = new();
    private bool _loading = true;
    private FarmerDto? _editDto;
    private string? _message;
    private bool _messageIsError;
    private string _activeTab = "info";
    private List<BcCountryRegionDto> _bcCountries = new();
    private List<BcCurrencyDto> _bcCurrencies = new();
    private List<BcPostingGroupDto> _bcGenBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcVatBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcVendorPostingGroups = new();
    private List<BcPaymentTermDto> _bcPaymentTerms = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        var allFarmers = await Api.GetFarmersAsync();
        _farmer = allFarmers.FirstOrDefault(s => s.Id == FarmerId);
        if (_farmer != null)
        {
            _lots = await Api.GetLotsByFarmerAsync(FarmerId);
            InitEditDto();
        }
        _bcCountries = await Api.GetBcCountriesAsync();
        _bcCurrencies = await Api.GetBcCurrenciesAsync();
        _bcGenBusPostingGroups = await Api.GetBcGenBusPostingGroupsAsync();
        _bcVatBusPostingGroups = await Api.GetBcVatBusPostingGroupsAsync();
        _bcVendorPostingGroups = await Api.GetBcVendorPostingGroupsAsync();
        _bcPaymentTerms = await Api.GetBcPaymentTermsAsync();
    }

    private void InitEditDto()
    {
        _editDto = new FarmerDto
        {
            Id = _farmer!.Id, FarmerNumber = _farmer.FarmerNumber, Name = _farmer.Name,
            Name2 = _farmer.Name2, SearchName = _farmer.SearchName,
            ContactName = _farmer.ContactName,
            AddressLine1 = _farmer.AddressLine1, AddressLine2 = _farmer.AddressLine2,
            Country = _farmer.Country, PostalCode = _farmer.PostalCode, City = _farmer.City,
            ContactPhone = _farmer.ContactPhone, MobilePhone = _farmer.MobilePhone,
            ContactEmail = _farmer.ContactEmail, HomePage = _farmer.HomePage,
            VatRegistrationNo = _farmer.VatRegistrationNo, RegistrationNo = _farmer.RegistrationNo,
            CustomerGroup = _farmer.CustomerGroup,
            GenBusPostingGroup = _farmer.GenBusPostingGroup,
            VatBusPostingGroup = _farmer.VatBusPostingGroup,
            VendorPostingGroup = _farmer.VendorPostingGroup,
            PaymentTerm = _farmer.PaymentTerm, PaymentMethod = _farmer.PaymentMethod,
            Currency = _farmer.Currency,
            BankName = _farmer.BankName, BankAddress = _farmer.BankAddress,
            BankIbanNumber = _farmer.BankIbanNumber, SwiftCode = _farmer.SwiftCode,
            BankCountry = _farmer.BankCountry, Assignee = _farmer.Assignee,
            AssignmentOfReceivable = _farmer.AssignmentOfReceivable,
            CreditLimit = _farmer.CreditLimit, Blocked = _farmer.Blocked,
            IsActive = _farmer.IsActive, Address = _farmer.Address
        };
    }

    private async Task SaveEdit()
    {
        if (_editDto == null) return;
        if (string.IsNullOrWhiteSpace(_editDto.FarmerNumber) || string.IsNullOrWhiteSpace(_editDto.Name))
        { _message = "Farmer Number and Name are required."; _messageIsError = true; return; }

        await Api.UpdateFarmerAsync(_editDto.Id, _editDto);
        _message = "Farmer updated."; _messageIsError = false;
        await LoadData();
    }
}
