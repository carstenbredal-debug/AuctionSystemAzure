@page "/admin/shipping"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Shipping - Admin</PageTitle>

<h3 class="mb-4">Shipping — Create Shipment</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_boxes.Count == 0)
{
    <div class="alert alert-info">No invoices released for shipping yet.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Shipper</label>
            <select class="form-select" @bind="_selectedShipperId">
                <option value="0">— Select Shipper —</option>
                @foreach (var sh in _shippers)
                {
                    <option value="@sh.Id">@sh.Code - @sh.Name</option>
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label fw-bold">Shipping Address</label>
            <select class="form-select" @bind="_selectedAddressId">
                <option value="0">— Select Address —</option>
                @foreach (var a in _addresses)
                {
                    <option value="@a.Id">@a.Name — @a.AddressLine1, @a.City @a.Country @(a.IsDefault ? "(Default)" : "")</option>
                }
            </select>
        </div>
    </div>

    @if (_selectedShipperId == 0 || _selectedAddressId == 0)
    {
        <div class="alert alert-secondary">Select a shipper and a shipping address, then choose the invoice to ship.</div>
    }

    <div class="section-container">
        <div class="section-header"><h6 class="mb-0">Invoices Ready for Shipping</h6></div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Invoice</th>
                        <th>Buyer</th>
                        <th class="text-end">Boxes</th>
                        <th class="text-end">Skins</th>
                        <th class="text-end">Gross (kg)</th>
                        <th class="text-end">Net (kg)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in GetInvoiceGroups())
                    {
                        <tr>
                            <td class="fw-bold">@inv.InvoiceNumber</td>
                            <td>@inv.BuyerName</td>
                            <td class="text-end">@inv.Boxes.Count</td>
                            <td class="text-end">@inv.Boxes.Sum(b => b.Skins).ToString("N0")</td>
                            <td class="text-end">@inv.Boxes.Sum(b => b.GrossWeight ?? 0).ToString("N2")</td>
                            <td class="text-end">@inv.Boxes.Sum(b => b.NetWeight ?? 0).ToString("N2")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenConfirmDialog(inv)"
                                        disabled="@(_selectedShipperId == 0 || _selectedAddressId == 0)">
                                    Create Shipment…
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Confirm popup: the boxes that ship on the chosen invoice *@
@if (_confirmInvoice != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Shipment — Invoice @_confirmInvoice.InvoiceNumber (@_confirmInvoice.BuyerName)</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmDialog"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        These <strong>@_confirmInvoice.Boxes.Count box(es)</strong>
                        (<strong>@_confirmInvoice.Boxes.Sum(b => b.Skins).ToString("N0") skins</strong>)
                        ship on this invoice
                        via <strong>@(_shippers.FirstOrDefault(s => s.Id == _selectedShipperId)?.Name)</strong>
                        to <strong>@(_addresses.FirstOrDefault(a => a.Id == _selectedAddressId)?.Name)</strong>.
                    </p>
                    <table class="table table-sm table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Box #</th>
                                <th>Lot #</th>
                                <th>Type</th>
                                <th class="text-end">Skins</th>
                                <th class="text-end">Gross (kg)</th>
                                <th class="text-end">Net (kg)</th>
                                <th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var box in _confirmInvoice.Boxes.OrderBy(b => b.LotNumber).ThenBy(b => b.BoxNumber))
                            {
                                <tr>
                                    <td>@box.BoxNumber</td>
                                    <td>@box.LotNumber</td>
                                    <td>@box.BoxType</td>
                                    <td class="text-end">@box.Skins</td>
                                    <td class="text-end">@(box.GrossWeight?.ToString("N2") ?? "—")</td>
                                    <td class="text-end">@(box.NetWeight?.ToString("N2") ?? "—")</td>
                                    <td>@(box.BoxLocation ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr>
                                <td colspan="3">Total</td>
                                <td class="text-end">@_confirmInvoice.Boxes.Sum(b => b.Skins).ToString("N0")</td>
                                <td class="text-end">@_confirmInvoice.Boxes.Sum(b => b.GrossWeight ?? 0).ToString("N2")</td>
                                <td class="text-end">@_confirmInvoice.Boxes.Sum(b => b.NetWeight ?? 0).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseConfirmDialog" disabled="@_creating">Cancel</button>
                    <button class="btn btn-success" @onclick="ConfirmCreateShipment" disabled="@_creating">
                        @(_creating ? "Creating..." : "Confirm — Create Shipment")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ShippingBoxDto> _boxes = new();
    private List<ShippingAddressListDto> _addresses = new();
    private List<ShipperListDto> _shippers = new();
    private bool _loading = true;
    private bool _creating;
    private int _selectedShipperId;
    private int _selectedAddressId;
    private string? _error;
    private string? _success;

    private InvoiceGroup? _confirmInvoice;

    private class InvoiceGroup
    {
        public string InvoiceNumber { get; init; } = "";
        public string BuyerName { get; init; } = "";
        public List<ShippingBoxDto> Boxes { get; init; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBoxes();
        _addresses = await Api.GetShippingAddressesAsync();
        _shippers = await Api.GetShippersAsync();
        var defaultAddr = _addresses.FirstOrDefault(a => a.IsDefault);
        _selectedAddressId = defaultAddr?.Id ?? 0;
        _loading = false;
    }

    private async Task LoadBoxes()
    {
        _boxes = await Api.GetShippingBoxesAsync();
    }

    private List<InvoiceGroup> GetInvoiceGroups()
    {
        return _boxes
            .GroupBy(b => b.InvoiceNumber ?? "—")
            .Select(g => new InvoiceGroup
            {
                InvoiceNumber = g.Key,
                BuyerName = g.Select(b => b.BuyerName ?? "—").FirstOrDefault() ?? "—",
                Boxes = g.ToList()
            })
            .OrderBy(g => g.InvoiceNumber)
            .ToList();
    }

    private void OpenConfirmDialog(InvoiceGroup inv)
    {
        _error = null;
        _success = null;
        _confirmInvoice = inv;
    }

    private void CloseConfirmDialog()
    {
        _confirmInvoice = null;
    }

    private async Task ConfirmCreateShipment()
    {
        if (_confirmInvoice == null) return;
        _creating = true;
        _error = null;
        StateHasChanged();

        var boxes = _confirmInvoice.Boxes;
        var payload = new
        {
            shipperId = _selectedShipperId,
            buyerId = boxes.Select(b => b.BuyerId).FirstOrDefault(),
            shippingAddressId = _selectedAddressId > 0 ? (int?)_selectedAddressId : null,
            trackingNumber = "",
            notes = "",
            lotNumbers = boxes.Select(b => b.LotNumber).Distinct().ToList(),
            boxNumbers = boxes.Select(b => b.BoxNumber).Distinct().ToList()
        };

        try
        {
            var (ok, err, num) = await Api.CreateShipmentAsync(payload);
            if (!ok)
            {
                _error = err;
                _creating = false;
                return;
            }
            _success = $"Shipment {num} created for invoice {_confirmInvoice.InvoiceNumber}: " +
                       $"{boxes.Count} box(es), {boxes.Sum(b => b.Skins):N0} skins.";
            _confirmInvoice = null;
            await LoadBoxes();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _creating = false;
    }
}
