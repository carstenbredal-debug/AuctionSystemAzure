@page "/admin/shipping"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Shipping - Admin</PageTitle>

<h3 class="mb-4">Shipping — Boxes Ready for Shipping</h3>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_boxes.Count == 0)
{
    <div class="alert alert-info">No lots released for shipping yet.</div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label fw-bold">Filter by Customer</label>
            <select class="form-select" @bind="_selectedBuyer">
                <option value="">All Customers</option>
                @foreach (var buyer in _buyerNames)
                {
                    <option value="@buyer">@buyer</option>
                }
            </select>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Boxes</h5>
                    <h3>@GetFilteredBoxes().Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Skins</h5>
                    <h3>@GetFilteredBoxes().Sum(b => b.Skins)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Volume (m³)</h5>
                    <h3>@GetFilteredBoxes().Sum(b => b.VolumeM3 ?? 0).ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Weight (kg)</h5>
                    <h3>@GetFilteredBoxes().Sum(b => b.WeightKg ?? 0).ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Invoice</th>
                        <th>Buyer</th>
                        <th>Lot #</th>
                        <th>Box #</th>
                        <th>Box Type</th>
                        <th>Skins</th>
                        <th>Volume (m³)</th>
                        <th>Weight (kg)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var box in GetFilteredBoxes())
                    {
                        <tr>
                            <td>@box.InvoiceNumber</td>
                            <td>@(box.BuyerName ?? "—")</td>
                            <td>@box.LotNumber</td>
                            <td>@box.BoxNumber</td>
                            <td>@box.BoxType</td>
                            <td>@box.Skins</td>
                            <td>@(box.VolumeM3.HasValue ? box.VolumeM3.Value.ToString("N4") : "—")</td>
                            <td>@(box.WeightKg.HasValue ? box.WeightKg.Value.ToString("N2") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ShippingBoxDto> _boxes = new();
    private bool _loading = true;
    private string _selectedBuyer = "";
    private List<string> _buyerNames = new();

    private List<ShippingBoxDto> GetFilteredBoxes() =>
        string.IsNullOrEmpty(_selectedBuyer)
            ? _boxes
            : _boxes.Where(b => b.BuyerName == _selectedBuyer).ToList();

    protected override async Task OnInitializedAsync()
    {
        _boxes = await Api.GetShippingBoxesAsync();
        _buyerNames = _boxes.Select(b => b.BuyerName ?? "—").Distinct().OrderBy(n => n).ToList();
        _loading = false;
    }
}
