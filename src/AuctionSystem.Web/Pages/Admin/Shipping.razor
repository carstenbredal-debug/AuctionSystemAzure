@page "/admin/shipping"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Shipping - Admin</PageTitle>

<h3 class="mb-4">Shipping — Confirm Shipments</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_shipments.Count == 0)
{
    <div class="alert alert-info">No shipments waiting to be shipped.</div>
}
else
{
    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Shipment #</th>
                        <th>Buyer</th>
                        <th>Shipper</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Lots</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _shipments)
                    {
                        <tr>
                            <td class="fw-bold">@s.ShipmentNumber</td>
                            <td>@s.BuyerNumber - @s.BuyerName</td>
                            <td>@s.ShipperCode - @s.ShipperName</td>
                            <td class="small">@s.ShippingAddressSummary</td>
                            <td><span class="badge @GetStatusBadge(s.Status)">@s.Status</span></td>
                            <td>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">@s.LotCount</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-success" @onclick="() => OpenShipDialog(s)">Ship…</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Confirm-shipment popup: shows the boxes that leave with this shipment *@
@if (_shipDialogShipment != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ship @_shipDialogShipment.ShipmentNumber — @_shipDialogShipment.BuyerName</h5>
                    <button type="button" class="btn-close" @onclick="CloseShipDialog"></button>
                </div>
                <div class="modal-body">
                    @if (_packingListLoading)
                    {
                        <p><em>Loading boxes...</em></p>
                    }
                    else if (_packingList == null || _packingList.PackingLines.Count == 0)
                    {
                        <div class="alert alert-warning">No boxes found for this shipment.</div>
                    }
                    else
                    {
                        <p class="mb-2">
                            You are shipping <strong>@_packingList.Totals.Boxes box(es)</strong>
                            with <strong>@_packingList.Totals.Skins.ToString("N0") skins</strong>
                            to <strong>@_packingList.BuyerName</strong>
                            via <strong>@_packingList.ShipperName</strong>.
                        </p>
                        <table class="table table-sm table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Box #</th>
                                    <th>Lot #</th>
                                    <th>Type</th>
                                    <th class="text-end">Skins</th>
                                    <th class="text-end">Gross (kg)</th>
                                    <th class="text-end">Net (kg)</th>
                                    <th>Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _packingList.PackingLines)
                                {
                                    <tr>
                                        <td>@line.BoxNumber</td>
                                        <td>@line.LotNumber</td>
                                        <td>@line.BoxType</td>
                                        <td class="text-end">@line.Skins</td>
                                        <td class="text-end">@line.GrossWeightKg.ToString("N2")</td>
                                        <td class="text-end">@line.NetWeightKg.ToString("N2")</td>
                                        <td>@line.Location</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="fw-bold">
                                <tr>
                                    <td colspan="3">Total</td>
                                    <td class="text-end">@_packingList.Totals.Skins.ToString("N0")</td>
                                    <td class="text-end">@_packingList.Totals.GrossWeightKg.ToString("N2")</td>
                                    <td class="text-end">@_packingList.Totals.NetWeightKg.ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tracking Number (optional)</label>
                                <input class="form-control" @bind="_trackingNumber" placeholder="Tracking number" />
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseShipDialog" disabled="@_confirming">Cancel</button>
                    <button class="btn btn-success" @onclick="ConfirmShip"
                            disabled="@(_confirming || _packingListLoading || _packingList == null || _packingList.PackingLines.Count == 0)">
                        @(_confirming ? "Confirming..." : "Confirm Shipment")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ShipmentListDto> _shipments = new();
    private bool _loading = true;
    private string? _error;
    private string? _success;

    private ShipmentListDto? _shipDialogShipment;
    private ShipmentPackingListDto? _packingList;
    private bool _packingListLoading;
    private bool _confirming;
    private string _trackingNumber = "";

    // Only shipments still in-house are confirmable here.
    private static readonly string[] OpenStatuses = { "Pending", "Packing", "ShowLot Packing" };

    protected override async Task OnInitializedAsync()
    {
        await LoadShipments();
        _loading = false;
    }

    private async Task LoadShipments()
    {
        var all = await Api.GetShipmentsAsync(null);
        _shipments = all.Where(s => OpenStatuses.Contains(s.Status))
            .OrderBy(s => s.CreatedAt)
            .ToList();
    }

    private async Task OpenShipDialog(ShipmentListDto s)
    {
        _shipDialogShipment = s;
        _trackingNumber = s.TrackingNumber ?? "";
        _packingList = null;
        _packingListLoading = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            _packingList = await Api.GetShipmentPackingListAsync(s.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _shipDialogShipment = null;
        }
        _packingListLoading = false;
    }

    private void CloseShipDialog()
    {
        _shipDialogShipment = null;
        _packingList = null;
    }

    private async Task ConfirmShip()
    {
        if (_shipDialogShipment == null) return;
        _confirming = true;
        _error = null;
        StateHasChanged();

        var (ok, err) = await Api.UpdateShipmentStatusAsync(_shipDialogShipment.Id,
            new { status = "Shipped", trackingNumber = _trackingNumber });
        if (!ok)
        {
            _error = err;
            _confirming = false;
            return;
        }

        _success = $"Shipment {_shipDialogShipment.ShipmentNumber} confirmed shipped" +
                   $" ({_packingList?.Totals.Boxes ?? 0} box(es), {_packingList?.Totals.Skins ?? 0:N0} skins).";
        CloseShipDialog();
        await LoadShipments();
        _confirming = false;
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Packing" => "bg-info text-dark",
        "ShowLot Packing" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
