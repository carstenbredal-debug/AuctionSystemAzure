@page "/admin/shipping"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Shipping - Admin</PageTitle>

<h3 class="mb-4">Shipping — Boxes Ready for Shipping</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_boxes.Count == 0)
{
    <div class="alert alert-info">No lots released for shipping yet.</div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label fw-bold">Filter by Customer</label>
            <select class="form-select" @bind="_selectedBuyer">
                <option value="">All Customers</option>
                @foreach (var buyer in _buyerNames)
                {
                    <option value="@buyer">@buyer</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Filter by Invoice</label>
            <select class="form-select" @bind="_selectedInvoice">
                <option value="">All Invoices</option>
                @foreach (var inv in _invoiceNumbers)
                {
                    <option value="@inv">@inv</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Shipping Address</label>
            <select class="form-select" @bind="_selectedAddressId">
                <option value="0">— Select Address —</option>
                @foreach (var a in _addresses)
                {
                    <option value="@a.Id">@a.Name — @a.AddressLine1, @a.City @a.Country @(a.IsDefault ? "(Default)" : "")</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary" @onclick="CreateShipmentFromSelected" disabled="@(_creating || _selectedBoxNumbers.Count == 0 || _selectedAddressId == 0)">
                @(_creating ? "Creating..." : $"Create Shipment ({_selectedBoxNumbers.Count} boxes)")
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Boxes</h5>
                    <h3>@GetFilteredBoxes().Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Total Skins</h5>
                    <h3>@GetFilteredBoxes().Sum(b => b.Skins)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Gross Weight (kg)</h5>
                    <h3>@GetFilteredBoxes().Sum(b => b.GrossWeight ?? 0).ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="section-body p-3">
                    <h5 class="card-title text-muted">Net Weight (kg)</h5>
                    <h3>@GetFilteredBoxes().Sum(b => b.NetWeight ?? 0).ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="section-container">
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th><input type="checkbox" @onchange="ToggleSelectAll" checked="@(_selectedBoxNumbers.Count == GetFilteredBoxes().Count && GetFilteredBoxes().Count > 0)" /></th>
                        <th>Invoice</th>
                        <th>Buyer</th>
                        <th>Lot #</th>
                        <th>Box #</th>
                        <th>Box Type</th>
                        <th>Skins</th>
                        <th>Volume (m³)</th>
                        <th>Gross Weight</th>
                        <th>Net Weight</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var box in GetFilteredBoxes())
                    {
                        <tr class="@(_selectedBoxNumbers.Contains(box.BoxNumber) ? "table-primary" : "")">
                            <td><input type="checkbox" checked="@_selectedBoxNumbers.Contains(box.BoxNumber)" @onchange="() => ToggleBoxSelection(box.BoxNumber)" /></td>
                            <td>@box.InvoiceNumber</td>
                            <td>@(box.BuyerName ?? "—")</td>
                            <td>@box.LotNumber</td>
                            <td>@box.BoxNumber</td>
                            <td>@box.BoxType</td>
                            <td>@box.Skins</td>
                            <td>@(box.VolumeM3.HasValue ? box.VolumeM3.Value.ToString("N4") : "—")</td>
                            <td>@(box.GrossWeight.HasValue ? box.GrossWeight.Value.ToString("N2") : "—")</td>
                            <td>@(box.NetWeight.HasValue ? box.NetWeight.Value.ToString("N2") : "—")</td>
                            <td>@(box.BoxLocation ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ShippingBoxDto> _boxes = new();
    private List<ShippingAddressListDto> _addresses = new();
    private bool _loading = true;
    private bool _creating;
    private string _selectedBuyer = "";
    private string _selectedInvoice = "";
    private int _selectedAddressId;
    private List<string> _buyerNames = new();
    private List<string> _invoiceNumbers = new();
    private HashSet<int> _selectedBoxNumbers = new();
    private string? _error;
    private string? _success;

    private List<ShippingBoxDto> GetFilteredBoxes()
    {
        var filtered = _boxes.AsEnumerable();
        if (!string.IsNullOrEmpty(_selectedBuyer))
            filtered = filtered.Where(b => b.BuyerName == _selectedBuyer);
        if (!string.IsNullOrEmpty(_selectedInvoice))
            filtered = filtered.Where(b => b.InvoiceNumber == _selectedInvoice);
        return filtered.ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _boxes = await Api.GetShippingBoxesAsync();
        _addresses = await Api.GetShippingAddressesAsync();
        _buyerNames = _boxes.Select(b => b.BuyerName ?? "—").Distinct().OrderBy(n => n).ToList();
        _invoiceNumbers = _boxes.Select(b => b.InvoiceNumber ?? "—").Distinct().OrderBy(n => n).ToList();
        var defaultAddr = _addresses.FirstOrDefault(a => a.IsDefault);
        _selectedAddressId = defaultAddr?.Id ?? 0;
        _loading = false;
    }

    private void ToggleBoxSelection(int boxNumber)
    {
        if (!_selectedBoxNumbers.Remove(boxNumber))
            _selectedBoxNumbers.Add(boxNumber);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedBoxNumbers = GetFilteredBoxes().Select(b => b.BoxNumber).ToHashSet();
        else
            _selectedBoxNumbers.Clear();
    }

    private async Task CreateShipmentFromSelected()
    {
        _creating = true;
        _error = null;
        _success = null;
        StateHasChanged();

        var selectedBoxes = _boxes.Where(b => _selectedBoxNumbers.Contains(b.BoxNumber)).ToList();
        var lotNumbers = selectedBoxes.Select(b => b.LotNumber).Distinct().ToList();
        var buyerId = selectedBoxes.Select(b => b.BuyerId).FirstOrDefault();

        // Need a shipper — use first available or default
        var shippers = await Api.GetShippersAsync();
        var shipperId = shippers.FirstOrDefault()?.Id ?? 0;
        if (shipperId == 0)
        {
            _error = "No shippers configured. Please add a shipper first.";
            _creating = false;
            return;
        }

        var payload = new
        {
            shipperId,
            buyerId,
            shippingAddressId = _selectedAddressId > 0 ? (int?)_selectedAddressId : null,
            trackingNumber = "",
            notes = "",
            lotNumbers,
            boxNumbers = _selectedBoxNumbers.ToList()
        };

        try
        {
            var (ok, err, num) = await Api.CreateShipmentAsync(payload);
            if (!ok)
            {
                _error = err;
                _creating = false;
                return;
            }
            _success = $"Shipment {num} created with {selectedBoxes.Count} box(es) from {lotNumbers.Count} lot(s).";
            _selectedBoxNumbers.Clear();
            _boxes = await Api.GetShippingBoxesAsync();
            _buyerNames = _boxes.Select(b => b.BuyerName ?? "—").Distinct().OrderBy(n => n).ToList();
            _invoiceNumbers = _boxes.Select(b => b.InvoiceNumber ?? "—").Distinct().OrderBy(n => n).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _creating = false;
    }
}
