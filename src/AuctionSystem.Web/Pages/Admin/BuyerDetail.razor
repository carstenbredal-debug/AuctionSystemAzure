            <div class="card-header">
                <strong>Purchases</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot</th>
                            <th>Quantity</th>
                            <th>Price/Unit</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Allocated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_allocations.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No purchases yet.</td></tr>
                        }
                        @foreach (var alloc in _allocations)
                        {
                            <tr>
                                <td><strong>@(alloc.Lot != null ? alloc.Lot.LotNumber.ToString() : $"Lot {alloc.LotId}")</strong></td>
                                <td>@alloc.Quantity</td>
                                <td>@alloc.PricePerUnit.ToString("C")</td>
                                <td><strong>@alloc.TotalPrice.ToString("C")</strong></td>
                                <td>
                                    <span class="badge bg-@GetAllocationStatusColor(alloc.Status)">@alloc.Status</span>
                                </td>
                                <td>@alloc.AllocatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
