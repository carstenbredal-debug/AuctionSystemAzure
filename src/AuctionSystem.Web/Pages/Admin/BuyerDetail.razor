            PaymentTerm = _buyer.PaymentTerm, PaymentMethod = _buyer.PaymentMethod,
            Currency = _buyer.Currency, Language = _buyer.Language,
            BankName = _buyer.BankName, BankAddress = _buyer.BankAddress,
