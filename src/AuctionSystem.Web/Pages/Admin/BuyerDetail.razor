@page "/admin/buyers/{BuyerId:int}"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Buyer Details - Admin</PageTitle>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyer == null)
{
    <div class="alert alert-warning">Buyer not found.</div>
    <a href="admin/buyers" class="btn btn-secondary">Back to Buyers</a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">@_buyer.BuyerNumber — @_buyer.Name</h4>
        </div>
        <a href="admin/buyers" class="btn btn-outline-secondary btn-sm">Back to Buyers</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "info" ? "active" : "")" @onclick='() => _activeTab = "info"'>Information</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "brokers" ? "active" : "")" @onclick='() => _activeTab = "brokers"'>
                Broker Relations <span class="badge bg-secondary ms-1">@_buyer.Brokers.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "purchases" ? "active" : "")" @onclick='() => _activeTab = "purchases"'>
                Purchases <span class="badge bg-secondary ms-1">@_purchases.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "takeback" ? "active" : "")" @onclick='() => _activeTab = "takeback"'>
                Takeback <span class="badge bg-@(_takebackRequests.Count(t => t.Status == CustomerRequestStatus.Pending) > 0 ? "warning" : "secondary") ms-1">@_takebackRequests.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "financial" ? "active" : "")" @onclick='() => _activeTab = "financial"'>
                Financial <span class="badge bg-secondary ms-1">@_buyerInvoices.Count</span>
            </button>
        </li>
    </ul>

    @if (_activeTab == "info")
    {
        <!-- General Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>General</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editDto!.BuyerNumber" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editDto!.Name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Credit Limit</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editDto!.CreditLimit" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Blocked</label>
                        <select class="form-select" @bind="_editDto!.Blocked">
                            <option value="">— (None)</option>
                            <option value="Ship">Ship</option>
                            <option value="Invoice">Invoice</option>
                            <option value="All">All</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address & Contact Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>Address & Contact</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input class="form-control" @bind="_editDto!.AddressLine1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address 2</label>
                        <input class="form-control" @bind="_editDto!.AddressLine2" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Country/Region Code</label>
                        <select class="form-select" @bind="_editDto!.Country">
                            <option value="">Select Country...</option>
                            @foreach (var c in _bcCountries)
                            {
                                <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Post Code</label>
                        <input class="form-control" @bind="_editDto!.PostalCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">City</label>
                        <input class="form-control" @bind="_editDto!.City" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Contact Name</label>
                        <input class="form-control" @bind="_editDto!.ContactName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone No.</label>
                        <input class="form-control" @bind="_editDto!.ContactPhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mobile Phone No.</label>
                        <input class="form-control" @bind="_editDto!.MobilePhone" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">E-Mail</label>
                        <input class="form-control" type="email" @bind="_editDto!.ContactEmail" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Home Page</label>
                        <input class="form-control" @bind="_editDto!.HomePage" placeholder="https://" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoicing Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>Invoicing</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">VAT Registration No.</label>
                        <input class="form-control" @bind="_editDto!.VatRegistrationNo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Registration No.</label>
                        <input class="form-control" @bind="_editDto!.RegistrationNo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Currency Code</label>
                        <select class="form-select" @bind="_editDto!.Currency">
                            <option value="">Select Currency...</option>
                            @foreach (var c in _bcCurrencies)
                            {
                                <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Gen. Bus. Posting Group</label>
                        <select class="form-select" @bind="_editDto!.GenBusPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcGenBusPostingGroups)
                            {
                                <option value="@g.Code">@g.Description (@g.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">VAT Bus. Posting Group</label>
                        <select class="form-select" @bind="_editDto!.VatBusPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcVatBusPostingGroups)
                            {
                                <option value="@g.Code">@g.Description (@g.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Customer Posting Group</label>
                        <select class="form-select" @bind="_editDto!.CustomerPostingGroup">
                            <option value="">Select...</option>
                            @foreach (var g in _bcCustomerPostingGroups)
                            {
                                <option value="@g.Code">@g.Code</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>Payments</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Payment Terms Code</label>
                        <select class="form-select" @bind="_editDto!.PaymentTerm">
                            <option value="">Select...</option>
                            @foreach (var t in _bcPaymentTerms)
                            {
                                <option value="@t.Code">@t.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Payment Method Code</label>
                        <input class="form-control" @bind="_editDto!.PaymentMethod" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="_editDto!.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-2">
            <button class="btn btn-success me-2" @onclick="SaveEdit">Save</button>
        </div>
    }

    @if (_activeTab == "brokers")
    {
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <strong>Link to Broker</strong>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Broker</label>
                        <select class="form-select" @bind="_linkBrokerId">
                            <option value="0">— Select Broker —</option>
                            @foreach (var b in _allBrokers.Where(b => !_buyer.Brokers.Any(lb => lb.Id == b.Id)))
                            {
                                <option value="@b.Id">@b.CompanyName (@b.BrokerNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-info text-white" @onclick="LinkToBroker" disabled="@(_linkBrokerId == 0)">
                            Link to Broker
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Broker Relationships</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Number</th>
                            <th>Broker</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_buyer.Brokers.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No broker relationships.</td></tr>
                        }
                        @foreach (var broker in _buyer.Brokers)
                        {
                            <tr>
                                <td style="cursor: pointer;" @onclick="() => ViewBroker(broker.Id)"><strong>@broker.BrokerNumber</strong></td>
                                <td style="cursor: pointer;" @onclick="() => ViewBroker(broker.Id)">@broker.CompanyName</td>
                                <td>@broker.ContactEmail</td>
                                <td>@broker.ContactPhone</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => UnlinkBroker(broker.Id)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "purchases")
    {
        <div class="row mb-3">
            <div class="col-md-2">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Total Lots</h5>
                    <h2>@_purchases.Count</h2>
                </div></div>
            </div>
            <div class="col-md-2">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Total Skins</h5>
                    <h2>@_purchases.Sum(p => p.TotalSkins).ToString("N0")</h2>
                </div></div>
            </div>
            <div class="col-md-2">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Hammer Price</h5>
                    <h2>€@_purchases.Sum(p => p.TotalSkins * p.PriceEur).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-2">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Auction Fees</h5>
                    <h2>€@_purchases.Sum(p => CalcAuctionFee(p.TotalSkins, p.PriceEur)).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-2">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Commission</h5>
                    <h2>€@_purchases.Sum(p => p.CommissionAmount ?? 0).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-2">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Total Value</h5>
                    <h2>€@((_purchases.Sum(p => p.TotalSkins * p.PriceEur) + _purchases.Sum(p => CalcAuctionFee(p.TotalSkins, p.PriceEur)) + _purchases.Sum(p => p.CommissionAmount ?? 0)).ToString("N2"))</h2>
                </div></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_returnMessage))
        {
            <div class="alert @(_returnMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
                @_returnMessage
                <button type="button" class="btn-close" @onclick="() => _returnMessage = null"></button>
            </div>
        }
        @if (_purchases.Any())
        {
            <div class="card mb-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <strong>Request return for selected lots:</strong>
                    <button class="btn btn-warning" @onclick="RequestReturn" disabled="@(_requestingReturn || _selectedPurchaseIds.Count == 0)">
                        @if (_requestingReturn) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Request Return (@_selectedPurchaseIds.Count)
                    </button>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:40px;"><input type="checkbox" @onchange="ToggleAllPurchases" checked="@_allPurchasesSelected" /></th>
                            <th>Lot #</th><th>Type</th><th>Gender</th><th>Color</th><th>Quality</th><th>Skins</th><th>Price (EUR)</th><th>Hammer Price</th><th>Auction Fee</th><th>Commission</th><th>Broker</th><th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_purchases.Count == 0)
                        { <tr><td colspan="13" class="text-center text-muted py-4">No purchases yet.</td></tr> }
                        @foreach (var p in _purchases)
                        {
                            <tr>
                                <td><input type="checkbox" checked="@_selectedPurchaseIds.Contains(p.Id)" @onchange="() => TogglePurchaseSelection(p.Id)" /></td>
                                <td><strong>@p.LotNumber</strong></td>
                                <td>@(p.SalesType ?? "—")</td><td>@(p.Gender ?? "—")</td><td>@(p.Color ?? "—")</td><td>@(p.Quality ?? "—")</td>
                                <td>@p.TotalSkins</td><td>€@p.PriceEur.ToString("N2")</td><td>€@((p.TotalSkins * p.PriceEur).ToString("N2"))</td><td>€@CalcAuctionFee(p.TotalSkins, p.PriceEur).ToString("N2")</td><td>€@((p.CommissionAmount ?? 0).ToString("N2"))</td>
                                <td>@(p.BrokerNumber ?? "") — @(p.BrokerName ?? "")</td>
                                <td>@(p.SoldAt?.ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "financial")
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Total Invoices</h5>
                    <h2>@_buyerInvoices.Count(i => !i.IsCreditNote)</h2>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Outstanding</h5>
                    <h2>€@_buyerInvoices.Where(i => !i.IsCreditNote).Sum(i => i.TotalAmount).ToString("N2")</h2>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Credit Notes</h5>
                    <h2>@_buyerInvoices.Count(i => i.IsCreditNote)</h2>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-center"><div class="card-body">
                    <h5 class="card-title text-muted">Total Amount</h5>
                    <h2>€@_buyerInvoices.Sum(i => i.TotalAmount).ToString("N2")</h2>
                </div></div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Invoices</strong> <span class="badge bg-secondary">@_buyerInvoices.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Type</th>
                            <th>Number</th>
                            <th>Lots</th>
                            <th>Subtotal</th>
                            <th>Auction Fee</th>
                            <th>Commission</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_buyerInvoices.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No invoices for this buyer yet.</td></tr>
                        }
                        @foreach (var inv in _buyerInvoices)
                        {
                            <tr class="@(inv.IsCreditNote ? "table-warning" : "")">
                                <td>
                                    @if (inv.IsCreditNote)
                                    {
                                        <span class="badge bg-warning text-dark">Credit Note</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Invoice</span>
                                    }
                                </td>
                                <td>
                                    <strong>@inv.InvoiceNumber</strong>
                                    @if (!string.IsNullOrEmpty(inv.OriginalInvoiceNumber))
                                    {
                                        <br /><small class="text-muted">Ref: @inv.OriginalInvoiceNumber</small>
                                    }
                                </td>
                                <td>@inv.LinesCount</td>
                                <td>€@inv.SubTotal.ToString("N2")</td>
                                <td>€@inv.AuctionFee.ToString("N2")</td>
                                <td>€@inv.Commission.ToString("N2")</td>
                                <td><strong>€@inv.TotalAmount.ToString("N2")</strong></td>
                                <td>@inv.InvoiceDate.ToString("d")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inv.PdfUrl))
                                    {
                                        <a href="@inv.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">PDF</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_activeTab == "takeback")
    {
        @if (!string.IsNullOrEmpty(_takebackMessage))
        {
            <div class="alert @(_takebackMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
                @_takebackMessage
                <button type="button" class="btn-close" @onclick="() => _takebackMessage = null"></button>
            </div>
        }
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th><th>Type</th><th>Color</th><th>Skins</th><th>Price (EUR)</th><th>Hammer Price</th><th>Broker</th><th>Initiated By</th><th>Requested</th><th>Status</th><th style="width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_takebackRequests.Count == 0)
                        { <tr><td colspan="11" class="text-center text-muted py-4">No takeback requests.</td></tr> }
                        @foreach (var t in _takebackRequests)
                        {
                            <tr>
                                <td><strong>@t.LotNumber</strong></td>
                                <td>@(t.SalesType ?? "—")</td><td>@(t.Color ?? "—")</td>
                                <td>@t.TotalSkins</td><td>€@t.PriceEur.ToString("N2")</td><td>€@((t.TotalSkins * t.PriceEur).ToString("N2"))</td>
                                <td>@(t.BrokerNumber ?? "") — @(t.BrokerName ?? "")</td>
                                <td><span class="badge bg-info">@t.InitiatedBy</span></td>
                                <td>@t.RequestedAt.ToString("g")</td>
                                <td><span class="badge bg-@(t.Status == CustomerRequestStatus.Pending ? "warning" : t.Status == CustomerRequestStatus.Approved ? "success" : "danger")">@t.Status</span></td>
                                <td>
                                    @if (t.Status == CustomerRequestStatus.Pending)
                                    {
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => RespondTakeback(t.Id, true)">Approve</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RespondTakeback(t.Id, false)">Decline</button>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@(t.RespondedAt?.ToString("g") ?? "")</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int BuyerId { get; set; }

    private BuyerDto? _buyer;
    private List<BrokerCustomerRequestDto> _requests = new();
    private List<AuctionResultDto> _purchases = new();
    private List<TakebackRequestDto> _takebackRequests = new();
    private List<BrokerDto> _allBrokers = new();
    private int _linkBrokerId;
    private decimal _auctionFeePercent;
    private decimal _handlingFeePerSkin;
    private HashSet<int> _selectedPurchaseIds = new();
    private bool _allPurchasesSelected => _purchases.Count > 0 && _purchases.All(p => _selectedPurchaseIds.Contains(p.Id));
    private bool _requestingReturn;
    private string? _returnMessage;
    private bool _returnMessageIsError;
    private string? _takebackMessage;
    private bool _takebackMessageIsError;
    private bool _loading = true;
    private BuyerDto? _editDto;
    private string? _message;
    private bool _messageIsError;
    private string _activeTab = "info";
    private List<BcCountryRegionDto> _bcCountries = new();
    private List<BcCurrencyDto> _bcCurrencies = new();
    private List<BcPostingGroupDto> _bcGenBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcVatBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcCustomerPostingGroups = new();
    private List<BcPaymentTermDto> _bcPaymentTerms = new();
    private List<InvoiceSummaryDto> _buyerInvoices = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        _buyer = await Api.GetBuyerAsync(BuyerId);
        _allBrokers = await Api.GetBrokersAsync();
        if (_buyer != null)
        {
            _requests = await Api.GetCustomerRequestsByBuyerAsync(BuyerId);
            _purchases = await Api.GetAuctionResultsByBuyerAsync(BuyerId);
            _takebackRequests = await Api.GetTakebackRequestsByBuyerAsync(BuyerId);
            _buyerInvoices = await Api.GetInvoicesByBuyerAsync(BuyerId);
            await LoadFeeParameters();
            InitEditDto();
        }
        _bcCountries = await Api.GetBcCountriesAsync();
        _bcCurrencies = await Api.GetBcCurrenciesAsync();
        _bcGenBusPostingGroups = await Api.GetBcGenBusPostingGroupsAsync();
        _bcVatBusPostingGroups = await Api.GetBcVatBusPostingGroupsAsync();
        _bcCustomerPostingGroups = await Api.GetBcCustomerPostingGroupsAsync();
        _bcPaymentTerms = await Api.GetBcPaymentTermsAsync();
    }

    private async Task LoadFeeParameters()
    {
        var parameters = await Api.GetParametersAsync();
        var auctionFee = parameters.FirstOrDefault(p => p.Key == "AuctionFee");
        var handlingFee = parameters.FirstOrDefault(p => p.Key == "HandlingFee");
        if (auctionFee != null) decimal.TryParse(auctionFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _auctionFeePercent);
        if (handlingFee != null) decimal.TryParse(handlingFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _handlingFeePerSkin);
    }

    private decimal CalcAuctionFee(int skins, decimal priceEur)
    {
        var hammerPrice = skins * priceEur;
        var handlingFee = skins * _handlingFeePerSkin;
        return (hammerPrice + handlingFee) * _auctionFeePercent / 100m;
    }

    private void TogglePurchaseSelection(int id)
    {
        if (!_selectedPurchaseIds.Remove(id)) _selectedPurchaseIds.Add(id);
    }

    private void ToggleAllPurchases(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedPurchaseIds = _purchases.Select(p => p.Id).ToHashSet();
        else
            _selectedPurchaseIds.Clear();
    }

    private async Task RequestReturn()
    {
        _returnMessage = null;
        if (_selectedPurchaseIds.Count == 0) return;
        _requestingReturn = true;
        try
        {
            var resp = await Api.RequestTakebackByBuyerAsync(_selectedPurchaseIds.ToList());
            if (resp.IsSuccessStatusCode)
            {
                _returnMessage = $"Return requested for {_selectedPurchaseIds.Count} lot(s). Awaiting broker approval.";
                _returnMessageIsError = false;
                _selectedPurchaseIds.Clear();
                await LoadData();
            }
            else
            {
                try
                {
                    var errorJson = await resp.Content.ReadFromJsonAsync<TakebackErrorResponse>();
                    if (errorJson?.Error == "Lot Sold")
                    {
                        _returnMessage = $"Lot Sold — {errorJson.Message}";
                    }
                    else
                    {
                        _returnMessage = "Failed to request return. Please try again.";
                    }
                }
                catch
                {
                    _returnMessage = "Failed to request return. Please try again.";
                }
                _returnMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _returnMessage = $"Error: {ex.Message}";
            _returnMessageIsError = true;
        }
        finally { _requestingReturn = false; }
    }

    private class TakebackErrorResponse
    {
        public string? Error { get; set; }
        public string? Message { get; set; }
    }

    private async Task RespondTakeback(int requestId, bool approve)
    {
        _takebackMessage = null;
        try
        {
            var resp = await Api.RespondTakebackAsync(requestId, approve);
            if (resp.IsSuccessStatusCode)
            {
                _takebackMessage = approve ? "Takeback approved. Lot returned." : "Takeback declined.";
                _takebackMessageIsError = false;
                await LoadData();
            }
            else
            {
                _takebackMessage = "Failed to respond. Please try again.";
                _takebackMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _takebackMessage = $"Error: {ex.Message}";
            _takebackMessageIsError = true;
        }
    }

    private void ViewBroker(int id) => Nav.NavigateTo($"admin/brokers/{id}");

    private async Task LinkToBroker()
    {
        if (_linkBrokerId == 0) return;
        var result = await Api.AdminCreateCustomerLinkAsync(_linkBrokerId, BuyerId);
        if (result != null)
        {
            _message = "Buyer linked to broker.";
            _messageIsError = false;
        }
        else
        {
            _message = "Failed to link buyer to broker.";
            _messageIsError = true;
        }
        _linkBrokerId = 0;
        await LoadData();
    }

    private async Task UnlinkBroker(int brokerId)
    {
        await Api.UnlinkBrokerBuyerAsync(brokerId, BuyerId);
        _message = "Broker link removed.";
        _messageIsError = false;
        await LoadData();
    }

