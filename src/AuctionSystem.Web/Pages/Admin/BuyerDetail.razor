}

@code {
    [Parameter] public int BuyerId { get; set; }

    private BuyerDto? _buyer;
    private List<BrokerCustomerRequestDto> _requests = new();
    private List<LotAllocationDto> _allocations = new();
    private bool _loading = true;
    private bool _editing;
    private BuyerDto? _editDto;
    private string? _message;
    private bool _messageIsError;
    private string _activeTab = "info";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        var allBuyers = await Api.GetAllBuyersAsync();
        _buyer = allBuyers.FirstOrDefault(b => b.Id == BuyerId);
        if (_buyer != null)
        {
            _requests = await Api.GetCustomerRequestsByBuyerAsync(BuyerId);
            _allocations = await Api.GetAllocationsByBuyerAsync(BuyerId);
        }
    }

    private void StartEdit()
    {
        _editDto = new BuyerDto
        {
            Id = _buyer!.Id, BuyerNumber = _buyer.BuyerNumber, Name = _buyer.Name,
            Name2 = _buyer.Name2, ErpAccountNumber = _buyer.ErpAccountNumber,
            SearchName = _buyer.SearchName, ContactName = _buyer.ContactName,
            AddressLine1 = _buyer.AddressLine1, AddressLine2 = _buyer.AddressLine2,
            Country = _buyer.Country, PostalCode = _buyer.PostalCode, City = _buyer.City,
            ContactPhone = _buyer.ContactPhone, MobilePhone = _buyer.MobilePhone,
            ContactEmail = _buyer.ContactEmail, HomePage = _buyer.HomePage,
            VatRegistrationNo = _buyer.VatRegistrationNo, RegistrationNo = _buyer.RegistrationNo,
            CustomerGroup = _buyer.CustomerGroup, SalesPerson = _buyer.SalesPerson,
            PaymentTerm = _buyer.PaymentTerm, PaymentMethod = _buyer.PaymentMethod,
            Currency = _buyer.Currency, Language = _buyer.Language,
            BankName = _buyer.BankName, BankAddress = _buyer.BankAddress,
            BankIbanNumber = _buyer.BankIbanNumber, SwiftCode = _buyer.SwiftCode,
            BankCountry = _buyer.BankCountry, Assignee = _buyer.Assignee,
            AssignmentOfReceivable = _buyer.AssignmentOfReceivable, IsActive = _buyer.IsActive,
            Address = _buyer.Address, BrokerId = _buyer.BrokerId
        };
        _editing = true;
        _message = null;
    }

    private void CancelEdit() { _editing = false; _editDto = null; }

    private async Task SaveEdit()
    {
        if (_editDto == null) return;
        if (string.IsNullOrWhiteSpace(_editDto.BuyerNumber) || string.IsNullOrWhiteSpace(_editDto.Name))
        { _message = "Buyer Number and Name are required."; _messageIsError = true; return; }

        await Api.UpdateBuyerAsync(_editDto.Id, _editDto);
        _message = "Buyer updated."; _messageIsError = false;
        _editing = false; _editDto = null;
        await LoadData();
    }

    private string GetStatusColor(CustomerRequestStatus status) => status switch
    {
        CustomerRequestStatus.Approved => "success",
        CustomerRequestStatus.Pending => "warning",
        CustomerRequestStatus.Declined => "danger",
        _ => "secondary"
    };

    private string GetStatusText(CustomerRequestStatus status) => status switch
    {
        CustomerRequestStatus.Approved => "Approved",
        CustomerRequestStatus.Pending => "Awaiting Approval",
        CustomerRequestStatus.Declined => "Declined",
        _ => "Unknown"
    };

    private string GetAllocationStatusColor(AllocationStatus status) => status switch
    {
        AllocationStatus.Allocated => "success",
        AllocationStatus.Pending => "warning",
        AllocationStatus.Cancelled => "danger",
        _ => "secondary"
    };
}
