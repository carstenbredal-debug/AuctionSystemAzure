                            <th>Status</th>
                            <th>Requested</th>
                            <th>Responded</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_requests.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No broker relationships.</td></tr>
                        }
                        @foreach (var req in _requests)
                        {
                            <tr>
                                <td><strong>@(req.Broker?.CompanyName ?? $"Broker {req.BrokerId}")</strong></td>
                                <td>
                                    <span class="badge bg-@GetStatusColor(req.Status)">@GetStatusText(req.Status)</span>
                                </td>
                                <td>@req.RequestedAt.ToString("g")</td>
                                <td>@(req.RespondedAt?.ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

