                            <input class="form-control" @bind="_editDto!.Name2" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">ERP Account Number</label>
                            <input class="form-control" @bind="_editDto!.ErpAccountNumber" />
                        </div>
                        <div class="col-md-4">
