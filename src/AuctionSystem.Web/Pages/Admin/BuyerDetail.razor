        <div>
            <h1>@_buyer.Name</h1>
            <p class="text-muted mb-0">Buyer #@_buyer.BuyerNumber</p>
        </div>
        <a href="admin/buyers" class="btn btn-outline-secondary">Back to Buyers</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "info" ? "active" : "")" @onclick='() => _activeTab = "info"'>Information</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "brokers" ? "active" : "")" @onclick='() => _activeTab = "brokers"'>
                Broker Relations <span class="badge bg-secondary ms-1">@_requests.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "purchases" ? "active" : "")" @onclick='() => _activeTab = "purchases"'>
                Purchases <span class="badge bg-secondary ms-1">@_allocations.Count</span>
