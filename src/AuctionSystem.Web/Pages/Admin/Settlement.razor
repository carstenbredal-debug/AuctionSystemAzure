@page "/admin/settlement"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject IJSRuntime JS

<PageTitle>Settlement - Finance</PageTitle>

<h1>Settlement</h1>
<p class="text-muted">Farmer settlement — export the raw sales results per farmer.</p>

<div class="row mb-3" style="max-width:520px">
    <div class="col">
        <label class="form-label">Auction</label>
        <select class="form-select" @bind="_auctionId">
            <option value="0">— select an auction —</option>
            @foreach (var a in _auctions ?? new())
            {
                <option value="@a.Id">@a.AuctionNumber — @a.Title</option>
            }
        </select>
    </div>
</div>

<button class="btn btn-success me-2" @onclick="ExportRaw" disabled="@(_auctionId <= 0)"
        title="Excel workbook: one sheet per farmer — delivered vs in auction, sold/unsold, salesresult with grading fee and VAT, and the Type/Gender/Group breakdown">
    <i class="bi bi-file-earmark-excel me-1"></i>Export Sales Result (RAW)
</button>
<button class="btn btn-outline-primary me-2" @onclick="ExportSalesNotes" disabled="@(_auctionId <= 0)"
        title="ZIP with a sales note PDF per farmer: sold Type/Gender/Group breakdown, SubTotal, VAT and TOTAL — invoice layout">
    <i class="bi bi-file-earmark-pdf me-1"></i>Sales Notes (all farmers)
</button>
<button class="btn btn-outline-secondary" @onclick="ExportGradingFeeNotes" disabled="@(_auctionId <= 0)"
        title="ZIP with a grading fee note PDF per farmer: sold skins x the farmer's contractual fee with VAT. Farmers with fee 0 are skipped">
    <i class="bi bi-file-earmark-pdf me-1"></i>Grading Fee Notes (all farmers)
</button>

@code {
    private List<AuctionDto>? _auctions;
    private int _auctionId;

    protected override async Task OnInitializedAsync() => _auctions = await Api.GetAuctionsAsync();

    private async Task ExportRaw()
    {
        await JS.InvokeVoidAsync("open", $"api/settlements/export-settlement-xlsx?auctionId={_auctionId}", "_blank");
    }

    private async Task ExportSalesNotes()
    {
        await JS.InvokeVoidAsync("open", $"api/settlements/sales-notes-pdf?auctionId={_auctionId}", "_blank");
    }

    private async Task ExportGradingFeeNotes()
    {
        await JS.InvokeVoidAsync("open", $"api/settlements/grading-fee-notes-zip?auctionId={_auctionId}", "_blank");
    }
}
