@page "/"
@attribute [Authorize]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Home - Kopenhagen Fur</PageTitle>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h2 class="h4 mb-3">Welcome to the Kopenhagen Fur Portal</h2>
        <p>We are committed to providing you with a reliable and user-friendly experience. As we continue to improve our services, your feedback is highly valued. If you have suggestions, comments, or ideas that could help us enhance the platform, we would be pleased to hear from you.</p>
        <p>If you require technical assistance or experience any issues while using the portal, please contact our IT Support team at <a href="mailto:ITSupport@@kopenhagenfur.com">ITSupport@@kopenhagenfur.com</a>. We will do our best to assist you as quickly as possible.</p>
        <p class="mb-0">Thank you for being part of Kopenhagen Fur, and we hope you enjoy using our platform.</p>
    </div>
</div>

@if (loading)
{
    <p>Loading...</p>
}
else if (_isBroker)
{
    @if (_activeAuction == null)
    {
        <p class="text-muted">No active auction at the moment.</p>
    }
    else
    {
        <p class="text-muted">@_activeAuction.AuctionNumber - @_activeAuction.Title</p>

        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("broker/lots")'>Go to Lots</button>
    }
}
else
{
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="section-container">
                <div class="section-header">Auctions</div>
                <div class="section-body p-3">
                    <table class="table table-sm">
                        <thead><tr><th>Number</th><th>Title</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var a in stats.RecentAuctions)
                            {
                                <tr>
                                    <td><a href="/farmer/auction/@a.Id">@a.AuctionNumber</a></td>
                                    <td>@a.Title</td>
                                    <td>@a.ScheduledDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-@GetStatusColor(a.Status)">@a.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private DashboardStats stats = new();

    private bool _isBroker;
    private AuctionDto? _activeAuction;
    private List<AuctionResultDto> _brokerResults = new();
    private decimal _auctionFeePercent;
    private decimal _handlingFeePerSkin;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isBroker = auth.User.IsInRole("Broker");

        if (_isBroker)
        {
            await LoadBrokerDashboard(auth);
        }
        else
        {
            stats = await Api.GetDashboardAsync();
        }

        loading = false;
    }

    private async Task LoadBrokerDashboard(Microsoft.AspNetCore.Components.Authorization.AuthenticationState auth)
    {
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid == null) return;

        var user = await Api.GetCurrentUserAsync(oid);
        if (user?.BrokerId == null) return;

        // Only ever one active auction; show the broker's cards for it directly.
        var auctions = await Api.GetAuctionsAsync();
        _activeAuction = auctions.FirstOrDefault(a => a.Status == AuctionStatus.Active);
        if (_activeAuction == null) return;

        var allResults = await Api.GetAuctionResultsByBrokerAsync(user.BrokerId.Value);
        _brokerResults = allResults.Where(r => r.AuctionId == _activeAuction.Id).ToList();
        await LoadFeeParameters();
    }

    private async Task LoadFeeParameters()
    {
        var parameters = await Api.GetParametersAsync();
        var auctionFee = parameters.FirstOrDefault(p => p.Key == "AuctionFee");
        var handlingFee = parameters.FirstOrDefault(p => p.Key == "HandlingFee");
        if (auctionFee != null) decimal.TryParse(auctionFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _auctionFeePercent);
        if (handlingFee != null) decimal.TryParse(handlingFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _handlingFeePerSkin);
    }

    private decimal CalcAuctionFee(int skins, decimal priceEur)
    {
        var hammerPrice = skins * priceEur;
        var handlingFee = skins * _handlingFeePerSkin;
        return (hammerPrice + handlingFee) * _auctionFeePercent / 100m;
    }

    private string GetStatusColor(AuctionStatus status) => status switch
    {
        AuctionStatus.Draft => "secondary",
        AuctionStatus.Active => "success",
        AuctionStatus.Closed => "primary",
        _ => "secondary"
    };
}
