@page "/"
@attribute [Authorize]
@inject AuctionApiClient Api

<PageTitle>Dashboard - Auction System</PageTitle>

<h1>Auction System Dashboard</h1>
<p class="text-muted">Connected to Azure SQL Server</p>

@if (loading)
{
    <p>Loading...</p>
}
else
{
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="section-container">
                <div class="section-header">Recent Auctions</div>
                <div class="section-body p-3">
                    <table class="table table-sm">
                        <thead><tr><th>Number</th><th>Title</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var a in stats.RecentAuctions)
                            {
                                <tr>
                                    <td><a href="/farmer/auction/@a.Id">@a.AuctionNumber</a></td>
                                    <td>@a.Title</td>
                                    <td>@a.ScheduledDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-@GetStatusColor(a.Status)">@a.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="section-container">
                <div class="section-header">Bid Activity</div>
                <div class="section-body p-3">
                    <p>Total bids: <strong>@stats.TotalBids</strong></p>
                    <p>Pending invoices: <strong>@stats.PendingInvoices</strong></p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private DashboardStats stats = new();

    protected override async Task OnInitializedAsync()
    {
        stats = await Api.GetDashboardAsync();
        loading = false;
    }

    private string GetStatusColor(AuctionStatus status) => status switch
    {
        AuctionStatus.Draft => "secondary",
        AuctionStatus.Active => "success",
        AuctionStatus.Closed => "primary",
        _ => "secondary"
    };
}
