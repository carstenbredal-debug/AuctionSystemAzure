@page "/typist/disagreements"
@attribute [Authorize(Roles = "Typist")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<PageTitle>Disagreements</PageTitle>

<h1>Disagreements</h1>
<p class="text-muted">Lots where the two typists entered different values. Both typists must re-enter to resolve.</p>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success alert-dismissible">
        @_successMessage
        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Loading disagreements...</p>
    </div>
}
else if (_disagreements.Count == 0)
{
    <div class="alert alert-info">No disagreements to resolve.</div>
}
else
{
    @foreach (var group in _disagreements)
    {
        <div class="card mb-4">
            <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
                <strong>Lot #@group.LotNumber</strong>
                <span class="badge bg-danger">Disagreement</span>
            </div>
            <div class="card-body">
                <h6>Original Entries:</h6>
                <table class="table table-sm table-bordered mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>Typist</th>
                            <th>Broker</th>
                            <th>Price (EUR)</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in group.Entries)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">Slot @entry.TypistSlot</span>
                                    @entry.TypistName
                                </td>
                                <td>@(_currentUser != null && entry.TypistUserId == _currentUser.Id ? $"{entry.BrokerNumber} — {entry.BrokerName}" : "—")</td>
                                <td>@(_currentUser != null && entry.TypistUserId == _currentUser.Id ? $"€{entry.PriceEur:N2}" : "—")</td>
                                <td><small>@entry.EnteredAt.ToString("HH:mm:ss")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_submittedLots.Contains(group.LotNumber))
                {
                    <div class="alert alert-success mb-0">
                        Re-entry recorded for Lot #@group.LotNumber.
                    </div>
                }
                else
                {
                    <h6>Re-enter:</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label"><strong>Broker</strong></label>
                            <select class="form-select" @bind="@GetReentryState(group.LotNumber).BrokerId">
                                <option value="0">— Select Broker —</option>
                                @foreach (var broker in _brokers)
                                {
                                    <option value="@broker.Id">@broker.BrokerNumber — @broker.CompanyName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><strong>Price per skin (EUR)</strong></label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" step="0.01" class="form-control"
                                       @bind="@GetReentryState(group.LotNumber).PriceEur" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button class="btn btn-primary w-100"
                                    @onclick="() => SubmitReentry(group.LotNumber)"
                                    disabled="@_submitting">
                                @if (_submitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Re-enter
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<TypistDisagreementGroup> _disagreements = new();
    private List<BrokerDto> _brokers = new();
    private AppUserDto? _currentUser;
    private bool _loading = true;
    private bool _submitting;
    private string? _successMessage;
    private string? _errorMessage;
    private Dictionary<int, ReentryState> _reentryStates = new();
    private HashSet<int> _submittedLots = new();
    private System.Threading.Timer? _pollTimer;

    private class ReentryState
    {
        public int BrokerId { get; set; }
        public decimal PriceEur { get; set; }
    }

    private ReentryState GetReentryState(int lotNumber)
    {
        if (!_reentryStates.ContainsKey(lotNumber))
            _reentryStates[lotNumber] = new ReentryState();
        return _reentryStates[lotNumber];
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid != null)
            _currentUser = await Api.GetCurrentUserAsync(oid);

        _brokers = await Api.GetBrokersAsync();
        _disagreements = await Api.GetTypistDisagreementsAsync();
        _loading = false;

        // Poll every 3 seconds to auto-update when the other typist re-enters
        _pollTimer = new System.Threading.Timer(async _ => await PollForUpdates(), null, 3000, 3000);
    }

    private async Task PollForUpdates()
    {
        try
        {
            var newDisagreements = await Api.GetTypistDisagreementsAsync();
            var changed = newDisagreements.Count != _disagreements.Count;

            if (!changed && _submittedLots.Count > 0)
            {
                // Check if any submitted lots have been resolved
                foreach (var lotNum in _submittedLots.ToList())
                {
                    if (!newDisagreements.Any(d => d.LotNumber == lotNum))
                    {
                        changed = true;
                        _submittedLots.Remove(lotNum);
                    }
                }
            }

            if (changed)
            {
                _disagreements = newDisagreements;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Silently ignore polling errors
        }
    }

    private async Task SubmitReentry(int lotNumber)
    {
        _successMessage = null;
        _errorMessage = null;

        var state = GetReentryState(lotNumber);
        if (state.BrokerId <= 0)
        {
            _errorMessage = "Please select a broker.";
            return;
        }
        if (state.PriceEur <= 0)
        {
            _errorMessage = "Please enter a valid price.";
            return;
        }
        if (_currentUser == null)
        {
            _errorMessage = "User not authenticated.";
            return;
        }

        _submitting = true;
        try
        {
            var result = await Api.SubmitTypistReentryAsync(lotNumber, state.BrokerId, state.PriceEur, _currentUser.Id);
            if (result != null)
            {
                if (result.IsMatched)
                {
                    _successMessage = $"Lot {lotNumber} resolved — both typists agree! Lot recorded.";
                    _disagreements = await Api.GetTypistDisagreementsAsync();
                    _submittedLots.Remove(lotNumber);
                }
                else if (result.IsDisagreement)
                {
                    _errorMessage = $"Lot {lotNumber} — still disagreeing! Both typists must re-enter again.";
                    _disagreements = await Api.GetTypistDisagreementsAsync();
                    _submittedLots.Remove(lotNumber);
                }
                else if (result.WaitingForOtherTypist)
                {
                    _successMessage = $"Re-entry recorded for Lot {lotNumber}.";
                    _submittedLots.Add(lotNumber);
                }
            }
            else
            {
                _errorMessage = "Failed to submit re-entry. You may have already re-entered for this lot.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
