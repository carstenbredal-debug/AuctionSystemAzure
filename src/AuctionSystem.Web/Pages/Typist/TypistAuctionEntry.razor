@page "/typist/auction-entry"
@attribute [Authorize(Roles = "Typist")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<PageTitle>Auction Entry</PageTitle>

<h1>Auction Entry</h1>
<p class="text-muted">Enter broker and price for each lot. Both typists must agree before a lot is recorded.</p>

<div class="mb-3">
    <label class="form-label fw-bold">Auction <span class="text-danger">*</span></label>
    <select class="form-select" style="max-width: 400px;" @bind="_selectedAuctionId" @bind:after="OnAuctionChanged">
        <option value="0">— Select Auction —</option>
        @foreach (var a in _auctions)
        {
            <option value="@a.Id">@a.AuctionNumber — @a.Title</option>
        }
    </select>
</div>

@if (_selectedAuctionId == 0)
{
    <div class="alert alert-info">Please select an auction to begin entering data.</div>
}
else
{
<div class="row">
    <div class="col-md-5">
        <div class="section-container mb-4">
            <div class="section-header">
                <strong>Submit Entry</strong>
                @if (_currentUser != null)
                {
                    <span class="badge bg-info float-end">@_currentUser.DisplayName</span>
                }
            </div>
            <div>
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success alert-dismissible">
                        @_successMessage
                        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible">
                        @_errorMessage
                        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label"><strong>Next Lot</strong></label>
                    @if (_nextLot != null)
                    {
                        <div class="form-control-plaintext">
                            <strong class="fs-4">Lot #@_nextLot.LotNumber</strong>
                            <br /><small class="text-muted">@_nextLot.Description — @_nextLot.Quantity @_nextLot.Unit</small>
                        </div>
                    }
                    else
                    {
                        <div class="form-control-plaintext text-muted">No unsold lots available.</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Broker</strong></label>
                    <select class="form-select" @bind="_selectedBrokerId">
                        <option value="0">— Select Broker —</option>
                        @foreach (var broker in _brokers)
                        {
                            <option value="@broker.Id">@broker.BrokerNumber — @broker.CompanyName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Price per skin (EUR)</strong></label>
                    <div class="input-group">
                        <span class="input-group-text">€</span>
                        <input type="number" step="0.01" class="form-control" @bind="_priceEur" placeholder="0.00" />
                    </div>
                </div>

                <button class="btn btn-primary w-100" @onclick="SubmitEntry" disabled="@(_submitting || _nextLot == null || _currentUser == null)">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Submit Entry
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="section-container">
            <div class="section-header">
                <strong>Recent Results</strong>
                <span class="badge bg-secondary">@_recentEntries.Count</span>
            </div>
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th>
                            <th>Broker</th>
                            <th>Price (EUR)</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_recentEntries.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No entries yet.</td></tr>
                        }
                        @foreach (var r in _recentEntries)
                        {
                            <tr>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@(r.IsMatched || r.IsDisagreement ? $"{r.BrokerNumber} — {r.BrokerName}" : "—")</td>
                                <td>@(r.IsMatched || r.IsDisagreement ? $"€{r.PriceEur:N2}" : "—")</td>
                                <td>
                                    @if (r.IsMatched)
                                    {
                                        <span class="badge bg-success">Matched</span>
                                    }
                                    else if (r.IsDisagreement && r.IsResolved)
                                    {
                                        <span class="badge bg-secondary">Resolved</span>
                                    }
                                    else if (r.IsDisagreement)
                                    {
                                        <span class="badge bg-danger">Disagreement</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                                <td><small>@r.EnteredAt.ToString("HH:mm:ss")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
}

@code {
    private List<AuctionDto> _auctions = new();
    private int _selectedAuctionId;
    private List<BrokerDto> _brokers = new();
    private List<TypistEntryDto> _recentEntries = new();
    private NextUnsoldLotDto? _nextLot;
    private AppUserDto? _currentUser;
    private int _selectedBrokerId;
    private decimal _priceEur;
    private bool _submitting;
    private string? _successMessage;
    private string? _errorMessage;
    private System.Threading.Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid != null)
            _currentUser = await Api.GetCurrentUserAsync(oid);

        _auctions = (await Api.GetAuctionsAsync()).Where(a => a.Status == AuctionStatus.Active).ToList();
        _brokers = await Api.GetBrokersAsync();
    }

    private async Task OnAuctionChanged()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
        _recentEntries.Clear();
        _nextLot = null;
        _successMessage = null;
        _errorMessage = null;

        if (_selectedAuctionId > 0)
        {
            _recentEntries = await Api.GetRecentTypistEntriesAsync(_selectedAuctionId);
            _nextLot = await Api.GetNextUnsoldLotForTypistAsync(_currentUser?.Id, _selectedAuctionId);
            _pollTimer = new System.Threading.Timer(async _ => await PollForUpdates(), null, 3000, 3000);
        }
    }

    private async Task PollForUpdates()
    {
        if (_selectedAuctionId <= 0) return;
        try
        {
            var newRecent = await Api.GetRecentTypistEntriesAsync(_selectedAuctionId);
            var changed = false;

            if (newRecent.Count != _recentEntries.Count)
                changed = true;
            else if (newRecent.Count > 0 && _recentEntries.Count > 0)
            {
                var newest = newRecent[0];
                var oldNewest = _recentEntries[0];
                changed = newest.Id != oldNewest.Id
                    || newest.IsMatched != oldNewest.IsMatched
                    || newest.IsDisagreement != oldNewest.IsDisagreement;
            }

            if (changed)
            {
                _recentEntries = newRecent;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task SubmitEntry()
    {
        _successMessage = null;
        _errorMessage = null;

        if (_selectedAuctionId <= 0)
        {
            _errorMessage = "Please select an auction.";
            return;
        }
        if (_nextLot == null)
        {
            _errorMessage = "No unsold lots available.";
            return;
        }
        if (_selectedBrokerId <= 0)
        {
            _errorMessage = "Please select a broker.";
            return;
        }
        if (_priceEur <= 0)
        {
            _errorMessage = "Please enter a valid price.";
            return;
        }
        if (_currentUser == null)
        {
            _errorMessage = "User not authenticated.";
            return;
        }

        _submitting = true;
        try
        {
            var lotNum = _nextLot.LotNumber;
            var result = await Api.SubmitTypistEntryAsync(lotNum, _selectedBrokerId, _priceEur, _currentUser.Id, _selectedAuctionId);
            if (result != null)
            {
                _successMessage = $"Entry recorded for Lot {lotNum}.";
                _priceEur = 0;
                _selectedBrokerId = 0;

                _nextLot = await Api.GetNextUnsoldLotForTypistAsync(_currentUser.Id, _selectedAuctionId);
                _recentEntries = await Api.GetRecentTypistEntriesAsync(_selectedAuctionId);
            }
            else
            {
                _errorMessage = "Failed to submit entry. You may have already submitted for this lot.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
