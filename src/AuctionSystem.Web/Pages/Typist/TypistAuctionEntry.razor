@page "/typist/auction-entry"
@attribute [Authorize(Roles = "Typist")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Auction Entry</PageTitle>

<h1>Auction Entry</h1>
<p class="text-muted">Enter broker and price for each lot. Both typists must agree before a lot is recorded.</p>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header">
                <strong>Submit Entry</strong>
                @if (_currentUser != null)
                {
                    <span class="badge bg-info float-end">@_currentUser.DisplayName</span>
                }
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success alert-dismissible">
                        @_successMessage
                        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible">
                        @_errorMessage
                        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label"><strong>Next Lot</strong></label>
                    @if (_nextLot != null)
                    {
                        <div class="form-control-plaintext">
                            <strong class="fs-4">Lot #@_nextLot.LotNumber</strong>
                            <br /><small class="text-muted">@_nextLot.Description — @_nextLot.Quantity @_nextLot.Unit</small>
                        </div>
                    }
                    else
                    {
                        <div class="form-control-plaintext text-muted">No unsold lots available.</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Broker</strong></label>
                    <select class="form-select" @bind="_selectedBrokerId">
                        <option value="0">— Select Broker —</option>
                        @foreach (var broker in _brokers)
                        {
                            <option value="@broker.Id">@broker.BrokerNumber — @broker.CompanyName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Price per skin (EUR)</strong></label>
                    <div class="input-group">
                        <span class="input-group-text">€</span>
                        <input type="number" step="0.01" class="form-control" @bind="_priceEur" placeholder="0.00" />
                    </div>
                </div>

                <button class="btn btn-primary w-100" @onclick="SubmitEntry" disabled="@(_submitting || _nextLot == null || _currentUser == null)">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Submit Entry
                </button>

                @if (_lastResult != null)
                {
                    <div class="mt-3">
                        @if (_lastResult.WaitingForOtherTypist)
                        {
                            <div class="alert alert-info mb-0">
                                <strong>Waiting for other typist</strong> to enter their values for Lot #@_lastResult.LotNumber.
                            </div>
                        }
                        else if (_lastResult.IsMatched)
                        {
                            <div class="alert alert-success mb-0">
                                <strong>Match!</strong> Both typists agree on Lot #@_lastResult.LotNumber. Lot recorded.
                            </div>
                        }
                        else if (_lastResult.IsDisagreement)
                        {
                            <div class="alert alert-warning mb-0">
                                <strong>Disagreement!</strong> Entries don't match for Lot #@_lastResult.LotNumber. Please re-enter on the Disagreements page.
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Recent Results</strong>
                <span class="badge bg-secondary">@_recentEntries.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th>
                            <th>Broker</th>
                            <th>Price (EUR)</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_recentEntries.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No entries yet.</td></tr>
                        }
                        @foreach (var r in _recentEntries)
                        {
                            <tr>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@r.BrokerNumber — @r.BrokerName</td>
                                <td>€@r.PriceEur.ToString("N2")</td>
                                <td>
                                    @if (r.IsMatched)
                                    {
                                        <span class="badge bg-success">Matched</span>
                                    }
                                    else if (r.IsDisagreement && r.IsResolved)
                                    {
                                        <span class="badge bg-secondary">Resolved</span>
                                    }
                                    else if (r.IsDisagreement)
                                    {
                                        <span class="badge bg-danger">Disagreement</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Waiting</span>
                                    }
                                </td>
                                <td><small>@r.EnteredAt.ToString("HH:mm:ss")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<BrokerDto> _brokers = new();
    private List<TypistEntryDto> _recentEntries = new();
    private NextUnsoldLotDto? _nextLot;
    private AppUserDto? _currentUser;
    private int _selectedBrokerId;
    private decimal _priceEur;
    private bool _submitting;
    private string? _successMessage;
    private string? _errorMessage;
    private TypistSubmitResult? _lastResult;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid != null)
            _currentUser = await Api.GetCurrentUserAsync(oid);

        _brokers = await Api.GetBrokersAsync();
        _recentEntries = await Api.GetRecentTypistEntriesAsync();
        _nextLot = await Api.GetNextUnsoldLotForTypistAsync();
    }

    private async Task SubmitEntry()
    {
        _successMessage = null;
        _errorMessage = null;
        _lastResult = null;

        if (_nextLot == null)
        {
            _errorMessage = "No unsold lots available.";
            return;
        }
        if (_selectedBrokerId <= 0)
        {
            _errorMessage = "Please select a broker.";
            return;
        }
        if (_priceEur <= 0)
        {
            _errorMessage = "Please enter a valid price.";
            return;
        }
        if (_currentUser == null)
        {
            _errorMessage = "User not authenticated.";
            return;
        }

        _submitting = true;
        try
        {
            var result = await Api.SubmitTypistEntryAsync(_nextLot.LotNumber, _selectedBrokerId, _priceEur, _currentUser.Id);
            if (result != null)
            {
                _lastResult = result;
                if (result.IsMatched)
                {
                    _successMessage = $"Lot {_nextLot.LotNumber} — both typists agree! Lot recorded.";
                    _priceEur = 0;
                    _selectedBrokerId = 0;
                    _nextLot = await Api.GetNextUnsoldLotForTypistAsync();
                }
                else if (result.IsDisagreement)
                {
                    _errorMessage = $"Lot {_nextLot.LotNumber} — disagreement! Entries don't match. Check the Disagreements page.";
                    _priceEur = 0;
                    _selectedBrokerId = 0;
                    _nextLot = await Api.GetNextUnsoldLotForTypistAsync();
                }
                else
                {
                    _successMessage = $"Entry recorded for Lot {_nextLot.LotNumber}. Waiting for the other typist.";
                    _priceEur = 0;
                    _selectedBrokerId = 0;
                }
                _recentEntries = await Api.GetRecentTypistEntriesAsync();
            }
            else
            {
                _errorMessage = "Failed to submit entry. You may have already submitted for this lot.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
