@page "/farmer/auction/{AuctionId:int}"
@attribute [Authorize(Roles = "Admin,Farmer")]
@using System.Text.Json
@inject HttpClient Http
@inject AuctionApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Auction Detail - Farmer Portal</PageTitle>

<nav class="mb-3"><a href="/">&larr; Back to Dashboard</a></nav>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Auction @_auctionNumber</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-bg-primary mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Skins</h6>
                    <p class="display-5 mb-0">@_totalSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Sold</h6>
                    <p class="display-5 mb-0">@_soldSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-warning mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Value</h6>
                    <p class="display-5 mb-0">€@_totalValue.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    @* Breadcrumb *@
    <nav class="mb-3" style="font-size:0.95rem;">
        <a href="javascript:void(0)" @onclick="ShowLots" class="@(_view == "lots" ? "fw-bold" : "")">Lots</a>
        @if (_view == "skins")
        {
            <span class="mx-1">/</span>
            <span class="fw-bold">Lot @_selectedLotNumber — Skins</span>
        }
    </nav>

    @if (_drillLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (_view == "lots")
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Lot Number</th>
                        <th>Skins</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Quality</th>
                        <th>Hair Length</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Clarity</th>
                        <th class="text-end">Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in _lots)
                    {
                        <tr style="cursor:pointer" @onclick="() => DrillToSkins(lot)">
                            <td>@lot.LotNumber</td>
                            <td>@lot.TotalSkins</td>
                            <td>@lot.SalesType</td>
                            <td>@lot.Gender</td>
                            <td>@lot.Group</td>
                            <td>@lot.Quality</td>
                            <td>@lot.HairLength</td>
                            <td>@lot.Size</td>
                            <td>@lot.Color</td>
                            <td>@lot.Clarity</td>
                            <td class="text-end">@(lot.HammerPrice.HasValue ? $"€{lot.HammerPrice:N2}" : "-")</td>
                            <td><span class="badge @(lot.Status == "Sold" ? "bg-success" : "bg-secondary")">@lot.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_view == "skins")
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Barcode</th>
                        <th>Box</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Clarity</th>
                        <th>Hair Length</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skin in _skins)
                    {
                        <tr>
                            <td>@skin.Barcode</td>
                            <td>@skin.BoxNumber</td>
                            <td>@skin.SalesType</td>
                            <td>@skin.Gender</td>
                            <td>@skin.Group</td>
                            <td>@skin.Size</td>
                            <td>@skin.Color</td>
                            <td>@skin.Quality</td>
                            <td>@skin.Clarity</td>
                            <td>@skin.HairLength</td>
                            <td><span class="badge @(skin.Status == "Sold" ? "bg-success" : "bg-secondary")">@skin.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int AuctionId { get; set; }

    private bool _loading = true;
    private bool _drillLoading;
    private string _auctionNumber = "";
    private string _farmerName = "";
    private int _totalSkins;
    private int _soldSkins;
    private decimal _totalValue;

    private string _view = "lots";
    private int _selectedLotNumber;
    private List<LotRow> _lots = new();
    private List<SkinRow> _skins = new();

    protected override async Task OnInitializedAsync()
    {
        _farmerName = await ResolveFarmerNameAsync() ?? "";

        if (string.IsNullOrEmpty(_farmerName))
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var url = $"api/skins/farmer-auction-detail?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}";
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            _auctionNumber = root.GetProperty("auctionNumber").GetString() ?? $"{AuctionId}";
            _totalSkins = root.GetProperty("totalSkins").GetInt32();
            _soldSkins = root.GetProperty("soldSkins").GetInt32();
            _totalValue = root.GetProperty("totalValue").GetDecimal();
        }
        catch { }

        try
        {
            var lotsUrl = $"api/skins/farmer-auction-lots?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}";
            var lotsJson = await Http.GetStringAsync(lotsUrl);
            _lots = JsonSerializer.Deserialize<List<LotRow>>(lotsJson, JsonOpts) ?? new();
        }
        catch { _lots = new(); }

        _loading = false;
    }

    private void ShowLots()
    {
        _view = "lots";
    }

    private async Task DrillToSkins(LotRow lot)
    {
        _selectedLotNumber = lot.LotNumber;
        _drillLoading = true;
        _view = "skins";
        StateHasChanged();

        try
        {
            var url = $"api/skins/farmer-auction-skins?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}&lotNumber={lot.LotNumber}";
            var json = await Http.GetStringAsync(url);
            _skins = JsonSerializer.Deserialize<List<SkinRow>>(json, JsonOpts) ?? new();
        }
        catch { _skins = new(); }

        _drillLoading = false;
    }

    private async Task<string?> ResolveFarmerNameAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        AppUserDto? user = null;
        if (oid != null)
            user = await Api.GetCurrentUserAsync(oid);
        if (user == null && !string.IsNullOrEmpty(email))
            user = await Api.GetCurrentUserAsync(email);

        if (user?.FarmerId == null) return null;

        var farmers = await Api.GetFarmersAsync();
        return farmers.FirstOrDefault(f => f.Id == user.FarmerId)?.Name;
    }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private class LotRow
    {
        public int LotNumber { get; set; }
        public int TotalSkins { get; set; }
        public string? SalesType { get; set; }
        public string? Gender { get; set; }
        public string? Group { get; set; }
        public string? Quality { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public string? Clarity { get; set; }
        public string? HairLength { get; set; }
        public string Status { get; set; } = "";
        public decimal? PricePerSkin { get; set; }
        public decimal? HammerPrice { get; set; }
    }

    private class SkinRow
    {
        public long Barcode { get; set; }
        public int BoxNumber { get; set; }
        public string? BoxType { get; set; }
        public string? SalesType { get; set; }
        public string? Gender { get; set; }
        public string? Group { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public string? Quality { get; set; }
        public string? Clarity { get; set; }
        public string? Damages { get; set; }
        public string? HairLength { get; set; }
        public string Status { get; set; } = "";
    }
}
