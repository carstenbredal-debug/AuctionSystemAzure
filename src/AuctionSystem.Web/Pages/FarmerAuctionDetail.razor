@page "/farmer/auction/{AuctionId:int}"
@attribute [Authorize(Roles = "Admin,Farmer")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Auction Detail - Farmer Portal</PageTitle>

<nav class="mb-3"><a href="/farmer">&larr; Back to Farmer Portal</a></nav>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@(_auction?.Title ?? _auction?.AuctionNumber ?? $"Auction {AuctionId}")</h1>
    <p class="text-muted">@(_auction?.ScheduledDate.ToString("yyyy-MM-dd") ?? "")</p>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-bg-primary mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Skins</h6>
                    <p class="display-5 mb-0">@_totalSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Sold</h6>
                    <p class="display-5 mb-0">@_soldSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-warning mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Value</h6>
                    <p class="display-5 mb-0">@_totalValue.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="section-container">
        <div class="section-header">Lots</div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th>
                        <th>Description</th>
                        <th>Skins</th>
                        <th>Hammer Price</th>
                        <th>Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in _lots)
                    {
                        <tr>
                            <td>@lot.LotNumber</td>
                            <td>@lot.Description</td>
                            <td>@lot.Quantity</td>
                            <td>@(lot.HammerPrice?.ToString("N2") ?? "-")</td>
                            <td>@((lot.Status == LotStatus.Sold || lot.Status == LotStatus.Broker) ? ((lot.HammerPrice ?? 0) * lot.Quantity).ToString("N2") : "-")</td>
                            <td><span class="badge bg-@GetLotColor(lot.Status)">@lot.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int AuctionId { get; set; }
    [SupplyParameterFromQuery] public int FarmerId { get; set; }

    private bool _loading = true;
    private AuctionDto? _auction;
    private List<LotDto> _lots = new();
    private int _totalSkins;
    private int _soldSkins;
    private decimal _totalValue;

    protected override async Task OnInitializedAsync()
    {
        if (FarmerId <= 0)
        {
            Nav.NavigateTo("/farmer");
            return;
        }

        var allLots = await Api.GetLotsByFarmerAsync(FarmerId);
        _lots = allLots.Where(l => l.AuctionId == AuctionId).OrderBy(l => l.LotNumber).ToList();

        if (_lots.Any())
            _auction = _lots.First().Auction;

        var soldLots = _lots.Where(l => l.Status == LotStatus.Sold || l.Status == LotStatus.Broker).ToList();
        _totalSkins = _lots.Sum(l => l.Quantity);
        _soldSkins = soldLots.Sum(l => l.Quantity);
        _totalValue = soldLots.Sum(l => (l.HammerPrice ?? 0) * l.Quantity);

        _loading = false;
    }

    private string GetLotColor(LotStatus s) => s switch
    {
        LotStatus.Sold => "success",
        LotStatus.Broker => "primary",
        LotStatus.Active => "warning",
        _ => "secondary"
    };
}
