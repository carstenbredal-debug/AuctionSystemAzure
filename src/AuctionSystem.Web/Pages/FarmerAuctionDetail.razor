@page "/farmer/auction/{AuctionId:int}"
@attribute [Authorize(Roles = "Admin,Farmer")]
@using System.Text.Json
@inject HttpClient Http
@inject AuctionApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Auction Detail - Farmer Portal</PageTitle>

<nav class="mb-3"><a href="/">&larr; Back to Dashboard</a></nav>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Auction @_auctionNumber</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-bg-primary mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Skins</h6>
                    <p class="display-5 mb-0">@_totalSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Sold</h6>
                    <p class="display-5 mb-0">@_soldSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-warning mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Value</h6>
                    <p class="display-5 mb-0">€@_totalValue.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    @* Tabs *@
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "results" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "results"'>Sales Results</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "catalog" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "catalog"'>Farmer Catalog</a>
        </li>
    </ul>

    @if (_activeTab == "results")
    {
        @* Breadcrumb *@
        <nav class="mb-3" style="font-size:0.95rem;">
            @for (int i = 0; i < _breadcrumbs.Count; i++)
            {
                var idx = i;
                @if (i > 0) { <span class="mx-1">/</span> }
                @if (i < _breadcrumbs.Count - 1)
                {
                    <a href="javascript:void(0)" @onclick="() => NavigateTo(idx)">@_breadcrumbs[idx]</a>
                }
                else
                {
                    <span class="fw-bold">@_breadcrumbs[idx]</span>
                }
            }
        </nav>

        @if (_currentLevel < _levels.Count)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>@_levels[_currentLevel].DisplayName</th>
                            <th>Skins</th>
                            <th class="text-end">Value of Sold Skins</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _groupRows)
                        {
                            <tr style="cursor:pointer" @onclick="() => DrillDown(row.Key)">
                                <td>@(string.IsNullOrEmpty(row.Key) ? "-" : row.Key)</td>
                                <td>@row.SkinCount.ToString("N0")</td>
                                <td class="text-end">@(row.SoldValue > 0 ? $"€{row.SoldValue:N2}" : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot Number</th>
                            <th>Skins</th>
                            @foreach (var lvl in _levels)
                            {
                                <th>@lvl.DisplayName</th>
                            }
                            <th class="text-end">Value of Sold Skins</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lot in _filteredLots)
                        {
                            <tr>
                                <td>@lot.LotNumber</td>
                                <td>@lot.TotalSkins</td>
                                @foreach (var lvl in _levels)
                                {
                                    <td>@(GetLotFieldByColumn(lot, lvl.ColumnName) ?? "")</td>
                                }
                                <td class="text-end">@(lot.SoldValue.HasValue ? $"€{lot.SoldValue:N2}" : "-")</td>
                                <td><span class="badge @(lot.Status == "Sold" ? "bg-success" : "bg-secondary")">@lot.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (_activeTab == "catalog")
    {
        <div class="mb-3">
            <button class="btn btn-primary" @onclick="DownloadCatalogPdf" disabled="@_downloadingPdf">
                @if (_downloadingPdf)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Generating PDF...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    <span>Download Farmer Catalog</span>
                }
            </button>
        </div>

        @* Show lots in catalog format *@
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Lot</th>
                        <th>Skins</th>
                        <th>Description</th>
                        <th>Section</th>
                        <th class="text-end">Price/Skin</th>
                        <th class="text-end">Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in _lots.OrderBy(l => l.LotNumber))
                    {
                        <tr>
                            <td>@lot.LotNumber</td>
                            <td>@lot.TotalSkins</td>
                            <td>@BuildDescription(lot)</td>
                            <td>@lot.SalesType - @lot.Gender - @lot.Group</td>
                            <td class="text-end">@(lot.PricePerSkin.HasValue ? $"€{lot.PricePerSkin:N2}" : "-")</td>
                            <td class="text-end">@(lot.SoldValue.HasValue ? $"€{lot.SoldValue:N2}" : "-")</td>
                            <td><span class="badge @(lot.Status == "Sold" ? "bg-success" : "bg-secondary")">@lot.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int AuctionId { get; set; }

    private bool _loading = true;
    private string _auctionNumber = "";
    private string _farmerName = "";
    private int _totalSkins;
    private int _soldSkins;
    private decimal _totalValue;
    private string _activeTab = "results";
    private bool _downloadingPdf;

    private List<DrillLevel> _levels = new();
    private int _currentLevel;
    private List<string> _breadcrumbs = new() { "Overview" };
    private List<string?> _filters = new();
    private List<LotRow> _lots = new();
    private List<LotRow> _filteredLots = new();
    private List<GroupRow> _groupRows = new();

    private static readonly Dictionary<string, string> _displayNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["SalesType"] = "Type",
        ["Gender"] = "Gender",
        ["Group"] = "Group",
        ["HairLength"] = "Hair Length",
        ["Size"] = "Size",
        ["Quality"] = "Quality",
        ["Color"] = "Color",
        ["Clarity"] = "Clarity",
        ["Damages"] = "Damages"
    };

    protected override async Task OnInitializedAsync()
    {
        _farmerName = await ResolveFarmerNameAsync() ?? "";

        if (string.IsNullOrEmpty(_farmerName))
        {
            Nav.NavigateTo("/");
            return;
        }

        // Load drill-down order from Sales Order Setup
        try
        {
            var groupOrders = await Api.GetLotGroupOrdersAsync();
            _levels = groupOrders
                .OrderBy(g => g.GroupOrder)
                .Select(g => new DrillLevel
                {
                    ColumnName = g.ColumnName,
                    DisplayName = _displayNames.TryGetValue(g.ColumnName, out var dn) ? dn : g.ColumnName
                })
                .ToList();
        }
        catch { }

        if (_levels.Count == 0)
        {
            _levels = new List<DrillLevel>
            {
                new() { ColumnName = "SalesType", DisplayName = "Type" },
                new() { ColumnName = "Gender", DisplayName = "Gender" },
                new() { ColumnName = "Group", DisplayName = "Group" },
                new() { ColumnName = "HairLength", DisplayName = "Hair Length" },
                new() { ColumnName = "Size", DisplayName = "Size" },
                new() { ColumnName = "Quality", DisplayName = "Quality" },
                new() { ColumnName = "Color", DisplayName = "Color" },
                new() { ColumnName = "Clarity", DisplayName = "Clarity" },
                new() { ColumnName = "Damages", DisplayName = "Damages" }
            };
        }

        try
        {
            var url = $"api/skins/farmer-auction-detail?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}";
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            _auctionNumber = root.GetProperty("auctionNumber").GetString() ?? $"{AuctionId}";
            _totalSkins = root.GetProperty("totalSkins").GetInt32();
            _soldSkins = root.GetProperty("soldSkins").GetInt32();
            _totalValue = root.GetProperty("totalValue").GetDecimal();
        }
        catch { }

        try
        {
            var lotsUrl = $"api/skins/farmer-auction-lots?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}";
            var lotsJson = await Http.GetStringAsync(lotsUrl);
            _lots = JsonSerializer.Deserialize<List<LotRow>>(lotsJson, JsonOpts) ?? new();
        }
        catch { _lots = new(); }

        _currentLevel = 0;
        _filters.Clear();
        _breadcrumbs = new() { _levels.Count > 0 ? _levels[0].DisplayName + "s" : "Overview" };
        BuildGroupRows();
        _loading = false;
    }

    private string? GetLotFieldByColumn(LotRow lot, string columnName) => columnName.ToLowerInvariant() switch
    {
        "salestype" => lot.SalesType,
        "gender" => lot.Gender,
        "group" => lot.Group,
        "hairlength" => lot.HairLength,
        "size" => lot.Size,
        "quality" => lot.Quality,
        "color" => lot.Color,
        "clarity" => lot.Clarity,
        "damages" => lot.Damages,
        _ => null
    };

    private string? GetLotField(LotRow lot, int level)
    {
        if (level < 0 || level >= _levels.Count) return null;
        return GetLotFieldByColumn(lot, _levels[level].ColumnName);
    }

    private IEnumerable<LotRow> GetCurrentFiltered()
    {
        IEnumerable<LotRow> result = _lots;
        for (int i = 0; i < _filters.Count; i++)
        {
            var level = i;
            var filterVal = _filters[i];
            result = result.Where(l => (GetLotField(l, level) ?? "") == (filterVal ?? ""));
        }
        return result;
    }

    private void BuildGroupRows()
    {
        var filtered = GetCurrentFiltered().ToList();

        if (_currentLevel < _levels.Count)
        {
            _groupRows = filtered
                .GroupBy(l => GetLotField(l, _currentLevel) ?? "")
                .Select(g => new GroupRow
                {
                    Key = g.Key,
                    SkinCount = g.Sum(l => l.TotalSkins),
                    SoldValue = g.Sum(l => l.SoldValue ?? 0m)
                })
                .OrderByDescending(r => r.SkinCount)
                .ToList();
        }
        else
        {
            _filteredLots = filtered.OrderBy(l => l.LotNumber).ToList();
        }
    }

    private void DrillDown(string key)
    {
        _filters.Add(key);
        _currentLevel++;
        var label = _levels[_currentLevel - 1].DisplayName + ": " + (string.IsNullOrEmpty(key) ? "-" : key);
        if (_currentLevel >= _levels.Count) label += " — Lots";
        _breadcrumbs.Add(label);
        BuildGroupRows();
        StateHasChanged();
    }

    private void NavigateTo(int index)
    {
        if (index == 0)
        {
            _currentLevel = 0;
            _filters.Clear();
            _breadcrumbs = new() { _levels.Count > 0 ? _levels[0].DisplayName + "s" : "Overview" };
        }
        else
        {
            _currentLevel = index;
            _filters = _filters.Take(index).ToList();
            _breadcrumbs = _breadcrumbs.Take(index + 1).ToList();
        }
        BuildGroupRows();
        StateHasChanged();
    }

    private async Task DownloadCatalogPdf()
    {
        _downloadingPdf = true;
        StateHasChanged();

        try
        {
            var pdfUrl = $"api/catalog/pdf?auctionNumber={Uri.EscapeDataString(_auctionNumber)}&farmerName={Uri.EscapeDataString(_farmerName)}";
            await JS.InvokeVoidAsync("open", pdfUrl, "_blank");
        }
        finally
        {
            _downloadingPdf = false;
            StateHasChanged();
        }
    }

    private static string BuildDescription(LotRow lot)
    {
        var parts = new List<string?> { lot.HairLength, lot.Size, lot.Quality, lot.Color, lot.Clarity };
        if (!string.IsNullOrWhiteSpace(lot.Damages) && !string.Equals(lot.Damages, "None", StringComparison.OrdinalIgnoreCase))
            parts.Add(lot.Damages);
        return string.Join(" / ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private async Task<string?> ResolveFarmerNameAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        AppUserDto? user = null;
        if (oid != null)
            user = await Api.GetCurrentUserAsync(oid);
        if (user == null && !string.IsNullOrEmpty(email))
            user = await Api.GetCurrentUserAsync(email);

        if (user?.FarmerId == null) return null;

        var farmers = await Api.GetFarmersAsync();
        return farmers.FirstOrDefault(f => f.Id == user.FarmerId)?.Name;
    }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private class DrillLevel
    {
        public string ColumnName { get; set; } = "";
        public string DisplayName { get; set; } = "";
    }

    private class GroupRow
    {
        public string Key { get; set; } = "";
        public int SkinCount { get; set; }
        public decimal SoldValue { get; set; }
    }

    private class LotRow
    {
        public int LotNumber { get; set; }
        public int TotalSkins { get; set; }
        public string? SalesType { get; set; }
        public string? Gender { get; set; }
        public string? Group { get; set; }
        public string? Quality { get; set; }
        public string? HairLength { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public string? Clarity { get; set; }
        public string? Damages { get; set; }
        public string Status { get; set; } = "";
        public decimal? SoldValue { get; set; }
        public decimal? PricePerSkin { get; set; }
    }
}
