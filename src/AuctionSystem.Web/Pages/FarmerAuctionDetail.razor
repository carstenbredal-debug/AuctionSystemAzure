@page "/farmer/auction/{AuctionId:int}"
@attribute [Authorize(Roles = "Admin,Farmer")]
@using System.Text.Json
@inject HttpClient Http
@inject AuctionApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Auction Detail - Farmer Portal</PageTitle>

<nav class="mb-3"><a href="/">&larr; Back to Dashboard</a></nav>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Auction @_auctionNumber</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-bg-primary mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Skins</h6>
                    <p class="display-5 mb-0">@_totalSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Sold</h6>
                    <p class="display-5 mb-0">@_soldSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-warning mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Value</h6>
                    <p class="display-5 mb-0">€@_totalValue.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    @* Breadcrumb *@
    <nav class="mb-3" style="font-size:0.95rem;">
        @for (int i = 0; i < _breadcrumbs.Count; i++)
        {
            var idx = i;
            @if (i > 0) { <span class="mx-1">/</span> }
            @if (i < _breadcrumbs.Count - 1)
            {
                <a href="javascript:void(0)" @onclick="() => NavigateTo(idx)">@_breadcrumbs[idx]</a>
            }
            else
            {
                <span class="fw-bold">@_breadcrumbs[idx]</span>
            }
        }
    </nav>

    @if (_currentLevel < _levels.Length)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>@_levels[_currentLevel]</th>
                        <th>Skins</th>
                        <th class="text-end">Value of Sold Skins</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _groupRows)
                    {
                        <tr style="cursor:pointer" @onclick="() => DrillDown(row.Key)">
                            <td>@(string.IsNullOrEmpty(row.Key) ? "-" : row.Key)</td>
                            <td>@row.SkinCount.ToString("N0")</td>
                            <td class="text-end">@(row.SoldValue > 0 ? $"€{row.SoldValue:N2}" : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Lot Number</th>
                        <th>Skins</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Quality</th>
                        <th>Hair Length</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Clarity</th>
                        <th>Damages</th>
                        <th class="text-end">Value of Sold Skins</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in _filteredLots)
                    {
                        <tr>
                            <td>@lot.LotNumber</td>
                            <td>@lot.TotalSkins</td>
                            <td>@lot.SalesType</td>
                            <td>@lot.Gender</td>
                            <td>@lot.Group</td>
                            <td>@lot.Quality</td>
                            <td>@lot.HairLength</td>
                            <td>@lot.Size</td>
                            <td>@lot.Color</td>
                            <td>@lot.Clarity</td>
                            <td>@lot.Damages</td>
                            <td class="text-end">@(lot.SoldValue.HasValue ? $"€{lot.SoldValue:N2}" : "-")</td>
                            <td><span class="badge @(lot.Status == "Sold" ? "bg-success" : "bg-secondary")">@lot.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int AuctionId { get; set; }

    private bool _loading = true;
    private string _auctionNumber = "";
    private string _farmerName = "";
    private int _totalSkins;
    private int _soldSkins;
    private decimal _totalValue;

    private static readonly string[] _levels = { "Type", "Gender", "Group", "Hair Length", "Size", "Quality", "Color", "Clarity", "Damages" };

    private int _currentLevel;
    private List<string> _breadcrumbs = new() { "Types" };
    private List<string?> _filters = new();
    private List<LotRow> _lots = new();
    private List<LotRow> _filteredLots = new();
    private List<GroupRow> _groupRows = new();

    protected override async Task OnInitializedAsync()
    {
        _farmerName = await ResolveFarmerNameAsync() ?? "";

        if (string.IsNullOrEmpty(_farmerName))
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var url = $"api/skins/farmer-auction-detail?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}";
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            _auctionNumber = root.GetProperty("auctionNumber").GetString() ?? $"{AuctionId}";
            _totalSkins = root.GetProperty("totalSkins").GetInt32();
            _soldSkins = root.GetProperty("soldSkins").GetInt32();
            _totalValue = root.GetProperty("totalValue").GetDecimal();
        }
        catch { }

        try
        {
            var lotsUrl = $"api/skins/farmer-auction-lots?farmerName={Uri.EscapeDataString(_farmerName)}&auctionId={AuctionId}";
            var lotsJson = await Http.GetStringAsync(lotsUrl);
            _lots = JsonSerializer.Deserialize<List<LotRow>>(lotsJson, JsonOpts) ?? new();
        }
        catch { _lots = new(); }

        _currentLevel = 0;
        _filters.Clear();
        _breadcrumbs = new() { "Types" };
        BuildGroupRows();
        _loading = false;
    }

    private string? GetLotField(LotRow lot, int level) => level switch
    {
        0 => lot.SalesType,
        1 => lot.Gender,
        2 => lot.Group,
        3 => lot.HairLength,
        4 => lot.Size,
        5 => lot.Quality,
        6 => lot.Color,
        7 => lot.Clarity,
        8 => lot.Damages,
        _ => null
    };

    private IEnumerable<LotRow> GetCurrentFiltered()
    {
        IEnumerable<LotRow> result = _lots;
        for (int i = 0; i < _filters.Count; i++)
        {
            var level = i;
            var filterVal = _filters[i];
            result = result.Where(l => (GetLotField(l, level) ?? "") == (filterVal ?? ""));
        }
        return result;
    }

    private void BuildGroupRows()
    {
        var filtered = GetCurrentFiltered().ToList();

        if (_currentLevel < _levels.Length)
        {
            _groupRows = filtered
                .GroupBy(l => GetLotField(l, _currentLevel) ?? "")
                .Select(g => new GroupRow
                {
                    Key = g.Key,
                    SkinCount = g.Sum(l => l.TotalSkins),
                    SoldValue = g.Sum(l => l.SoldValue ?? 0m)
                })
                .OrderByDescending(r => r.SkinCount)
                .ToList();
        }
        else
        {
            _filteredLots = filtered.OrderBy(l => l.LotNumber).ToList();
        }
    }

    private void DrillDown(string key)
    {
        _filters.Add(key);
        _currentLevel++;
        _breadcrumbs.Add(_currentLevel < _levels.Length ? $"{_levels[_currentLevel - 1]}: {(string.IsNullOrEmpty(key) ? "-" : key)}" : $"{_levels[_currentLevel - 1]}: {(string.IsNullOrEmpty(key) ? "-" : key)} — Lots");
        BuildGroupRows();
        StateHasChanged();
    }

    private void NavigateTo(int index)
    {
        if (index == 0)
        {
            _currentLevel = 0;
            _filters.Clear();
            _breadcrumbs = new() { "Types" };
        }
        else
        {
            _currentLevel = index;
            _filters = _filters.Take(index).ToList();
            _breadcrumbs = _breadcrumbs.Take(index + 1).ToList();
        }
        BuildGroupRows();
        StateHasChanged();
    }

    private async Task<string?> ResolveFarmerNameAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        AppUserDto? user = null;
        if (oid != null)
            user = await Api.GetCurrentUserAsync(oid);
        if (user == null && !string.IsNullOrEmpty(email))
            user = await Api.GetCurrentUserAsync(email);

        if (user?.FarmerId == null) return null;

        var farmers = await Api.GetFarmersAsync();
        return farmers.FirstOrDefault(f => f.Id == user.FarmerId)?.Name;
    }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private class GroupRow
    {
        public string Key { get; set; } = "";
        public int SkinCount { get; set; }
        public decimal SoldValue { get; set; }
    }

    private class LotRow
    {
        public int LotNumber { get; set; }
        public int TotalSkins { get; set; }
        public string? SalesType { get; set; }
        public string? Gender { get; set; }
        public string? Group { get; set; }
        public string? Quality { get; set; }
        public string? HairLength { get; set; }
        public string? Size { get; set; }
        public string? Color { get; set; }
        public string? Clarity { get; set; }
        public string? Damages { get; set; }
        public string Status { get; set; } = "";
        public decimal? SoldValue { get; set; }
    }
}
