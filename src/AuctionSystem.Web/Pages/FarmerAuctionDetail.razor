@page "/farmer/auction/{AuctionId:int}"
@attribute [Authorize(Roles = "Admin,Farmer")]
@inject AuctionApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Auction Detail - Farmer Portal</PageTitle>

<nav class="mb-3"><a href="/">&larr; Back to Dashboard</a></nav>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Auction @_auctionNumber</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-bg-primary mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Skins</h6>
                    <p class="display-5 mb-0">@_totalSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Sold</h6>
                    <p class="display-5 mb-0">@_soldSkins.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-warning mb-3">
                <div class="card-body text-center">
                    <h6 class="card-title">Total Value</h6>
                    <p class="display-5 mb-0">@_totalValue.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int AuctionId { get; set; }

    private bool _loading = true;
    private string _auctionNumber = "";
    private int _totalSkins;
    private int _soldSkins;
    private decimal _totalValue;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        int? farmerId = null;

        if (oid != null)
        {
            var user = await Api.GetCurrentUserAsync(oid);
            farmerId = user?.FarmerId;
        }

        if (farmerId == null || farmerId <= 0)
        {
            Nav.NavigateTo("/");
            return;
        }

        var allLots = await Api.GetLotsByFarmerAsync(farmerId.Value);
        var lots = allLots.Where(l => l.AuctionId == AuctionId).ToList();

        if (lots.Any())
        {
            var auction = lots.First().Auction;
            _auctionNumber = auction?.AuctionNumber ?? auction?.Title ?? $"{AuctionId}";
        }

        var soldLots = lots.Where(l => l.Status == LotStatus.Sold || l.Status == LotStatus.Broker).ToList();
        _totalSkins = lots.Sum(l => l.Quantity);
        _soldSkins = soldLots.Sum(l => l.Quantity);
        _totalValue = soldLots.Sum(l => (l.HammerPrice ?? 0) * l.Quantity);

        _loading = false;
    }
}
