@page "/buyer/invitations"
@attribute [Authorize(Roles = "Admin,Buyer")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Invitations - Buyer Portal</PageTitle>

<h1>Invitations</h1>
<p class="text-muted">View and respond to broker partnership invitations, or request a connection to a broker.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyerId == 0)
{
    <div class="alert alert-warning">Your account is not linked to a buyer profile. Please contact an administrator.</div>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="card mb-4 border-primary">
        <div class="section-header">
            <strong>Request Connection to Broker</strong>
        </div>
        <div>
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Select Broker</label>
                    <select class="form-select" @bind="_selectedBrokerId">
                        <option value="0">— Select Broker —</option>
                        @foreach (var b in _availableBrokers)
                        {
                            <option value="@b.Id">@b.CompanyName (@b.BrokerNumber)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-primary" @onclick="SendRequest" disabled="@(_selectedBrokerId == 0)">
                        Send Connection Request
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_brokerInitiatedPending.Any())
    {
        <div class="section-container mb-4">
            <div class="section-header">
                <strong>Pending Invitations from Brokers</strong> <span class="badge bg-dark">@_brokerInitiatedPending.Count</span>
            </div>
            <div class="section-body">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Broker</th>
                            <th>Requested</th>
                            <th style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in _brokerInitiatedPending)
                        {
                            <tr>
                                <td><strong>@(req.Broker?.CompanyName ?? $"Broker {req.BrokerId}")</strong></td>
                                <td>@req.RequestedAt.ToString("g")</td>
                                <td>
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => RespondToRequest(req, true)">Accept</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => RespondToRequest(req, false)">Decline</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_buyerInitiatedPending.Any())
    {
        <div class="card mb-4 border-info">
            <div class="section-header">
                <strong>Your Pending Requests</strong> <span class="badge bg-dark">@_buyerInitiatedPending.Count</span>
            </div>
            <div class="section-body">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Broker</th>
                            <th>Requested</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in _buyerInitiatedPending)
                        {
                            <tr>
                                <td><strong>@(req.Broker?.CompanyName ?? $"Broker {req.BrokerId}")</strong></td>
                                <td>@req.RequestedAt.ToString("g")</td>
                                <td><span class="badge bg-warning text-dark">Awaiting broker approval</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!_brokerInitiatedPending.Any() && !_buyerInitiatedPending.Any())
    {
        <div class="alert alert-info">No pending invitations or requests.</div>
    }

    @if (_approvedRequests.Any())
    {
        <div class="section-container">
            <div class="section-header">
                <strong>My Brokers</strong> <span class="badge bg-secondary">@_approvedRequests.Count</span>
            </div>
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Broker</th>
                            <th>Connected Since</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in _approvedRequests)
                        {
                            <tr>
                                <td><strong>@(req.Broker?.CompanyName ?? $"Broker {req.BrokerId}")</strong></td>
                                <td>@(req.RespondedAt?.ToString("g") ?? req.RequestedAt.ToString("g"))</td>
                                <td><span class="badge bg-success">Connected</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private int _buyerId;
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private int _selectedBrokerId;

    private List<BrokerCustomerRequestDto> _brokerInitiatedPending = new();
    private List<BrokerCustomerRequestDto> _buyerInitiatedPending = new();
    private List<BrokerCustomerRequestDto> _approvedRequests = new();
    private List<BrokerDto> _availableBrokers = new();

    protected override async Task OnInitializedAsync()
    {
        _buyerId = await ResolveBuyerId();
        if (_buyerId > 0)
            await LoadData();
        _loading = false;
    }

    private async Task<int> ResolveBuyerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BuyerId ?? 0;
    }

    private async Task LoadData()
    {
        var allRequests = await Api.GetCustomerRequestsByBuyerAsync(_buyerId);
        var pending = allRequests.Where(r => r.Status == CustomerRequestStatus.Pending).ToList();
        _brokerInitiatedPending = pending.Where(r => r.InitiatedBy == "Broker").ToList();
        _buyerInitiatedPending = pending.Where(r => r.InitiatedBy == "Buyer").ToList();
        _approvedRequests = allRequests.Where(r => r.Status == CustomerRequestStatus.Approved).ToList();

        var allBrokers = await Api.GetBrokersAsync();
        var linkedBrokerIds = allRequests
            .Where(r => r.Status == CustomerRequestStatus.Pending || r.Status == CustomerRequestStatus.Approved)
            .Select(r => r.BrokerId)
            .ToHashSet();
        _availableBrokers = allBrokers.Where(b => !linkedBrokerIds.Contains(b.Id)).OrderBy(b => b.CompanyName).ToList();
    }

    private async Task SendRequest()
    {
        if (_selectedBrokerId == 0) return;

        var result = await Api.CreateCustomerRequestByBuyerAsync(_buyerId, _selectedBrokerId);
        if (result != null)
        {
            var brokerName = _availableBrokers.FirstOrDefault(b => b.Id == _selectedBrokerId)?.CompanyName ?? "Broker";
            _message = $"Connection request sent to '{brokerName}'. Awaiting their approval.";
            _messageIsError = false;
            _selectedBrokerId = 0;
        }
        else
        {
            _message = "Failed to send request. A connection may already exist.";
            _messageIsError = true;
        }
        await LoadData();
    }

    private async Task RespondToRequest(BrokerCustomerRequestDto req, bool approve)
    {
        var result = await Api.RespondToCustomerRequestAsync(req.Id, approve);
        var brokerName = req.Broker?.CompanyName ?? $"Broker {req.BrokerId}";
        if (result != null)
        {
            _message = approve
                ? $"You accepted the invitation from '{brokerName}'."
                : $"You declined the invitation from '{brokerName}'.";
            _messageIsError = false;
        }
        else
        {
            _message = "Failed to respond to the invitation.";
            _messageIsError = true;
        }
        await LoadData();
    }
}
