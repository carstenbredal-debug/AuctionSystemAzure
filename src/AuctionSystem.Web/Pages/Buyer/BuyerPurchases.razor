@page "/buyer/purchases"
@attribute [Authorize(Roles = "Admin,Buyer")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Purchases - Buyer Portal</PageTitle>

<h1>Purchases</h1>
<p class="text-muted">View your purchased lots.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyerId == 0)
{
    <div class="alert alert-warning">Your account is not linked to a buyer profile. Please contact an administrator.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Lots</h5>
                    <h2>@_purchases.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Skins</h5>
                    <h2>@_purchases.Sum(p => p.TotalSkins)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Value</h5>
                    <h2>€@_purchases.Sum(p => p.PriceEur).ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Purchased Lots</strong>
            <span class="badge bg-secondary">@_purchases.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Size</th>
                        <th>Skins</th>
                        <th>Boxes</th>
                        <th>Price (EUR)</th>
                        <th>Broker</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_purchases.Any())
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">No purchases yet.</td></tr>
                    }
                    @foreach (var p in _purchases)
                    {
                        <tr>
                            <td><strong>@p.LotNumber</strong></td>
                            <td>@(p.SalesType ?? "—")</td>
                            <td>@(p.Gender ?? "—")</td>
                            <td>@(p.Group ?? "—")</td>
                            <td>@(p.Color ?? "—")</td>
                            <td>@(p.Quality ?? "—")</td>
                            <td>@(p.Size ?? "—")</td>
                            <td>@p.TotalSkins</td>
                            <td>@p.BoxCount</td>
                            <td>€@p.PriceEur.ToString("N2")</td>
                            <td>@(p.BrokerNumber ?? "") — @(p.BrokerName ?? "")</td>
                            <td>@(p.SoldAt?.ToString("g") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _buyerId;
    private bool _loading = true;
    private List<AuctionResultDto> _purchases = new();

    protected override async Task OnInitializedAsync()
    {
        _buyerId = await ResolveBuyerId();
        if (_buyerId > 0)
            _purchases = await Api.GetAuctionResultsByBuyerAsync(_buyerId);
        _loading = false;
    }

    private async Task<int> ResolveBuyerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BuyerId ?? 0;
    }
}
