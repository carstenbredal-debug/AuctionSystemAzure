@page "/buyer/financial"
@attribute [Authorize(Roles = "Admin,Buyer")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Financial - Buyer Portal</PageTitle>

<h1>Financial</h1>
<p class="text-muted">Financial overview of your purchases and spending.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyerId == 0)
{
    <div class="alert alert-warning">Your account is not linked to a buyer profile. Please contact an administrator.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Purchases</h5>
                    <h2>@_allocations.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Spent</h5>
                    <h2>@_allocations.Sum(a => a.TotalPrice).ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Confirmed</h5>
                    <h2 class="text-success">@_allocations.Count(a => a.Status == AllocationStatus.Allocated)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Pending</h5>
                    <h2 class="text-warning">@_allocations.Count(a => a.Status == AllocationStatus.Pending)</h2>
                </div>
            </div>
        </div>
    </div>

    @if (_brokerSummaries.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <strong>Spending by Broker</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Broker</th>
                            <th>Purchases</th>
                            <th>Quantity</th>
                            <th>Total Spent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _brokerSummaries)
                        {
                            <tr>
                                <td><strong>@s.BrokerName</strong></td>
                                <td>@s.Count</td>
                                <td>@s.TotalQuantity</td>
                                <td><strong>@s.TotalSpent.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <strong>Recent Purchases</strong> <span class="badge bg-secondary">@_allocations.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot</th>
                        <th>Broker</th>
                        <th>Qty</th>
                        <th>Price/Unit</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_allocations.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No purchases yet.</td></tr>
                    }
                    @foreach (var a in _allocations.OrderByDescending(a => a.AllocatedAt).Take(20))
                    {
                        <tr>
                            <td>@(a.Lot != null ? $"Lot #{a.Lot.LotNumber} — {a.Lot.Description}" : $"Lot {a.LotId}")</td>
                            <td>@(a.Broker?.CompanyName ?? $"Broker {a.BrokerId}")</td>
                            <td>@a.Quantity</td>
                            <td>@a.PricePerUnit.ToString("N2")</td>
                            <td><strong>@a.TotalPrice.ToString("N2")</strong></td>
                            <td><span class="badge bg-@GetStatusColor(a.Status)">@a.Status</span></td>
                            <td>@a.AllocatedAt.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _buyerId;
    private bool _loading = true;
    private List<LotAllocationDto> _allocations = new();
    private List<BrokerSpendingSummary> _brokerSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        _buyerId = await ResolveBuyerId();
        if (_buyerId > 0)
        {
            _allocations = await Api.GetAllocationsByBuyerAsync(_buyerId);
            _brokerSummaries = _allocations
                .GroupBy(a => new { a.BrokerId, Name = a.Broker?.CompanyName ?? $"Broker {a.BrokerId}" })
                .Select(g => new BrokerSpendingSummary
                {
                    BrokerName = g.Key.Name,
                    Count = g.Count(),
                    TotalQuantity = g.Sum(a => a.Quantity),
                    TotalSpent = g.Sum(a => a.TotalPrice)
                })
                .OrderByDescending(s => s.TotalSpent)
                .ToList();
        }
        _loading = false;
    }

    private async Task<int> ResolveBuyerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BuyerId ?? 0;
    }

    private string GetStatusColor(AllocationStatus status) => status switch
    {
        AllocationStatus.Allocated => "success",
        AllocationStatus.Pending => "warning",
        AllocationStatus.Cancelled => "danger",
        _ => "info"
    };

    private class BrokerSpendingSummary
    {
        public string BrokerName { get; set; } = "";
        public int Count { get; set; }
        public int TotalQuantity { get; set; }
        public decimal TotalSpent { get; set; }
    }
}
