@page "/buyer/financial"
@attribute [Authorize(Roles = "Admin,Buyer")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Financial - Buyer Portal</PageTitle>

<h1>Financial</h1>
<p class="text-muted">Financial overview of your purchases and spending.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyerId == 0)
{
    <div class="alert alert-warning">Your account is not linked to a buyer profile. Please contact an administrator.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Total Purchases</div>
                <div class="card-value">@_allocations.Count</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Total Spent</div>
                <div class="card-value">@_allocations.Sum(a => a.TotalPrice).ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Confirmed</div>
                <div class="card-value">@_allocations.Count(a => a.Status == AllocationStatus.Allocated)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Pending</div>
                <div class="card-value">@_allocations.Count(a => a.Status == AllocationStatus.Pending)</div>
            </div>
        </div>
    </div>

    @if (_brokerSummaries.Any())
    {
        <div class="section-container mb-4">
            <div class="section-header">
            Spending by Broker
        </div>
            <div class="section-body">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Broker</th>
                            <th>Purchases</th>
                            <th>Quantity</th>
                            <th>Total Spent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _brokerSummaries)
                        {
                            <tr>
                                <td><strong>@s.BrokerName</strong></td>
                                <td>@s.Count</td>
                                <td>@s.TotalQuantity</td>
                                <td><strong>@s.TotalSpent.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="section-container mb-4">
        <div class="section-header">
            Invoices
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>Number</th>
                        <th>Broker</th>
                        <th>Lots</th>
                        <th>Subtotal</th>
                        <th>Auction Fee</th>
                        <th>Commission</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_invoices.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No invoices or credit notes yet.</td></tr>
                    }
                    @foreach (var inv in _invoices)
                    {
                        <tr class="@(inv.IsCreditNote ? "credit-row" : "")">
                            <td>
                                @if (inv.IsCreditNote)
                                {
                                    <span class="badge bg-warning text-dark">Credit Note</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Invoice</span>
                                }
                            </td>
                            <td>
                                <strong>@inv.InvoiceNumber</strong>
                                @if (!string.IsNullOrEmpty(inv.OriginalInvoiceNumber))
                                {
                                    <br /><small class="text-muted">Ref: @inv.OriginalInvoiceNumber</small>
                                }
                            </td>
                            <td>@(inv.BrokerName ?? "—")</td>
                            <td>@inv.LinesCount</td>
                            <td>€@inv.SubTotal.ToString("N2")</td>
                            <td>€@inv.AuctionFee.ToString("N2")</td>
                            <td>€@inv.Commission.ToString("N2")</td>
                            <td><strong>€@inv.TotalAmount.ToString("N2")</strong></td>
                            <td>@inv.InvoiceDate.ToString("d")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(inv.PdfUrl))
                                {
                                    <a href="@inv.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">📄 PDF</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="section-container">
        <div class="section-header">
            Recent Purchases
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot</th>
                        <th>Broker</th>
                        <th>Qty</th>
                        <th>Price/Unit</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_allocations.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No purchases yet.</td></tr>
                    }
                    @foreach (var a in _allocations.OrderByDescending(a => a.AllocatedAt).Take(20))
                    {
                        <tr>
                            <td>@(a.Lot != null ? $"Lot #{a.Lot.LotNumber} — {a.Lot.Description}" : $"Lot {a.LotId}")</td>
                            <td>@(a.Broker?.CompanyName ?? $"Broker {a.BrokerId}")</td>
                            <td>@a.Quantity</td>
                            <td>@a.PricePerUnit.ToString("N2")</td>
                            <td><strong>@a.TotalPrice.ToString("N2")</strong></td>
                            <td><span class="badge bg-@GetStatusColor(a.Status)">@a.Status</span></td>
                            <td>@a.AllocatedAt.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _buyerId;
    private bool _loading = true;
    private List<LotAllocationDto> _allocations = new();
    private List<InvoiceSummaryDto> _invoices = new();
    private List<BrokerSpendingSummary> _brokerSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        _buyerId = await ResolveBuyerId();
        if (_buyerId > 0)
        {
            _allocations = await Api.GetAllocationsByBuyerAsync(_buyerId);
            _invoices = await Api.GetInvoicesByBuyerAsync(_buyerId);
            _brokerSummaries = _allocations
                .GroupBy(a => new { a.BrokerId, Name = a.Broker?.CompanyName ?? $"Broker {a.BrokerId}" })
                .Select(g => new BrokerSpendingSummary
                {
                    BrokerName = g.Key.Name,
                    Count = g.Count(),
                    TotalQuantity = g.Sum(a => a.Quantity),
                    TotalSpent = g.Sum(a => a.TotalPrice)
                })
                .OrderByDescending(s => s.TotalSpent)
                .ToList();
        }
        _loading = false;
    }

    private async Task<int> ResolveBuyerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BuyerId ?? 0;
    }

    private string GetStatusColor(AllocationStatus status) => status switch
    {
        AllocationStatus.Allocated => "success",
        AllocationStatus.Pending => "warning",
        AllocationStatus.Cancelled => "danger",
        _ => "info"
    };

    private string GetInvoiceStatusColor(string status) => status switch
    {
        "Paid" => "success",
        "Issued" or "Sent" => "primary",
        "Overdue" => "danger",
        "Draft" => "secondary",
        _ => "warning"
    };

    private class BrokerSpendingSummary
    {
        public string BrokerName { get; set; } = "";
        public int Count { get; set; }
        public int TotalQuantity { get; set; }
        public decimal TotalSpent { get; set; }
    }
}
