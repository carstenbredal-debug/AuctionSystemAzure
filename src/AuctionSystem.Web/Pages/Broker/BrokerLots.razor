@page "/broker/lots"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Lots - Broker Portal</PageTitle>

<h1>Lots</h1>
<p class="text-muted">Manage your purchased lots and sell to buyers.</p>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "purchased" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "purchased"'>
            Purchased Lots <span class="badge bg-secondary">@_purchasedLots.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "sold" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "sold"'>
            Sold Lots <span class="badge bg-secondary">@_soldLots.Count</span>
        </a>
    </li>
</ul>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_activeTab == "purchased")
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    @if (_purchasedLots.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <strong>Sell selected lots to:</strong>
                <select class="form-select w-auto" @bind="_selectedBuyerId">
                    <option value="0">— Select Buyer —</option>
                    @foreach (var buyer in _buyers)
                    {
                        <option value="@buyer.Id">@buyer.BuyerNumber — @buyer.Name</option>
                    }
                </select>
                <button class="btn btn-primary" @onclick="SellToBuyer" disabled="@(_selling || _selectedIds.Count == 0 || _selectedBuyerId <= 0)">
                    @if (_selling)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Sell (@_selectedIds.Count)
                </button>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Purchased Lots</strong>
            <span class="badge bg-secondary">@_purchasedLots.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" @onchange="ToggleAll" checked="@_allSelected" />
                        </th>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Size</th>
                        <th>Skins</th>
                        <th>Boxes</th>
                        <th>Price (EUR)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_purchasedLots.Count == 0)
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No purchased lots available.</td></tr>
                    }
                    @foreach (var r in _purchasedLots)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" checked="@_selectedIds.Contains(r.Id)" @onchange="() => ToggleSelection(r.Id)" />
                            </td>
                            <td><strong>@r.LotNumber</strong></td>
                            <td>@(r.SalesType ?? "—")</td>
                            <td>@(r.Gender ?? "—")</td>
                            <td>@(r.Group ?? "—")</td>
                            <td>@(r.Color ?? "—")</td>
                            <td>@(r.Quality ?? "—")</td>
                            <td>@(r.Size ?? "—")</td>
                            <td>@r.TotalSkins</td>
                            <td>@r.BoxCount</td>
                            <td>€@r.PriceEur.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Sold Lots</strong>
            <span class="badge bg-secondary">@_soldLots.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Skins</th>
                        <th>Price (EUR)</th>
                        <th>Sold To</th>
                        <th>Sold Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_soldLots.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No lots sold yet.</td></tr>
                    }
                    @foreach (var r in _soldLots)
                    {
                        <tr>
                            <td><strong>@r.LotNumber</strong></td>
                            <td>@(r.SalesType ?? "—")</td>
                            <td>@(r.Gender ?? "—")</td>
                            <td>@(r.Color ?? "—")</td>
                            <td>@(r.Quality ?? "—")</td>
                            <td>@r.TotalSkins</td>
                            <td>€@r.PriceEur.ToString("N2")</td>
                            <td>@(r.SoldToBuyerNumber ?? "") — @(r.SoldToBuyerName ?? "")</td>
                            <td>@(r.SoldAt?.ToString("g") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<AuctionResultDto> _allResults = new();
    private List<AuctionResultDto> _purchasedLots => _allResults.Where(r => r.SoldToBuyerId == null).ToList();
    private List<AuctionResultDto> _soldLots => _allResults.Where(r => r.SoldToBuyerId != null).ToList();
    private List<BuyerDto> _buyers = new();
    private HashSet<int> _selectedIds = new();
    private int _selectedBuyerId;
    private bool _loading = true;
    private bool _selling;
    private string _activeTab = "purchased";
    private string? _message;
    private bool _messageIsError;
    private bool _allSelected => _purchasedLots.Count > 0 && _purchasedLots.All(r => _selectedIds.Contains(r.Id));
    private int _brokerId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid != null)
        {
            var user = await Api.GetCurrentUserAsync(oid);
            if (user?.BrokerId != null)
            {
                _brokerId = user.BrokerId.Value;
                _allResults = await Api.GetAuctionResultsByBrokerAsync(_brokerId);
                _buyers = await Api.GetAllBuyersAsync();
            }
        }

        _loading = false;
    }

    private void ToggleSelection(int id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedIds = _purchasedLots.Select(r => r.Id).ToHashSet();
        else
            _selectedIds.Clear();
    }

    private async Task SellToBuyer()
    {
        _message = null;
        if (_selectedIds.Count == 0 || _selectedBuyerId <= 0) return;

        _selling = true;
        try
        {
            var resp = await Api.SellLotsToBuyerAsync(_selectedIds.ToList(), _selectedBuyerId);
            if (resp.IsSuccessStatusCode)
            {
                var buyer = _buyers.FirstOrDefault(b => b.Id == _selectedBuyerId);
                _message = $"{_selectedIds.Count} lot(s) sold to {buyer?.Name ?? "buyer"}.";
                _messageIsError = false;
                _selectedIds.Clear();
                _selectedBuyerId = 0;
                _allResults = await Api.GetAuctionResultsByBrokerAsync(_brokerId);
            }
            else
            {
                _message = "Failed to sell lots. Please try again.";
                _messageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _messageIsError = true;
        }
        finally
        {
            _selling = false;
        }
    }
}
