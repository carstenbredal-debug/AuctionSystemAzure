@* Lot Sales History Popup *@
@if (_showSalesHistoryModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sales History — Lot @_salesHistoryLotNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => _showSalesHistoryModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (_loadingSalesHistory)
                    {
                        <div class="text-center py-3"><span class="spinner-border"></span></div>
                    }
                    else if (_salesHistory.Count == 0)
                    {
                        <div class="text-center text-muted py-3">No sales history recorded for this lot.</div>
                    }
                    else
                    {
                        <table class="table table-sm table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Action</th>
                                    <th>Initiated By</th>
                                    <th>Buyer</th>
                                    <th>Invoice / Credit Note</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _salesHistory)
                                {
                                    <tr>
                                        <td>@h.CreatedAt.ToString("g")</td>
                                        <td>
                                            <span class="badge @(h.ActionType == "Sold" ? "bg-success" : h.ActionType == "Re-Invoice" ? "bg-warning" : "bg-info")">
                                                @h.ActionType
                                            </span>
                                        </td>
                                        <td><strong>@(h.Initials ?? "—")</strong></td>
                                        <td>@(h.BuyerName ?? "—")</td>
                                        <td>@(h.InvoiceNumber ?? "—")</td>
                                        <td>@(h.Amount != null ? $"€{h.Amount:N2}" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showSalesHistoryModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AuctionResultDto> _allResults = new();
    private string _sortColumn = "";
    private bool _sortAsc = true;

    private List<AuctionResultDto> GetSoldLots() => ApplySort(GetFilteredResults().Where(r => r.SoldToBuyerId != null));
    private List<AuctionResultDto> GetUnsoldLots() => ApplySort(GetFilteredResults().Where(r => r.SoldToBuyerId == null));

    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = column;
            _sortAsc = true;
        }
    }

    private string SortIndicator(string column) =>
        _sortColumn != column ? "⇅" : (_sortAsc ? "▲" : "▼");

    private List<AuctionResultDto> ApplySort(IEnumerable<AuctionResultDto> source)
    {
        if (string.IsNullOrEmpty(_sortColumn))
            return source.ToList();

        Func<AuctionResultDto, object?> keySelector = _sortColumn switch
        {
            "LotNumber" => r => r.LotNumber,
            "Type" => r => r.SalesType ?? "",
            "Gender" => r => r.Gender ?? "",
            "Group" => r => r.Group ?? "",
            "Color" => r => r.Color ?? "",
            "Quality" => r => r.Quality ?? "",
            "Size" => r => r.Size ?? "",
            "Skins" => r => r.TotalSkins,
            "Boxes" => r => r.BoxCount,
            "Price" => r => r.PriceEur,
            "HammerPrice" => r => r.TotalSkins * r.PriceEur,
            "AuctionFee" => r => CalcAuctionFee(r.TotalSkins, r.PriceEur),
            "Commission" => r => r.CommissionAmount ?? 0m,
            "Status" => r => !string.IsNullOrEmpty(r.ShippingStatus) ? r.ShippingStatus : (r.SoldToBuyerId == null ? "Un-Invoiced" : (r.InvoicePosted ? "Invoiced" : "Not Posted")),
            "SoldTo" => r => r.SoldToBuyerNumber ?? "",
            "SoldDate" => r => r.SoldAt ?? DateTime.MinValue,
            "InitiatedBy" => r => r.LastModifiedBy ?? "",
            _ => r => r.LotNumber
        };

        return _sortAsc
            ? source.OrderBy(keySelector).ToList()
            : source.OrderByDescending(keySelector).ToList();
    }
    private List<AuctionDto> _auctions = new();
    private int _selectedAuctionId;
    private List<BuyerDto> _buyers = new();
    private List<TakebackRequestDto> _pendingTakebacks = new();
    private decimal _auctionFeePercent;
    private decimal _handlingFeePerSkin;
    private HashSet<int> _selectedIds = new();
    private HashSet<int> _selectedSoldIds = new();
    private int _selectedBuyerId;
    private bool _loading = true;
    private bool _selling;
    private bool _showCommissionModal;
    private string _commissionType = "percentage";
    private decimal _commissionValue;
    private bool _showInvalidAmountPopup;
    private string _invalidAmountMessage = "";
    private bool _requestingTakeback;
    private string _activeTab = "purchased";
    private string? _message;
    private bool _messageIsError;
    private int? _lastInvoiceId;
    private string? _lastInvoicePdfUrl;
    private int? _lastCreditNoteId;
    private string? _lastCreditNotePdfUrl;
    private Dictionary<int, InvoiceLinkDto> _invoiceLinks = new();
    private string? _takebackMessage;
    private bool _takebackMessageIsError;
    private string? _brokerTakebackMessage;
    private bool _brokerTakebackMessageIsError;
    private bool _allSelected => GetUnsoldLots().Count > 0 && GetUnsoldLots().All(r => _selectedIds.Contains(r.Id));
    private bool _allSoldSelected => GetSoldLots().Count > 0 && GetSoldLots().All(r => _selectedSoldIds.Contains(r.Id));
    private int _brokerId;
    // Initials modal
    private bool _showInitialsModal;
    private string _initialsValue = "";
    private string _initialsAction = "sell"; // "sell" or "reinvoice"
    // Sales history modal
    private bool _showSalesHistoryModal;
    private int _salesHistoryLotNumber;
    private bool _loadingSalesHistory;
    private List<LotSalesHistoryDto> _salesHistory = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid != null)
        {
            var user = await Api.GetCurrentUserAsync(oid);
            if (user?.BrokerId != null)
            {
                _brokerId = user.BrokerId.Value;

                // Fire the independent loads concurrently, then await once (was ~5 serial round-trips).
                var auctionsTask = Api.GetAuctionsAsync();
                // Sell dropdown must be ONLY the broker's linked customers (the BrokerBuyers
                // junction). No customer-request fallback — a non-linked buyer can never appear.
                var buyersTask = Api.GetBrokerLinkedBuyersAsync(_brokerId);
                var takebacksTask = Api.GetTakebackRequestsByBrokerAsync(_brokerId);
                var linksTask = Api.GetInvoiceLinksForBrokerAsync(_brokerId);
                var paramsTask = Api.GetParametersAsync();
                await Task.WhenAll(auctionsTask, buyersTask, takebacksTask, linksTask, paramsTask);

                _auctions = (await auctionsTask)
                    .Where(a => a.Status == AuctionStatus.Active || a.Status == AuctionStatus.Closed)
                    .ToList();
                if (_auctions.Any())
                    _selectedAuctionId = _auctions.First().Id;
                _buyers = await buyersTask;
                _pendingTakebacks = await takebacksTask;
                _invoiceLinks = await linksTask;
                ApplyFeeParameters(await paramsTask);

                // Results depend on the chosen auction, so this one runs after.
                await LoadResults();
            }
        }

        _loading = false;
    }

    // Results are now fetched scoped to the selected auction, so _allResults already holds just
    // that sale. Kept as a defensive filter so a stale _selectedAuctionId can never leak rows.
    private List<AuctionResultDto> GetFilteredResults()
    {
        if (_selectedAuctionId <= 0) return new();
        return _allResults.Where(r => r.AuctionId == _selectedAuctionId).ToList();
    }

    // Download a catalogue PDF of just this broker's won lots in the selected auction (full lot skins).
    private string BrokerCatalogUrl()
    {
        var num = _auctions.FirstOrDefault(a => a.Id == _selectedAuctionId)?.AuctionNumber;
        return string.IsNullOrEmpty(num)
            ? "javascript:void(0)"
            : $"api/catalog/pdf?auctionNumber={Uri.EscapeDataString(num)}&brokerId={_brokerId}";
    }

    // Load only the selected auction's results instead of the broker's entire cross-auction history.
    private async Task LoadResults()
    {
        _allResults = _selectedAuctionId > 0
            ? await Api.GetAuctionResultsByBrokerAsync(_brokerId, _selectedAuctionId)
            : new();
    }

    private async Task OnAuctionFilterChanged()
    {
        _selectedIds.Clear();
        _selectedSoldIds.Clear();
        await LoadResults();
    }

    private void ApplyFeeParameters(List<SystemParameterDto> parameters)
    {
        var auctionFee = parameters.FirstOrDefault(p => p.Key == "AuctionFee");
        var handlingFee = parameters.FirstOrDefault(p => p.Key == "HandlingFee");
        if (auctionFee != null) decimal.TryParse(auctionFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _auctionFeePercent);
        if (handlingFee != null) decimal.TryParse(handlingFee.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out _handlingFeePerSkin);
    }

    private decimal CalcAuctionFee(int skins, decimal priceEur)
    {
        var hammerPrice = skins * priceEur;
        var handlingFee = skins * _handlingFeePerSkin;
        return (hammerPrice + handlingFee) * _auctionFeePercent / 100m;
    }

    private void ToggleSelection(int id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedIds = GetUnsoldLots().Select(r => r.Id).ToHashSet();
        else
            _selectedIds.Clear();
    }

    private void OpenCommissionModal()
    {
        _commissionType = "percentage";
        _commissionValue = 0;
        _showInvalidAmountPopup = false;
        _showCommissionModal = true;
    }


    private void CloseCommissionModal()
    {
        _showCommissionModal = false;
    }

    private void OpenInitialsForSell()
    {
        _initialsAction = "sell";
        _initialsValue = "";
        _showInitialsModal = true;
    }

    private void InitialsNextToCommission()
    {
        if (string.IsNullOrWhiteSpace(_initialsValue)) return;
        _showInitialsModal = false;
        _commissionType = "percentage";
        _commissionValue = 0;
        _showInvalidAmountPopup = false;
        _showCommissionModal = true;
    }

    private async Task HandleCommissionKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _selectedIds.Count > 0 && _selectedBuyerId > 0)
            await SellToBuyer();
    }

    private void OpenInitialsForReinvoice()
    {
        _initialsAction = "reinvoice";
        _initialsValue = "";
        _showInitialsModal = true;
    }

    private void CloseInitialsModal()
    {
        _showInitialsModal = false;
        _initialsValue = "";
    }

    private async Task HandleInitialsKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_initialsValue))
        {
            if (_initialsAction == "sell")
                InitialsNextToCommission();
            else
                await ConfirmInitials();
        }
    }

    private async Task ConfirmInitials()
    {
        if (string.IsNullOrWhiteSpace(_initialsValue)) return;
        _showInitialsModal = false;
        if (_initialsAction == "sell")
            await SellToBuyer();
        else
            await ExecuteTakeback();
    }

    private async Task SellToBuyer()
    {
        _message = null;
        if (_selectedIds.Count == 0 || _selectedBuyerId <= 0) return;

        // Commission can never be negative. Show the popup; OK dismisses it and leaves the
        // commission modal open underneath so the user can correct the value.
        if (_commissionValue < 0)
        {
            _invalidAmountMessage = _commissionType == "percentage"
                ? "Commission percentage cannot be negative."
                : "Commission amount cannot be negative.";
            _showInvalidAmountPopup = true;
            return;
        }

        _selling = true;
        try
        {
            var resp = await Api.SellLotsToBuyerAsync(_selectedIds.ToList(), _selectedBuyerId, _commissionType, _commissionValue, _initialsValue);
            if (resp.IsSuccessStatusCode)
                await HandleSellSuccess(resp);
            else
            {
                _message = "Failed to sell lots. Please try again.";
                _messageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _messageIsError = true;
        }
        finally
        {
            _selling = false;
        }
    }

    private async Task HandleSellSuccess(HttpResponseMessage resp)
    {
        var buyer = _buyers.FirstOrDefault(b => b.Id == _selectedBuyerId);
        var json = await resp.Content.ReadFromJsonAsync<SellResponse>();
        _message = $"{_selectedIds.Count} lot(s) sold to {buyer?.Name ?? "buyer"}.";
        if (json?.InvoiceId != null)
        {
            _lastInvoiceId = json.InvoiceId;
            _lastInvoicePdfUrl = json.PdfUrl;
            // BC posting now runs in the background, so the number/PDF aren't ready this instant —
            // they appear in the grid shortly (the delayed refresh below picks them up).
            _message += " Invoice created — posting to Business Central; the number and PDF will appear shortly.";
        }
        _messageIsError = !string.IsNullOrEmpty(json?.BcError);
        if (_messageIsError) _message += $" BC Error: {json!.BcError}";

        _selectedIds.Clear();
        _selectedBuyerId = 0;
        _showCommissionModal = false;
        await LoadResults();
        _invoiceLinks = await Api.GetInvoiceLinksForBrokerAsync(_brokerId);

        // The background worker posts to BC within seconds; refresh a few times so the posted number,
        // PDF and "Invoiced" status appear without the broker having to reload the page.
        _ = RefreshAfterBcPostAsync();
    }

    private async Task RefreshAfterBcPostAsync()
    {
        try
        {
            for (var i = 0; i < 3; i++)
            {
                await Task.Delay(3000);
                await LoadResults();
                _pendingTakebacks = await Api.GetTakebackRequestsByBrokerAsync(_brokerId);
                _invoiceLinks = await Api.GetInvoiceLinksForBrokerAsync(_brokerId);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* best-effort; the broker can always reload manually */ }
    }

    private void ToggleSoldSelection(int id)
    {
        if (!_selectedSoldIds.Remove(id))
            _selectedSoldIds.Add(id);
    }

    private void ToggleAllSold(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedSoldIds = GetSoldLots().Select(r => r.Id).ToHashSet();
        else
            _selectedSoldIds.Clear();
    }

    private async Task RequestTakeback()
    {
        if (_selectedSoldIds.Count == 0) return;
        OpenInitialsForReinvoice();
    }

    private async Task ExecuteTakeback()
    {
        _takebackMessage = null;
        if (_selectedSoldIds.Count == 0) return;

        _requestingTakeback = true;
        try
        {
            var resp = await Api.RequestTakebackAsync(_selectedSoldIds.ToList(), _initialsValue);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<TakebackResponse>();
                _takebackMessage = $"{_selectedSoldIds.Count} lot(s) taken back. Lots moved to Un-invoiced.";
                if (json?.CreditNoteId != null)
                {
                    _lastCreditNoteId = json.CreditNoteId;
                    _lastCreditNotePdfUrl = json.CreditNotePdfUrl;
                    // Credit-note BC posting runs in the background now; the PDF appears shortly.
                    _takebackMessage += " Credit note created — posting to Business Central; the PDF will appear shortly.";
                }
                _takebackMessageIsError = false;
                _selectedSoldIds.Clear();
                await LoadResults();
                _pendingTakebacks = await Api.GetTakebackRequestsByBrokerAsync(_brokerId);
                _invoiceLinks = await Api.GetInvoiceLinksForBrokerAsync(_brokerId);

                // Pick up the background BC post (number + PDF) without a manual reload.
                _ = RefreshAfterBcPostAsync();
            }
            else
            {
                try
                {
                    var errorJson = await resp.Content.ReadFromJsonAsync<TakebackErrorResponse>();
                    if (errorJson?.Error == "Lot Sold")
                    {
                        _takebackMessage = $"Lot Sold — {errorJson.Message}";
                    }
                    else
                    {
                        _takebackMessage = "Failed to request takeback. Please try again.";
                    }
                }
                catch
                {
                    _takebackMessage = "Failed to request takeback. Please try again.";
                }
                _takebackMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _takebackMessage = $"Error: {ex.Message}";
            _takebackMessageIsError = true;
        }
        finally
        {
            _requestingTakeback = false;
        }
    }

    private async Task RespondBrokerTakeback(int requestId, bool approve)
    {
        _brokerTakebackMessage = null;
        try
        {
            var resp = await Api.RespondTakebackAsync(requestId, approve);
            if (resp.IsSuccessStatusCode)
            {
                _brokerTakebackMessage = approve
                    ? "Return approved. Lot moved back to un-invoiced. Credit note posting to Business Central; it will appear shortly."
                    : "Return request declined.";
                _brokerTakebackMessageIsError = false;
                await LoadResults();
                _pendingTakebacks = await Api.GetTakebackRequestsByBrokerAsync(_brokerId);
                _invoiceLinks = await Api.GetInvoiceLinksForBrokerAsync(_brokerId);
                // Approving generates a credit note whose BC post runs in the background; refresh so it appears.
                if (approve) _ = RefreshAfterBcPostAsync();
            }
            else
            {
                _brokerTakebackMessage = "Failed to respond. Please try again.";
                _brokerTakebackMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _brokerTakebackMessage = $"Error: {ex.Message}";
            _brokerTakebackMessageIsError = true;
        }
    }

    private async Task ShowLotSalesHistory(int lotNumber)
    {
        _salesHistoryLotNumber = lotNumber;
        _loadingSalesHistory = true;
        _showSalesHistoryModal = true;
        _salesHistory = new();
        StateHasChanged();
        try
        {
            _salesHistory = await Api.GetLotSalesHistoryAsync(lotNumber);
        }
        catch { }
        _loadingSalesHistory = false;
    }

    private class SellResponse
    {
        public int SoldCount { get; set; }
        public int? InvoiceId { get; set; }
        public string? PdfUrl { get; set; }
        public string? BcError { get; set; }
    }

    private class TakebackResponse
    {
        public int RequestCount { get; set; }
        public int? CreditNoteId { get; set; }
        public string? CreditNotePdfUrl { get; set; }
    }

    private class TakebackErrorResponse
    {
        public string? Error { get; set; }
        public string? Message { get; set; }
    }

    private async Task ExportPurchasedToExcel()
    {
        var headers = new[] { "Lot #", "Type", "Gender", "Group", "Color", "Quality", "Size", "Skins", "Boxes", "Price (EUR)", "Hammer Price", "Auction Fee", "Commission", "Status" };
        var rows = GetFilteredResults().Select(r => new object[]
        {
            r.LotNumber,
            r.SalesType ?? "",
            r.Gender ?? "",
            r.Group ?? "",
            r.Color ?? "",
            r.Quality ?? "",
            r.Size ?? "",
            r.TotalSkins,
            r.BoxCount,
            r.PriceEur,
            r.TotalSkins * r.PriceEur,
            CalcAuctionFee(r.TotalSkins, r.PriceEur),
            r.CommissionAmount ?? 0m,
            !string.IsNullOrEmpty(r.ShippingStatus) ? r.ShippingStatus : (r.SoldToBuyerId == null ? "Un-Invoiced" : (r.InvoicePosted ? "Invoiced" : "Not Posted"))
        }).ToArray();

        await JS.InvokeVoidAsync("exportToExcel", $"PurchasedLots_{DateTime.Now:yyyyMMdd}.xlsx", "Purchased Lots", headers, rows);
    }
}
