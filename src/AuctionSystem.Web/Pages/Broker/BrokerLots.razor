@* Initials Popup Modal *@
@if (_showInitialsModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Enter Initials</h5>
                    <button type="button" class="btn-close" @onclick="CloseInitialsModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Enter your initials to @(_initialsAction == "sell" ? "confirm the sale" : "confirm re-invoicing")</p>
