@page "/broker/lots"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api

<PageTitle>Lots - Broker Portal</PageTitle>

<h1>Purchased Lots</h1>
<p class="text-muted">Your purchased and allocated lots from auctions.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Purchased Lots</strong>
            <span class="badge bg-secondary">@_auctionResults.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Size</th>
                        <th>Skins</th>
                        <th>Boxes</th>
                        <th>Price (EUR)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_auctionResults.Count == 0)
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No purchased lots yet.</td></tr>
                    }
                    @foreach (var r in _auctionResults)
                    {
                        <tr>
                            <td><strong>@r.LotNumber</strong></td>
                            <td>@(r.SalesType ?? "—")</td>
                            <td>@(r.Gender ?? "—")</td>
                            <td>@(r.Group ?? "—")</td>
                            <td>@(r.Color ?? "—")</td>
                            <td>@(r.Quality ?? "—")</td>
                            <td>@(r.Size ?? "—")</td>
                            <td>@r.TotalSkins</td>
                            <td>@r.BoxCount</td>
                            <td>€@r.PriceEur.ToString("N2")</td>
                            <td>
                                @if (r.Processed)
                                {
                                    <span class="badge bg-success">Allocated</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<AuctionResultDto> _auctionResults = new();
    private bool _loading = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var objectId = authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                ?? authState.User.FindFirst("oid")?.Value
                ?? authState.User.FindFirst("sub")?.Value;

            if (objectId != null)
            {
                var currentUser = await Api.GetCurrentUserAsync(objectId);
                if (currentUser?.BrokerId != null)
                {
                    _auctionResults = await Api.GetAuctionResultsByBrokerAsync(currentUser.BrokerId.Value);
                }
            }
        }

        _loading = false;
    }
}
