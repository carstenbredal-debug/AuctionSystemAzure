@page "/broker/lots"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Lots - Broker Portal</PageTitle>

<h1>Lots</h1>
<p class="text-muted">Manage your purchased lots and sell to buyers.</p>

@if (!_loading)
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Total Purchase</h5>
                    <h2>€@_allResults.Sum(r => r.TotalSkins * r.PriceEur).ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Sold</h5>
                    <h2>€@_soldLots.Sum(r => r.TotalSkins * r.PriceEur).ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Unsold</h5>
                    <h2>€@_unsoldLots.Sum(r => r.TotalSkins * r.PriceEur).ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "purchased" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "purchased"'>
            Purchased Lots <span class="badge bg-secondary">@_allResults.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "sold" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "sold"'>
            Sold Lots <span class="badge bg-secondary">@_soldLots.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "unsold" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "unsold"'>
            Unsold Lots <span class="badge bg-secondary">@_unsoldLots.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "takeback" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "takeback"'>
            Takeback <span class="badge bg-@(_pendingTakebacks.Count > 0 ? "warning" : "secondary")">@_pendingTakebacks.Count</span>
        </a>
    </li>
</ul>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_activeTab == "purchased")
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>All Purchased Lots</strong>
            <span class="badge bg-secondary">@_allResults.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Size</th>
                        <th>Skins</th>
                        <th>Boxes</th>
                        <th>Price (EUR)</th>
                        <th>Hammer Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_allResults.Count == 0)
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">No purchased lots yet.</td></tr>
                    }
                    @foreach (var r in _allResults)
                    {
                        <tr>
                            <td><strong>@r.LotNumber</strong></td>
                            <td>@(r.SalesType ?? "—")</td>
                            <td>@(r.Gender ?? "—")</td>
                            <td>@(r.Group ?? "—")</td>
                            <td>@(r.Color ?? "—")</td>
                            <td>@(r.Quality ?? "—")</td>
                            <td>@(r.Size ?? "—")</td>
                            <td>@r.TotalSkins</td>
                            <td>@r.BoxCount</td>
                            <td>€@r.PriceEur.ToString("N2")</td>
                            <td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td>
                            <td>
                                @if (r.SoldToBuyerId != null)
                                {
                                    <span class="badge bg-success">Sold</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Unsold</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (_activeTab == "sold")
{
    @if (!string.IsNullOrEmpty(_takebackMessage))
    {
        <div class="alert @(_takebackMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
            @_takebackMessage
            <button type="button" class="btn-close" @onclick="() => _takebackMessage = null"></button>
        </div>
    }

    @if (_soldLots.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <strong>Takeback selected lots:</strong>
                <button class="btn btn-warning" @onclick="RequestTakeback" disabled="@(_requestingTakeback || _selectedSoldIds.Count == 0)">
                    @if (_requestingTakeback)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Takeback (@_selectedSoldIds.Count)
                </button>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Sold Lots</strong>
            <span class="badge bg-secondary">@_soldLots.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" @onchange="ToggleAllSold" checked="@_allSoldSelected" />
                        </th>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Skins</th>
                        <th>Price (EUR)</th>
                        <th>Hammer Price</th>
                        <th>Sold To</th>
                        <th>Sold Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_soldLots.Count == 0)
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No lots sold yet.</td></tr>
                    }
                    @foreach (var r in _soldLots)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" checked="@_selectedSoldIds.Contains(r.Id)" @onchange="() => ToggleSoldSelection(r.Id)" />
                            </td>
                            <td><strong>@r.LotNumber</strong></td>
                            <td>@(r.SalesType ?? "—")</td>
                            <td>@(r.Gender ?? "—")</td>
                            <td>@(r.Color ?? "—")</td>
                            <td>@(r.Quality ?? "—")</td>
                            <td>@r.TotalSkins</td>
                            <td>€@r.PriceEur.ToString("N2")</td>
                            <td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td>
                            <td>@(r.SoldToBuyerNumber ?? "") — @(r.SoldToBuyerName ?? "")</td>
                            <td>@(r.SoldAt?.ToString("g") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (_activeTab == "unsold")
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    @if (_unsoldLots.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <strong>Sell selected lots to:</strong>
                <select class="form-select w-auto" @bind="_selectedBuyerId">
                    <option value="0">— Select Buyer —</option>
                    @foreach (var buyer in _buyers)
                    {
                        <option value="@buyer.Id">@buyer.BuyerNumber — @buyer.Name</option>
                    }
                </select>
                <button class="btn btn-primary" @onclick="SellToBuyer" disabled="@(_selling || _selectedIds.Count == 0 || _selectedBuyerId <= 0)">
                    @if (_selling)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Sell (@_selectedIds.Count)
                </button>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Unsold Lots</strong>
            <span class="badge bg-secondary">@_unsoldLots.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" @onchange="ToggleAll" checked="@_allSelected" />
                        </th>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Size</th>
                        <th>Skins</th>
                        <th>Boxes</th>
                        <th>Price (EUR)</th>
                        <th>Hammer Price</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_unsoldLots.Count == 0)
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">All lots have been sold.</td></tr>
                    }
                    @foreach (var r in _unsoldLots)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" checked="@_selectedIds.Contains(r.Id)" @onchange="() => ToggleSelection(r.Id)" />
                            </td>
                            <td><strong>@r.LotNumber</strong></td>
                            <td>@(r.SalesType ?? "—")</td>
                            <td>@(r.Gender ?? "—")</td>
                            <td>@(r.Group ?? "—")</td>
                            <td>@(r.Color ?? "—")</td>
                            <td>@(r.Quality ?? "—")</td>
                            <td>@(r.Size ?? "—")</td>
                            <td>@r.TotalSkins</td>
                            <td>@r.BoxCount</td>
                            <td>€@r.PriceEur.ToString("N2")</td>
                            <td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (_activeTab == "takeback")
{
    @if (!string.IsNullOrEmpty(_brokerTakebackMessage))
    {
        <div class="alert @(_brokerTakebackMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
            @_brokerTakebackMessage
            <button type="button" class="btn-close" @onclick="() => _brokerTakebackMessage = null"></button>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Takeback Requests</strong>
            <span class="badge bg-secondary">@_pendingTakebacks.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Lot #</th>
                        <th>Type</th>
                        <th>Gender</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th>Skins</th>
                        <th>Price (EUR)</th>
                        <th>Hammer Price</th>
                        <th>Sold To</th>
                        <th>Initiated By</th>
                        <th>Requested</th>
                        <th>Status</th>
                        <th style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pendingTakebacks.Count == 0)
                    {
                        <tr><td colspan="13" class="text-center text-muted py-4">No takeback requests.</td></tr>
                    }
                    @foreach (var t in _pendingTakebacks)
                    {
                        <tr>
                            <td><strong>@t.LotNumber</strong></td>
                            <td>@(t.SalesType ?? "—")</td>
                            <td>@(t.Gender ?? "—")</td>
                            <td>@(t.Color ?? "—")</td>
                            <td>@(t.Quality ?? "—")</td>
                            <td>@t.TotalSkins</td>
                            <td>€@t.PriceEur.ToString("N2")</td>
                            <td>€@((t.TotalSkins * t.PriceEur).ToString("N2"))</td>
                            <td>@(t.BuyerNumber ?? "") — @(t.BuyerName ?? "")</td>
                            <td><span class="badge bg-info">@t.InitiatedBy</span></td>
                            <td>@t.RequestedAt.ToString("g")</td>
                            <td>
                                <span class="badge bg-@(t.Status == CustomerRequestStatus.Pending ? "warning" : t.Status == CustomerRequestStatus.Approved ? "success" : "danger")">
                                    @t.Status
                                </span>
                            </td>
                            <td>
                                @if (t.Status == CustomerRequestStatus.Pending && t.InitiatedBy == "Buyer")
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => RespondBrokerTakeback(t.Id, true)">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RespondBrokerTakeback(t.Id, false)">Decline</button>
                                }
                                else
                                {
                                    <small class="text-muted">@(t.RespondedAt?.ToString("g") ?? "")</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<AuctionResultDto> _allResults = new();
    private List<AuctionResultDto> _soldLots => _allResults.Where(r => r.SoldToBuyerId != null).ToList();
    private List<AuctionResultDto> _unsoldLots => _allResults.Where(r => r.SoldToBuyerId == null).ToList();
    private List<BuyerDto> _buyers = new();
    private List<TakebackRequestDto> _pendingTakebacks = new();
    private HashSet<int> _selectedIds = new();
    private HashSet<int> _selectedSoldIds = new();
    private int _selectedBuyerId;
    private bool _loading = true;
    private bool _selling;
    private bool _requestingTakeback;
    private string _activeTab = "purchased";
    private string? _message;
    private bool _messageIsError;
    private string? _takebackMessage;
    private bool _takebackMessageIsError;
    private string? _brokerTakebackMessage;
    private bool _brokerTakebackMessageIsError;
    private bool _allSelected => _unsoldLots.Count > 0 && _unsoldLots.All(r => _selectedIds.Contains(r.Id));
    private bool _allSoldSelected => _soldLots.Count > 0 && _soldLots.All(r => _selectedSoldIds.Contains(r.Id));
    private int _brokerId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (oid != null)
        {
            var user = await Api.GetCurrentUserAsync(oid);
            if (user?.BrokerId != null)
            {
                _brokerId = user.BrokerId.Value;
                _allResults = await Api.GetAuctionResultsByBrokerAsync(_brokerId);
                _buyers = await Api.GetAllBuyersAsync();
                _pendingTakebacks = await Api.GetTakebackRequestsByBrokerAsync(_brokerId);
            }
        }

        _loading = false;
    }

    private void ToggleSelection(int id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedIds = _unsoldLots.Select(r => r.Id).ToHashSet();
        else
            _selectedIds.Clear();
    }

    private async Task SellToBuyer()
    {
        _message = null;
        if (_selectedIds.Count == 0 || _selectedBuyerId <= 0) return;

        _selling = true;
        try
        {
            var resp = await Api.SellLotsToBuyerAsync(_selectedIds.ToList(), _selectedBuyerId);
            if (resp.IsSuccessStatusCode)
            {
                var buyer = _buyers.FirstOrDefault(b => b.Id == _selectedBuyerId);
                _message = $"{_selectedIds.Count} lot(s) sold to {buyer?.Name ?? "buyer"}.";
                _messageIsError = false;
                _selectedIds.Clear();
                _selectedBuyerId = 0;
                _allResults = await Api.GetAuctionResultsByBrokerAsync(_brokerId);
            }
            else
            {
                _message = "Failed to sell lots. Please try again.";
                _messageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _messageIsError = true;
        }
        finally
        {
            _selling = false;
        }
    }

    private void ToggleSoldSelection(int id)
    {
        if (!_selectedSoldIds.Remove(id))
            _selectedSoldIds.Add(id);
    }

    private void ToggleAllSold(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedSoldIds = _soldLots.Select(r => r.Id).ToHashSet();
        else
            _selectedSoldIds.Clear();
    }

    private async Task RequestTakeback()
    {
        _takebackMessage = null;
        if (_selectedSoldIds.Count == 0) return;

        _requestingTakeback = true;
        try
        {
            var resp = await Api.RequestTakebackAsync(_selectedSoldIds.ToList());
            if (resp.IsSuccessStatusCode)
            {
                _takebackMessage = $"{_selectedSoldIds.Count} lot(s) taken back. Lots moved to unsold.";
                _takebackMessageIsError = false;
                _selectedSoldIds.Clear();
                _allResults = await Api.GetAuctionResultsByBrokerAsync(_brokerId);
                _pendingTakebacks = await Api.GetTakebackRequestsByBrokerAsync(_brokerId);
            }
            else
            {
                _takebackMessage = "Failed to request takeback. Please try again.";
                _takebackMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _takebackMessage = $"Error: {ex.Message}";
            _takebackMessageIsError = true;
        }
        finally
        {
            _requestingTakeback = false;
        }
    }

    private async Task RespondBrokerTakeback(int requestId, bool approve)
    {
        _brokerTakebackMessage = null;
        try
        {
            var resp = await Api.RespondTakebackAsync(requestId, approve);
            if (resp.IsSuccessStatusCode)
            {
                _brokerTakebackMessage = approve ? "Return approved. Lot moved back to unsold." : "Return request declined.";
                _brokerTakebackMessageIsError = false;
                _allResults = await Api.GetAuctionResultsByBrokerAsync(_brokerId);
                _pendingTakebacks = await Api.GetTakebackRequestsByBrokerAsync(_brokerId);
            }
            else
            {
                _brokerTakebackMessage = "Failed to respond. Please try again.";
                _brokerTakebackMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _brokerTakebackMessage = $"Error: {ex.Message}";
            _brokerTakebackMessageIsError = true;
        }
    }
}
