@page "/broker/financial"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Financial - Broker Portal</PageTitle>

<h1>Financial</h1>
<p class="text-muted">View your invoices and financial overview.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_brokerId == 0)
{
    <div class="alert alert-warning">Your account is not linked to a broker profile. Please contact an administrator.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Total Invoices</div>
                <div class="card-value">@_invoices.Count</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Outstanding</div>
                <div class="card-value">@_invoices.Count(i => i.Status != "Paid")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Paid</div>
                <div class="card-value">@_invoices.Count(i => i.Status == "Paid")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="summary-card">
                <div class="card-title">Total Amount</div>
                <div class="card-value">€@_invoices.Sum(i => i.TotalAmount).ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="section-container">
        <div class="section-header">
            Invoices
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>Number</th>
                        <th>Buyer</th>
                        <th>Lots</th>
                        <th>Subtotal</th>
                        <th>Auction Fee</th>
                        <th>Commission</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_invoices.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No invoices or credit notes yet.</td></tr>
                    }
                    @foreach (var inv in _invoices)
                    {
                        <tr class="@(inv.IsCreditNote ? "credit-row" : "")">
                            <td>
                                @if (inv.IsCreditNote)
                                {
                                    <span class="badge bg-warning text-dark">Credit Note</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Invoice</span>
                                }
                            </td>
                            <td>
                                <strong>@inv.InvoiceNumber</strong>
                                @if (!string.IsNullOrEmpty(inv.OriginalInvoiceNumber))
                                {
                                    <br /><small class="text-muted">Ref: @inv.OriginalInvoiceNumber</small>
                                }
                            </td>
                            <td>@(inv.BuyerName ?? "—")</td>
                            <td>@inv.LinesCount</td>
                            <td>€@inv.SubTotal.ToString("N2")</td>
                            <td>€@inv.AuctionFee.ToString("N2")</td>
                            <td>€@inv.Commission.ToString("N2")</td>
                            <td><strong>€@inv.TotalAmount.ToString("N2")</strong></td>
                            <td>@inv.InvoiceDate.ToString("d")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(inv.PdfUrl))
                                {
                                    <a href="@inv.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">📄 PDF</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _brokerId;
    private bool _loading = true;
    private List<InvoiceSummaryDto> _invoices = new();

    protected override async Task OnInitializedAsync()
    {
        _brokerId = await ResolveBrokerId();
        if (_brokerId > 0)
            _invoices = await Api.GetInvoicesByBrokerAsync(_brokerId);
        _loading = false;
    }

    private async Task<int> ResolveBrokerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BrokerId ?? 0;
    }

    private string GetStatusColor(string status) => status switch
    {
        "Paid" => "success",
        "Issued" or "Sent" => "primary",
        "Overdue" => "danger",
        "Draft" => "secondary",
        "Cancelled" => "dark",
        _ => "warning"
    };
}
