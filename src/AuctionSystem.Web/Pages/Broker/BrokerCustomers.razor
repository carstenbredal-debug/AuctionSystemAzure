@page "/broker/customers"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState

<PageTitle>Customers - Broker Portal</PageTitle>

<h1>Customers</h1>
<p class="text-muted">Select a customer from the system to send them an invitation. They must approve before they appear as your customer.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_brokerId == 0)
{
    <div class="alert alert-warning">Your account is not linked to a broker profile. Please contact an administrator.</div>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <strong>Add Customer</strong>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Select Customer</label>
                    <select class="form-select" @bind="_selectedBuyerId">
                        <option value="0">— Choose a customer to invite —</option>
                        @foreach (var buyer in _availableBuyers)
                        {
                            <option value="@buyer.Id">@buyer.Name (@buyer.BuyerNumber) — @buyer.ContactEmail</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary" @onclick="SendInvitation" disabled="@(_selectedBuyerId == 0)">
                        Send Invitation
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Your Customers</strong> <span class="badge bg-secondary">@_requests.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Number</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Requested</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_requests.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No customers yet. Use the dropdown above to invite a customer.</td></tr>
                    }
                    @foreach (var req in _requests)
                    {
                        <tr>
                            <td>@(req.Buyer?.BuyerNumber ?? "—")</td>
                            <td><strong>@(req.Buyer?.Name ?? "—")</strong></td>
                            <td>@(req.Buyer?.ContactEmail ?? "—")</td>
                            <td>@(req.Buyer?.ContactPhone ?? "—")</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(req.Status)">
                                    @GetStatusText(req.Status)
                                </span>
                            </td>
                            <td>@req.RequestedAt.ToString("g")</td>
                            <td>
                                @if (req.Status == CustomerRequestStatus.Pending)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelRequest(req)">Cancel</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _brokerId;
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private int _selectedBuyerId;

    private List<BrokerCustomerRequestDto> _requests = new();
    private List<BuyerDto> _allBuyers = new();
    private List<BuyerDto> _availableBuyers = new();

    protected override async Task OnInitializedAsync()
    {
        _brokerId = await ResolveBrokerId();
        if (_brokerId > 0)
            await LoadData();
        _loading = false;
    }

    private async Task<int> ResolveBrokerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BrokerId ?? 0;
    }

    private async Task LoadData()
    {
        _requests = await Api.GetCustomerRequestsByBrokerAsync(_brokerId);
        _allBuyers = await Api.GetAllBuyersAsync();

        var requestedBuyerIds = _requests.Select(r => r.BuyerId).ToHashSet();
        _availableBuyers = _allBuyers
            .Where(b => !requestedBuyerIds.Contains(b.Id))
            .OrderBy(b => b.Name)
            .ToList();
    }

    private async Task SendInvitation()
    {
        if (_selectedBuyerId == 0) return;

        var result = await Api.CreateCustomerRequestAsync(_brokerId, _selectedBuyerId);
        if (result != null)
        {
            var buyerName = _allBuyers.FirstOrDefault(b => b.Id == _selectedBuyerId)?.Name ?? "Customer";
            _message = $"Invitation sent to '{buyerName}'. Awaiting their approval.";
            _messageIsError = false;
        }
        else
        {
            _message = "Failed to send invitation. The customer may already have a pending request.";
            _messageIsError = true;
        }

        _selectedBuyerId = 0;
        await LoadData();
    }

    private async Task CancelRequest(BrokerCustomerRequestDto req)
    {
        await Api.DeleteCustomerRequestAsync(req.Id);
        _message = $"Invitation to '{req.Buyer?.Name}' cancelled.";
        _messageIsError = false;
        await LoadData();
    }

    private string GetStatusColor(CustomerRequestStatus status) => status switch
    {
        CustomerRequestStatus.Pending => "warning",
        CustomerRequestStatus.Approved => "success",
        CustomerRequestStatus.Declined => "danger",
        _ => "secondary"
    };

    private string GetStatusText(CustomerRequestStatus status) => status switch
    {
        CustomerRequestStatus.Pending => "Awaiting Approval",
        CustomerRequestStatus.Approved => "Approved",
        CustomerRequestStatus.Declined => "Declined",
        _ => "Unknown"
    };
}
