@page "/broker/customers/{BuyerId:int}"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Customer Detail - Broker Portal</PageTitle>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyer == null)
{
    <div class="alert alert-warning">Customer not found.</div>
}
else
{
    <div class="d-flex align-items-center mb-3">
        <button class="btn btn-outline-secondary btn-sm me-3" @onclick='() => Nav.NavigateTo("/broker/customers")'>← Back</button>
        <h1 class="mb-0">@_buyer.Name</h1>
        <span class="badge bg-secondary ms-2">@_buyer.BuyerNumber</span>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "info" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "info"'>
                Information
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "lots" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "lots"'>
                Lots <span class="badge bg-secondary">@_soldLots.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "financial" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "financial"'>
                Financial
            </a>
        </li>
    </ul>

    @if (_activeTab == "info")
    {
        <div class="card">
            <div class="card-header"><strong>Customer Information</strong></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless mb-0">
                            <tr><td class="text-muted" style="width: 160px;">Name</td><td><strong>@_buyer.Name</strong></td></tr>
                            <tr><td class="text-muted">Name 2</td><td>@_buyer.Name2</td></tr>
                            <tr><td class="text-muted">Number</td><td>@_buyer.BuyerNumber</td></tr>
                            <tr><td class="text-muted">Contact</td><td>@_buyer.ContactName</td></tr>
                            <tr><td class="text-muted">Email</td><td>@_buyer.ContactEmail</td></tr>
                            <tr><td class="text-muted">Phone</td><td>@_buyer.ContactPhone</td></tr>
                            <tr><td class="text-muted">Mobile</td><td>@_buyer.MobilePhone</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless mb-0">
                            <tr><td class="text-muted" style="width: 160px;">Address</td><td>@_buyer.AddressLine1</td></tr>
                            <tr><td class="text-muted">Address 2</td><td>@_buyer.AddressLine2</td></tr>
                            <tr><td class="text-muted">City</td><td>@_buyer.PostalCode @_buyer.City</td></tr>
                            <tr><td class="text-muted">Country</td><td>@_buyer.Country</td></tr>
                            <tr><td class="text-muted">VAT No.</td><td>@_buyer.VatRegistrationNo</td></tr>
                            <tr><td class="text-muted">Currency</td><td>@_buyer.Currency</td></tr>
                            <tr><td class="text-muted">Language</td><td>@_buyer.Language</td></tr>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "lots")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Lots Sold to @_buyer.Name</strong>
                <span class="badge bg-secondary">@_soldLots.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th>
                            <th>Type</th>
                            <th>Gender</th>
                            <th>Group</th>
                            <th>Color</th>
                            <th>Quality</th>
                            <th>Size</th>
                            <th>Skins</th>
                            <th>Boxes</th>
                            <th>Price (EUR)</th>
                            <th>Hammer Price</th>
                            <th>Sold Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_soldLots.Count == 0)
                        {
                            <tr><td colspan="12" class="text-center text-muted py-4">No lots sold to this customer yet.</td></tr>
                        }
                        @foreach (var r in _soldLots)
                        {
                            <tr>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@(r.SalesType ?? "—")</td>
                                <td>@(r.Gender ?? "—")</td>
                                <td>@(r.Group ?? "—")</td>
                                <td>@(r.Color ?? "—")</td>
                                <td>@(r.Quality ?? "—")</td>
                                <td>@(r.Size ?? "—")</td>
                                <td>@r.TotalSkins</td>
                                <td>@r.BoxCount</td>
                                <td>€@r.PriceEur.ToString("N2")</td>
                                <td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td>
                                <td>@(r.SoldAt?.ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Total Lots Sold</h5>
                        <h2>@_soldLots.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Total Skins</h5>
                        <h2>@_soldLots.Sum(l => l.TotalSkins)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Total Value</h5>
                        <h2>€@_soldLots.Sum(l => l.PriceEur).ToString("N2")</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><strong>Financial Summary</strong></div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><td class="text-muted" style="width: 200px;">Payment Term</td><td>@_buyer.PaymentTerm</td></tr>
                    <tr><td class="text-muted">Payment Method</td><td>@_buyer.PaymentMethod</td></tr>
                    <tr><td class="text-muted">Currency</td><td>@_buyer.Currency</td></tr>
                    <tr><td class="text-muted">Bank Name</td><td>@_buyer.BankName</td></tr>
                    <tr><td class="text-muted">IBAN</td><td>@_buyer.BankIbanNumber</td></tr>
                    <tr><td class="text-muted">SWIFT</td><td>@_buyer.SwiftCode</td></tr>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int BuyerId { get; set; }

    private BuyerDto? _buyer;
    private List<AuctionResultDto> _soldLots = new();
    private bool _loading = true;
    private string _activeTab = "info";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _buyer = await Api.GetBuyerAsync(BuyerId);
            _soldLots = await Api.GetAuctionResultsByBuyerAsync(BuyerId);
        }
        catch { }

        _loading = false;
    }
}
