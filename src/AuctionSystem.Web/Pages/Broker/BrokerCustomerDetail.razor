@page "/broker/customers/{BuyerId:int}"
@attribute [Authorize(Roles = "Broker")]
@inject AuctionApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Customer Detail - Broker Portal</PageTitle>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_buyer == null)
{
    <div class="alert alert-warning">Customer not found.</div>
}
else
{
    <div class="d-flex align-items-center mb-3">
        <button class="btn btn-outline-secondary btn-sm me-3" @onclick='() => Nav.NavigateTo("/broker/customers")'>← Back</button>
        <h1 class="mb-0">@_buyer.Name</h1>
        <span class="badge bg-secondary ms-2">@_buyer.BuyerNumber</span>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "info" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "info"'>
                Information
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "lots" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "lots"'>
                Lots <span class="badge bg-secondary">@_soldLots.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(_activeTab == "financial" ? "active" : "")" href="javascript:void(0)" @onclick='() => _activeTab = "financial"'>
                Financial
            </a>
        </li>
    </ul>

    @if (_activeTab == "info")
    {
        <!-- General Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>General</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">No.</label>
                        <input class="form-control" value="@_buyer.BuyerNumber" readonly />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold">Name</label>
                        <input class="form-control" value="@_buyer.Name" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Name 2</label>
                        <input class="form-control" value="@_buyer.Name2" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Credit Limit</label>
                        <input class="form-control" value="@_buyer.CreditLimit.ToString("N2")" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Blocked</label>
                        <input class="form-control" value="@(_buyer.Blocked ?? "—")" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Currency Code</label>
                        <input class="form-control" value="@(_buyer.Currency ?? "—")" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Language</label>
                        <input class="form-control" value="@(_buyer.Language ?? "—")" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Address & Contact Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>Address & Contact</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input class="form-control" value="@_buyer.AddressLine1" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address 2</label>
                        <input class="form-control" value="@_buyer.AddressLine2" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Country/Region Code</label>
                        <input class="form-control" value="@(_buyer.Country ?? "—")" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Post Code</label>
                        <input class="form-control" value="@_buyer.PostalCode" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">City</label>
                        <input class="form-control" value="@_buyer.City" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Contact Name</label>
                        <input class="form-control" value="@_buyer.ContactName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone No.</label>
                        <input class="form-control" value="@_buyer.ContactPhone" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mobile Phone No.</label>
                        <input class="form-control" value="@_buyer.MobilePhone" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">E-Mail</label>
                        <input class="form-control" value="@_buyer.ContactEmail" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Home Page</label>
                        <input class="form-control" value="@_buyer.HomePage" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoicing Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>Invoicing</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">VAT Registration No.</label>
                        <input class="form-control" value="@_buyer.VatRegistrationNo" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Registration No.</label>
                        <input class="form-control" value="@_buyer.RegistrationNo" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Gen. Bus. Posting Group</label>
                        <input class="form-control" value="@(_buyer.GenBusPostingGroup ?? "—")" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">VAT Bus. Posting Group</label>
                        <input class="form-control" value="@(_buyer.VatBusPostingGroup ?? "—")" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Customer Posting Group</label>
                        <input class="form-control" value="@(_buyer.CustomerPostingGroup ?? "—")" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Section -->
        <div class="card mb-3">
            <div class="card-header bg-light"><strong>Payments</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Payment Terms Code</label>
                        <input class="form-control" value="@(_buyer.PaymentTerm ?? "—")" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Payment Method Code</label>
                        <input class="form-control" value="@(_buyer.PaymentMethod ?? "—")" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bank Name</label>
                        <input class="form-control" value="@_buyer.BankName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">IBAN</label>
                        <input class="form-control" value="@_buyer.BankIbanNumber" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">SWIFT Code</label>
                        <input class="form-control" value="@_buyer.SwiftCode" readonly />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "lots")
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Lots Sold to @_buyer.Name</strong>
                <span class="badge bg-secondary">@_soldLots.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lot #</th>
                            <th>Type</th>
                            <th>Gender</th>
                            <th>Group</th>
                            <th>Color</th>
                            <th>Quality</th>
                            <th>Size</th>
                            <th>Skins</th>
                            <th>Boxes</th>
                            <th>Price (EUR)</th>
                            <th>Hammer Price</th>
                            <th>Sold Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_soldLots.Count == 0)
                        {
                            <tr><td colspan="12" class="text-center text-muted py-4">No lots sold to this customer yet.</td></tr>
                        }
                        @foreach (var r in _soldLots)
                        {
                            <tr>
                                <td><strong>@r.LotNumber</strong></td>
                                <td>@(r.SalesType ?? "—")</td>
                                <td>@(r.Gender ?? "—")</td>
                                <td>@(r.Group ?? "—")</td>
                                <td>@(r.Color ?? "—")</td>
                                <td>@(r.Quality ?? "—")</td>
                                <td>@(r.Size ?? "—")</td>
                                <td>@r.TotalSkins</td>
                                <td>@r.BoxCount</td>
                                <td>€@r.PriceEur.ToString("N2")</td>
                                <td>€@((r.TotalSkins * r.PriceEur).ToString("N2"))</td>
                                <td>@(r.SoldAt?.ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Total Invoices</h5>
                        <h2>@_customerInvoices.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Outstanding</h5>
                        <h2 class="text-warning">@_customerInvoices.Count(i => i.Status != "Paid")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Paid</h5>
                        <h2 class="text-success">@_customerInvoices.Count(i => i.Status == "Paid")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Total Amount</h5>
                        <h2>€@_customerInvoices.Sum(i => i.TotalAmount).ToString("N2")</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Invoices</strong> <span class="badge bg-secondary">@_customerInvoices.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Type</th>
                            <th>Number</th>
                            <th>Lots</th>
                            <th>Subtotal</th>
                            <th>Auction Fee</th>
                            <th>Commission</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_customerInvoices.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No invoices for this customer yet.</td></tr>
                        }
                        @foreach (var inv in _customerInvoices)
                        {
                            <tr class="@(inv.IsCreditNote ? "table-warning" : "")">
                                <td>
                                    @if (inv.IsCreditNote)
                                    {
                                        <span class="badge bg-warning text-dark">Credit Note</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Invoice</span>
                                    }
                                </td>
                                <td>
                                    <strong>@inv.InvoiceNumber</strong>
                                    @if (!string.IsNullOrEmpty(inv.OriginalInvoiceNumber))
                                    {
                                        <br /><small class="text-muted">Ref: @inv.OriginalInvoiceNumber</small>
                                    }
                                </td>
                                <td>@inv.LinesCount</td>
                                <td>€@inv.SubTotal.ToString("N2")</td>
                                <td>€@inv.AuctionFee.ToString("N2")</td>
                                <td>€@inv.Commission.ToString("N2")</td>
                                <td><strong>€@inv.TotalAmount.ToString("N2")</strong></td>
                                <td>@inv.InvoiceDate.ToString("d")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inv.PdfUrl))
                                    {
                                        <a href="@inv.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">📄 PDF</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int BuyerId { get; set; }

    private BuyerDto? _buyer;
    private List<AuctionResultDto> _soldLots = new();
    private List<InvoiceSummaryDto> _customerInvoices = new();
    private int _brokerId;
    private bool _loading = true;
    private string _activeTab = "info";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _brokerId = await ResolveBrokerId();
            _buyer = await Api.GetBuyerAsync(BuyerId);
            _soldLots = await Api.GetAuctionResultsByBuyerAsync(BuyerId);

            if (_brokerId > 0)
            {
                _customerInvoices = await Api.GetInvoicesByBrokerAndBuyerAsync(_brokerId, BuyerId);
            }
        }
        catch { }

        _loading = false;
    }

    private async Task<int> ResolveBrokerId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var oid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(oid)) return 0;
        var user = await Api.GetCurrentUserAsync(oid);
        return user?.BrokerId ?? 0;
    }
}
