                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Post Code</label>
                                    <input class="form-control" @bind="_buyerForm.PostalCode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <input class="form-control" @bind="_buyerForm.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Contact Name</label>
                                    <input class="form-control" @bind="_buyerForm.ContactName" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone No.</label>
                                    <input class="form-control" @bind="_buyerForm.ContactPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Phone No.</label>
                                    <input class="form-control" @bind="_buyerForm.MobilePhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-Mail</label>
                                    <input class="form-control" type="email" @bind="_buyerForm.ContactEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Home Page</label>
                                    <input class="form-control" @bind="_buyerForm.HomePage" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoicing -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Invoicing</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">VAT Registration No.</label>
                                    <input class="form-control" @bind="_buyerForm.VatRegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Registration No.</label>
                                    <input class="form-control" @bind="_buyerForm.RegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency Code</label>
                                    <select class="form-select" @bind="_buyerForm.Currency">
                                        <option value="">Select Currency...</option>
                                        @foreach (var c in _bcCurrencies)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Gen. Bus. Posting Group</label>
                                    <select class="form-select" @bind="_buyerForm.GenBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcGenBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">VAT Bus. Posting Group</label>
                                    <select class="form-select" @bind="_buyerForm.VatBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcVatBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Customer Posting Group</label>
