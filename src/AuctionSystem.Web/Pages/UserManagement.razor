@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Users & Roles - Admin</PageTitle>

<h1>Users & Roles</h1>
<p class="text-muted">Manage user access. Each user needs an Azure AD account and a role assignment to access the system.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-circle"></i> Add User
        </button>
    </div>

    @if (_showForm)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <strong>@(_editingUser?.Id > 0 ? "Edit User" : "Add New User")</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="CancelForm"></button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Azure AD Object ID <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editingUser!.AzureAdObjectId"
                               placeholder="e.g. 18a768cd-1d23-4942-92ca-2e1cc0d0955e" />
                        <small class="form-text text-muted">
                            Find in Entra ID → Users → select user → Object ID
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input class="form-control" type="email" @bind="_editingUser!.Email"
                               placeholder="user@infra-tech.dk" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Display Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editingUser!.DisplayName"
                               placeholder="Full name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="SelectedRole">
                            <option value="">— Select Role —</option>
                            <option value="Admin">Admin — Full system access</option>
                            <option value="Broker">Broker — Bidding, allocations, customers</option>
                            <option value="Farmer">Farmer — Lot tracking, settlements</option>
                            <option value="Buyer">Buyer — Purchase history, allocations</option>
                        </select>
                    </div>
                </div>

                @if (_editingUser?.Role == "Broker")
                {
                    <hr class="my-4" />

                    <!-- General Section -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>General</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_brokerForm.BrokerNumber" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_brokerForm.CompanyName" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Credit Limit</label>
                                    <input class="form-control" type="number" step="0.01" @bind="_brokerForm.CreditLimit" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Blocked</label>
                                    <select class="form-select" @bind="_brokerForm.Blocked">
                                        <option value="">— (None)</option>
                                        <option value="Ship">Ship</option>
                                        <option value="Invoice">Invoice</option>
                                        <option value="All">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Address & Contact Section -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Address & Contact</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input class="form-control" @bind="_brokerForm.AddressLine1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Address 2</label>
                                    <input class="form-control" @bind="_brokerForm.AddressLine2" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Country/Region Code</label>
                                    <select class="form-select" @bind="_brokerForm.Country">
                                        <option value="">Select Country...</option>
                                        @foreach (var c in _bcCountries)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Post Code</label>
                                    <input class="form-control" @bind="_brokerForm.PostalCode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <input class="form-control" @bind="_brokerForm.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Contact Name</label>
                                    <input class="form-control" @bind="_brokerForm.ContactPerson" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone No.</label>
                                    <input class="form-control" @bind="_brokerForm.ContactPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Phone No.</label>
                                    <input class="form-control" @bind="_brokerForm.MobilePhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-Mail</label>
                                    <input class="form-control" type="email" @bind="_brokerForm.ContactEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Home Page</label>
                                    <input class="form-control" @bind="_brokerForm.HomePage" placeholder="https://" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoicing Section -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Invoicing</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">VAT Registration No.</label>
                                    <input class="form-control" @bind="_brokerForm.VatRegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Registration No.</label>
                                    <input class="form-control" @bind="_brokerForm.RegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency Code</label>
                                    <select class="form-select" @bind="_brokerForm.Currency">
                                        <option value="">Select Currency...</option>
                                        @foreach (var c in _bcCurrencies)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Gen. Bus. Posting Group</label>
                                    <select class="form-select" @bind="_brokerForm.GenBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcGenBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Description (@g.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">VAT Bus. Posting Group</label>
                                    <select class="form-select" @bind="_brokerForm.VatBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcVatBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Description (@g.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Customer Posting Group</label>
                                    <select class="form-select" @bind="_brokerForm.CustomerPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcCustomerPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Customer Group</label>
                                    <input class="form-control" @bind="_brokerForm.CustomerGroup" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payments Section -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Payments</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Payment Terms Code</label>
                                    <input class="form-control" @bind="_brokerForm.PaymentTerm" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Payment Method Code</label>
                                    <input class="form-control" @bind="_brokerForm.PaymentMethod" />
                                </div>
                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" @bind="_brokerForm.IsActive" />
                                        <label class="form-check-label">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_editingUser?.Role == "Farmer")
