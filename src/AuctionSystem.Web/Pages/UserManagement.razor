                    <hr class="my-4" />
                    <h5 class="mb-3">Farmer Details</h5>

                    <!-- General -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>General</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
