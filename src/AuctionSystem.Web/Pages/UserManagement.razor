                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Country/Region Code</label>
                                    <select class="form-select" @bind="_farmerForm.Country">
                                        <option value="">Select Country...</option>
                                        @foreach (var c in _bcCountries)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Post Code</label>
                                    <input class="form-control" @bind="_farmerForm.PostalCode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <input class="form-control" @bind="_farmerForm.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Contact Name</label>
                                    <input class="form-control" @bind="_farmerForm.ContactName" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone No.</label>
                                    <input class="form-control" @bind="_farmerForm.ContactPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Phone No.</label>
                                    <input class="form-control" @bind="_farmerForm.MobilePhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-Mail</label>
                                    <input class="form-control" type="email" @bind="_farmerForm.ContactEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Home Page</label>
                                    <input class="form-control" @bind="_farmerForm.HomePage" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoicing -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Invoicing</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">VAT Registration No.</label>
                                    <input class="form-control" @bind="_farmerForm.VatRegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Registration No.</label>
                                    <input class="form-control" @bind="_farmerForm.RegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency Code</label>
                                    <select class="form-select" @bind="_farmerForm.Currency">
                                        <option value="">Select Currency...</option>
                                        @foreach (var c in _bcCurrencies)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payments -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Payments</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Payment Terms Code</label>
                                    <select class="form-select" @bind="_farmerForm.PaymentTerm">
                                        <option value="">Select...</option>
                                        @foreach (var t in _bcPaymentTerms)
                                        {
                                            <option value="@t.Code">@t.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Payment Method Code</label>
                                    <input class="form-control" @bind="_farmerForm.PaymentMethod" />
                                </div>
                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" @bind="_farmerForm.IsActive" />
                                        <label class="form-check-label">Is Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_editingUser?.Role == "Buyer")
                {
                    <hr class="my-4" />
                    <h5 class="mb-3">Buyer Details</h5>

                    <!-- General -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>General</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_buyerForm.BuyerNumber" placeholder="C001" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_buyerForm.Name" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Credit Limit</label>
                                    <input class="form-control" type="number" step="0.01" @bind="_buyerForm.CreditLimit" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Blocked</label>
                                    <select class="form-select" @bind="_buyerForm.Blocked">
                                        <option value="">— (None)</option>
                                        <option value="Ship">Ship</option>
                                        <option value="Invoice">Invoice</option>
                                        <option value="All">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Address & Contact -->
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Address & Contact</strong></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input class="form-control" @bind="_buyerForm.AddressLine1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Address 2</label>
                                    <input class="form-control" @bind="_buyerForm.AddressLine2" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Country/Region Code</label>
                                    <select class="form-select" @bind="_buyerForm.Country">
                                        <option value="">Select Country...</option>
                                        @foreach (var c in _bcCountries)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
