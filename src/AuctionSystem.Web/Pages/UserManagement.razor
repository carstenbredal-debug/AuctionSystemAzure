@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api

<PageTitle>Users & Roles - Admin</PageTitle>

<h1>Users & Roles</h1>
<p class="text-muted">Manage user access. Each user needs an Azure AD account and a role assignment to access the system.</p>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="mb-3 d-flex gap-2">
        <button class="btn btn-primary" @onclick="ShowAddForm">
            <i class="bi bi-plus-circle"></i> Add User
        </button>
        <button class="btn btn-outline-success" @onclick="BulkCreateFromEntities" disabled="@_bulkCreating">
            @if (_bulkCreating)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-people"></i> Create Users for All Entities
        </button>
    </div>

    @if (_showForm)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <strong>@(_editingUser?.Id > 0 ? "Edit User" : "Add New User")</strong>
                <button type="button" class="btn-close btn-close-white" @onclick="CancelForm"></button>
            </div>
            <div class="section-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Azure AD Object ID <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editingUser!.AzureAdObjectId"
                               placeholder="e.g. 18a768cd-1d23-4942-92ca-2e1cc0d0955e" />
                        <small class="form-text text-muted">
                            Find in Entra ID → Users → select user → Object ID
                        </small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input class="form-control" type="email" @bind="_editingUser!.Email"
                               placeholder="user@infra-tech.dk" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Display Name <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="_editingUser!.DisplayName"
                               placeholder="Full name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="SelectedRole">
                            <option value="">— Select Role —</option>
                            <option value="Admin">Admin — Full system access</option>
                            <option value="Broker">Broker — Bidding, allocations, customers</option>
                            <option value="Farmer">Farmer — Lot tracking, settlements</option>
                            <option value="Buyer">Buyer — Purchase history, allocations</option>
                            <option value="Typist">Typist — Dual-entry auction recording</option>
                        </select>
                    </div>
                </div>

                @if (_editingUser?.Role == "Broker")
                {
                    <hr class="my-4" />

                    <!-- General Section -->
                    <div class="section-container mb-3">
                        <div class="section-header">General</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_brokerForm.BrokerNumber" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_brokerForm.CompanyName" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Credit Limit</label>
                                    <input class="form-control" type="number" step="0.01" @bind="_brokerForm.CreditLimit" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Blocked</label>
                                    <select class="form-select" @bind="_brokerForm.Blocked">
                                        <option value="">— (None)</option>
                                        <option value="Ship">Ship</option>
                                        <option value="Invoice">Invoice</option>
                                        <option value="All">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Address & Contact Section -->
                    <div class="section-container mb-3">
                        <div class="section-header">Address & Contact</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input class="form-control" @bind="_brokerForm.AddressLine1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Address 2</label>
                                    <input class="form-control" @bind="_brokerForm.AddressLine2" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Country/Region Code</label>
                                    <select class="form-select" @bind="_brokerForm.Country">
                                        <option value="">Select Country...</option>
                                        @foreach (var c in _bcCountries)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Post Code</label>
                                    <input class="form-control" @bind="_brokerForm.PostalCode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <input class="form-control" @bind="_brokerForm.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Contact Name</label>
                                    <input class="form-control" @bind="_brokerForm.ContactPerson" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone No.</label>
                                    <input class="form-control" @bind="_brokerForm.ContactPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Phone No.</label>
                                    <input class="form-control" @bind="_brokerForm.MobilePhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-Mail</label>
                                    <input class="form-control" type="email" @bind="_brokerForm.ContactEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Home Page</label>
                                    <input class="form-control" @bind="_brokerForm.HomePage" placeholder="https://" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoicing Section -->
                    <div class="section-container mb-3">
                        <div class="section-header">Invoicing</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">VAT Registration No.</label>
                                    <input class="form-control" @bind="_brokerForm.VatRegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Registration No.</label>
                                    <input class="form-control" @bind="_brokerForm.RegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency Code</label>
                                    <select class="form-select" @bind="_brokerForm.Currency">
                                        <option value="">Select Currency...</option>
                                        @foreach (var c in _bcCurrencies)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Gen. Bus. Posting Group</label>
                                    <select class="form-select" @bind="_brokerForm.GenBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcGenBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Description (@g.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">VAT Bus. Posting Group</label>
                                    <select class="form-select" @bind="_brokerForm.VatBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcVatBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Description (@g.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Vendor Posting Group</label>
                                    <select class="form-select" @bind="_brokerForm.CustomerPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcVendorPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payments Section -->
                    <div class="section-container mb-3">
                        <div class="section-header">Payments</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Payment Terms Code</label>
                                    <select class="form-select" @bind="_brokerForm.PaymentTerm">
                                        <option value="">Select...</option>
                                        @foreach (var t in _bcPaymentTerms)
                                        {
                                            <option value="@t.Code">@t.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Payment Method Code</label>
                                    <input class="form-control" @bind="_brokerForm.PaymentMethod" />
                                </div>
                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" @bind="_brokerForm.IsActive" />
                                        <label class="form-check-label">Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_editingUser?.Role == "Farmer")
                {
                    <hr class="my-4" />
                    <h5 class="mb-3">Farmer Details</h5>

                    <!-- General -->
                    <div class="section-container mb-3">
                        <div class="section-header">General</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_farmerForm.FarmerNumber" placeholder="S001" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_farmerForm.Name" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Address & Contact -->
                    <div class="section-container mb-3">
                        <div class="section-header">Address & Contact</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input class="form-control" @bind="_farmerForm.AddressLine1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Address 2</label>
                                    <input class="form-control" @bind="_farmerForm.AddressLine2" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Country/Region Code</label>
                                    <select class="form-select" @bind="_farmerForm.Country">
                                        <option value="">Select Country...</option>
                                        @foreach (var c in _bcCountries)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Post Code</label>
                                    <input class="form-control" @bind="_farmerForm.PostalCode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <input class="form-control" @bind="_farmerForm.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Contact Name</label>
                                    <input class="form-control" @bind="_farmerForm.ContactName" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone No.</label>
                                    <input class="form-control" @bind="_farmerForm.ContactPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Phone No.</label>
                                    <input class="form-control" @bind="_farmerForm.MobilePhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-Mail</label>
                                    <input class="form-control" type="email" @bind="_farmerForm.ContactEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Home Page</label>
                                    <input class="form-control" @bind="_farmerForm.HomePage" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoicing -->
                    <div class="section-container mb-3">
                        <div class="section-header">Invoicing</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">VAT Registration No.</label>
                                    <input class="form-control" @bind="_farmerForm.VatRegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Registration No.</label>
                                    <input class="form-control" @bind="_farmerForm.RegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency Code</label>
                                    <select class="form-select" @bind="_farmerForm.Currency">
                                        <option value="">Select Currency...</option>
                                        @foreach (var c in _bcCurrencies)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payments -->
                    <div class="section-container mb-3">
                        <div class="section-header">Payments</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Payment Terms Code</label>
                                    <select class="form-select" @bind="_farmerForm.PaymentTerm">
                                        <option value="">Select...</option>
                                        @foreach (var t in _bcPaymentTerms)
                                        {
                                            <option value="@t.Code">@t.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Payment Method Code</label>
                                    <input class="form-control" @bind="_farmerForm.PaymentMethod" />
                                </div>
                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" @bind="_farmerForm.IsActive" />
                                        <label class="form-check-label">Is Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_editingUser?.Role == "Buyer")
                {
                    <hr class="my-4" />
                    <h5 class="mb-3">Buyer Details</h5>

                    <!-- General -->
                    <div class="section-container mb-3">
                        <div class="section-header">General</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">No. <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_buyerForm.BuyerNumber" placeholder="C001" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_buyerForm.Name" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Credit Limit</label>
                                    <input class="form-control" type="number" step="0.01" @bind="_buyerForm.CreditLimit" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Blocked</label>
                                    <select class="form-select" @bind="_buyerForm.Blocked">
                                        <option value="">— (None)</option>
                                        <option value="Ship">Ship</option>
                                        <option value="Invoice">Invoice</option>
                                        <option value="All">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Address & Contact -->
                    <div class="section-container mb-3">
                        <div class="section-header">Address & Contact</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input class="form-control" @bind="_buyerForm.AddressLine1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Address 2</label>
                                    <input class="form-control" @bind="_buyerForm.AddressLine2" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Country/Region Code</label>
                                    <select class="form-select" @bind="_buyerForm.Country">
                                        <option value="">Select Country...</option>
                                        @foreach (var c in _bcCountries)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Post Code</label>
                                    <input class="form-control" @bind="_buyerForm.PostalCode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City</label>
                                    <input class="form-control" @bind="_buyerForm.City" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Contact Name</label>
                                    <input class="form-control" @bind="_buyerForm.ContactName" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone No.</label>
                                    <input class="form-control" @bind="_buyerForm.ContactPhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Phone No.</label>
                                    <input class="form-control" @bind="_buyerForm.MobilePhone" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-Mail</label>
                                    <input class="form-control" type="email" @bind="_buyerForm.ContactEmail" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Home Page</label>
                                    <input class="form-control" @bind="_buyerForm.HomePage" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoicing -->
                    <div class="section-container mb-3">
                        <div class="section-header">Invoicing</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">VAT Registration No.</label>
                                    <input class="form-control" @bind="_buyerForm.VatRegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Registration No.</label>
                                    <input class="form-control" @bind="_buyerForm.RegistrationNo" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency Code</label>
                                    <select class="form-select" @bind="_buyerForm.Currency">
                                        <option value="">Select Currency...</option>
                                        @foreach (var c in _bcCurrencies)
                                        {
                                            <option value="@c.Code">@c.DisplayName (@c.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Gen. Bus. Posting Group</label>
                                    <select class="form-select" @bind="_buyerForm.GenBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcGenBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">VAT Bus. Posting Group</label>
                                    <select class="form-select" @bind="_buyerForm.VatBusPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcVatBusPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Customer Posting Group</label>
                                    <select class="form-select" @bind="_buyerForm.CustomerPostingGroup">
                                        <option value="">Select...</option>
                                        @foreach (var g in _bcCustomerPostingGroups)
                                        {
                                            <option value="@g.Code">@g.Code</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payments -->
                    <div class="section-container mb-3">
                        <div class="section-header">Payments</div>
                        <div class="section-body p-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Payment Terms Code</label>
                                    <select class="form-select" @bind="_buyerForm.PaymentTerm">
                                        <option value="">Select...</option>
                                        @foreach (var t in _bcPaymentTerms)
                                        {
                                            <option value="@t.Code">@t.Code</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Payment Method Code</label>
                                    <input class="form-control" @bind="_buyerForm.PaymentMethod" />
                                </div>
                                <div class="col-md-4 d-flex align-items-center pt-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" @bind="_buyerForm.IsActive" />
                                        <label class="form-check-label">Is Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="mt-4 text-end">
                    <button class="btn btn-primary me-2" @onclick="SaveUser">
                        @(_editingUser?.Id > 0 ? "Update User" : "Create User")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
                </div>
            </div>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in _roleTabs)
        {
            <li class="nav-item">
                <a class="nav-link @(_activeTab == tab ? "active" : "")" href="" @onclick:preventDefault @onclick="() => _activeTab = tab">
                    @tab
                    <span class="badge bg-secondary ms-1">@GetTabCount(tab)</span>
                </a>
            </li>
        }
    </ul>

    <div class="section-container">
        <div class="section-header">
            @(_activeTab == "All" ? "All Users" : $"{_activeTab} Users")
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Display Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Linked Entity</th>
                        <th>Azure AD Object ID</th>
                        <th>Active</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var filtered = GetFilteredUsers(); }
                    @if (filtered.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">
                            @(_activeTab == "All" ? "No users registered. Click \"Add User\" to create the first user." : $"No {_activeTab} users found.")
                        </td></tr>
                    }
                    @foreach (var user in filtered)
                    {
                        <tr>
                            <td><strong>@user.DisplayName</strong></td>
                            <td>@user.Email</td>
                            <td><span class="badge bg-@GetRoleBadgeColor(user.Role)">@user.Role</span></td>
                            <td>@GetLinkedEntity(user)</td>
                            <td>
                                @if (user.AzureAdObjectId?.StartsWith("PENDING-") == true)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else
                                {
                                    <span class="small text-truncate d-inline-block" style="max-width: 180px;" title="@user.AzureAdObjectId">@user.AzureAdObjectId</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                { <span class="badge bg-success">Active</span> }
                                else
                                { <span class="badge bg-secondary">Inactive</span> }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditUser(user)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUser(user)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private string _activeTab = "All";
    private readonly string[] _roleTabs = { "All", "Admin", "Broker", "Buyer", "Farmer", "Typist" };
    private List<AppUserDto> _users = new();
    private List<BrokerDto> _brokers = new();
    private List<FarmerDto> _farmers = new();
    private List<BuyerDto> _buyers = new();
    private AppUserDto? _editingUser;
    private BrokerDto _brokerForm = new() { IsActive = true };
    private FarmerDto _farmerForm = new();
    private BuyerDto _buyerForm = new();
    private bool _loading = true;
    private bool _showForm;
    private string? _message;
    private bool _messageIsError;
    private bool _bulkCreating;
    private List<BcCountryRegionDto> _bcCountries = new();
    private List<BcCurrencyDto> _bcCurrencies = new();
    private List<BcPostingGroupDto> _bcGenBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcVatBusPostingGroups = new();
    private List<BcPostingGroupDto> _bcCustomerPostingGroups = new();
    private List<BcPostingGroupDto> _bcVendorPostingGroups = new();
    private List<BcPaymentTermDto> _bcPaymentTerms = new();
    private List<BcVendorDto> _bcVendors = new();
    private List<BcCustomerDto> _bcCustomers = new();

    private string SelectedRole
    {
        get => _editingUser?.Role ?? "";
        set
        {
            if (_editingUser == null) return;
            _editingUser.Role = value;
            _editingUser.BrokerId = null;
            _editingUser.FarmerId = null;
            _editingUser.BuyerId = null;
            _brokerForm = new BrokerDto
            {
                IsActive = true,
                ContactEmail = _editingUser.Email,
                ContactPerson = _editingUser.DisplayName,
                CompanyName = _editingUser.DisplayName
            };
            _farmerForm = new FarmerDto
            {
                ContactEmail = _editingUser.Email,
                Name = _editingUser.DisplayName
            };
            _buyerForm = new BuyerDto
            {
                ContactEmail = _editingUser.Email,
                Name = _editingUser.DisplayName
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        _users = await Api.GetAllUsersAsync();
        _brokers = await Api.GetBrokersAsync();
        _farmers = await Api.GetFarmersAsync();
        _buyers = await Api.GetAllBuyersAsync();
        _bcCountries = await Api.GetBcCountriesAsync();
        _bcCurrencies = await Api.GetBcCurrenciesAsync();
        _bcGenBusPostingGroups = await Api.GetBcGenBusPostingGroupsAsync();
        _bcVatBusPostingGroups = await Api.GetBcVatBusPostingGroupsAsync();
        _bcCustomerPostingGroups = await Api.GetBcCustomerPostingGroupsAsync();
        _bcVendorPostingGroups = await Api.GetBcVendorPostingGroupsAsync();
        _bcPaymentTerms = await Api.GetBcPaymentTermsAsync();
        try { _bcVendors = await Api.GetBcVendorsAsync(); } catch { }
        try { _bcCustomers = await Api.GetBcCustomersAsync(); } catch { }
    }

    private async Task BulkCreateFromEntities()
    {
        _bulkCreating = true;
        _message = null;
        try
        {
            var result = await Api.BulkCreateUsersFromEntitiesAsync();
            _message = $"Created {result.CreatedCount} users ({result.Brokers} brokers, {result.Buyers} buyers, {result.Farmers} farmers). Edit each user to set the Azure AD Object ID.";
            _messageIsError = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _message = $"Failed to create users: {ex.Message}";
            _messageIsError = true;
        }
        _bulkCreating = false;
    }

    private void ShowAddForm()
    {
        _editingUser = new AppUserDto { IsActive = true };
        _brokerForm = new BrokerDto { IsActive = true };
        _farmerForm = new FarmerDto();
        _buyerForm = new BuyerDto();
        _showForm = true;
        _message = null;
    }

    private void EditUser(AppUserDto user)
    {
        _editingUser = new AppUserDto
        {
            Id = user.Id,
            AzureAdObjectId = user.AzureAdObjectId,
            Email = user.Email,
            DisplayName = user.DisplayName,
            Role = user.Role,
            BrokerId = user.BrokerId,
            FarmerId = user.FarmerId,
            BuyerId = user.BuyerId,
            IsActive = user.IsActive
        };

        _brokerForm = LoadBrokerFormForEdit(user);
        _farmerForm = LoadFarmerFormForEdit(user);
        _buyerForm = LoadBuyerFormForEdit(user);

        _showForm = true;
        _message = null;
    }

    private BrokerDto LoadBrokerFormForEdit(AppUserDto user)
    {
        if (!user.BrokerId.HasValue)
            return new BrokerDto { IsActive = true };

        var broker = _brokers.FirstOrDefault(b => b.Id == user.BrokerId.Value);
        if (broker == null)
            return new BrokerDto { IsActive = true };

        var form = CloneBroker(broker);
        var bcVendor = _bcVendors.FirstOrDefault(v => v.Number == broker.BrokerNumber);
        if (bcVendor != null)
        {
            form.GenBusPostingGroup = bcVendor.GenBusPostingGroup;
            form.VatBusPostingGroup = bcVendor.VatBusPostingGroup;
            form.CustomerPostingGroup = bcVendor.VendorPostingGroup;
            form.Currency = bcVendor.CurrencyCode;
            form.PaymentTerm = bcVendor.PaymentTermsCode;
            form.PaymentMethod = bcVendor.PaymentMethodCode;
            form.VatRegistrationNo = bcVendor.VatRegistrationNo;
            form.Blocked = bcVendor.Blocked;
        }
        return form;
    }

    private FarmerDto LoadFarmerFormForEdit(AppUserDto user)
    {
        if (!user.FarmerId.HasValue)
            return new FarmerDto();

        var farmer = _farmers.FirstOrDefault(f => f.Id == user.FarmerId.Value);
        if (farmer == null)
            return new FarmerDto();

        var form = CloneFarmer(farmer);
        var bcVendor = _bcVendors.FirstOrDefault(v => v.Number == farmer.FarmerNumber);
        if (bcVendor != null)
        {
            form.GenBusPostingGroup = bcVendor.GenBusPostingGroup;
            form.VatBusPostingGroup = bcVendor.VatBusPostingGroup;
            form.VendorPostingGroup = bcVendor.VendorPostingGroup;
            form.Currency = bcVendor.CurrencyCode;
            form.PaymentTerm = bcVendor.PaymentTermsCode;
            form.PaymentMethod = bcVendor.PaymentMethodCode;
            form.VatRegistrationNo = bcVendor.VatRegistrationNo;
        }
        return form;
    }

    private BuyerDto LoadBuyerFormForEdit(AppUserDto user)
    {
        if (!user.BuyerId.HasValue)
            return new BuyerDto();

        var buyer = _buyers.FirstOrDefault(b => b.Id == user.BuyerId.Value);
        if (buyer == null)
            return new BuyerDto();

        var form = CloneBuyer(buyer);
        var bcCustomer = _bcCustomers.FirstOrDefault(c => c.Number == buyer.BuyerNumber);
        if (bcCustomer != null)
        {
            form.GenBusPostingGroup = bcCustomer.GenBusPostingGroup;
            form.VatBusPostingGroup = bcCustomer.VatBusPostingGroup;
            form.CustomerPostingGroup = bcCustomer.CustomerPostingGroup;
            form.CreditLimit = bcCustomer.CreditLimit;
            form.Currency = bcCustomer.CurrencyCode;
            form.PaymentTerm = bcCustomer.PaymentTermsCode;
            form.PaymentMethod = bcCustomer.PaymentMethodCode;
            form.VatRegistrationNo = bcCustomer.VatRegistrationNo;
            form.Blocked = bcCustomer.Blocked;
        }
        return form;
    }

    private static BrokerDto CloneBroker(BrokerDto src) => new()
    {
        Id = src.Id, BrokerNumber = src.BrokerNumber, CompanyName = src.CompanyName, CompanyName2 = src.CompanyName2,
        SearchName = src.SearchName, ContactPerson = src.ContactPerson, AddressLine1 = src.AddressLine1,
        AddressLine2 = src.AddressLine2, Country = src.Country, PostalCode = src.PostalCode, City = src.City,
        ContactPhone = src.ContactPhone, MobilePhone = src.MobilePhone, ContactEmail = src.ContactEmail,
        HomePage = src.HomePage, VatRegistrationNo = src.VatRegistrationNo, RegistrationNo = src.RegistrationNo,
        CustomerGroup = src.CustomerGroup, SalesPerson = src.SalesPerson, PaymentTerm = src.PaymentTerm,
        PaymentMethod = src.PaymentMethod, Currency = src.Currency, Language = src.Language,
        GenBusPostingGroup = src.GenBusPostingGroup, VatBusPostingGroup = src.VatBusPostingGroup,
        CustomerPostingGroup = src.CustomerPostingGroup, CreditLimit = src.CreditLimit, Blocked = src.Blocked,
        IsActive = src.IsActive
    };

    private static FarmerDto CloneFarmer(FarmerDto src) => new()
    {
        Id = src.Id, FarmerNumber = src.FarmerNumber, Name = src.Name,
        ContactName = src.ContactName, AddressLine1 = src.AddressLine1, AddressLine2 = src.AddressLine2,
        Country = src.Country, PostalCode = src.PostalCode, City = src.City,
        ContactPhone = src.ContactPhone, MobilePhone = src.MobilePhone, ContactEmail = src.ContactEmail,
        HomePage = src.HomePage, VatRegistrationNo = src.VatRegistrationNo, RegistrationNo = src.RegistrationNo,
        GenBusPostingGroup = src.GenBusPostingGroup, VatBusPostingGroup = src.VatBusPostingGroup,
        VendorPostingGroup = src.VendorPostingGroup, PaymentTerm = src.PaymentTerm,
        PaymentMethod = src.PaymentMethod, Currency = src.Currency
    };

    private static BuyerDto CloneBuyer(BuyerDto src) => new()
    {
        Id = src.Id, BuyerNumber = src.BuyerNumber, Name = src.Name, Name2 = src.Name2,
        SearchName = src.SearchName, ContactName = src.ContactName, AddressLine1 = src.AddressLine1,
        AddressLine2 = src.AddressLine2, Country = src.Country, PostalCode = src.PostalCode, City = src.City,
        ContactPhone = src.ContactPhone, MobilePhone = src.MobilePhone, ContactEmail = src.ContactEmail,
        HomePage = src.HomePage, VatRegistrationNo = src.VatRegistrationNo, RegistrationNo = src.RegistrationNo,
        CustomerGroup = src.CustomerGroup, SalesPerson = src.SalesPerson, PaymentTerm = src.PaymentTerm,
        PaymentMethod = src.PaymentMethod, Currency = src.Currency, Language = src.Language,
        GenBusPostingGroup = src.GenBusPostingGroup, VatBusPostingGroup = src.VatBusPostingGroup,
        CustomerPostingGroup = src.CustomerPostingGroup
    };

    private async Task SaveUser()
    {
        if (_editingUser == null) return;

        if (string.IsNullOrWhiteSpace(_editingUser.AzureAdObjectId) ||
            string.IsNullOrWhiteSpace(_editingUser.Email) ||
            string.IsNullOrWhiteSpace(_editingUser.DisplayName) ||
            string.IsNullOrWhiteSpace(_editingUser.Role))
        {
            SetError("Please fill in all required fields (Azure AD Object ID, Email, Display Name, Role).");
            return;
        }

        if (_editingUser.Id == 0 && !await CreateLinkedEntityForNewUser())
            return;

        if (!await PersistUser())
            return;

        _showForm = false;
        _editingUser = null;
        await LoadData();
    }

    private async Task<bool> CreateLinkedEntityForNewUser()
    {
        return _editingUser!.Role switch
        {
            "Broker" => await CreateLinkedBrokerAsync(),
            "Farmer" => await CreateLinkedFarmerAsync(),
            "Buyer" => await CreateLinkedBuyerAsync(),
            _ => true
        };
    }

    private async Task<bool> CreateLinkedBrokerAsync()
    {
        if (string.IsNullOrWhiteSpace(_brokerForm.CompanyName) || string.IsNullOrWhiteSpace(_brokerForm.BrokerNumber))
        { SetError("Broker Name and Broker Number are required."); return false; }
        var broker = await Api.CreateBrokerAsync(_brokerForm);
        if (broker == null) { SetError("Failed to create broker."); return false; }
        _editingUser!.BrokerId = broker.Id;
        return true;
    }

    private async Task<bool> CreateLinkedFarmerAsync()
    {
        if (string.IsNullOrWhiteSpace(_farmerForm.FarmerNumber) || string.IsNullOrWhiteSpace(_farmerForm.Name))
        { SetError("Farmer Number and Name are required."); return false; }
        var farmer = await Api.CreateFarmerAsync(_farmerForm);
        if (farmer == null) { SetError("Failed to create farmer."); return false; }
        _editingUser!.FarmerId = farmer.Id;
        return true;
    }

    private async Task<bool> CreateLinkedBuyerAsync()
    {
        if (string.IsNullOrWhiteSpace(_buyerForm.BuyerNumber) || string.IsNullOrWhiteSpace(_buyerForm.Name))
        { SetError("Buyer Number and Name are required."); return false; }
        var buyer = await Api.CreateBuyerAsync(0, _buyerForm);
        if (buyer == null) { SetError("Failed to create buyer."); return false; }
        _editingUser!.BuyerId = buyer.Id;
        return true;
    }

    private async Task<bool> PersistUser()
    {
        if (_editingUser!.Id > 0)
        {
            var result = await Api.UpdateUserAsync(_editingUser.Id, _editingUser);
            if (result == null) { SetError("Failed to update user. Please check the details and try again."); return false; }
            _message = $"User '{_editingUser.DisplayName}' updated successfully.";
            _messageIsError = false;
        }
        else
        {
            var result = await Api.CreateUserAsync(_editingUser);
            if (result == null) { SetError("Failed to create user. The Azure AD Object ID may already be in use."); return false; }
            _message = $"User '{_editingUser.DisplayName}' created with role '{_editingUser.Role}'.";
            _messageIsError = false;
        }
        return true;
    }

    private void SetError(string msg)
    {
        _message = msg;
        _messageIsError = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _editingUser = null;
    }

    private async Task DeleteUser(AppUserDto user)
    {
        await Api.DeleteUserAsync(user.Id);
        _message = $"User '{user.DisplayName}' deleted.";
        _messageIsError = false;
        await LoadData();
    }

    private string GetRoleBadgeColor(string role) => role switch
    {
        "Admin" => "danger",
        "Broker" => "primary",
        "Farmer" => "success",
        "Buyer" => "info",
        _ => "secondary"
    };

    private List<AppUserDto> GetFilteredUsers() =>
        _activeTab == "All" ? _users : _users.Where(u => u.Role == _activeTab).ToList();

    private int GetTabCount(string tab) =>
        tab == "All" ? _users.Count : _users.Count(u => u.Role == tab);

    private string GetLinkedEntity(AppUserDto user)
    {
        if (user.BrokerId.HasValue)
            return _brokers.FirstOrDefault(b => b.Id == user.BrokerId.Value)?.CompanyName ?? $"Broker #{user.BrokerId}";
        if (user.FarmerId.HasValue)
            return _farmers.FirstOrDefault(s => s.Id == user.FarmerId.Value)?.Name ?? $"Farmer #{user.FarmerId}";
        if (user.BuyerId.HasValue)
            return _buyers.FirstOrDefault(b => b.Id == user.BuyerId.Value)?.Name ?? $"Buyer #{user.BuyerId}";
        return "—";
    }
}
