@page "/settlements"
@inject AuctionApiClient Api

<PageTitle>Settlements - Auction System</PageTitle>

<h1>Payment & Settlement</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(tab == "invoices" ? "active" : "")" href="#" @onclick='() => tab = "invoices"' @onclick:preventDefault>Invoices</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "settlements" ? "active" : "")" href="#" @onclick='() => tab = "settlements"' @onclick:preventDefault>Settlements</a></li>
    <li class="nav-item"><a class="nav-link @(tab == "generate" ? "active" : "")" href="#" @onclick='() => tab = "generate"' @onclick:preventDefault>Generate</a></li>
</ul>

@if (tab == "invoices")
{
    <h4>All Invoices</h4>
    <table class="table table-striped">
        <thead><tr><th>Number</th><th>Broker</th><th>Auction</th><th>Subtotal</th><th>Commission</th><th>Tax</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var inv in invoices)
            {
                <tr>
                    <td>@inv.InvoiceNumber</td>
                    <td>@(inv.Broker?.CompanyName ?? "")</td>
                    <td>@(inv.Auction?.Title ?? "")</td>
                    <td>@inv.SubTotal.ToString("N2")</td>
                    <td>@inv.Commission.ToString("N2")</td>
                    <td>@inv.Tax.ToString("N2")</td>
                    <td><strong>@inv.TotalAmount.ToString("N2")</strong></td>
                    <td><span class="badge bg-@GetInvColor(inv.Status)">@inv.Status</span></td>
                    <td>
                        @if (inv.Status == InvoiceStatus.Issued)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => MarkPaid(inv.Id)">Mark Paid</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (tab == "settlements")
{
    <h4>All Settlements</h4>
    <table class="table table-striped">
        <thead><tr><th>Number</th><th>Seller</th><th>Lot</th><th>Gross</th><th>Commission</th><th>Fees</th><th>Net</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var s in allSettlements)
            {
                <tr>
                    <td>@s.SettlementNumber</td>
                    <td>@(s.Seller?.Name ?? "")</td>
                    <td>@(s.Lot != null ? $"Lot #{s.Lot.LotNumber}" : "")</td>
                    <td>@s.GrossAmount.ToString("N2")</td>
                    <td>@s.Commission.ToString("N2")</td>
                    <td>@s.Fees.ToString("N2")</td>
                    <td><strong>@s.NetAmount.ToString("N2")</strong></td>
                    <td><span class="badge bg-@GetSettColor(s.Status)">@s.Status</span></td>
                    <td>
                        @if (s.Status == SettlementStatus.Pending)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => MarkComplete(s.Id)">Complete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (tab == "generate")
{
    <div class="card">
        <div class="card-header">Generate Invoice / Settlement</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Auction</label>
                    <select class="form-select" @bind="genAuctionId">
                        <option value="0">Select...</option>
                        @foreach (var a in auctions)
                        {
                            <option value="@a.Id">@a.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Broker</label>
                    <select class="form-select" @bind="genBrokerId">
                        <option value="0">Select...</option>
                        @foreach (var b in brokers)
                        {
                            <option value="@b.Id">@b.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-primary" @onclick="GenerateInvoice">Generate Invoice</button>
                </div>
            </div>

            <hr />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Lot ID (sold lot)</label>
                    <input type="number" class="form-control" @bind="genLotId" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-warning" @onclick="CreateSettlement">Create Settlement</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(genMessage))
            {
                <div class="alert alert-info mt-3">@genMessage</div>
            }
        </div>
    </div>
}

@code {
    private string tab = "invoices";
    private List<InvoiceDto> invoices = new();
    private List<SettlementDto> allSettlements = new();
    private List<AuctionDto> auctions = new();
    private List<BrokerDto> brokers = new();
    private int genAuctionId, genBrokerId, genLotId;
    private string? genMessage;

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        invoices = await Api.GetAllInvoicesAsync();
        allSettlements = await Api.GetAllSettlementsAsync();
        auctions = await Api.GetAuctionsAsync();
        brokers = await Api.GetBrokersAsync();
    }

    private async Task GenerateInvoice()
    {
        if (genAuctionId <= 0 || genBrokerId <= 0) return;
        var inv = await Api.GenerateInvoiceAsync(genAuctionId, genBrokerId);
        genMessage = inv != null ? $"Invoice {inv.InvoiceNumber} generated: {inv.TotalAmount:N2}" : "No won lots found";
        await LoadAll();
    }

    private async Task CreateSettlement()
    {
        if (genLotId <= 0) return;
        var s = await Api.CreateSettlementAsync(genLotId);
        genMessage = s != null ? $"Settlement {s.SettlementNumber} created: Net {s.NetAmount:N2}" : "Lot not eligible";
        await LoadAll();
    }

    private async Task MarkPaid(int id)
    {
        await Api.MarkInvoicePaidAsync(id);
        await LoadAll();
    }

    private async Task MarkComplete(int id)
    {
        await Api.MarkSettlementCompleteAsync(id);
        await LoadAll();
    }

    private string GetInvColor(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Paid => "success",
        InvoiceStatus.Issued => "warning",
        _ => "secondary"
    };

    private string GetSettColor(SettlementStatus s) => s switch
    {
        SettlementStatus.Completed => "success",
        SettlementStatus.Pending => "warning",
        _ => "info"
    };
}
