@page "/auctions"
@page "/auctions/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav

<PageTitle>Auctions - Auction System</PageTitle>

<h1>Auction Management</h1>

@if (Id.HasValue)
{
    @if (loadingAuction)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading auction...</p>
        </div>
    }
    else if (selectedAuction == null)
    {
        <div class="alert alert-warning">
            Auction not found. <a href="/auctions">Back to Auctions</a>
        </div>
    }
    else
    {
        <nav><a href="/auctions">&larr; Back to Auctions</a></nav>
        <h2 class="mt-3">@selectedAuction.Title</h2>
        <div class="d-flex align-items-center gap-3 mb-3">
            <p class="mb-0"><strong>Number:</strong> @selectedAuction.AuctionNumber | <strong>Date:</strong> @selectedAuction.ScheduledDate.ToString("yyyy-MM-dd")</p>
            <div class="d-flex align-items-center gap-2">
                <strong>Status:</strong>
                <select class="form-select form-select-sm" style="width: auto;" value="@selectedAuction.Status" @onchange="OnStatusChanged">
                    @foreach (var status in Enum.GetValues<AuctionStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "lots" ? "active" : "")" @onclick='() => activeTab = "lots"'>
                    Lots <span class="badge bg-secondary">@lots.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "import" ? "active" : "")" @onclick="OpenImportTab">
                    Import Catalog Lots
                </button>
            </li>
        </ul>

        @if (activeTab == "lots")
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr><th>#</th><th>Description</th><th>Category</th><th>Qty</th><th>Hammer</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @if (lots.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No lots in this auction. Use the "Import Catalog Lots" tab to add lots.</td></tr>
                    }
                    @foreach (var lot in lots)
                    {
                        <tr>
                            <td>@lot.LotNumber</td>
                            <td>@lot.Description</td>
                            <td>@lot.Category</td>
                            <td>@lot.Quantity @lot.Unit</td>
                            <td>@(lot.HammerPrice?.ToString("N2") ?? "-")</td>
                            <td><span class="badge bg-@GetLotColor(lot.Status)">@lot.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (activeTab == "import")
        {
            @if (!string.IsNullOrEmpty(importMessage))
            {
                <div class="alert @(importIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
                    @importMessage
                    <button type="button" class="btn-close" @onclick="() => importMessage = null"></button>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header"><strong>Filter Catalog Lots</strong></div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Filter by Type</label>
                            <select class="form-select" @bind="filterSalesType" @bind:after="ApplyFilters">
                                <option value="">All Types</option>
                                @foreach (var t in salesTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Filter by Gender</label>
                            <select class="form-select" @bind="filterGender" @bind:after="ApplyFilters">
                                <option value="">All Genders</option>
                                @foreach (var g in genders)
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong>Catalog Lots</strong> <span class="badge bg-secondary">@filteredCatalogLots.Count</span>
                    @if (selectedCatalogLotIds.Count > 0)
                    {
                        <span class="badge bg-primary ms-2">@selectedCatalogLotIds.Count selected</span>
                    }
                </div>
                <div>
                    @if (selectedCatalogLotIds.Count > 0)
                    {
                        <button class="btn btn-primary" @onclick="ImportSelectedLots" disabled="@importing">
                            @(importing ? "Importing..." : $"Import {selectedCatalogLotIds.Count} Lots")
                        </button>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><input type="checkbox" @onchange="ToggleSelectAll" checked="@allSelected" /></th>
                                <th>Lot #</th>
                                <th>Type</th>
                                <th>Gender</th>
                                <th>Color</th>
                                <th>Quality</th>
                                <th>Size</th>
                                <th>Skins</th>
                                <th>Boxes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loadingCatalog)
                            {
                                <tr><td colspan="9" class="text-center py-4"><em>Loading catalog lots...</em></td></tr>
                            }
                            else if (filteredCatalogLots.Count == 0)
                            {
                                <tr><td colspan="9" class="text-center text-muted py-4">No catalog lots found.</td></tr>
                            }
                            @foreach (var cl in filteredCatalogLots)
                            {
                                var isAlreadyImported = importedLotNumbers.Contains(cl.LotNumber);
                                <tr class="@(isAlreadyImported ? "table-success" : "")">
                                    <td>
                                        @if (isAlreadyImported)
                                        {
                                            <span class="text-success" title="Already imported">&#10003;</span>
                                        }
                                        else
                                        {
                                            <input type="checkbox" checked="@selectedCatalogLotIds.Contains(cl.CatalogLotID)"
                                                   @onchange="e => ToggleLotSelection(cl.CatalogLotID, (bool)(e.Value ?? false))" />
                                        }
                                    </td>
                                    <td><strong>@cl.LotNumber</strong></td>
                                    <td>@cl.SalesType</td>
                                    <td>@cl.Gender</td>
                                    <td>@cl.Color</td>
                                    <td>@cl.Quality</td>
                                    <td>@cl.Size</td>
                                    <td>@cl.TotalSkins</td>
                                    <td>@cl.BoxCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Create New Auction</strong>
            <button class="btn btn-sm @(showCreateForm ? "btn-secondary" : "btn-primary")" @onclick="() => showCreateForm = !showCreateForm">
                @(showCreateForm ? "Cancel" : "+ New Auction")
            </button>
        </div>
        @if (showCreateForm)
        {
            <div class="card-body">
                @if (!string.IsNullOrEmpty(createMessage))
                {
                    <div class="alert @(createIsError ? "alert-danger" : "alert-success") alert-dismissible">
                        @createMessage
                        <button type="button" class="btn-close" @onclick="() => createMessage = null"></button>
                    </div>
                }
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Auction Number</label>
                        <input type="text" class="form-control" @bind="newAuctionNumber" placeholder="e.g. AUC-2026-001" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" @bind="newTitle" placeholder="e.g. Spring Auction 2026" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Location</label>
                        <input type="text" class="form-control" @bind="newLocation" placeholder="e.g. Copenhagen" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Scheduled Date</label>
                        <input type="date" class="form-control" @bind="newScheduledDate" />
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-9">
                        <label class="form-label">Description (optional)</label>
                        <input type="text" class="form-control" @bind="newDescription" placeholder="Description" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="CreateAuction" disabled="@creatingAuction">
                            @if (creatingAuction) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Create Auction
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Auctions</strong> <span class="badge bg-secondary">@auctions.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr><th>Number</th><th>Title</th><th>Location</th><th>Date</th><th>Status</th><th>Lots</th></tr>
                </thead>
                <tbody>
                    @if (auctions.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No auctions found.</td></tr>
                    }
                    @foreach (var a in auctions)
                    {
                        <tr @onclick="() => NavigateTo(a.Id)" style="cursor:pointer">
                            <td><strong>@a.AuctionNumber</strong></td>
                            <td>@a.Title</td>
                            <td>@a.Location</td>
                            <td>@a.ScheduledDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-info">@a.Status</span></td>
                            <td>@(a.LotCount > 0 ? a.LotCount : a.Lots.Count)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private List<AuctionDto> auctions = new();
    private AuctionDto? selectedAuction;
    private List<LotDto> lots = new();
    private string activeTab = "lots";
    private bool loadingAuction;

    // Import tab state
    private List<CatalogLotDto> catalogLots = new();
    private List<CatalogLotDto> filteredCatalogLots = new();
    private HashSet<int> selectedCatalogLotIds = new();
    private HashSet<int> importedLotNumbers = new();
    private string filterSalesType = "";
    private string filterGender = "";
    private List<string> salesTypes = new();
    private List<string> genders = new();
    private bool loadingCatalog;
    private bool importing;
    private string? importMessage;
    private bool importIsError;
    private bool allSelected => filteredCatalogLots.Count > 0 &&
        filteredCatalogLots.Where(cl => !importedLotNumbers.Contains(cl.LotNumber)).All(cl => selectedCatalogLotIds.Contains(cl.CatalogLotID));

    // Create auction state
    private bool showCreateForm;
    private string newAuctionNumber = "";
    private string newTitle = "";
    private string newLocation = "";
    private string? newDescription;
    private DateTime newScheduledDate = DateTime.Today.AddDays(7);
    private bool creatingAuction;
    private string? createMessage;
    private bool createIsError;

    private void NavigateTo(int id) => Nav.NavigateTo($"/auctions/{id}");

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            loadingAuction = true;
            try
            {
                var auctionTask = Api.GetAuctionAsync(Id.Value);
                var lotsTask = Api.GetLotsByAuctionAsync(Id.Value);
                selectedAuction = await auctionTask;
                lots = await lotsTask;
                importedLotNumbers = lots.Select(l => l.LotNumber).ToHashSet();
            }
            catch (HttpRequestException)
            {
                selectedAuction = null;
            }
            finally
            {
                loadingAuction = false;
            }
        }
        else
        {
            auctions = await Api.GetAuctionsAsync();
        }
    }

    private async Task CreateAuction()
    {
        createMessage = null;
        if (string.IsNullOrWhiteSpace(newAuctionNumber) || string.IsNullOrWhiteSpace(newTitle))
        {
            createMessage = "Auction Number and Title are required.";
            createIsError = true;
            return;
        }

        creatingAuction = true;
        try
        {
            var resp = await Api.CreateAuctionAsync(new
            {
                auctionNumber = newAuctionNumber,
                title = newTitle,
                description = newDescription,
                location = newLocation,
                scheduledDate = newScheduledDate
            });

            if (resp.IsSuccessStatusCode)
            {
                createMessage = $"Auction '{newTitle}' created successfully.";
                createIsError = false;
                newAuctionNumber = "";
                newTitle = "";
                newLocation = "";
                newDescription = null;
                newScheduledDate = DateTime.Today.AddDays(7);
                showCreateForm = false;
                auctions = await Api.GetAuctionsAsync();
            }
            else
            {
                var content = await resp.Content.ReadAsStringAsync();
                createMessage = $"Failed to create auction: {content}";
                createIsError = true;
            }
        }
        catch (Exception ex)
        {
            createMessage = $"Error: {ex.Message}";
            createIsError = true;
        }
        finally
        {
            creatingAuction = false;
        }
    }

    private async Task OpenImportTab()
    {
        activeTab = "import";
        if (catalogLots.Count == 0)
        {
            loadingCatalog = true;
            catalogLots = await Api.GetCatalogLotsAsync();
            salesTypes = catalogLots.Where(c => c.SalesType != null).Select(c => c.SalesType!).Distinct().OrderBy(x => x).ToList();
            genders = catalogLots.Where(c => c.Gender != null).Select(c => c.Gender!).Distinct().OrderBy(x => x).ToList();
            ApplyFilters();
            loadingCatalog = false;
        }
    }

    private void ApplyFilters()
    {
        filteredCatalogLots = catalogLots;
        if (!string.IsNullOrEmpty(filterSalesType))
            filteredCatalogLots = filteredCatalogLots.Where(c => c.SalesType == filterSalesType).ToList();
        if (!string.IsNullOrEmpty(filterGender))
            filteredCatalogLots = filteredCatalogLots.Where(c => c.Gender == filterGender).ToList();
    }

    private void ToggleLotSelection(int catalogLotId, bool selected)
    {
        if (selected)
            selectedCatalogLotIds.Add(catalogLotId);
        else
            selectedCatalogLotIds.Remove(catalogLotId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var selectAll = (bool)(e.Value ?? false);
        foreach (var cl in filteredCatalogLots.Where(cl => !importedLotNumbers.Contains(cl.LotNumber)))
        {
            if (selectAll)
                selectedCatalogLotIds.Add(cl.CatalogLotID);
            else
                selectedCatalogLotIds.Remove(cl.CatalogLotID);
        }
    }

    private async Task ImportSelectedLots()
    {
        if (selectedCatalogLotIds.Count == 0) return;
        importing = true;
        importMessage = null;
        try
        {
            var request = new ImportCatalogLotsRequest
            {
                CatalogLotIds = selectedCatalogLotIds.ToList(),
                FarmerId = 0
            };
            var resp = await Api.ImportCatalogLotsToAuctionAsync(Id!.Value, request);
            if (resp.IsSuccessStatusCode)
            {
                lots = await Api.GetLotsByAuctionAsync(Id.Value);
                importedLotNumbers = lots.Select(l => l.LotNumber).ToHashSet();
                importMessage = $"Successfully imported {selectedCatalogLotIds.Count} catalog lots into this auction.";
                importIsError = false;
                selectedCatalogLotIds.Clear();
            }
            else
            {
                importMessage = "Failed to import lots. Please try again.";
                importIsError = true;
            }
        }
        catch (Exception ex)
        {
            importMessage = $"Error: {ex.Message}";
            importIsError = true;
        }
        importing = false;
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<AuctionStatus>(e.Value?.ToString(), out var status))
        {
            await Api.UpdateAuctionStatusAsync(Id!.Value, status);
            selectedAuction = await Api.GetAuctionAsync(Id.Value);
        }
    }

    private string GetLotColor(LotStatus s) => s switch
    {
        LotStatus.Pending => "secondary",
        LotStatus.Active => "warning",
        LotStatus.Sold => "success",
        LotStatus.Unsold => "danger",
        LotStatus.Broker => "info",
        _ => "secondary"
    };
}
