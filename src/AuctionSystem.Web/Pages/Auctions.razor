@page "/auctions"
@page "/auctions/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject AuctionApiClient Api
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Auctions - Auction System</PageTitle>

<h1>Auction Management</h1>

@if (Id.HasValue)
{
    @if (loadingAuction)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading auction...</p>
        </div>
    }
    else if (selectedAuction == null)
    {
        <div class="alert alert-warning">
            Auction not found. <a href="/auctions">Back to Auctions</a>
        </div>
    }
    else
    {
        <nav><a href="/auctions">&larr; Back to Auctions</a></nav>
        <h2 class="mt-3">@selectedAuction.Title</h2>
        <div class="d-flex align-items-center gap-3 mb-3">
            <p class="mb-0"><strong>Number:</strong> @selectedAuction.AuctionNumber | <strong>Date:</strong> @selectedAuction.ScheduledDate.ToString("yyyy-MM-dd")</p>
            <div class="d-flex align-items-center gap-2">
                <strong>Status:</strong>
                <select class="form-select form-select-sm" style="width: auto;" value="@selectedAuction.Status" @onchange="OnStatusChanged">
                    @foreach (var status in Enum.GetValues<AuctionStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            @if (selectedAuction.Status == AuctionStatus.Draft)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="DeleteAuction" disabled="@deletingAuction">
                    @(deletingAuction ? "Deleting..." : "Delete Auction")
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(deleteError))
        {
            <div class="alert alert-danger">@deleteError</div>
        }

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "lots" ? "active" : "")" @onclick='() => activeTab = "lots"'>
                    Lots <span class="badge bg-secondary">@lots.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "transactions" ? "active" : "")" @onclick="OpenTransactionsTab">
                    Transactions <span class="badge bg-secondary">@transactions.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "skins" ? "active" : "")" @onclick="OpenSkinsTab">
                    Skins
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "import" ? "active" : "")" @onclick="OpenImportTab">
                    Import Catalog Lots
                </button>
            </li>
        </ul>

        @if (activeTab == "lots")
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr><th>#</th><th>Description</th><th>Category</th><th>Qty</th><th>Hammer</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @if (lots.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No lots in this auction. Use the "Import Catalog Lots" tab to add lots.</td></tr>
                    }
                    @foreach (var lot in lots)
                    {
                        <tr>
                            <td>@lot.LotNumber</td>
                            <td>@lot.Description</td>
                            <td>@lot.Category</td>
                            <td>@lot.Quantity @lot.Unit</td>
                            <td>@(lot.HammerPrice?.ToString("N2") ?? "-")</td>
                            <td><span class="badge bg-@GetLotColor(lot.Status)">@lot.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (activeTab == "transactions")
        {
            @if (transactionsLoading)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                @if (transactionSummary.Any())
                {
                    <div class="row mb-4">
                        @foreach (var s in transactionSummary)
                        {
                            <div class="col-md-4">
                                <div class="card text-center">
                                    <div class="section-body p-3">
                                        <h5 class="card-title text-muted">@FormatTransactionType(s.TransactionType)</h5>
                                        <h2>€@s.TotalAmount.ToString("N2")</h2>
                                        <small class="text-muted">@s.Count transactions</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!transactions.Any())
                {
                    <div class="alert alert-info">No transactions for this auction.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>Lot</th><th>Type</th><th>Broker</th><th>Description</th>
                                    <th class="text-end">Qty</th><th class="text-end">Unit Price</th>
                                    <th class="text-end">Amount</th><th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in transactions)
                                {
                                    <tr class="@GetTransactionRowClass(t.TransactionType)">
                                        <td><strong>@t.LotNumber</strong></td>
                                        <td><span class="badge @GetTransactionBadgeClass(t.TransactionType)">@FormatTransactionType(t.TransactionType)</span></td>
                                        <td>@t.BrokerNumber — @t.BrokerName</td>
                                        <td><small>@t.Description</small></td>
                                        <td class="text-end">@t.Quantity</td>
                                        <td class="text-end">€@t.UnitPrice.ToString("N4")</td>
                                        <td class="text-end"><strong>€@t.Amount.ToString("N2")</strong></td>
                                        <td><small>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-dark">
                                    <td colspan="6"><strong>Total</strong></td>
                                    <td class="text-end"><strong>€@transactions.Sum(t => t.Amount).ToString("N2")</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
        }
        else if (activeTab == "skins")
        {
            @if (skinsLoading)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="card-title">Total Sold Skins</div>
                            <div class="card-value">@skinsTotalCount.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <input class="form-control" placeholder="Search by farmer, barcode, or box..."
                               @bind="skinsSearch" @bind:event="oninput" @onkeydown="HandleSkinsSearchKey" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary" @onclick="SearchSkins">Search</button>
                        @if (!string.IsNullOrEmpty(skinsActiveSearch))
                        {
                            <button class="btn btn-outline-secondary ms-1" @onclick="ClearSkinsSearch">Clear</button>
                        }
                    </div>
                </div>

                @if (!skinsList.Any())
                {
                    <div class="alert alert-info">No sold skins for this auction.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>Lot</th><th>Box</th><th>Barcode</th><th>Farmer</th>
                                    <th>Sales Type</th><th>Gender</th><th>Group</th><th>Size</th>
                                    <th>Color</th><th>Quality</th><th>Broker</th><th>Buyer</th>
                                    <th>Price (EUR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var skin in skinsList)
                                {
                                    <tr>
                                        <td>@skin.LotNumber</td><td>@skin.BoxNumber</td><td>@skin.Barcode</td>
                                        <td>@skin.Farmer</td><td>@skin.SalesType</td><td>@skin.Gender</td>
                                        <td>@skin.Group</td><td>@skin.Size</td><td>@skin.Color</td>
                                        <td>@skin.Quality</td><td>@skin.BrokerName</td><td>@skin.BuyerName</td>
                                        <td>@skin.PriceEur?.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Showing @(((skinsPage - 1) * skinsPageSize) + 1)–@(Math.Min(skinsPage * skinsPageSize, skinsTotalCount)) of @skinsTotalCount.ToString("N0")</small>
                            <ul class="pagination mb-0">
                                <li class="page-item @(skinsPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" @onclick="() => GoToSkinsPage(1)">First</a>
                                </li>
                                <li class="page-item @(skinsPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" @onclick="() => GoToSkinsPage(skinsPage - 1)">Prev</a>
                                </li>
                                <li class="page-item @(skinsPage >= skinsTotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" @onclick="() => GoToSkinsPage(skinsPage + 1)">Next</a>
                                </li>
                                <li class="page-item @(skinsPage >= skinsTotalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" @onclick="() => GoToSkinsPage(skinsTotalPages)">Last</a>
                                </li>
                            </ul>
                        </div>
                    </nav>
                }
            }
        }
        else if (activeTab == "import")
        {
            @if (!string.IsNullOrEmpty(importMessage))
            {
                <div class="alert @(importIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
                    @importMessage
                    <button type="button" class="btn-close" @onclick="() => importMessage = null"></button>
                </div>
            }

            <div class="section-container mb-3">
                <div class="section-header"><strong>Filter Catalog Lots</strong></div>
                <div class="section-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Filter by Type</label>
                            <select class="form-select" @bind="filterSalesType" @bind:after="ApplyFilters">
                                <option value="">All Types</option>
                                @foreach (var t in salesTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Filter by Gender</label>
                            <select class="form-select" @bind="filterGender" @bind:after="ApplyFilters">
                                <option value="">All Genders</option>
                                @foreach (var g in genders)
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong>Catalog Lots</strong> <span class="badge bg-secondary">@filteredCatalogLots.Count</span>
                    @if (selectedCatalogLotIds.Count > 0)
                    {
                        <span class="badge bg-primary ms-2">@selectedCatalogLotIds.Count selected</span>
                    }
                </div>
                <div>
                    @if (selectedCatalogLotIds.Count > 0)
                    {
                        <button class="btn btn-primary" @onclick="ImportSelectedLots" disabled="@importing">
                            @(importing ? "Importing..." : $"Import {selectedCatalogLotIds.Count} Lots")
                        </button>
                    }
                </div>
            </div>

            <div class="section-container">
                <div class="section-body">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><input type="checkbox" @onchange="ToggleSelectAll" checked="@allSelected" /></th>
                                <th>Lot #</th>
                                <th>Type</th>
                                <th>Gender</th>
                                <th>Color</th>
                                <th>Quality</th>
                                <th>Size</th>
                                <th>Skins</th>
                                <th>Boxes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loadingCatalog)
                            {
                                <tr><td colspan="9" class="text-center py-4"><em>Loading catalog lots...</em></td></tr>
                            }
                            else if (filteredCatalogLots.Count == 0)
                            {
                                <tr><td colspan="9" class="text-center text-muted py-4">No catalog lots found.</td></tr>
                            }
                            @foreach (var cl in filteredCatalogLots)
                            {
                                var isAlreadyImported = importedLotNumbers.Contains(cl.LotNumber);
                                <tr class="@(isAlreadyImported ? "table-success" : "")">
                                    <td>
                                        @if (isAlreadyImported)
                                        {
                                            <span class="text-success" title="Already imported">&#10003;</span>
                                        }
                                        else
                                        {
                                            <input type="checkbox" checked="@selectedCatalogLotIds.Contains(cl.CatalogLotID)"
                                                   @onchange="e => ToggleLotSelection(cl.CatalogLotID, (bool)(e.Value ?? false))" />
                                        }
                                    </td>
                                    <td><strong>@cl.LotNumber</strong></td>
                                    <td>@cl.SalesType</td>
                                    <td>@cl.Gender</td>
                                    <td>@cl.Color</td>
                                    <td>@cl.Quality</td>
                                    <td>@cl.Size</td>
                                    <td>@cl.TotalSkins</td>
                                    <td>@cl.BoxCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
else
{
    <div class="section-container mb-3">
        <div class="section-header">
            <strong>Create New Auction</strong>
            <button class="btn btn-sm @(showCreateForm ? "btn-secondary" : "btn-primary")" @onclick="() => showCreateForm = !showCreateForm">
                @(showCreateForm ? "Cancel" : "+ New Auction")
            </button>
        </div>
        @if (showCreateForm)
        {
            <div>
                @if (!string.IsNullOrEmpty(createMessage))
                {
                    <div class="alert @(createIsError ? "alert-danger" : "alert-success") alert-dismissible">
                        @createMessage
                        <button type="button" class="btn-close" @onclick="() => createMessage = null"></button>
                    </div>
                }
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Auction Number</label>
                        <input type="text" class="form-control" @bind="newAuctionNumber" placeholder="e.g. AUC-2026-001" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" @bind="newTitle" placeholder="e.g. Spring Auction 2026" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Location</label>
                        <input type="text" class="form-control" @bind="newLocation" placeholder="e.g. Copenhagen" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Scheduled Date</label>
                        <input type="date" class="form-control" @bind="newScheduledDate" />
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-9">
                        <label class="form-label">Description (optional)</label>
                        <input type="text" class="form-control" @bind="newDescription" placeholder="Description" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="CreateAuction" disabled="@creatingAuction">
                            @if (creatingAuction) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Create Auction
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="section-container mb-3">
        <div class="section-header">
            <strong>Copy Catalog to Auction Hub</strong>
        </div>
        <div class="section-body p-3">
            @if (!string.IsNullOrEmpty(copyMessage))
            {
                <div class="alert @(copyIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
                    @copyMessage
                    <button type="button" class="btn-close" @onclick="() => copyMessage = null"></button>
                </div>
            }
            <p class="text-muted mb-3">Copy the current catalog lots to the Auction Hub database.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="AppendCatalog" disabled="@copyingCatalog">
                    @if (copyingCatalog && copyAction == "append") { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Append Catalog
                </button>
                <button class="btn btn-warning" @onclick="ConfirmRecreateCatalog" disabled="@copyingCatalog">
                    @if (copyingCatalog && copyAction == "recreate") { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Recreate Catalog
                </button>
            </div>
            @if (showRecreateConfirm)
            {
                <div class="alert alert-warning mt-3">
                    <strong>Are you sure?</strong> This will delete all existing rows in the target table and replace them with the current catalog.
                    <div class="mt-2">
                        <button class="btn btn-danger btn-sm me-2" @onclick="RecreateCatalog">Yes, Recreate</button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => showRecreateConfirm = false">Cancel</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="section-container">
        <div class="section-header">
            <strong>Auctions</strong> <span class="badge bg-secondary">@auctions.Count</span>
        </div>
        <div class="section-body">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr><th>Number</th><th>Title</th><th>Location</th><th>Date</th><th>Status</th><th>Lots</th></tr>
                </thead>
                <tbody>
                    @if (auctions.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No auctions found.</td></tr>
                    }
                    @foreach (var a in auctions)
                    {
                        <tr @onclick="() => NavigateTo(a.Id)" style="cursor:pointer">
                            <td><strong>@a.AuctionNumber</strong></td>
                            <td>@a.Title</td>
                            <td>@a.Location</td>
                            <td>@a.ScheduledDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-info">@a.Status</span></td>
                            <td>@(a.LotCount > 0 ? a.LotCount : a.Lots.Count)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private List<AuctionDto> auctions = new();
    private AuctionDto? selectedAuction;
    private List<LotDto> lots = new();
    private string activeTab = "lots";
    private bool loadingAuction;
    private bool deletingAuction;
    private string? deleteError;

    // Transactions tab state
    private List<AuctionTransactionDto> transactions = new();
    private List<AuctionTransactionSummaryDto> transactionSummary = new();
    private bool transactionsLoading;

    // Skins tab state
    private List<SkinItem> skinsList = new();
    private bool skinsLoading;
    private int skinsPage = 1;
    private int skinsPageSize = 100;
    private int skinsTotalPages;
    private int skinsTotalCount;
    private string skinsSearch = "";
    private string skinsActiveSearch = "";

    // Import tab state
    private List<CatalogLotDto> catalogLots = new();
    private List<CatalogLotDto> filteredCatalogLots = new();
    private HashSet<int> selectedCatalogLotIds = new();
    private HashSet<int> importedLotNumbers = new();
    private string filterSalesType = "";
    private string filterGender = "";
    private List<string> salesTypes = new();
    private List<string> genders = new();
    private bool loadingCatalog;
    private bool importing;
    private string? importMessage;
    private bool importIsError;
    private bool allSelected => filteredCatalogLots.Count > 0 &&
        filteredCatalogLots.Where(cl => !importedLotNumbers.Contains(cl.LotNumber)).All(cl => selectedCatalogLotIds.Contains(cl.CatalogLotID));

    // Create auction state
    private bool showCreateForm;
    private string newAuctionNumber = "";
    private string newTitle = "";
    private string newLocation = "";
    private string? newDescription;
    private DateTime newScheduledDate = DateTime.Today.AddDays(7);
    private bool creatingAuction;
    private string? createMessage;
    private bool createIsError;

    // Copy catalog state
    private bool copyingCatalog;
    private string copyAction = "";
    private string? copyMessage;
    private bool copyIsError;
    private bool showRecreateConfirm;

    private void NavigateTo(int id) => Nav.NavigateTo($"/auctions/{id}");

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            loadingAuction = true;
            try
            {
                var auctionTask = Api.GetAuctionAsync(Id.Value);
                var lotsTask = Api.GetLotsByAuctionAsync(Id.Value);
                selectedAuction = await auctionTask;
                lots = await lotsTask;
                importedLotNumbers = lots.Select(l => l.LotNumber).ToHashSet();
            }
            catch (HttpRequestException)
            {
                selectedAuction = null;
            }
            finally
            {
                loadingAuction = false;
            }
        }
        else
        {
            auctions = await Api.GetAuctionsAsync();
        }
    }

    private async Task CreateAuction()
    {
        createMessage = null;
        if (string.IsNullOrWhiteSpace(newAuctionNumber) || string.IsNullOrWhiteSpace(newTitle))
        {
            createMessage = "Auction Number and Title are required.";
            createIsError = true;
            return;
        }

        creatingAuction = true;
        try
        {
            var resp = await Api.CreateAuctionAsync(new
            {
                auctionNumber = newAuctionNumber,
                title = newTitle,
                description = newDescription,
                location = newLocation,
                scheduledDate = newScheduledDate
            });

            if (resp.IsSuccessStatusCode)
            {
                createMessage = $"Auction '{newTitle}' created successfully.";
                createIsError = false;
                newAuctionNumber = "";
                newTitle = "";
                newLocation = "";
                newDescription = null;
                newScheduledDate = DateTime.Today.AddDays(7);
                showCreateForm = false;
                auctions = await Api.GetAuctionsAsync();
            }
            else
            {
                var content = await resp.Content.ReadAsStringAsync();
                createMessage = $"Failed to create auction: {content}";
                createIsError = true;
            }
        }
        catch (Exception ex)
        {
            createMessage = $"Error: {ex.Message}";
            createIsError = true;
        }
        finally
        {
            creatingAuction = false;
        }
    }

    private async Task OpenTransactionsTab()
    {
        activeTab = "transactions";
        transactionsLoading = true;
        transactions = await Api.GetAuctionTransactionsAsync(Id!.Value);
        transactionSummary = await Api.GetAuctionTransactionSummaryAsync(Id!.Value);
        transactionsLoading = false;
    }

    private static string FormatTransactionType(string type) => type switch
    {
        "LotSale" => "Lot Sale",
        "AuctionFee" => "Auction Fee",
        "Commission" => "Commission",
        _ => type
    };

    private static string GetTransactionBadgeClass(string type) => type switch
    {
        "LotSale" => "bg-primary",
        "AuctionFee" => "bg-warning text-dark",
        "Commission" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private static string GetTransactionRowClass(string type) => type switch
    {
        "AuctionFee" or "Commission" => "table-light",
        _ => ""
    };

    private async Task OpenSkinsTab()
    {
        activeTab = "skins";
        skinsPage = 1;
        await LoadSkins();
    }

    private async Task LoadSkins()
    {
        skinsLoading = true;
        try
        {
            var url = $"api/skins?page={skinsPage}&pageSize={skinsPageSize}&auctionId={Id!.Value}";
            if (!string.IsNullOrEmpty(skinsActiveSearch))
                url += $"&search={Uri.EscapeDataString(skinsActiveSearch)}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = System.Text.Json.JsonDocument.Parse(json);
                skinsTotalCount = doc.RootElement.GetProperty("totalSkins").GetInt32();
                skinsPage = doc.RootElement.GetProperty("page").GetInt32();
                skinsTotalPages = doc.RootElement.GetProperty("totalPages").GetInt32();
                var skinsArray = doc.RootElement.GetProperty("skins");
                skinsList = System.Text.Json.JsonSerializer.Deserialize<List<SkinItem>>(skinsArray.GetRawText(),
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch { }
        skinsLoading = false;
    }

    private async Task GoToSkinsPage(int page)
    {
        if (page < 1 || page > skinsTotalPages) return;
        skinsPage = page;
        await LoadSkins();
    }

    private async Task SearchSkins()
    {
        skinsActiveSearch = skinsSearch;
        skinsPage = 1;
        await LoadSkins();
    }

    private async Task ClearSkinsSearch()
    {
        skinsSearch = "";
        skinsActiveSearch = "";
        skinsPage = 1;
        await LoadSkins();
    }

    private async Task HandleSkinsSearchKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchSkins();
    }

