@using Microsoft.AspNetCore.Components.Routing
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<header class="top-nav">
    <div class="nav-brand">
        <span class="brand-name">KOPENHAGEN</span>
        <span class="brand-name">FUR</span>
    </div>

    <a href="@ClientPortalUrl" class="btn-login">Client Portals</a>
</header>

@code {
    // The portal (main web app) URL is environment-specific; set ClientPortalUrl in appsettings.json
    // (rewritten per environment at deploy, like ApiBaseUrl). Falls back to "#" if unset.
    private string ClientPortalUrl =>
        string.IsNullOrWhiteSpace(Configuration["ClientPortalUrl"]) ? "#" : Configuration["ClientPortalUrl"]!;
}
